# CALQIX repo — normalize line endings to LF for text source.
# Ends the CRLF/LF churn that this mixed-history repo accumulated.
# No mass renormalization is performed here: existing files are normalized
# only when they are next edited and committed.
*.liquid  text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.svg     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Treat binaries as binary (never normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.woff  binary
*.woff2 binary
*.ico  binary
