{%- comment -%}
  CALQIX — Inline USPs snippet
  Renders 4 USPs as clickable-style cards inside the main-product block.
  Navy-on-cream clinical theme with cyan accent glow + entrance + hover micro-animations.

  Accepts:
    - block: the main-product block object (required — its id becomes the CSS namespace + attribute hook)
    - mobile_columns: "1" (stacked) or "2" (2x2 on mobile). Defaults to "1".
    - show_badge: bool — render the golden STEP badge on top
    - badge_text: string — e.g. "STEP 3 OF THE CALQIX ROUTINE"
    - animate: bool — enable entrance stagger + hover glow
{%- endcomment -%}

{%- liquid
  assign ns = 'cq-inu-' | append: block.id
  assign mcols = mobile_columns | default: '1'
  assign anim = true
  if animate == false
    assign anim = false
  endif
-%}

<style>
  .{{ ns }} {
    --cq-ink: #0b2540;
    --cq-ink-2: #1a3b5c;
    --cq-ink-soft: rgba(26, 59, 92, 0.72);
    --cq-card: #ffffff;
    --cq-shell: #f2f7ff;
    --cq-shell-2: #e7f0fb;
    --cq-accent: #3d8bff;
    --cq-accent-soft: rgba(61, 139, 255, 0.14);
    --cq-accent-line: rgba(61, 139, 255, 0.28);
    --cq-glow: 0 0 0 1px rgba(61, 139, 255, 0.12), 0 12px 28px -16px rgba(26, 59, 92, 0.28);
    --cq-glow-hover: 0 0 0 1px rgba(61, 139, 255, 0.38), 0 18px 36px -18px rgba(26, 59, 92, 0.32), 0 0 32px -8px rgba(61, 139, 255, 0.45);
    --cq-pop-shadow: 0 24px 48px -16px rgba(11, 37, 64, 0.32), 0 0 32px -4px rgba(61, 139, 255, 0.55), 0 0 0 1px rgba(61, 139, 255, 0.45);
    margin: 14px 0 18px;
  }
  /* Mobile-first: minimal shell, no big gradient */
  .{{ ns }}__shell {
    position: relative;
    background: transparent;
    border-radius: 0;
    padding: 4px 0 0;
    border: 0;
    overflow: visible;
    isolation: isolate;
  }
  .{{ ns }}__shell::before { content: none; }

  /* Desktop ≥900px: bring back the soft blue card shell */
  @media (min-width: 900px) {
    .{{ ns }}__shell {
      background: linear-gradient(180deg, var(--cq-shell) 0%, var(--cq-shell-2) 100%);
      border-radius: 14px;
      padding: 14px 12px 12px;
      border: 1px solid rgba(26, 59, 92, 0.06);
      overflow: hidden;
    }
    .{{ ns }}__shell::before {
      content: "";
      position: absolute;
      inset: -30% -10% auto auto;
      width: 60%; height: 120%;
      background: radial-gradient(ellipse at top right, rgba(61, 139, 255, 0.12), transparent 60%);
      pointer-events: none;
      z-index: 0;
    }
  }
  .{{ ns }}__badge {
    display: inline-block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--cq-accent);
    background: var(--cq-accent-soft);
    border: 1px solid var(--cq-accent-line);
    padding: 4px 10px;
    border-radius: 999px;
    margin: 0 0 10px;
    position: relative; z-index: 1;
  }
  .{{ ns }}__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    list-style: none;
    padding: 0; margin: 0;
    position: relative; z-index: 1;
  }
  {%- if mcols == '2' -%}
  @media (min-width: 480px) {
    .{{ ns }}__list { grid-template-columns: 1fr 1fr; gap: 8px; }
  }
  {%- endif -%}
  @media (min-width: 900px) {
    .{{ ns }}__list { grid-template-columns: 1fr 1fr; gap: 10px; }
  }

  /* MOBILE: minimal flat list, transparent cards, no icon background.
     Layout = icon LEFT | title RIGHT, cyan line UNDER title, subtitle
     hidden until tap → appears as floating pop-up ABOVE the row. */
  .{{ ns }}__item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(26, 59, 92, 0.08);
    border-radius: 0;
    box-shadow: none;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s ease;
  }
  .{{ ns }}__item:last-child { border-bottom: 0; }
  .{{ ns }}__item:active {
    background: rgba(61, 139, 255, 0.04);
  }

  .{{ ns }}__icon {
    flex: 0 0 auto;
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--cq-ink-2);
    background: transparent;
    border-radius: 0;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                color 0.32s ease;
  }
  .{{ ns }}__icon svg { width: 26px; height: 26px; display: block; }
  .{{ ns }}__icon svg .cq-accent { stroke: var(--cq-accent); }

  .{{ ns }}__body { min-width: 0; flex: 1 1 auto; position: relative; }
  .{{ ns }}__title {
    font-family: 'Playfair Display', 'DM Serif Display', Georgia, serif;
    font-weight: 500;
    color: var(--cq-ink);
    font-size: 14.5px;
    line-height: 1.25;
    margin: 0 0 6px;
    letter-spacing: 0.005em;
    text-align: left;
  }
  /* Cyan accent line UNDER title (always visible — replaces the bottom sweep) */
  .{{ ns }}__title::after {
    content: "";
    display: block;
    width: 36px;
    height: 2px;
    margin-top: 6px;
    background: linear-gradient(90deg, var(--cq-accent), rgba(61, 139, 255, 0));
    border-radius: 2px;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 900px) {
    .{{ ns }}__title { font-size: 15px; }
  }
  .{{ ns }}__item.is-active .{{ ns }}__title::after,
  .{{ ns }}__item:hover .{{ ns }}__title::after {
    width: 60px;
  }

  /* Subtitle = popover floating ABOVE the title.
     Hidden by default. Toggled via .is-active (mobile tap) or :hover (desktop). */
  .{{ ns }}__subtitle {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    z-index: 5;
    width: max-content;
    max-width: min(calc(100vw - 40px), 280px);
    margin: 0;
    padding: 12px 16px;
    background: var(--cq-card);
    color: var(--cq-ink);
    border-radius: 12px;
    box-shadow: var(--cq-pop-shadow);
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 12.5px;
    line-height: 1.45;
    text-align: left;
    opacity: 0;
    transform: translateY(14px) scale(0.85);
    transform-origin: bottom left;
    pointer-events: none;
    transition: opacity 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* Pointer arrow connecting popover to title */
  .{{ ns }}__subtitle::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 18px;
    width: 12px; height: 12px;
    background: var(--cq-card);
    transform: translateY(-6px) rotate(45deg);
    box-shadow: 4px 4px 8px -2px rgba(11, 37, 64, 0.08);
    z-index: -1;
  }

  /* Active states — clinical exaggerated entrance: bounce-in scale + lift */
  .{{ ns }}__item.is-active .{{ ns }}__subtitle {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    animation: {{ ns }}-pop-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes {{ ns }}-pop-in {
    0%   { opacity: 0; transform: translateY(14px) scale(0.7);   filter: blur(2px); }
    40%  { opacity: 1; transform: translateY(-4px) scale(1.06); filter: blur(0); }
    70%  {            transform: translateY(2px) scale(0.98); }
    100% {            transform: translateY(0)   scale(1); }
  }

  /* Desktop ≥900px overrides — restore card look + hover popover */
  @media (min-width: 900px) {
    .{{ ns }}__list { gap: 10px; }
    .{{ ns }}__item {
      padding: 12px 14px;
      background: var(--cq-card);
      border: 1px solid rgba(26, 59, 92, 0.08);
      border-radius: 10px;
      box-shadow: var(--cq-glow);
      align-items: center;
    }
    .{{ ns }}__item:last-child { border-bottom: 1px solid rgba(26, 59, 92, 0.08); }
    .{{ ns }}__icon {
      width: 38px; height: 38px;
      background: var(--cq-accent-soft);
      border-radius: 10px;
    }
    .{{ ns }}__icon svg { width: 22px; height: 22px; }
    .{{ ns }}__title { margin-bottom: 4px; }
    .{{ ns }}__title::after { display: none; }
  }

  /* Desktop hover micro-interaction — show subtitle popover */
  @media (hover: hover) and (min-width: 900px) {
    .{{ ns }}__item:hover {
      transform: translateY(-2px);
      box-shadow: var(--cq-glow-hover);
      border-color: var(--cq-accent-line);
    }
    .{{ ns }}__item:hover .{{ ns }}__icon {
      transform: scale(1.08) rotate(-2deg);
      background: var(--cq-accent);
      color: #fff;
    }
    .{{ ns }}__item:hover .{{ ns }}__icon svg .cq-accent {
      stroke: #fff;
    }
    .{{ ns }}__item:hover .{{ ns }}__subtitle {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
  }

  {%- if anim -%}
  /* Entrance animation */
  .{{ ns }}[data-animate] .{{ ns }}__item {
    opacity: 0;
    transform: translateY(14px);
  }
  .{{ ns }}[data-animate].is-visible .{{ ns }}__item {
    animation: {{ ns }}-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .{{ ns }}[data-animate].is-visible .{{ ns }}__item:nth-child(1) { animation-delay: 0.00s; }
  .{{ ns }}[data-animate].is-visible .{{ ns }}__item:nth-child(2) { animation-delay: 0.08s; }
  .{{ ns }}[data-animate].is-visible .{{ ns }}__item:nth-child(3) { animation-delay: 0.16s; }
  .{{ ns }}[data-animate].is-visible .{{ ns }}__item:nth-child(4) { animation-delay: 0.24s; }

  /* Subtle breathing glow after entrance */
  .{{ ns }}[data-animate].is-visible .{{ ns }}__icon {
    animation: {{ ns }}-glow 4.2s ease-in-out infinite;
    animation-delay: 1s;
  }

  @keyframes {{ ns }}-in {
    0%   { opacity: 0; transform: translateY(14px); }
    60%  { opacity: 1; }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes {{ ns }}-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(61, 139, 255, 0); }
    50%      { box-shadow: 0 0 0 4px rgba(61, 139, 255, 0.14); }
  }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    .{{ ns }} *,
    .{{ ns }} *::before,
    .{{ ns }} *::after {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<div
  class="{{ ns }} calqix-inline-usps"
  data-block-id="{{ block.id }}"
  {% if anim %}data-animate{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="{{ ns }}__shell">
    {%- if show_badge and badge_text != blank -%}
      <span class="{{ ns }}__badge">{{ badge_text }}</span>
    {%- endif -%}

    <ul class="{{ ns }}__list">
      {%- for i in (1..4) -%}
        {%- assign key_icon = 'usp_' | append: i | append: '_icon' -%}
        {%- assign key_title = 'usp_' | append: i | append: '_title' -%}
        {%- assign key_sub = 'usp_' | append: i | append: '_subtitle' -%}
        {%- assign icon = block.settings[key_icon] -%}
        {%- assign title = block.settings[key_title] -%}
        {%- assign subtitle = block.settings[key_sub] -%}
        {%- if title != blank -%}
          <li class="{{ ns }}__item">
            <span class="{{ ns }}__icon" aria-hidden="true">
              {%- case icon -%}
                {%- when 'microbiome' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 30 L32 30" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M20 30 L20 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M10 10 L30 10" class="cq-accent" stroke-width="1.8" stroke-linecap="round" fill="none"/>
                    <circle cx="12" cy="20" r="5" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <circle cx="28" cy="20" r="5" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <circle cx="11" cy="20" r="0.9" fill="currentColor"/>
                    <circle cx="13.5" cy="19" r="0.7" fill="currentColor"/>
                    <circle cx="12" cy="21.5" r="0.7" fill="currentColor"/>
                    <circle cx="27" cy="20" r="0.9" fill="currentColor"/>
                    <circle cx="29.2" cy="19.2" r="0.7" fill="currentColor"/>
                    <circle cx="28" cy="21.6" r="0.7" fill="currentColor"/>
                  </svg>
                {%- when 'breath-target' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="20" cy="22" rx="11" ry="6" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <path d="M11 22 Q20 27 29 22" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/>
                    <circle cx="20" cy="20" r="8" class="cq-accent" stroke-width="1.6" fill="none" opacity="0.9"/>
                    <path d="M20 8 L20 14" class="cq-accent" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M20 26 L20 32" class="cq-accent" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M8 20 L14 20" class="cq-accent" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M26 20 L32 20" class="cq-accent" stroke-width="1.6" stroke-linecap="round"/>
                    <circle cx="20" cy="20" r="1.4" fill="currentColor"/>
                  </svg>
                {%- when 'lozenge-moon' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M26 8 A12 12 0 1 0 26 32 A9 9 0 0 1 26 8 Z" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round"/>
                    <ellipse cx="14" cy="28" rx="5.5" ry="3.2" class="cq-accent" stroke-width="1.8" fill="none"/>
                    <circle cx="30" cy="14" r="0.8" fill="currentColor"/>
                    <circle cx="32" cy="20" r="0.6" fill="currentColor"/>
                  </svg>
                {%- when 'calendar-30' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="13" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <circle cx="20" cy="20" r="13" class="cq-accent" stroke-width="1.8" fill="none" stroke-dasharray="2 4" opacity="0.6"/>
                    <path d="M20 7 L20 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M20 30 L20 33" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M7 20 L10 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M30 20 L33 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <text x="20" y="24" text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" font-size="11" font-weight="400" fill="currentColor">30</text>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6 L32 11 V22 C32 28 26 33 20 34 C14 33 8 28 8 22 V11 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="none"/>
                    <path d="M14 20 L18 24 L26 16" class="cq-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  </svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 32 C12 14 22 8 32 8 C32 18 26 28 12 32 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="none"/>
                    <path d="M32 8 L12 30" class="cq-accent" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                {%- when 'sparkle' -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6 L22 18 L34 20 L22 22 L20 34 L18 22 L6 20 L18 18 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" fill="none"/>
                    <circle cx="30" cy="10" r="1.5" class="cq-accent" fill="none" stroke-width="1.4"/>
                    <circle cx="10" cy="30" r="1" class="cq-accent" fill="none" stroke-width="1.4"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="13" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <path d="M14 20 L18 24 L26 16" class="cq-accent" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  </svg>
              {%- endcase -%}
            </span>
            <div class="{{ ns }}__body">
              <h3 class="{{ ns }}__title">{{ title }}</h3>
              {%- if subtitle != blank -%}
                <p class="{{ ns }}__subtitle">{{ subtitle }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- if anim -%}
<script>
  (function () {
    var root = document.querySelector('.{{ ns }}[data-animate]');
    if (!root) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-visible');
      return;
    }
    if (!('IntersectionObserver' in window)) {
      root.classList.add('is-visible');
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.25 });
    observer.observe(root);
  })();
</script>
{%- endif -%}

<script>
  /* Mobile tap-to-toggle for the subtitle popover.
     Desktop relies on :hover (handled in CSS), so this script only adds
     pointer-coarse / touch behaviour. Tapping the same item again or
     anywhere outside the USP list dismisses the active popup. */
  (function () {
    var ns = {{ ns | json }};
    var listSel = '.' + ns;
    var itemSel = '.' + ns + '__item';
    var activeClass = 'is-active';

    function init() {
      var root = document.querySelector(listSel);
      if (!root) return;
      var items = root.querySelectorAll(itemSel);
      if (!items.length) return;

      function closeAll(except) {
        items.forEach(function (it) {
          if (it !== except) it.classList.remove(activeClass);
        });
      }

      items.forEach(function (item) {
        item.addEventListener('click', function (e) {
          // On hover-capable desktop the CSS :hover already does the work,
          // and we don't want a stuck-open state after tapping with a mouse.
          var hoverCapable = window.matchMedia && window.matchMedia('(hover: hover) and (min-width: 900px)').matches;
          if (hoverCapable) return;
          e.stopPropagation();
          var wasActive = item.classList.contains(activeClass);
          closeAll(item);
          if (!wasActive) item.classList.add(activeClass);
        });
      });

      // Tap anywhere else on the page → close all popovers.
      document.addEventListener('click', function (e) {
        if (!e.target.closest(itemSel)) closeAll();
      });

      // Escape key closes too (a11y nicety).
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAll();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
