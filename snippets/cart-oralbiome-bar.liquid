{%- liquid
  assign oralbiome_qty = 0
  for item in cart.items
    assign item_handle = item.product.handle | default: item.handle
    if item_handle contains 'oralbiome-pro-'
      assign oralbiome_qty = oralbiome_qty | plus: item.quantity
    endif
  endfor

  assign reward_fill = 0
  if oralbiome_qty == 2
    assign reward_fill = 50
  elsif oralbiome_qty >= 3
    assign reward_fill = 100
  endif

  assign reward_step = oralbiome_qty
  if reward_step > 3
    assign reward_step = 3
  endif

  assign rewards_title = 'calqix_cart.oralbiome_rewards.title' | t
  assign unlocked_10_label = 'calqix_cart.oralbiome_rewards.unlocked_10' | t
  assign unlocked_free_label = 'calqix_cart.oralbiome_rewards.unlocked_free' | t
  assign label_one = 'calqix_cart.oralbiome_rewards.label_one' | t
  assign label_two = 'calqix_cart.oralbiome_rewards.label_two' | t
  assign label_three = 'calqix_cart.oralbiome_rewards.label_three' | t
  assign msg_one_prefix = 'calqix_cart.oralbiome_rewards.msg_one_prefix' | t
  assign msg_one_strong = 'calqix_cart.oralbiome_rewards.msg_one_strong' | t
  assign msg_two_prefix = 'calqix_cart.oralbiome_rewards.msg_two_prefix' | t
  assign msg_two_strong = 'calqix_cart.oralbiome_rewards.msg_two_strong' | t
  assign msg_full_prefix = 'calqix_cart.oralbiome_rewards.msg_full_prefix' | t
  assign msg_full_strong = 'calqix_cart.oralbiome_rewards.msg_full_strong' | t
-%}

{%- if oralbiome_qty > 0 -%}
  <cart-oralbiome-bar
    class="oralbiome-bar"
    data-oralbiome-qty="{{ oralbiome_qty }}"
    data-oralbiome-handles="oralbiome-pro-freshmint,oralbiome-pro-cool-mint,oralbiome-pro-citrus-orange,oralbiome-pro-peach,oralbiome-pro-grape"
  >
    <div class="oralbiome-bar__header">
      <span class="oralbiome-bar__title">{{ rewards_title }}</span>
      <span class="oralbiome-bar__ratio">{{ reward_step }}/3</span>
    </div>

    <div class="oralbiome-bar__track" style="--oralbiome-fill: {{ reward_fill }}%;">
      <span class="oralbiome-bar__fill"></span>
      {%- for node in (1..3) -%}
        <span class="oralbiome-bar__node{% if oralbiome_qty >= node %} is-active{% endif %} oralbiome-bar__node--{{ node }}">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3 3 7-7"/></svg>
        </span>
      {%- endfor -%}
    </div>

    <div class="oralbiome-bar__labels" aria-hidden="true">
      <span class="is-active">{{ label_one }}</span>
      <span class="{% if oralbiome_qty >= 2 %}is-active{% endif %}">{{ label_two }}</span>
      <span class="{% if oralbiome_qty >= 3 %}is-active{% endif %}">{{ label_three }}</span>
    </div>

    <p class="oralbiome-bar__message">
      {%- if oralbiome_qty == 1 -%}
        {{ msg_one_prefix }} <strong>{{ msg_one_strong }}</strong>
      {%- elsif oralbiome_qty == 2 -%}
        <span class="oralbiome-bar__badge">{{ unlocked_10_label }}</span>
        {{ msg_two_prefix }} <strong>{{ msg_two_strong }}</strong>
      {%- else -%}
        <span class="oralbiome-bar__badge">{{ unlocked_free_label }}</span>
        {{ msg_full_prefix }} <strong>{{ msg_full_strong }}</strong>
      {%- endif -%}
    </p>
  </cart-oralbiome-bar>
{%- endif -%}
