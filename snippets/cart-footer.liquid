<div class="wt-cart__footer__body">
  {% assign cart_baseline_total = 0 %}
  {% for item in cart.items %}
    {% assign compare_unit_price = item.variant.compare_at_price %}
    {% if compare_unit_price != blank and compare_unit_price > item.final_price %}
      {% assign line_baseline = compare_unit_price | times: item.quantity %}
    {% else %}
      {% assign line_baseline = item.original_price | times: item.quantity %}
    {% endif %}
    {% assign cart_baseline_total = cart_baseline_total | plus: line_baseline %}
  {% endfor %}
  {% assign cart_total_saved = cart_baseline_total | minus: cart.total_price %}
  {% if cart_total_saved > 0 %}
    <div class="wt-cart__saved-row">
      <div class="wt-cart__saved-label">
        <span class="text">{{ 'calqix_cart.total_saved' | t }}</span>
      </div>
      <div class="wt-cart__saved-value">
        <svg class="wt-cart__saved-check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7.5l2.8 2.8L11 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ cart_total_saved | money_with_currency }}
      </div>
    </div>
  {% endif %}

  <div
    class="wt-cart__subtotal"
    data-subtotal-cents="{{ cart.total_price }}"
    data-currency-code="{{ cart.currency.iso_code }}"
  >
    <div class="wt-cart__subtotal__label">
      <span class="text">{{ 'sections.cart.subtotal' | t }}</span>
    </div>
    <div class="wt-cart__subtotal__value" data-subtotal-value>
      {%- if cart_total_saved > 0 and cart_baseline_total > cart.total_price -%}
        <s class="wt-cart__subtotal__compare" data-compare-cents="{{ cart_baseline_total }}">
          {{- cart_baseline_total | money_without_currency -}}
        </s>
      {%- endif -%}
      {{ cart.total_price | money_with_currency }}
    </div>
  </div>

  {%- liquid
    assign cart_all_items_available = true
    for item in cart.items
      unless item.variant.available
        assign cart_all_items_available = false
      endunless
    endfor
    assign cart_country_code = localization.country.iso_code | default: shop.address.country_code | default: 'EN' | upcase
  -%}
  <div
    class="wt-cart__stock-status{% unless cart_all_items_available %} wt-cart__stock-status--muted{% endunless %}"
    {% if cart_all_items_available %}
      data-cx-stock-countdown
      data-cx-country="{{ cart_country_code }}"
      data-cx-template="{{ 'calqix_product.cutoff_template' | t: hours: '__H__', minutes: '__M__', date: '__D__' | escape }}"
      data-cx-fallback="{{ 'calqix_cart.stock_ready' | t | escape }}"
      data-cx-months="{{ 'calqix_product.months_short' | t | escape }}"
    {% endif %}
  >
    <span class="wt-cart__stock-dot" aria-hidden="true"></span>
    <span class="wt-cart__stock-text">
      <span class="wt-cart__stock-label">
        {%- if cart_all_items_available -%}
          {{ 'calqix_product.in_stock_label' | t }}
        {%- else -%}
          {{ 'calqix_cart.stock_checking' | t }}
        {%- endif -%}
      </span>
      {%- if cart_all_items_available -%}
        <span class="wt-cart__stock-detail" data-cx-stock-detail aria-live="polite">{{ 'calqix_cart.stock_ready' | t }}</span>
      {%- endif -%}
    </span>
  </div>

  {% if settings.show_view_cart and settings.hide_checkout_button %}
    {% comment %}Only view cart button{% endcomment %}
    <button
      aria-label="{{ 'aria-label.featured-collection' | t }}"
      class="btn-checkout wt-cart__cta"
      onclick='location.href="{{ routes.cart_url }}"'
      tabindex="-1"
      {% if cart == empty %}
        disabled
      {% endif %}
    >
      <span>{{ 'sections.cart.view_cart' | t }}</span>
    </button>
  {% elsif settings.show_view_cart == false and settings.hide_checkout_button == false %}
    {% comment %}Only checkout button{% endcomment %}
    <button
      aria-label="{{ 'sections.cart.checkout' | t }}"
      type="submit"
      id="CartDrawer-Checkout"
      class="btn-checkout wt-cart__cta"
      name="checkout"
      form="CartDrawer-Form"
      {% if cart == empty %}
        disabled
      {% endif %}
      tabindex="-1"
    >
      {% if settings['enable-lock-icon'] %}
        {% render 'icon-lock' %}
      {% endif %}
      {{ 'sections.cart.checkout' | t }}
    </button>
  {% else %}
    {% comment %}Both buttons{% endcomment %}
    <button
      aria-label="{{ 'sections.cart.checkout' | t }}"
      type="submit"
      id="CartDrawer-Checkout"
      class="btn-checkout wt-cart__cta"
      name="checkout"
      form="CartDrawer-Form"
      {% if cart == empty %}
        disabled
      {% endif %}
      tabindex="-1"
    >
      {% if settings['enable-lock-icon'] %}
        {% render 'icon-lock' %}
      {% endif %}
      {{ 'sections.cart.checkout' | t }}
    </button>
    <div class="wt-featured-collection__button-container wt-button__container">
      <button
        aria-label="{{ 'aria-label.featured-collection' | t }}"
        class="wt-cart__show-cart hero__button--link"
        onclick='location.href="{{ routes.cart_url }}"'
        tabindex="-1"
      >
        <span>{{ 'sections.cart.view_cart' | t }}</span>
      </button>
    </div>
  {% endif %}

  <span style="padding-top: 10px" class="wt-cart__subtitle__text wt-cart__subtitle__text--custom wt-cart__subtitle__text--taxes">
    {{ 'calqix_cart.taxes_duties' | t }}
  </span>

  {% assign show_trust_module = settings.drawer_module_trust %}
  {% if show_trust_module == blank %}
    {% assign show_trust_module = true %}
  {% endif %}
  {% if show_trust_module %}
    {% render 'calqix-payment-methods' %}
  {% endif %}
</div>
