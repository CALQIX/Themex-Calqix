{%- comment -%}
  CALQIX Cart · Rebuild Kit FlowCore color picker modal
  ------------------------------------------------------------
  Server-rendered modal that shows the available FlowCore
  colors (variants of the water flosser) from the merchant-
  selected collection. Hidden by default; opened by
  calqix-rebuild-kit-bundle.js when the customer clicks the
  Rebuild Kit banner.

  We render the product cards server-side so layout is SEO-
  stable and the modal opens instantly without a fetch.
{%- endcomment -%}

{%- if settings.cq_rk_enable -%}
  {%- liquid
    assign flavor_collection = settings.cq_rk_flowcore_collection
    assign products = flavor_collection.products
    assign pct = settings.cq_rk_discount_pct | default: 30

    assign modal_title = settings.cq_rk_modal_title
    if modal_title == blank
      assign modal_title = 'cart.rebuild_kit_picker.modal_title' | t
      if modal_title contains 'translation missing'
        assign modal_title = 'Choose your FlowCore color'
      endif
    endif

    assign modal_sub = settings.cq_rk_modal_sub
    if modal_sub == blank
      assign modal_sub = 'cart.rebuild_kit_picker.modal_sub' | t
      if modal_sub contains 'translation missing'
        assign modal_sub = 'Your Rebuild Kit bundle saves 30% automatically at checkout.'
      endif
    endif

    assign cta_label = settings.cq_rk_modal_cta
    if cta_label == blank
      assign cta_label = 'cart.rebuild_kit_picker.cta' | t
      if cta_label contains 'translation missing'
        assign cta_label = 'Add to Kit'
      endif
    endif

    assign rrp_label = 'cart.rebuild_kit_picker.rrp' | t
    if rrp_label contains 'translation missing'
      assign rrp_label = 'RRP'
    endif

    assign bundle_price_label = 'cart.rebuild_kit_picker.bundle_price_suffix' | t
    if bundle_price_label contains 'translation missing'
      assign bundle_price_label = 'with Rebuild Kit'
    endif

    assign empty_label = 'cart.rebuild_kit_picker.empty' | t
    if empty_label contains 'translation missing'
      assign empty_label = 'No FlowCore colors configured yet. Set a collection in Theme Editor → CALQIX · Rebuild Kit Bundle.'
    endif

    assign footer_label = 'cart.rebuild_kit_picker.footer' | t
    if footer_label contains 'translation missing'
      assign footer_label = 'Discount applied automatically at checkout.'
    endif

    assign close_label = 'accessibility.close' | t
    if close_label contains 'translation missing'
      assign close_label = 'Close'
    endif
  -%}

  <div
    id="cq-rk-picker"
    class="cq-rk-picker"
    data-cq-rk-picker
    role="dialog"
    aria-modal="true"
    aria-labelledby="cq-rk-picker-title"
    aria-hidden="true"
    hidden
  >
    <div class="cq-rk-picker__backdrop" data-cq-rk-close aria-hidden="true"></div>

    <div class="cq-rk-picker__dialog" role="document">
      <button
        type="button"
        class="cq-rk-picker__close"
        data-cq-rk-close
        aria-label="{{ close_label | escape }}"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
      </button>

      <header class="cq-rk-picker__header">
        <span class="cq-rk-picker__badge">−{{ pct }}%</span>
        <h2 id="cq-rk-picker-title" class="cq-rk-picker__title">{{ modal_title }}</h2>
        <p class="cq-rk-picker__sub">{{ modal_sub }}</p>
      </header>

      {%- if products.size > 0 -%}
        <ul class="cq-rk-picker__grid" role="list">
          {%- for product in products limit: 8 -%}
            {%- liquid
              assign first_variant = product.selected_or_first_available_variant
              assign variant_id = first_variant.id
              assign available = first_variant.available
              assign rrp_cents = first_variant.price
              assign discount_cents = rrp_cents | times: pct | divided_by: 100
              assign bundle_cents = rrp_cents | minus: discount_cents
              assign rrp_money = rrp_cents | money
              assign bundle_money = bundle_cents | money
              assign color_name = product.metafields.calqix.color.value
              if color_name == blank
                assign color_name = product.metafields.calqix.flavor.value
              endif
            -%}
            <li class="cq-rk-picker__card" style="--cq-rk-card-delay: {{ forloop.index0 | times: 70 }}ms">
              <button
                type="button"
                class="cq-rk-picker__card-btn"
                data-cq-rk-add
                data-variant-id="{{ variant_id }}"
                data-product-title="{{ product.title | escape }}"
                data-product-image="{{ product.featured_image | image_url: width: 160 | default: '' }}"
                data-rrp="{{ rrp_money | escape }}"
                data-bundle-price="{{ bundle_money | escape }}"
                {% unless available %}disabled aria-disabled="true"{% endunless %}
              >
                <span class="cq-rk-picker__card-media" aria-hidden="true">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 320
                      | image_tag:
                          loading: 'lazy',
                          width: 160,
                          height: 160,
                          alt: product.title
                    }}
                  {%- else -%}
                    <span class="cq-rk-picker__card-placeholder"></span>
                  {%- endif -%}
                  <span class="cq-rk-picker__card-shine" aria-hidden="true"></span>
                </span>
                <span class="cq-rk-picker__card-info">
                  <span class="cq-rk-picker__card-title">{{ product.title }}</span>
                  {%- if color_name != blank -%}
                    <span class="cq-rk-picker__card-color">{{ color_name }}</span>
                  {%- endif -%}
                  <span class="cq-rk-picker__card-pricing">
                    <span class="cq-rk-picker__card-rrp" aria-label="{{ rrp_label | escape }}">
                      <s>{{ rrp_money }}</s>
                    </span>
                    <span class="cq-rk-picker__card-price">{{ bundle_money }}</span>
                    <span class="cq-rk-picker__card-price-suffix">{{ bundle_price_label }}</span>
                  </span>
                </span>
                <span class="cq-rk-picker__card-cta">
                  <span class="cq-rk-picker__card-cta-text">{{ cta_label }}</span>
                  <span class="cq-rk-picker__card-cta-arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="cq-rk-picker__empty">{{ empty_label }}</p>
      {%- endif -%}

      <footer class="cq-rk-picker__footer">
        <svg class="cq-rk-picker__lock" viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.5 7V5.5a3.5 3.5 0 1 1 7 0V7M3.5 7h9v6h-9z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ footer_label }}</span>
      </footer>
    </div>
  </div>
{%- endif -%}
