{%- comment -%}
  CALQIX /cart -> localized homepage redirect + sidecart auto-open.

  Behavior:
    Any GET to the locale-aware cart route (for example `/cart`, `/fr/cart`,
    `/de/cart`, `/pt-br/cart`) immediately redirects to the locale-aware
    homepage with `?open_cart=1` appended. A companion script
    (`assets/cx-cart-redirect.js`) then opens the sidecart drawer on arrival
    and strips the query flag from the URL.

  Placement:
    MUST render as the FIRST thing inside <head> so `location.replace` fires
    before any other scripts, stylesheets or page paint. Firing after GTM
    would cause a bogus /cart pageview in analytics.

  Fallbacks:
    - Shopify theme editor preview (designMode) -> skip redirect so merchants
      can still view the cart template in editor
    - Cart subpaths like /cart/change, /cart/update, /cart/clear are NOT
      redirected (only exact /cart or /cart/)
    - AJAX fetches to /cart/change.js etc. are unaffected (this only runs on
      HTML page loads)
{%- endcomment -%}
<script>
(function () {
  try {
    if (window.Shopify && window.Shopify.designMode) return;

    var path = location.pathname;
    var normalize = function (value) {
      return String(value || '/').replace(/\/+$/, '') || '/';
    };
    var currentPath = normalize(path);
    var cartPath = normalize({{ routes.cart_url | json }});
    if (currentPath !== cartPath) return;

    // Per merchant request: /cart in any locale always returns to the
    // localized homepage. Shopify owns root_url, so market prefixes stay
    // correct even for mixed-case or regional locale codes.
    var home = {{ routes.root_url | json }};
    if (home.slice(-1) !== '/') home += '/';
    location.replace(home + (home.indexOf('?') === -1 ? '?' : '&') + 'open_cart=1');
  } catch (e) { /* fall through to normal /cart page on any failure */ }
})();
</script>
