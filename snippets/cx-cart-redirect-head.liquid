{%- comment -%}
  CALQIX /cart -> product page redirect + sidecart auto-open.

  Behavior:
    Any GET to `/cart` (or localized variants like `/en/cart`, `/de-DE/cart/`,
    `/nl/cart`) is immediately redirected back to the last product page the
    customer visited this session, with `?open_cart=1` appended. A companion
    script (`assets/cx-cart-redirect.js`) then opens the sidecart drawer on
    arrival and strips the query flag from the URL.

  Placement:
    MUST render as the FIRST thing inside <head> so `location.replace` fires
    before any other scripts, stylesheets or page paint. Firing after GTM
    would cause a bogus /cart pageview in analytics.

  Fallbacks:
    - No stored product page -> redirect to `/` (homepage)
    - Stored URL is not a product page -> redirect to `/`
    - Shopify theme editor preview (designMode) -> skip redirect so merchants
      can still view the cart template in editor
    - Cart subpaths like /cart/change, /cart/update, /cart/clear are NOT
      redirected (only exact /cart or /cart/)
    - AJAX fetches to /cart/change.js etc. are unaffected (this only runs on
      HTML page loads)
{%- endcomment -%}
<script>
(function () {
  try {
    if (window.Shopify && window.Shopify.designMode) return;

    var path = location.pathname;
    var stripped = path.replace(/^\/[a-z]{2}(?:-[A-Z]{2})?(?=\/|$)/, '');
    if (stripped !== '/cart' && stripped !== '/cart/') return;

    var last = null;
    try { last = sessionStorage.getItem('cx:lastProduct'); } catch (e) {}
    if (!last || !/\/products\//.test(last)) last = '/';

    var sep = last.indexOf('?') >= 0 ? '&' : '?';
    location.replace(last + sep + 'open_cart=1');
  } catch (e) { /* fall through to normal /cart page on any failure */ }
})();
</script>
