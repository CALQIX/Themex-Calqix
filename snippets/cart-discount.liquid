{%- liquid
  assign manual_discount_count = 0
  assign automatic_discount_count = 0
  assign discount_count = 0
  assign rendered_discount_titles = '|'
  assign discount_prompt = 'calqix_cart.discount_prompt' | t
  assign input_label = 'calqix_cart.discount_input_label' | t
  assign input_placeholder = 'calqix_cart.discount_input_placeholder' | t
  assign apply_label = 'calqix_cart.discount_apply' | t
  assign active_singular_label = 'calqix_cart.discount_active_singular' | t
  assign active_plural_label = 'calqix_cart.discount_active_plural' | t
  assign already_applied_label = 'calqix_cart.discount_already_applied' | t
  assign invalid_label = 'calqix_cart.discount_invalid' | t
  assign remove_label = 'calqix_cart.discount_remove' | t
  assign auto_prefix = 'calqix_cart.discount_auto_prefix' | t
-%}

<cart-discount
  class="cart-discount"
  data-total-discount="{{ cart.total_discount }}"
  data-prompt="{{ discount_prompt | escape }}"
  data-active-singular="{{ active_singular_label | escape }}"
  data-active-plural="{{ active_plural_label | escape }}"
  data-already-applied="{{ already_applied_label | escape }}"
  data-invalid="{{ invalid_label | escape }}"
>
  <div class="cart-discount__panel">
    <button
      type="button"
      class="cart-discount__toggle"
      aria-expanded="false"
      aria-controls="CartDiscountPanel"
      data-cart-discount-toggle
    >
      <span class="cart-discount__headline">
        <svg class="cart-discount__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.59 13.41L13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
          <line x1="7" y1="7" x2="7.01" y2="7"/>
        </svg>
        <span class="cart-discount__title" data-cart-discount-title>
          {{- discount_prompt -}}
        </span>
      </span>
      <svg class="cart-discount__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </button>

    <div class="cart-discount__tags" data-cart-discount-tags>
      {%- for discount in cart.cart_level_discount_applications -%}
        {%- assign discount_key = discount.title | append: '|' | prepend: '|' -%}
        {%- unless rendered_discount_titles contains discount_key -%}
          {%- assign rendered_discount_titles = rendered_discount_titles | append: discount.title | append: '|' -%}
          {%- assign discount_count = discount_count | plus: 1 -%}
          {%- if discount.type == 'discount_code' -%}
            {%- assign manual_discount_count = manual_discount_count | plus: 1 -%}
            <span class="cart-discount__tag cart-discount__tag--manual" data-discount-code="{{ discount.title | escape }}">
              <span>{{ discount.title }}</span>
              <button type="button" class="cart-discount__remove" aria-label="{{ remove_label | escape }} {{ discount.title | escape }}" data-cart-discount-remove="{{ discount.title | escape }}">x</button>
            </span>
          {%- else -%}
            {%- assign automatic_discount_count = automatic_discount_count | plus: 1 -%}
            <span class="cart-discount__tag cart-discount__tag--automatic" data-discount-title="{{ discount.title | escape }}">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <span>{{ auto_prefix }} · {{ discount.title | upcase | truncate: 14, '' }}</span>
            </span>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- for item in cart.items -%}
        {%- for allocation in item.line_level_discount_allocations -%}
          {%- assign discount_title = allocation.discount_application.title -%}
          {%- assign discount_key = discount_title | append: '|' | prepend: '|' -%}
          {%- unless discount_title == blank or rendered_discount_titles contains discount_key -%}
            {%- assign rendered_discount_titles = rendered_discount_titles | append: discount_title | append: '|' -%}
            {%- assign discount_count = discount_count | plus: 1 -%}
            {%- assign automatic_discount_count = automatic_discount_count | plus: 1 -%}
            <span class="cart-discount__tag cart-discount__tag--automatic" data-discount-title="{{ discount_title | escape }}">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <span>{{ auto_prefix }} · {{ discount_title | upcase | truncate: 14, '' }}</span>
            </span>
          {%- endunless -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div class="cart-discount__content" id="CartDiscountPanel" data-cart-discount-content>
      <form class="cart-discount__form" data-cart-discount-form>
        <input class="cart-discount__input" type="text" name="discount" autocomplete="off" aria-label="{{ input_label | escape }}" placeholder="{{ input_placeholder | escape }}" data-cart-discount-input>
        <button class="cart-discount__apply" type="submit" data-cart-discount-apply>
          <span data-cart-discount-apply-label>{{ apply_label }}</span>
          <span class="cart-discount__spinner" aria-hidden="true"></span>
        </button>
      </form>
      <p class="cart-discount__message" role="alert" data-cart-discount-message></p>
    </div>
  </div>

  <script type="application/json" data-cart-discount-state>{"count":{{ discount_count }},"manual":{{ manual_discount_count }},"automatic":{{ automatic_discount_count }}}</script>
</cart-discount>
