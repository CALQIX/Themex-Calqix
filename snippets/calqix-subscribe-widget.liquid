{%- comment -%}
  CALQIX Subscribe & Save Widget — v2
  Horizontal scrollable plan cards · corner SAVE badge · CALQIX SVG icons
  Place inside a product form. Only renders if the product has selling plans.
{%- endcomment -%}

{%- assign cq_v = product.selected_or_first_available_variant -%}
{%- assign cq_ot = cq_v.price -%}
{%- assign cq_has_plans = false -%}
{%- assign cq_sp_id = '' -%}

{%- assign cq_sw_subscribe_save = 'calqix_oralbiome.widget.subscribe_save' | t -%}
{%- assign cq_sw_one_time = 'calqix_oralbiome.widget.one_time' | t -%}
{%- assign cq_sw_save_pct = 'calqix_oralbiome.widget.save_pct' | t -%}
{%- assign cq_sw_per_month = 'calqix_oralbiome.widget.per_month' | t -%}
{%- assign cq_sw_per_day = 'calqix_oralbiome.widget.per_day' | t -%}
{%- assign cq_sw_benefit_shipping = 'calqix_oralbiome.widget.benefit_shipping' | t -%}
{%- assign cq_sw_benefit_skip = 'calqix_oralbiome.widget.benefit_skip' | t -%}
{%- assign cq_sw_benefit_guarantee = 'calqix_oralbiome.widget.benefit_guarantee' | t -%}
{%- assign cq_sw_benefit_no_commit = 'calqix_oralbiome.widget.benefit_no_commit' | t -%}
{%- assign cq_sw_frequency_label = 'calqix_oralbiome.widget.frequency_label' | t -%}
{%- assign cq_sw_ot_shipping = 'calqix_oralbiome.widget.ot_shipping' | t -%}
{%- assign cq_sw_ot_guarantee = 'calqix_oralbiome.widget.ot_guarantee' | t -%}
{%- assign cq_sw_ot_save_note = 'calqix_oralbiome.widget.ot_save_note' | t -%}

{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign cq_has_plans = true -%}
  {%- assign cq_spg = product.selling_plan_groups[0] -%}
  {%- assign cq_sp = cq_spg.selling_plans[0] -%}
  {%- assign cq_sp_id = cq_sp.id -%}
  {%- assign cq_adj = cq_sp.price_adjustments[0] -%}

  {%- if cq_adj.value_type == 'percentage' -%}
    {%- assign cq_disc = cq_ot | times: cq_adj.value | divided_by: 100 -%}
    {%- assign cq_sub = cq_ot | minus: cq_disc -%}
    {%- assign cq_pct = cq_adj.value -%}
  {%- elsif cq_adj.value_type == 'fixed_amount' -%}
    {%- assign cq_sub = cq_ot | minus: cq_adj.value -%}
    {%- assign cq_pct = cq_adj.value | times: 100 | divided_by: cq_ot -%}
  {%- else -%}
    {%- assign cq_sub = cq_adj.value -%}
    {%- assign cq_pct = cq_ot | minus: cq_adj.value | times: 100 | divided_by: cq_ot -%}
  {%- endif -%}
{%- else -%}
  {%- assign cq_pct = 20 -%}
  {%- assign cq_disc = cq_ot | times: cq_pct | divided_by: 100 -%}
  {%- assign cq_sub = cq_ot | minus: cq_disc -%}
{%- endif -%}

{%- assign cq_perday = cq_sub | divided_by: 30 -%}

{%- capture cq_icon_truck -%}<svg class="cq-sw__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/></svg>{%- endcapture -%}
{%- capture cq_icon_refresh -%}<svg class="cq-sw__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 019-9 9.75 9.75 0 016.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 01-9 9 9.75 9.75 0 01-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>{%- endcapture -%}
{%- capture cq_icon_shield -%}<svg class="cq-sw__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>{%- endcapture -%}
{%- capture cq_icon_calendar -%}<svg class="cq-sw__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M9 16l2 2 4-4"/></svg>{%- endcapture -%}

<style>
  @keyframes cq-sw-fade {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cq-sw { margin: 0 0 14px; }

  .cq-sw__tabs-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .cq-sw__tabs-scroll::-webkit-scrollbar { display: none; }

  .cq-sw__tabs {
    display: flex;
    gap: 0;
    min-width: min-content;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    border: 2px solid #E5E7EB;
    border-bottom: none;
  }
  .cq-sw__tabs.is-sub-active { border-color: #C9A84C; }

  .cq-sw__tab {
    position: relative;
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    background: #FAFAFA;
    border: none;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #6B7280;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    min-height: 44px;
  }
  .cq-sw__tab + .cq-sw__tab { border-left: 1px solid #E5E7EB; }
  .cq-sw__tab.is-active {
    background: #1a3b5c;
    color: #fff;
  }

  .cq-sw__tab-radio {
    width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.3);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: border-color 0.2s ease;
  }
  .cq-sw__tab:not(.is-active) .cq-sw__tab-radio { border-color: #D1D5DB; }
  .cq-sw__tab-radio-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: transparent; transition: background 0.2s ease;
  }
  .cq-sw__tab.is-active .cq-sw__tab-radio { border-color: #C9A84C; }
  .cq-sw__tab.is-active .cq-sw__tab-radio-dot { background: #C9A84C; }

  .cq-sw__tab-badge {
    position: absolute;
    top: -1px;
    right: -1px;
    background: #2E7D32;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 8px;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 0 7px 0 7px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    line-height: 1;
    z-index: 1;
  }

  .cq-sw__detail {
    border: 2px solid #E5E7EB;
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 16px;
    background: #fff;
    transition: border-color 0.3s ease;
  }
  .cq-sw__detail.is-sub-active { border-color: #C9A84C; }

  .cq-sw__panel { display: none; }
  .cq-sw__panel.is-visible {
    display: block;
    animation: cq-sw-fade 0.25s ease both;
  }

  .cq-sw__pricing {
    display: flex; align-items: baseline;
    gap: 8px; flex-wrap: wrap; margin-bottom: 4px;
  }
  .cq-sw__price {
    font-family: 'DM Serif Display', serif;
    font-size: 24px; font-weight: 400; color: #1a3b5c;
  }
  .cq-sw__price-period {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px; font-weight: 400; color: #6B7280;
  }
  .cq-sw__compare {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; color: #9CA3AF; text-decoration: line-through;
  }
  .cq-sw__perday {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px; color: #6B7280; margin-bottom: 12px;
  }

  .cq-sw__benefits {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px 14px;
  }
  .cq-sw__benefit {
    font-family: 'DM Sans', sans-serif; font-size: 12px;
    color: #1a1a1a; display: flex; align-items: flex-start;
    gap: 7px; line-height: 1.4;
  }
  .cq-sw__icon {
    flex-shrink: 0; width: 15px; height: 15px;
    color: #1a3b5c; margin-top: 1px;
  }

  .cq-sw__frequency {
    margin-top: 12px; padding-top: 12px;
    border-top: 1px solid #F3F4F6;
  }
  .cq-sw__frequency label {
    font-family: 'DM Sans', sans-serif; font-size: 12px;
    color: #6B7280; display: block; margin-bottom: 4px;
  }
  .cq-sw__frequency select {
    font-family: 'DM Sans', sans-serif; font-size: 13px;
    padding: 8px 12px; border: 1px solid #D1D5DB; border-radius: 6px;
    background: #fff; color: #1a1a1a; width: 100%; max-width: 220px;
    height: 36px; cursor: pointer;
  }

  .cq-sw__note {
    font-family: 'DM Sans', sans-serif; font-size: 12px;
    color: #6B7280; margin-top: 8px; font-style: italic;
  }

  @media (max-width: 480px) {
    .cq-sw__tab { font-size: 12px; padding: 10px 12px; gap: 6px; }
    .cq-sw__price { font-size: 20px; }
    .cq-sw__benefits { grid-template-columns: 1fr; }
  }
</style>

<div class="cq-sw" data-selling-plan-id="{{ cq_sp_id }}">
  <div class="cq-sw__tabs-scroll">
    <div class="cq-sw__tabs is-sub-active" role="radiogroup" aria-label="Purchase options">
      <button type="button" class="cq-sw__tab is-active" data-plan="subscribe" role="radio" aria-checked="true">
        <span class="cq-sw__tab-badge">{{ cq_sw_save_pct }} {{ cq_pct }}%</span>
        <span class="cq-sw__tab-radio"><span class="cq-sw__tab-radio-dot"></span></span>
        {{ cq_sw_subscribe_save }}
      </button>
      <button type="button" class="cq-sw__tab" data-plan="onetime" role="radio" aria-checked="false">
        <span class="cq-sw__tab-radio"><span class="cq-sw__tab-radio-dot"></span></span>
        {{ cq_sw_one_time }}
      </button>
    </div>
  </div>

  <div class="cq-sw__detail is-sub-active">
    <div class="cq-sw__panel is-visible" data-panel="subscribe">
      <div class="cq-sw__pricing">
        <span class="cq-sw__price">{{ cq_sub | money }}<span class="cq-sw__price-period"> {{ cq_sw_per_month }}</span></span>
        <span class="cq-sw__compare">{{ cq_ot | money }}</span>
      </div>
      <p class="cq-sw__perday">{{ cq_perday | money }} {{ cq_sw_per_day }}</p>
      <ul class="cq-sw__benefits">
        <li class="cq-sw__benefit">{{ cq_icon_truck }}{{ cq_sw_benefit_shipping }}</li>
        <li class="cq-sw__benefit">{{ cq_icon_refresh }}{{ cq_sw_benefit_skip }}</li>
        <li class="cq-sw__benefit">{{ cq_icon_shield }}{{ cq_sw_benefit_guarantee }}</li>
        <li class="cq-sw__benefit">{{ cq_icon_calendar }}{{ cq_sw_benefit_no_commit }}</li>
      </ul>
      {%- if cq_has_plans and cq_spg.selling_plans.size > 1 -%}
        <div class="cq-sw__frequency">
          <label for="cq-sw-freq">{{ cq_sw_frequency_label }}</label>
          <select id="cq-sw-freq">
            {%- for plan in cq_spg.selling_plans -%}
              <option value="{{ plan.id }}"{% if plan.id == cq_sp.id %} selected{% endif %}>{{ plan.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    <div class="cq-sw__panel" data-panel="onetime">
      <div class="cq-sw__pricing">
        <span class="cq-sw__price">{{ cq_ot | money }}</span>
      </div>
      <ul class="cq-sw__benefits">
        <li class="cq-sw__benefit">{{ cq_icon_truck }}{{ cq_sw_ot_shipping }}</li>
        <li class="cq-sw__benefit">{{ cq_icon_shield }}{{ cq_sw_ot_guarantee }}</li>
      </ul>
      <p class="cq-sw__note">{{ cq_sw_ot_save_note }}</p>
    </div>
  </div>

  <input type="hidden" name="selling_plan" class="cq-sw__sp-input" value="{{ cq_sp_id }}">
</div>

<script>
(function(){
  var w = document.querySelector('.cq-sw');
  if (!w) return;
  var tabs = w.querySelectorAll('.cq-sw__tab');
  var tabsBar = w.querySelector('.cq-sw__tabs');
  var panels = w.querySelectorAll('.cq-sw__panel');
  var detail = w.querySelector('.cq-sw__detail');
  var spInput = w.querySelector('.cq-sw__sp-input');
  var defaultId = w.dataset.sellingPlanId;

  function switchPlan(plan) {
    tabs.forEach(function(t) {
      var active = t.dataset.plan === plan;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    panels.forEach(function(p) {
      p.classList.toggle('is-visible', p.dataset.panel === plan);
    });
    var isSub = plan === 'subscribe';
    detail.classList.toggle('is-sub-active', isSub);
    tabsBar.classList.toggle('is-sub-active', isSub);
    if (isSub) {
      spInput.name = 'selling_plan';
      spInput.value = defaultId;
    } else {
      spInput.name = '';
      spInput.value = '';
    }
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() { switchPlan(tab.dataset.plan); });
  });

  var freq = w.querySelector('#cq-sw-freq');
  if (freq) {
    freq.addEventListener('change', function() {
      defaultId = freq.value;
      spInput.value = freq.value;
    });
  }
})();
</script>
