{%- comment -%}
  CALQIX Subscribe & Save Widget — v4
  Zapply-style single checkbox layout. Rendered directly below the bundle picker
  (outside the product form) so it sits at the top of the buy area.
  Checkbox ON  → JS injects a hidden `selling_plan` input into the product form
                 and dispatches `cqsw:change` so the bundle picker swaps its
                 per-card prices + shows the {pct}% OFF badge.
  Checkbox OFF → one-time purchase; selling_plan input removed, prices restored.
  Reads selling plans from Shopify product.
{%- endcomment -%}

{%- assign cq_v = product.selected_or_first_available_variant -%}
{%- assign cq_ot = cq_v.price -%}
{%- assign cq_has_plans = false -%}
{%- assign cq_sp_id = '' -%}

{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign cq_has_plans = true -%}
  {%- assign cq_spg = product.selling_plan_groups[0] -%}
  {%- assign cq_sp = cq_spg.selling_plans[0] -%}
  {%- assign cq_sp_id = cq_sp.id -%}
  {%- assign cq_adj = cq_sp.price_adjustments[0] -%}

  {%- if cq_adj.value_type == 'percentage' -%}
    {%- assign cq_disc = cq_ot | times: cq_adj.value | divided_by: 100 -%}
    {%- assign cq_sub = cq_ot | minus: cq_disc -%}
    {%- assign cq_pct = cq_adj.value -%}
  {%- elsif cq_adj.value_type == 'fixed_amount' -%}
    {%- assign cq_sub = cq_ot | minus: cq_adj.value -%}
    {%- assign cq_pct = cq_adj.value | times: 100 | divided_by: cq_ot -%}
  {%- else -%}
    {%- assign cq_sub = cq_adj.value -%}
    {%- assign cq_pct = cq_ot | minus: cq_adj.value | times: 100 | divided_by: cq_ot -%}
  {%- endif -%}
{%- else -%}
  {%- assign cq_pct = 20 -%}
  {%- assign cq_disc = cq_ot | times: cq_pct | divided_by: 100 -%}
  {%- assign cq_sub = cq_ot | minus: cq_disc -%}
{%- endif -%}

{%- assign cq_pct_int = cq_pct | round: 0 -%}

{%- assign cq_sw_title = 'calqix_oralbiome.widget.save_with_refills' | t | replace: '{pct}', cq_pct_int -%}
{%- assign cq_sw_hint = 'calqix_oralbiome.widget.refill_hint' | t -%}

<style>
  /* ── NUKE: Hide every possible SEAL Subscriptions element ── */
  [id*="seal"][id*="widget"],
  [id*="seal-sub"], [id*="seal_sub"],
  [id*="sealSub"], [id*="SealSub"],
  [class*="seal-sub"], [class*="seal_sub"],
  [class*="sealSub"], [class*="SealSub"],
  [class*="seal-subscription"], [class*="seal_subscription"],
  [data-seal-subscription], [data-seal-widget], [data-seal],
  .seal-product-form-widget, .sealsubscriptions, .seal-sub-widget,
  .sls-widget, .sls-widget-container, #sls-widget,
  [id*="sls-widget"], [class*="sls-widget"],
  [id*="sls_widget"], [class*="sls_widget"] {
    display: none !important;
    height: 0 !important;
    overflow: hidden !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    position: absolute !important;
    width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* ── Widget container ── */
  .cqsw {
    margin: 0 0 16px;
    font-family: 'DM Sans', sans-serif;
    --cqsw-navy: #1A3B5C;
    --cqsw-navy-deep: #0F2233;
    --cqsw-gold: #C9A84C;
    --cqsw-gold-light: rgba(201, 168, 76, 0.10);
    --cqsw-gold-softer: rgba(201, 168, 76, 0.05);
    --cqsw-border: #E5E7EB;
    --cqsw-muted: #6B7280;
    --cqsw-text: #1A1A1A;
    --cqsw-bg: #FFFFFF;
    --cqsw-radius: 12px;
  }

  /* ── Checkbox row ── */
  .cqsw__row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 2px solid var(--cqsw-border);
    border-radius: var(--cqsw-radius);
    background: var(--cqsw-bg);
    cursor: pointer;
    transition: border-color .25s ease, background-color .25s ease, box-shadow .25s ease;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .cqsw__row:hover {
    border-color: #D1D5DB;
  }
  .cqsw__row.is-active {
    border-color: var(--cqsw-gold);
    background: linear-gradient(180deg, var(--cqsw-gold-softer) 0%, #fff 100%);
    box-shadow: 0 0 0 1px var(--cqsw-gold), 0 4px 14px rgba(201, 168, 76, 0.12);
  }

  /* Native checkbox hidden, visual box styled */
  .cqsw__input {
    position: absolute;
    opacity: 0;
    width: 1px; height: 1px;
    pointer-events: none;
  }
  .cqsw__box {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border: 2px solid #CBD5E1;
    border-radius: 6px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .2s ease, background-color .2s ease;
    margin-top: 1px;
  }
  .cqsw__row.is-active .cqsw__box {
    border-color: var(--cqsw-gold);
    background: var(--cqsw-gold);
  }
  .cqsw__check {
    width: 14px;
    height: 14px;
    color: #fff;
    opacity: 0;
    transform: scale(.5);
    transition: opacity .2s ease, transform .25s cubic-bezier(.4,0,.2,1);
  }
  .cqsw__row.is-active .cqsw__check {
    opacity: 1;
    transform: scale(1);
  }
  .cqsw__input:focus-visible + .cqsw__box {
    box-shadow: 0 0 0 3px rgba(201,168,76,0.28);
  }

  /* Text stack */
  .cqsw__body { flex: 1; min-width: 0; }
  .cqsw__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--cqsw-navy);
    line-height: 1.3;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cqsw__hint {
    font-size: 12.5px;
    color: var(--cqsw-muted);
    margin-top: 3px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .cqsw__hint::before {
    content: "✓";
    color: var(--cqsw-gold);
    font-weight: 700;
  }

  @media (max-width: 480px) {
    .cqsw__row { padding: 12px 14px; gap: 10px; }
    .cqsw__title { font-size: 13px; }
    .cqsw__hint { font-size: 12px; }
    .cqsw__box { width: 20px; height: 20px; }
  }
</style>

<div class="cqsw"
     data-selling-plan-id="{{ cq_sp_id }}"
     data-price-onetime="{{ cq_ot | money }}"
     data-price-subscribe="{{ cq_sub | money }}"
     data-price-onetime-raw="{{ cq_ot }}"
     data-price-subscribe-raw="{{ cq_sub }}"
     data-discount-pct="{{ cq_pct_int }}">
  <label class="cqsw__row" data-plan="onetime">
    <input type="checkbox" class="cqsw__input" aria-label="{{ cq_sw_title | escape }}">
    <span class="cqsw__box" aria-hidden="true">
      <svg class="cqsw__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </span>
    <div class="cqsw__body">
      <div class="cqsw__title">{{ cq_sw_title }}</div>
      <div class="cqsw__hint">{{ cq_sw_hint }}</div>
    </div>
  </label>

</div>

<script>
(function(){
  var w = document.querySelector('.cqsw');
  if (!w) return;
  var row = w.querySelector('.cqsw__row');
  var cb = w.querySelector('.cqsw__input');
  var planId = w.dataset.sellingPlanId;
  var discountPct = w.dataset.discountPct;

  function getProductForm() {
    return document.querySelector('product-form form[action*="/cart/add"]')
        || document.querySelector('form[action*="/cart/add"]');
  }

  function injectSellingPlan(subscribe) {
    var form = getProductForm();
    if (!form) return;
    var existing = form.querySelector('input[name="selling_plan"][data-cqsw="1"]');
    if (subscribe && planId) {
      if (!existing) {
        existing = document.createElement('input');
        existing.type = 'hidden';
        existing.name = 'selling_plan';
        existing.setAttribute('data-cqsw', '1');
        form.appendChild(existing);
      }
      existing.value = planId;
    } else if (existing) {
      existing.parentNode.removeChild(existing);
    }
  }

  function applyState(subscribe) {
    row.classList.toggle('is-active', subscribe);
    row.setAttribute('data-plan', subscribe ? 'subscribe' : 'onetime');
    injectSellingPlan(subscribe);
    // Notify bundle picker + any other listeners.
    try {
      document.dispatchEvent(new CustomEvent('cqsw:change', {
        detail: { subscribe: subscribe, planId: planId, pct: discountPct }
      }));
    } catch (e) {}
  }

  cb.addEventListener('change', function() {
    applyState(cb.checked);
  });

  applyState(false);

  /* ── Aggressively hide leftover SEAL widgets ── */
  function nukeSeal() {
    var sealSelectors = [
      '[id*="seal"][id*="widget"]', '[id*="seal-sub"]', '[id*="seal_sub"]',
      '[id*="sealSub"]', '[id*="SealSub"]',
      '[class*="seal-sub"]', '[class*="seal_sub"]',
      '[class*="sealSub"]', '[class*="SealSub"]',
      '[class*="seal-subscription"]', '[class*="seal_subscription"]',
      '[data-seal-subscription]', '[data-seal-widget]', '[data-seal]',
      '.sls-widget', '.sls-widget-container', '#sls-widget',
      '[id*="sls-widget"]', '[class*="sls-widget"]',
      '[id*="sls_widget"]', '[class*="sls_widget"]'
    ];
    document.querySelectorAll(sealSelectors.join(',')).forEach(function(el) {
      el.remove();
    });
  }
  nukeSeal();
  new MutationObserver(nukeSeal).observe(
    w.closest('form') || document.querySelector('form[action*="/cart/add"]') || document.body,
    { childList: true, subtree: true }
  );
})();
</script>
