{%- comment -%}
  CALQIX Cart · Rebuild Kit promo banner
  ------------------------------------------------------------
  The banner is rendered SERVER-SIDE as hidden and is only
  unhidden by calqix-rebuild-kit-bundle.js when ALL of these
  conditions are true:

    - cart.item_count > 0 (cart not empty)
    - the last cartUpdate was within the last few seconds
      (i.e. just after an add-to-cart event)
    - the customer has not already used the banner in this
      session (sessionStorage flag cq_rk_used)
    - the bundle is NOT already complete
      (combi = has FlowCore handle AND has OralBiome handle)

  The actual 30% discount is applied server-side by a Shopify
  'Buy X Get Y' automatic discount configured in Shopify Admin.

  Merchant settings live in settings_schema under
  "CALQIX · Rebuild Kit Bundle" (cq_rk_* keys).
{%- endcomment -%}

{%- if settings.cq_rk_enable -%}
  {%- liquid
    assign oralbiome_product = settings.cq_rk_oralbiome_product
    assign flavor_collection = settings.cq_rk_flowcore_collection

    assign oralbiome_handle = ''
    if oralbiome_product
      assign oralbiome_handle = oralbiome_product.handle
    else
      assign oralbiome_handle = 'oralbiome-pro-freshmint'
    endif

    assign flavor_collection_handle = ''
    if flavor_collection
      assign flavor_collection_handle = flavor_collection.handle
    else
      assign flavor_collection_handle = 'flowcore'
    endif

    assign pct = settings.cq_rk_discount_pct | default: 30
  -%}

  <aside
    class="cq-rk-banner"
    data-cq-rk-banner
    data-cq-rk-config='{
      "enable": true,
      "pct": {{ pct | json }},
      "oralbiomeHandle": {{ oralbiome_handle | json }},
      "flavorCollection": {{ flavor_collection_handle | json }},
      "requireCartNotEmpty": {{ settings.cq_rk_require_cart_not_empty | json }},
      "requirePostAtc": {{ settings.cq_rk_require_post_atc | json }},
      "oncePerSession": {{ settings.cq_rk_once_per_session | json }},
      "combiLabel": {{ settings.cq_rk_combi_label | default: 'Rebuild Kit bundle · 30% off' | json }}
    }'
    hidden
    aria-hidden="true"
    role="region"
    aria-label="{{ settings.cq_rk_banner_title | default: 'Complete the Rebuild Kit' | escape }}"
  >
    <button
      type="button"
      class="cq-rk-banner__btn"
      data-cq-rk-open
      aria-haspopup="dialog"
      aria-controls="cq-rk-picker"
    >
      <span class="cq-rk-banner__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M12 2.5c-2.6 0-4.7 1.9-4.7 4.2 0 1 .3 1.9.9 2.6-1.7 1.1-3 2.7-3 5 0 3.5 3 5.7 4.7 6.8.5.3 1 .5 1.6.5h1c.6 0 1.1-.2 1.6-.5 1.7-1.1 4.7-3.3 4.7-6.8 0-2.3-1.3-3.9-3-5 .6-.7.9-1.6.9-2.6 0-2.3-2.1-4.2-4.7-4.2z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
            fill="currentColor"
            fill-opacity="0.12"
          />
        </svg>
      </span>

      <span class="cq-rk-banner__body">
        <span class="cq-rk-banner__headline">
          <span class="cq-rk-banner__label">
            {{- settings.cq_rk_banner_label | default: 'SAVE 30%' -}}
          </span>
          <span class="cq-rk-banner__title">
            {{- settings.cq_rk_banner_title | default: 'Complete the Rebuild Kit' -}}
          </span>
        </span>
        <span class="cq-rk-banner__sub">
          {{- settings.cq_rk_banner_sub | default: 'Pair your OralBiome with a FlowCore flavor for 30% off.' -}}
        </span>
      </span>

      <span class="cq-rk-banner__arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <span class="cq-rk-banner__sheen" aria-hidden="true"></span>
    </button>
  </aside>

  {%- comment -%}
    Combi-active badge: shown when both products are in cart.
    Rendered here so it lives inside the drawer and can be targeted
    by JS via [data-cq-rk-combi-badge]. Hidden by default.
  {%- endcomment -%}
  <div class="cq-rk-combi-badge" data-cq-rk-combi-badge hidden aria-live="polite">
    <span class="cq-rk-combi-badge__dot" aria-hidden="true"></span>
    <span class="cq-rk-combi-badge__text">
      {{- settings.cq_rk_combi_label | default: 'Rebuild Kit bundle · 30% off' -}}
    </span>
    <span class="cq-rk-combi-badge__pct">−{{ pct }}%</span>
  </div>
{%- endif -%}
