{%- comment -%}
  CALQIX Meta Pixel Init
  ----------------------
  Bootstraps fbq() with Advanced Matching and fires PageView BEFORE the
  bridge (`assets/calqix-meta-bridge.js`) runs. The bridge then calls
  `fbq('track', 'ViewContent', ..., { eventID })` and AddToCart with
  deterministic event_ids that match server-side CAPI events.

  Why inline in <head> (not async):
    - Guarantees `fbq` is defined before ANY defer-loaded script that uses it.
    - Makes PageView the first Meta-visible event per page load.
    - Advanced Matching passed to fbq('init', ...) raises EMQ significantly
      for logged-in customers (external_id, em, ph, fn, ln, ct, zp, country).

  Anonymous users fall back to `_cq_anon_id` cookie from bridge as external_id,
  giving non-logged-in PageViews a stable identifier for matching.

  The Meta Pixel JS library (fbevents.js) auto-hashes em/ph/fn/ln/ct/st/zp
  on the browser side with SHA-256 before transmission — do NOT pre-hash here.
{%- endcomment -%}

<!-- CALQIX Meta Pixel + Advanced Matching -->
<script>
(function () {
  var CALQIX_PIXEL = '934134615770602';
  var cqCountryCode = {{ localization.country.iso_code | downcase | json }};
  if (cqCountryCode) window.CALQIX_COUNTRY_CODE = cqCountryCode;

  function cqWriteCookie(name, value, days) {
    try {
      if (!name || !value) return;
      var expires = '';
      if (days) {
        var d = new Date();
        d.setTime(d.getTime() + days * 86400000);
        expires = '; expires=' + d.toUTCString();
      }
      var secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/; SameSite=Lax' + secure;
    } catch (e) { /* silent */ }
  }

  function cqWriteStorage(key, value) {
    if (!key || !value) return;
    try { localStorage.setItem(key, value); } catch (e) { /* silent */ }
    try { sessionStorage.setItem(key, value); } catch (e) { /* silent */ }
  }

  function cqPersistMetaClickId() {
    try {
      var params = new URLSearchParams(window.location.search);
      var fbclid = params.get('fbclid');
      if (!fbclid) return;
      cqWriteStorage('_cq_fbclid', fbclid);
      var fbc = 'fb.1.' + Date.now() + '.' + fbclid;
      cqWriteCookie('_fbc', fbc, 90);
      cqWriteStorage('_cq_fbc', fbc);
    } catch (e) { /* silent */ }
  }

  cqPersistMetaClickId();

  function markMetaBeacon(url) {
    try {
      var value = String(url || '');
      if (value.indexOf('facebook.com/tr') === -1) return;
      window.__calqixMetaBrowserBeaconSeen = true;
      window.__calqixMetaBeaconSeenByEventId = window.__calqixMetaBeaconSeenByEventId || {};
      var parsed = new URL(value, window.location.href);
      var eid = parsed.searchParams.get('eid') || parsed.searchParams.get('eventID');
      if (eid) window.__calqixMetaBeaconSeenByEventId[eid] = true;
    } catch (e) { /* silent */ }
  }

  function installMetaBeaconWatch() {
    if (window.__calqixMetaBeaconWatch) return;
    window.__calqixMetaBeaconWatch = true;
    window.__calqixMetaBeaconSeenByEventId = window.__calqixMetaBeaconSeenByEventId || {};

    try {
      var oldBeacon = navigator.sendBeacon;
      if (oldBeacon) {
        navigator.sendBeacon = function (url, data) {
          markMetaBeacon(url);
          return oldBeacon.apply(this, arguments);
        };
      }
    } catch (e) { /* silent */ }

    try {
      var oldFetch = window.fetch;
      if (oldFetch) {
        window.fetch = function (input) {
          markMetaBeacon(input && input.url ? input.url : input);
          return oldFetch.apply(this, arguments);
        };
      }
    } catch (e) { /* silent */ }

    try {
      var oldOpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (method, url) {
        markMetaBeacon(url);
        return oldOpen.apply(this, arguments);
      };
    } catch (e) { /* silent */ }

    try {
      var srcDescriptor = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
      if (srcDescriptor && srcDescriptor.set && srcDescriptor.get) {
        Object.defineProperty(HTMLImageElement.prototype, 'src', {
          configurable: true,
          enumerable: srcDescriptor.enumerable,
          get: function () {
            return srcDescriptor.get.call(this);
          },
          set: function (value) {
            markMetaBeacon(value);
            return srcDescriptor.set.call(this, value);
          }
        });
      }
    } catch (e) { /* silent */ }
  }

  function appendMetaParam(params, key, value) {
    if (value === undefined || value === null || value === '') return;
    if (Array.isArray(value) || (typeof value === 'object' && value !== null)) {
      try { params.append(key, JSON.stringify(value)); } catch (e) { /* silent */ }
      return;
    }
    params.append(key, String(value));
  }

  window.__calqixMetaTrackFallback = function (eventName, eventId, customData, delayMs) {
    if (!eventName || !eventId) return;
    window.__calqixMetaBeaconSeenByEventId = window.__calqixMetaBeaconSeenByEventId || {};
    window.setTimeout(function () {
      if (window.__calqixMetaBeaconSeenByEventId[eventId]) return;
      try {
        var params = new URLSearchParams();
        params.set('id', CALQIX_PIXEL);
        params.set('ev', eventName);
        params.set('dl', window.location.href);
        params.set('rl', document.referrer || '');
        params.set('if', 'false');
        params.set('ts', String(Date.now()));
        params.set('eid', eventId);
        var data = customData || {};
        Object.keys(data).forEach(function (key) {
          appendMetaParam(params, 'cd[' + key + ']', data[key]);
        });
        var img = new Image(1, 1);
        img.style.display = 'none';
        img.alt = '';
        img.src = 'https://www.facebook.com/tr?' + params.toString();
        window.__calqixMetaBeaconSeenByEventId[eventId] = true;
      } catch (e) { /* silent */ }
    }, delayMs || 3000);
  };

  installMetaBeaconWatch();

  /* Meta Pixel base loader (official snippet) */
  !function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
    if (!f._fbq) f._fbq = n;
    n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
    t = b.createElement(e); t.async = !0; t.src = v;
    s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
  }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

  var am = {};

  {%- if customer -%}
    {%- comment -%} Server-rendered logged-in customer Advanced Matching. {%- endcomment -%}
    am.external_id = {{ customer.id | json }};
    {%- if customer.email -%}      am.em = {{ customer.email | downcase | json }};{%- endif -%}
    {%- if customer.phone -%}      am.ph = {{ customer.phone | replace: '+', '' | replace: ' ', '' | replace: '-', '' | json }};{%- endif -%}
    {%- if customer.first_name -%} am.fn = {{ customer.first_name | downcase | json }};{%- endif -%}
    {%- if customer.last_name -%}  am.ln = {{ customer.last_name | downcase | json }};{%- endif -%}
    {%- if customer.default_address -%}
      {%- if customer.default_address.city -%}           am.ct = {{ customer.default_address.city | downcase | remove: ' ' | json }};{%- endif -%}
      {%- if customer.default_address.province_code -%}  am.st = {{ customer.default_address.province_code | downcase | json }};{%- endif -%}
      {%- if customer.default_address.zip -%}            am.zp = {{ customer.default_address.zip | downcase | remove: ' ' | json }};{%- endif -%}
      {%- if customer.default_address.country_code -%}   am.country = {{ customer.default_address.country_code | downcase | json }};{%- endif -%}
    {%- endif -%}
    {%- assign cq_birthday = customer.metafields.calqix.birthday -%}
    {%- assign cq_gender = customer.metafields.calqix.gender -%}
    {%- if cq_birthday -%}  am.db = {{ cq_birthday | date: '%Y%m%d' | json }};{%- endif -%}
    {%- if cq_gender -%}    am.ge = {{ cq_gender | downcase | slice: 0 | json }};{%- endif -%}
  {%- endif -%}

  if (cqCountryCode && !am.country) {
    am.country = cqCountryCode;
  }

  function readFirstPartyCookie(name) {
    try {
      var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : null;
    } catch (e) {
      return null;
    }
  }

  function writeFirstPartyCookie(name, value, days) {
    try {
      var expires = '';
      if (days) {
        var d = new Date();
        d.setTime(d.getTime() + days * 86400000);
        expires = '; expires=' + d.toUTCString();
      }
      document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/; SameSite=Lax';
    } catch (e) { /* silent */ }
  }

  function getOrCreateAnonId() {
    var key = '_cq_anon_id';
    var existing = null;
    try { existing = localStorage.getItem(key); } catch (e) { /* silent */ }
    if (!existing) existing = readFirstPartyCookie(key);
    if (existing) return existing;

    var id = 'cq_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);
    try { localStorage.setItem(key, id); } catch (e) { /* silent */ }
    writeFirstPartyCookie(key, id, 365);
    return id;
  }

  /* Anonymous fallback: create the bridge-compatible id before fbq('init'). */
  if (!am.external_id) {
    am.external_id = getOrCreateAnonId();
  }

  if (am.external_id) {
    fbq('init', CALQIX_PIXEL, am);
  } else {
    fbq('init', CALQIX_PIXEL);
  }

  /* PageView — browser-only event. Includes eventID so a future server-side
     PageView CAPI endpoint (if added) can dedupe on the same ID. */
  var pvEventId = 'pv_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);
  fbq('track', 'PageView', {}, { eventID: pvEventId });
  window.__calqixPvEventId = pvEventId;
})();
</script>
<noscript>
  <img height="1" width="1" style="display:none" alt=""
       src="https://www.facebook.com/tr?id=934134615770602&ev=PageView&noscript=1" />
</noscript>
<!-- End CALQIX Meta Pixel -->
