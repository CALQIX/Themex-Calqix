<style>
  .product-review-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 16px;
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
    border-bottom: 1px solid #E5E7EB;
    cursor: pointer;
    min-height: 48px;
  }
  .product-review-badge__stars { display: flex; gap: 2px; }
  .product-review-badge__stars svg { width: 14px; height: 14px; fill: #C9A84C; }
  .product-review-badge__rating { font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 700; color: #1A3B5C; }
  .product-review-badge__separator { color: #D1D5DB; font-size: 12px; }
  .product-review-badge__count { font-family: 'DM Sans', sans-serif; font-size: 13px; color: #6B7280; text-decoration: underline; }
  @media (min-width: 768px) {
    .product-review-badge {
      justify-content: flex-start;
      padding: 0 0 12px 0;
      background: transparent;
      border: none;
    }
  }
</style>

{%- assign badge_rating = product.metafields.reviews.rating.value | default: '4.8' -%}
{%- assign badge_count = product.metafields.reviews.rating_count | default: '127' -%}
{%- assign badge_label = badge_reviews_label | default: 'reviews' -%}
{%- assign badge_scroll_target = badge_scroll_to | default: 'reviews' -%}

<div class="product-review-badge" data-scroll-to="{{ badge_scroll_target }}">
  <div class="product-review-badge__stars">
    {%- for i in (1..5) -%}
      <svg viewBox="0 0 24 24" fill="#C9A84C" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    {%- endfor -%}
  </div>
  <span class="product-review-badge__rating">{{ badge_rating }}</span>
  <span class="product-review-badge__separator">&bull;</span>
  <span class="product-review-badge__count">{{ badge_count }} {{ badge_label }}</span>
</div>

<script>
  (function() {
    var badges = document.querySelectorAll('.product-review-badge[data-scroll-to]');
    badges.forEach(function(badge) {
      badge.addEventListener('click', function() {
        var targetId = badge.dataset.scrollTo;
        var el = document.getElementById(targetId) || document.querySelector('[id*="' + targetId + '"]');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>
