{%- comment -%}
  Product Review Badge — compact bar below product gallery (mobile-only by default).
  Renders: ★★★★★  4.8  ·  Based on 127 reviews
  On click → smooth scroll to reviews section with clinical highlight.

  Usage:
    {% render 'product-review-badge', badge_rating: '4.8', badge_count: '127', badge_label: 'reviews' %}
  Or auto-detect from product metafields if no args passed.
{%- endcomment -%}

{%- comment -%}
  Initial server-side count = inline pool baseline (120 reviews in the
  OralBiome reviews section) + the cron-populated metafield array size.
  Once the page is hydrated, the reviews section JS syncs real numbers to
  any `.prb__count` / `.prb__rating` elements on the page — so whatever we
  render here is only visible for the first few ms before JS runs.
{%- endcomment -%}
{%- assign _rb_base_count = 120 -%}
{%- assign _rb_extra_count = 0 -%}
{%- assign _rb_extra_raw = product.metafields.calqix.ob_extra_reviews -%}
{%- if _rb_extra_raw -%}
  {%- comment -%} json_string metafield: .value is the raw string {%- endcomment -%}
  {%- assign _rb_extra_str = _rb_extra_raw | default: '' -%}
  {%- if _rb_extra_str.size > 2 -%}
    {%- comment -%} Rough count: each entry contains exactly one `"cc":` key.
        Far cheaper + more robust than parse_json on huge arrays. {%- endcomment -%}
    {%- assign _rb_extra_count = _rb_extra_str | split: '"cc":' | size | minus: 1 -%}
    {%- if _rb_extra_count < 0 -%}{%- assign _rb_extra_count = 0 -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- assign _rb_derived_count = _rb_base_count | plus: _rb_extra_count -%}

{%- assign _rb_rating = badge_rating | default: product.metafields.reviews.rating.value | default: '4.7' -%}
{%- assign _rb_count  = badge_count  | default: product.metafields.reviews.rating_count | default: _rb_derived_count -%}
{%- assign _rb_label  = badge_label  | default: 'calqix_oralbiome.hero.rating_text' | t -%}

<style>
  .prb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 16px;
    margin: 5px 0 10px;
    background: #1A3B5C;
    border-radius: 5px;
    cursor: pointer;
    min-height: 40px;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .prb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(201,168,76,0.08) 50%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .prb:active::after { opacity: 1; }
  .prb__stars { display: flex; gap: 2px; flex-shrink: 0; }
  .prb__stars svg { width: 12px; height: 12px; }
  .prb__rating {
    font-family: 'DM Serif Display', serif;
    font-size: 13px;
    font-weight: 400;
    color: #FFFFFF;
    line-height: 1;
  }
  .prb__sep {
    color: rgba(255,255,255,0.3);
    font-size: 10px;
    line-height: 1;
  }
  .prb__count {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.02em;
  }
  /* ── Desktop / wider screens ───────────────────────────────
     Subtle inline bar: no dark background, small readable text,
     gold stars, same click behaviour as mobile. */
  @media (min-width: 768px) {
    .prb {
      justify-content: flex-start;
      gap: 8px;
      padding: 6px 0;
      margin: 4px 0 12px;
      background: transparent;
      border-radius: 0;
      min-height: 0;
    }
    .prb::after { display: none; }
    .prb:hover .prb__count { color: #1A3B5C; }
    .prb__stars svg { width: 11px; height: 11px; }
    .prb__rating {
      font-size: 12.5px;
      color: #1A3B5C;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      letter-spacing: 0.01em;
    }
    .prb__sep {
      color: rgba(26, 59, 92, 0.35);
      font-size: 10px;
    }
    .prb__count {
      font-size: 11px;
      color: rgba(26, 59, 92, 0.6);
      font-weight: 400;
      letter-spacing: 0.01em;
      transition: color 0.18s ease;
    }
  }

  @keyframes prb-highlight {
    0%   { box-shadow: 0 0 0 0 rgba(201,168,76,0.4); }
    40%  { box-shadow: 0 0 0 6px rgba(201,168,76,0.15); }
    100% { box-shadow: 0 0 0 0 rgba(201,168,76,0); }
  }
  .prb-target-highlight {
    animation: prb-highlight 0.8s ease-out;
  }
</style>

<div class="prb" role="button" tabindex="0" aria-label="{{ _rb_rating }} out of 5 — {{ _rb_count }} {{ _rb_label }}">
  <span class="prb__stars">
    {%- for i in (1..5) -%}
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#C9A84C"/></svg>
    {%- endfor -%}
  </span>
  <span class="prb__rating">{{ _rb_rating }}</span>
  <span class="prb__sep">&bull;</span>
  <span class="prb__count">{{ 'blogs.article.based_on' | t | default: 'Gebaseerd op' }} {{ _rb_count }} {{ _rb_label }}</span>
</div>

<script>
  (function(){
    var badges = document.querySelectorAll('.prb');
    if (!badges.length) return;

    function findReviewSection() {
      var selectors = [
        '#oralbiome-reviews',
        '[id^="cq-reviews-"]',
        '#judgeme_product_reviews',
        '.lumicore-testimonials-grid',
        '.calqix-reviews',
        '.ob-reviews',
        '[data-reviews-section]'
      ];
      for (var i = 0; i < selectors.length; i++) {
        var el = document.querySelector(selectors[i]);
        if (el) return el;
      }
      return null;
    }

    function scrollToReviews() {
      var target = findReviewSection();
      if (!target) return;
      var headerH = document.querySelector('.page-header')
        ? document.querySelector('.page-header').offsetHeight
        : 0;
      var y = target.getBoundingClientRect().top + window.pageYOffset - headerH - 16;

      window.scrollTo({ top: y, behavior: 'smooth' });

      setTimeout(function() {
        target.classList.add('prb-target-highlight');
        target.addEventListener('animationend', function handler() {
          target.classList.remove('prb-target-highlight');
          target.removeEventListener('animationend', handler);
        });
      }, 600);
    }

    badges.forEach(function(badge) {
      badge.addEventListener('click', scrollToReviews);
      badge.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); scrollToReviews(); }
      });
    });
  })();
</script>
