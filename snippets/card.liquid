{%- liquid
  if lazy_load
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif

  if media_aspect_ratio
    if media_aspect_ratio == 'portrait'
      assign aspect_ratio = 'var(--aspect-ratio-portait)'
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign aspect_ratio = card_product.featured_media.aspect_ratio
    elsif media_aspect_ratio == 'square'
      assign aspect_ratio = 1
    else
      assign aspect_ratio = 'auto'
    endif
  endif

  if settings.enable_product_variations
    assign product_variations_metafield = settings.product_varations_metafield | split: '.' 
    assign product_variations_namespace = product_variations_metafield[0] 
    assign product_variations_key = product_variations_metafield[1] 
    assign product_variations_color_metafield = settings.product_varations_color_metafield | split: '.' 
    assign product_variations_color_namespace = product_variations_color_metafield[0] 
    assign product_variations_color_key = product_variations_color_metafield[1] 
    assign product_variations = product.metafields[product_variations_namespace][product_variations_key].value 
  endif

  if img.alt != blank
    assign card_alt = img.alt | escape
  else
    assign card_alt = title | escape
  endif

  assign product_card_brand_font = 'var(--font-base)'
  if settings.product_card_brand_font == 'heading'
    assign product_card_brand_font = 'var(--font-headings)'
  elsif settings.product_card_brand_font == 'price'
    assign product_card_brand_font = 'var(--font-price)'
  elsif settings.product_card_brand_font == 'dm_serif'
    assign product_card_brand_font = '"DM Serif Display", Georgia, serif'
  elsif settings.product_card_brand_font == 'dm_sans'
    assign product_card_brand_font = '"DM Sans", sans-serif'
  endif

  assign product_card_title_font = 'var(--font-base)'
  if settings.product_card_title_font == 'heading'
    assign product_card_title_font = 'var(--font-headings)'
  elsif settings.product_card_title_font == 'price'
    assign product_card_title_font = 'var(--font-price)'
  elsif settings.product_card_title_font == 'dm_serif'
    assign product_card_title_font = '"DM Serif Display", Georgia, serif'
  elsif settings.product_card_title_font == 'dm_sans'
    assign product_card_title_font = '"DM Sans", sans-serif'
  endif

  assign product_card_reviews_font = 'var(--font-base)'
  if settings.product_card_reviews_font == 'heading'
    assign product_card_reviews_font = 'var(--font-headings)'
  elsif settings.product_card_reviews_font == 'price'
    assign product_card_reviews_font = 'var(--font-price)'
  elsif settings.product_card_reviews_font == 'dm_serif'
    assign product_card_reviews_font = '"DM Serif Display", Georgia, serif'
  elsif settings.product_card_reviews_font == 'dm_sans'
    assign product_card_reviews_font = '"DM Sans", sans-serif'
  endif

  assign product_card_price_font = 'var(--font-price)'
  if settings.product_card_price_font == 'heading'
    assign product_card_price_font = 'var(--font-headings)'
  elsif settings.product_card_price_font == 'base'
    assign product_card_price_font = 'var(--font-base)'
  elsif settings.product_card_price_font == 'dm_serif'
    assign product_card_price_font = '"DM Serif Display", Georgia, serif'
  elsif settings.product_card_price_font == 'dm_sans'
    assign product_card_price_font = '"DM Sans", sans-serif'
  endif

  assign show_brand_row = false
  if settings.product_card_show_brand and subtitle != blank
    assign show_brand_row = true
  endif

  assign show_reviews_row = false
  if settings.product_card_show_reviews and rating and reviews and collection_list != true
    assign show_reviews_row = true
  endif

  assign product_card_brand_alignment = settings.product_card_brand_alignment | default: 'center'
  assign product_card_brand_justify = 'center'
  if product_card_brand_alignment == 'left'
    assign product_card_brand_justify = 'flex-start'
  elsif product_card_brand_alignment == 'right'
    assign product_card_brand_justify = 'flex-end'
  endif

  assign product_card_title_alignment = settings.product_card_title_alignment | default: 'center'
  assign product_card_title_justify = 'center'
  if product_card_title_alignment == 'left'
    assign product_card_title_justify = 'flex-start'
  elsif product_card_title_alignment == 'right'
    assign product_card_title_justify = 'flex-end'
  endif

  assign product_card_reviews_alignment = settings.product_card_reviews_alignment | default: 'center'
  assign product_card_reviews_justify = 'center'
  if product_card_reviews_alignment == 'left'
    assign product_card_reviews_justify = 'flex-start'
  elsif product_card_reviews_alignment == 'right'
    assign product_card_reviews_justify = 'flex-end'
  endif

  assign product_card_price_alignment = settings.product_card_price_alignment | default: 'center'
  assign product_card_price_justify = 'center'
  if product_card_price_alignment == 'left'
    assign product_card_price_justify = 'flex-start'
  elsif product_card_price_alignment == 'right'
    assign product_card_price_justify = 'flex-end'
  endif

  assign product_card_brand_icon_render_size = settings.product_card_brand_icon_size | times: 2
  assign product_card_show_discount_percentage = settings.product_card_show_discount_percentage
  assign product_card_sale_price_layout = settings.product_card_sale_price_layout | default: 'compare_first'
-%}

{%- assign title_tag = title_tag | default: 'h3' -%}
{% assign placeholder_title = 'sections.card.placeholder_title' | t %}
<color-swatch
  {% if settings.enable_product_variations %}
    data-product-variations
    data-current-variant-handle="{{ card_product.handle }}"
  {% endif %}
  {% if are_filters_active %}
    data-active-filters
  {% endif %}
>
  <div
    class="card__container"
    data-card-hover="{{ settings.product_card_hover_animation }}"
    data-card-copy-animation="{{ settings.product_card_content_animation }}"
    style="
      --aspect-ratio: {{ aspect_ratio }};
      --product-card-gap: {{ settings.product_card_vertical_gap }}px;
      --product-card-animation-duration: {{ settings.product_card_animation_duration }}ms;
      --product-card-brand-font: {{ product_card_brand_font }};
      --product-card-brand-size: {{ settings.product_card_brand_size }}px;
      --product-card-brand-weight: {{ settings.product_card_brand_weight }};
      --product-card-brand-style: {{ settings.product_card_brand_style }};
      --product-card-brand-transform: {{ settings.product_card_brand_transform }};
      --product-card-brand-letter-spacing: {{ settings.product_card_brand_letter_spacing }}px;
      --product-card-brand-color: {{ settings.product_card_brand_color }};
      --product-card-brand-icon-size: {{ settings.product_card_brand_icon_size }}px;
      --product-card-brand-align: {{ product_card_brand_alignment }};
      --product-card-brand-justify: {{ product_card_brand_justify }};
      --product-card-title-font: {{ product_card_title_font }};
      --product-card-title-size: {{ settings.product_card_title_size }}px;
      --product-card-title-weight: {{ settings.product_card_title_weight }};
      --product-card-title-style: {{ settings.product_card_title_style }};
      --product-card-title-color: {{ settings.product_card_title_color }};
      --product-card-title-hover-color: {{ settings.product_card_title_hover_color }};
      --product-card-title-align: {{ product_card_title_alignment }};
      --product-card-title-justify: {{ product_card_title_justify }};
      --product-card-reviews-font: {{ product_card_reviews_font }};
      --product-card-reviews-size: {{ settings.product_card_reviews_size }}px;
      --product-card-reviews-weight: {{ settings.product_card_reviews_weight }};
      --product-card-reviews-style: {{ settings.product_card_reviews_style }};
      --product-card-reviews-color: {{ settings.product_card_reviews_color }};
      --product-card-star-size: {{ settings.product_card_review_star_size }}px;
      --product-card-star-color: {{ settings.product_card_review_star_color }};
      --product-card-star-empty-color: {{ settings.product_card_review_star_empty_color }};
      --product-card-reviews-align: {{ product_card_reviews_alignment }};
      --product-card-reviews-justify: {{ product_card_reviews_justify }};
      --product-card-price-font: {{ product_card_price_font }};
      --product-card-price-size: {{ settings.product_card_price_size }}px;
      --product-card-price-weight: {{ settings.product_card_price_weight }};
      --product-card-price-style: {{ settings.product_card_price_style }};
      --product-card-price-color: {{ settings.product_card_price_color }};
      --product-card-price-sale-color: {{ settings.product_card_price_sale_color }};
      --product-card-price-compare-color: {{ settings.product_card_price_compare_color }};
      --product-card-price-gap: {{ settings.product_card_price_gap }}px;
      --product-card-price-compare-size: {{ settings.product_card_price_compare_size }}px;
      --product-card-price-compare-weight: {{ settings.product_card_price_compare_weight }};
      --product-card-price-compare-style: {{ settings.product_card_price_compare_style }};
      --product-card-price-compare-opacity: {{ settings.product_card_price_compare_opacity }};
      --product-card-price-compare-line-color: {{ settings.product_card_price_compare_line_color }};
      --product-card-price-compare-line-thickness: {{ settings.product_card_price_compare_line_thickness }}px;
      --product-card-price-discount-color: {{ settings.product_card_price_discount_color }};
      --product-card-price-discount-size: {{ settings.product_card_price_discount_size }}px;
      --product-card-price-discount-weight: {{ settings.product_card_price_discount_weight }};
      --product-card-price-align: {{ product_card_price_alignment }};
      --product-card-price-justify: {{ product_card_price_justify }};
      --product-card-image-radius: {{ settings.product_card_image_radius }}px;
    "
  >
    <div class="card__picture-container">
      <a
        href="{{ url | default: '#' }}"
        class="card{% if text_alignment %} card--{{ text_alignment }}{% endif %}"
        tabindex="0"
        aria-label="{{ 'aria-label.card-url' | t }}"
      >
        <picture class="card__picture" data-uri="{{uri}}">
          <div class="card__loader hidden"></div>
          {% if img == 'hide' %}
          {% elsif img and focal %}
            {% assign card_classes = 'card__img' %}
            {% assign card_alt = img.alt | escape %}

            {{
              img
              | image_url: width: 1000
              | image_tag:
                loading: loading,
                sizes: '(min-width: 1000px) 620px, 100vw',
                width: null,
                widths: '375, 750, 1000, 1440',
                alt: card_alt,
                class: card_classes
            }}
          {% elsif img %}
            {% assign is_video_exist = false %}

            {% if show_video %}
              {% for media in product.media %}
                {% if media.media_type == 'video' %}
                  {{ media | video_tag: image_size: '400x', autoplay: true, loop: true, class: 'card__video' }}
                  {% assign is_video_exist = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}

            {% if is_video_exist == false %}
              <img
                class="card__img"
                srcset="
                  {% if img.width >= 375 %}{{ img | image_url: width: 375 }} 375w, {% endif %}
                  {% if img.width >= 750 %}{{ img | image_url: width: 750 }} 750w, {% endif %}
                  {% if img.width >= 1000 %}{{ img | image_url: width: 1000 }} 1000w, {% endif %}
                  {% if img.width >= 1440 %}{{ img | image_url: width: 1440 }} 1440w, {% endif %}
                  {{ img | image_url: width: 1000 }} 1000w
                "
                sizes="(min-width: 1000px) 620px, 100vw"
                src="{{ img | image_url: width: 1000 }}"
                alt="{{ card_alt }}"
                loading="{{ loading }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
              >
            {% else %}
              <img
                class="card__img hidden"
                srcset="
                  {% if img.width >= 375 %}{{ img | image_url: width: 375 }} 375w, {% endif %}
                  {% if img.width >= 750 %}{{ img | image_url: width: 750 }} 750w, {% endif %}
                  {% if img.width >= 1000 %}{{ img | image_url: width: 1000 }} 1000w, {% endif %}
                  {% if img.width >= 1440 %}{{ img | image_url: width: 1440 }} 1440w, {% endif %}
                  {{ img | image_url: width: 1000 }} 1000w
                "
                sizes="(min-width: 1000px) 620px, 100vw"
                src="{{ img | image_url: width: 1000 }}"
                alt="{{ card_alt }}"
                loading="{{ loading }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
              >
            {% endif %}

            {% if img_hover %}
              <img
                class="card__img card__img--hover"
                srcset="
                  {% if img_hover.width >= 375 %}{{ img_hover | image_url: width: 375 }} 375w, {% endif %}
                  {% if img_hover.width >= 750 %}{{ img_hover | image_url: width: 750 }} 750w, {% endif %}
                  {% if img_hover.width >= 1000 %}{{ img_hover | image_url: width: 1000 }} 1000w, {% endif %}
                  {% if img_hover.width >= 1440 %}{{ img_hover | image_url: width: 1440 }} 1440w, {% endif %}
                  {{ img_hover | image_url: width: 1000 }} 1000w
                "
                sizes="(min-width: 1000px) 620px, 100vw"
                src="{{ img_hover | image_url: width: 1000 }}"
                alt="{{ card_alt }}"
                loading="{{ loading }}"
                width="{{ img_hover.width }}"
                height="{{ img_hover.height }}"
              >
            {% endif %}
          {% else %}
            {% unless url %}
              {% if placeholder_image_index %}
                {{
                  'product-apparel-'
                  | append: placeholder_image_index
                  | placeholder_svg_tag: 'card__img card__img--placeholder'
                }}
              {% else %}
                {{
                  'collection-apparel-1'
                  | append: placeholder_image_index
                  | placeholder_svg_tag: 'card__img card__img--placeholder'
                }}
              {% endif %}
            {% else %}
              <div class="card__img card__img--empty"></div>
            {% endunless %}
          {% endif %}
          {% if promo %}
            <div class="card__promo">{{ promo }}</div>
          {% endif %}
          {% if save %}
            <a href="#">[]</a>
          {% endif %}
          <div class="card__badges">
            {% assign custom-badge-1-input = settings['custom-badge-1-input'] | downcase %}
            {% assign custom-badge-2-input = settings['custom-badge-2-input'] | downcase %}
            {% assign custom-badge-3-input = settings['custom-badge-3-input'] | downcase %}
            {% assign custom-badge-4-input = settings['custom-badge-4-input'] | downcase %}

            {% if product.available == false %}
              <div class="card__badges--item" data-custom-badge="sold-out">
                {% if settings['badges-uppercase'] == 'uppercase' %}
                  {{ 'products.product.sold_out' | t | upcase }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </div>
            {% endif %}

            {% for tag in product.tags %}
                {% assign downcase_tag = tag | downcase %}
                {% if downcase_tag == custom-badge-1-input %}
                <div class="card__badges--item" data-custom-badge="{{ settings.custom-badge-1-input }}">
                  {% if settings['badges-uppercase'] == 'uppercase' %}
                    {% if settings['custom-badge-1-label'] != blank %}
                      {{ settings['custom-badge-1-label'] | upcase }}
                    {% else %}
                      {{ settings['custom-badge-1-input'] | upcase }}
                    {% endif %}
                  {% else %}
                    {% if settings['custom-badge-1-label'] != blank %}
                      {{ settings['custom-badge-1-label'] }}
                    {% else %}
                      {{ settings['custom-badge-1-input'] }}
                    {% endif %}
                  {% endif %}
                </div>
              {% endif %}
              {% if downcase_tag == custom-badge-2-input %}
                <div class="card__badges--item" data-custom-badge="{{ settings.custom-badge-2-input }}">
                  {% if settings['badges-uppercase'] == 'uppercase' %}
                    {% if settings['custom-badge-2-label'] != blank %}
                      {{ settings['custom-badge-2-label'] | upcase }}
                    {% else %}
                      {{ settings['custom-badge-2-input'] | upcase }}
                    {% endif %}
                  {% else %}
                    {% if settings['custom-badge-2-label'] != blank %}
                      {{ settings['custom-badge-2-label'] }}
                    {% else %}
                      {{ settings['custom-badge-2-input'] }}
                    {% endif %}
                  {% endif %}
                </div>
              {% endif %}
              {% if downcase_tag == custom-badge-3-input %}
                <div class="card__badges--item" data-custom-badge="{{ settings.custom-badge-3-input }}">
                  {% if settings['badges-uppercase'] == 'uppercase' %}
                    {% if settings['custom-badge-3-label'] != blank %}
                      {{ settings['custom-badge-3-label'] | upcase }}
                    {% else %}
                      {{ settings['custom-badge-3-input'] | upcase }}
                    {% endif %}
                  {% else %}
                    {% if settings['custom-badge-3-label'] != blank %}
                      {{ settings['custom-badge-3-label'] }}
                    {% else %}
                      {{ settings['custom-badge-3-input'] }}
                    {% endif %}
                  {% endif %}
                </div>
              {% endif %}
              {% if downcase_tag == custom-badge-4-input %}
                <div class="card__badges--item" data-custom-badge="{{ settings.custom-badge-4-input }}">
                  {% if settings['badges-uppercase'] == 'uppercase' %}
                    {% if settings['custom-badge-4-label'] != blank %}
                      {{ settings['custom-badge-4-label'] | upcase }}
                    {% else %}
                      {{ settings['custom-badge-4-input'] | upcase }}
                    {% endif %}
                  {% else %}
                    {% if settings['custom-badge-4-label'] != blank %}
                      {{ settings['custom-badge-4-label'] }}
                    {% else %}
                      {{ settings['custom-badge-4-input'] }}
                    {% endif %}
                  {% endif %}
                </div>
              {% endif %}
              {% endfor %}
          </div>
        </picture>
      </a>

      {% if enable_quick_add_button %}
        <div class="card__quick-add-container--desktop">
          {% render 'quick-add-button', card_product: product, product: card_product, product_variations: product_variations %}
        </div>
      {% endif %}
    </div>

    <div class="card card--product-meta">
      {% if show_brand_row %}
        <p class="card__subtitle card__subtitle--brand card__meta-row card__meta-row--brand">
          {% if settings.product_card_brand_icon != blank %}
            <span class="card__subtitle-icon" aria-hidden="true">
              {{
                settings.product_card_brand_icon
                | image_url: width: product_card_brand_icon_render_size
                | image_tag: widths: '20, 28, 40, 56, 64', class: 'card__subtitle-icon-image', alt: ''
              }}
            </span>
          {% endif %}
          {% if enable_vendor_link %}
            <a class="vendor-link" href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}">
          {% endif %}

          {{ subtitle }}

          {% if enable_vendor_link %}
            </a>
          {% endif %}
        </p>
      {% endif %}

      <{{ title_tag }} class="card__title card__meta-row card__meta-row--title">
        <a
          href="{{ url }}"
          tabindex="-1"
          data-omit-tabindex
        >
        {% if title %}
          {{ title }}
        {% else %}
          {% if default_title %}{{ default_title }}{% else %}{{ placeholder_title }}{% endif %}
        {% endif %}
      </a>
      </{{ title_tag }}>

      {% if show_reviews_row %}
        <div class="card__reviews card__meta-row card__meta-row--reviews">
          {% render 'calqix-card-rating',
            reviews: reviews,
            text_alignment: settings.product_card_reviews_alignment,
            product: product,
            url: url
          %}
        </div>
      {% endif %}

      {%- liquid
        assign badge_product = card_product | default: product
        assign has_selling_plan = false
        if badge_product.selling_plan_groups and badge_product.selling_plan_groups.size > 0
          assign has_selling_plan = true
        endif
      -%}
      {%- if has_selling_plan -%}
        <span class="subscribe-save-badge card__meta-row card__meta-row--subscribe">
          {{ 'product.subscribe_save_badge' | t }}
        </span>
      {%- endif -%}

      {% if price and collection_list != true %}
        <div class="card__price card__meta-row card__meta-row--price">
          {% if price_old and product_card_sale_price_layout == 'compare_first' %}
            <s class="card__price__compare">{{ price_old }}</s>
          {% endif %}
          {% if settings.currency_code_enabled %}
            <span class="card__price__current">{{ price | money_with_currency }}</span>
          {% else %}
            <span class="card__price__current">{{ price | money }}</span>
          {% endif %}
          {% if price_old and product_card_sale_price_layout == 'current_first' %}
            <s class="card__price__compare">{{ price_old }}</s>
          {% endif %}
        </div>
      {% elsif product and collection_list != true %}
        {%- liquid
          assign card_price_product = product | default: card_product
          assign card_compare_at_price = card_price_product.compare_at_price
          assign card_current_price = card_price_product.price | default: 1999
          assign card_money_price = card_current_price | money
          assign card_money_compare = card_compare_at_price | money
          if settings.currency_code_enabled
            assign card_money_price = card_current_price | money_with_currency
            assign card_money_compare = card_compare_at_price | money_with_currency
          endif
          if card_price_product.price_varies
            assign card_money_price = 'products.product.price.from_price_html' | t: price: card_money_price
          endif
          assign card_product_on_sale = false
          if card_compare_at_price > card_current_price and card_price_product.quantity_price_breaks_configured? != true
            assign card_product_on_sale = true
          endif
          assign show_card_compare_price = card_product_on_sale
          if card_price_product.price_varies == false and card_price_product.compare_at_price_varies
            assign show_card_compare_price = false
          endif
          assign card_discount_percentage = 0
          if show_card_compare_price and card_compare_at_price > 0
            assign card_discount_percentage = card_compare_at_price | minus: card_current_price | times: 100 | divided_by: card_compare_at_price
          endif
        -%}
        <div class="card__price card__meta-row card__meta-row--price{% if card_product_on_sale %} card__price--on-sale{% endif %}">
          {% if show_card_compare_price and product_card_sale_price_layout == 'compare_first' %}
            <s class="card__price__compare">{{ card_money_compare }}</s>
          {% endif %}
          <span class="card__price__current{% if card_product_on_sale %} card__price__current--sale{% endif %}">
            {{ card_money_price }}
          </span>
          {% if show_card_compare_price and product_card_show_discount_percentage %}
            <span class="card__price__discount">-{{ card_discount_percentage }}%</span>
          {% endif %}
          {% if show_card_compare_price and product_card_sale_price_layout == 'current_first' %}
            <s class="card__price__compare">{{ card_money_compare }}</s>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if settings.enable_product_variations %}
      {% render 'card-product-variation-swatches', 
        product: product, text_alignment: text_alignment,
        product_variations: product_variations,
        product_variations_color_namespace: product_variations_color_namespace,
        product_variations_color_key: product_variations_color_key
      %}
    {% elsif settings.enable_color_swatch %}
        {% render 'card-color-swatches', product: product, text_alignment: text_alignment, are_filters_active: are_filters_active %}
    {% endif %}

    {% if enable_quick_add_button %}
      <div class="card__quick-add-container">
        {% render 'quick-add-button', card_product: product, product: card_product, product_variations: product_variations %}
      </div>
    {% endif %}
  </div>
</color-swatch>
