{%- comment -%}
  CALQIX Bundle Picker — v2
  Compact tiered quantity selector with price sync.
  Tier 2 = percentage discount, Tier 3 = buy 2 get 1 free.
{%- endcomment -%}

{%- assign cqbp_v = product.selected_or_first_available_variant -%}
{%- assign cqbp_base = cqbp_v.price -%}
{%- assign cqbp_t2_pct = tier_2_discount | default: 10 -%}
{%- assign cqbp_t3_free = tier_3_free_jar -%}
{%- assign cqbp_pop = popular_tier | default: '3' -%}

{%- comment -%} Tier 2: percentage discount {%- endcomment -%}
{%- assign cqbp_t2_disc_unit = cqbp_base | times: cqbp_t2_pct | divided_by: 100 -%}
{%- assign cqbp_t2_each = cqbp_base | minus: cqbp_t2_disc_unit -%}

{%- comment -%} Tier 3: buy 2 get 1 free OR percentage {%- endcomment -%}
{%- if cqbp_t3_free -%}
  {%- assign cqbp_t3_total = cqbp_base | times: 2 -%}
  {%- assign cqbp_t3_each = cqbp_t3_total | divided_by: 3 -%}
{%- else -%}
  {%- assign cqbp_t3_pct = tier_3_discount | default: 33 -%}
  {%- assign cqbp_t3_disc_unit = cqbp_base | times: cqbp_t3_pct | divided_by: 100 -%}
  {%- assign cqbp_t3_each = cqbp_base | minus: cqbp_t3_disc_unit -%}
{%- endif -%}

{%- comment -%} Subscription per-unit price {%- endcomment -%}
{%- assign cqbp_sub = cqbp_base -%}
{%- assign cqbp_sub_pct = 20 -%}
{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign cqbp_sp = product.selling_plan_groups[0].selling_plans[0] -%}
  {%- assign cqbp_adj = cqbp_sp.price_adjustments[0] -%}
  {%- if cqbp_adj.value_type == 'percentage' -%}
    {%- assign cqbp_sd = cqbp_base | times: cqbp_adj.value | divided_by: 100 -%}
    {%- assign cqbp_sub = cqbp_base | minus: cqbp_sd -%}
    {%- assign cqbp_sub_pct = cqbp_adj.value -%}
  {%- elsif cqbp_adj.value_type == 'fixed_amount' -%}
    {%- assign cqbp_sub = cqbp_base | minus: cqbp_adj.value -%}
    {%- assign cqbp_sub_pct = cqbp_adj.value | times: 100 | divided_by: cqbp_base -%}
  {%- else -%}
    {%- assign cqbp_sub = cqbp_adj.value -%}
    {%- assign cqbp_sub_pct = cqbp_base | minus: cqbp_adj.value | times: 100 | divided_by: cqbp_base -%}
  {%- endif -%}
{%- else -%}
  {%- assign cqbp_sd = cqbp_base | times: cqbp_sub_pct | divided_by: 100 -%}
  {%- assign cqbp_sub = cqbp_base | minus: cqbp_sd -%}
{%- endif -%}
{%- assign cqbp_sub_pct_int = cqbp_sub_pct | round: 0 -%}

{%- comment -%} Per-tier subscription per-each prices (sub pct applied to each-price) {%- endcomment -%}
{%- assign cqbp_t1_sd = cqbp_base | times: cqbp_sub_pct | divided_by: 100 -%}
{%- assign cqbp_t1_sub_each = cqbp_base | minus: cqbp_t1_sd -%}
{%- assign cqbp_t2_sd = cqbp_t2_each | times: cqbp_sub_pct | divided_by: 100 -%}
{%- assign cqbp_t2_sub_each = cqbp_t2_each | minus: cqbp_t2_sd -%}
{%- assign cqbp_t3_sd = cqbp_t3_each | times: cqbp_sub_pct | divided_by: 100 -%}
{%- assign cqbp_t3_sub_each = cqbp_t3_each | minus: cqbp_t3_sd -%}

{%- comment -%} i18n {%- endcomment -%}
{%- assign cqbp_t_heading = 'calqix_oralbiome.bundle.heading' | t -%}
{%- assign cqbp_t_jar = 'calqix_oralbiome.bundle.jar' | t -%}
{%- assign cqbp_t_jars = 'calqix_oralbiome.bundle.jars' | t -%}
{%- assign cqbp_t_supply_30 = 'calqix_oralbiome.bundle.supply_30' | t -%}
{%- assign cqbp_t_supply_60 = 'calqix_oralbiome.bundle.supply_60' | t -%}
{%- assign cqbp_t_supply_90 = 'calqix_oralbiome.bundle.supply_90' | t -%}
{%- assign cqbp_t_each = 'calqix_oralbiome.bundle.each' | t -%}
{%- assign cqbp_t_popular = 'calqix_oralbiome.bundle.most_popular' | t -%}
{%- assign cqbp_t_best_deal = 'calqix_oralbiome.bundle.best_value' | t -%}
{%- assign cqbp_t_discount = 'calqix_oralbiome.bundle.discount_label' | t -%}
{%- assign cqbp_t_free = 'calqix_oralbiome.bundle.third_free' | t -%}
{%- assign cqbp_t_sub_off = 'calqix_oralbiome.bundle.sub_off_badge' | t | replace: '{pct}', cqbp_sub_pct_int -%}

<style>
  .cqbp {
    margin: 0 0 4px;
    font-family: 'DM Sans', sans-serif;
    --cqbp-navy: #1A3B5C;
    --cqbp-gold: #C9A84C;
    --cqbp-green: #2E7D32;
    --cqbp-border: #E5E7EB;
    --cqbp-muted: #6B7280;
  }
  .cqbp__heading {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cqbp-navy);
    margin-bottom: 8px;
  }
  .cqbp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .cqbp__card {
    position: relative;
    border: 2px solid var(--cqbp-border);
    border-radius: 8px;
    padding: 12px 6px 10px;
    text-align: center;
    cursor: pointer;
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    transition: border-color 0.2s, box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .cqbp__card:hover:not(.is-active) { border-color: #D1D5DB; }
  .cqbp__card.is-active {
    border-color: var(--cqbp-navy);
    box-shadow: 0 0 0 1px var(--cqbp-navy);
  }
  .cqbp__card.is-active[data-popular="true"] {
    border-color: var(--cqbp-gold);
    box-shadow: 0 0 0 1px var(--cqbp-gold);
  }
  .cqbp__popular {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--cqbp-gold);
    color: #fff;
    font-size: 7.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 50px;
    white-space: nowrap;
    line-height: 1.3;
  }
  .cqbp__supply {
    font-size: 13px;
    font-weight: 600;
    color: var(--cqbp-navy);
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .cqbp__label {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    color: var(--cqbp-muted);
    line-height: 1.2;
  }
  .cqbp__qty {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: var(--cqbp-muted);
    line-height: 1.2;
  }
  .cqbp__qty-label {
    font-size: 10px;
    font-weight: 400;
    color: var(--cqbp-muted);
  }
  .cqbp__price-row {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 2px;
  }
  .cqbp__price {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 15px;
    color: var(--cqbp-navy);
    line-height: 1.2;
  }
  .cqbp__price--sub { display: none; }
  .cqbp__each {
    font-family: 'DM Sans', sans-serif;
    font-size: 9px;
    color: var(--cqbp-muted);
    font-weight: 400;
    margin-left: 1px;
  }
  .cqbp__pct-badge {
    display: none;
    background: var(--cqbp-gold);
    color: #fff;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 50px;
    white-space: nowrap;
    line-height: 1.3;
  }
  .cqbp[data-subscribe="true"] .cqbp__price--base { display: none; }
  .cqbp[data-subscribe="true"] .cqbp__price--sub { display: inline-flex; }
  .cqbp[data-subscribe="true"] .cqbp__pct-badge { display: inline-flex; }
  .cqbp[data-subscribe="true"] .cqbp__deal { display: none; }
  .cqbp__deal {
    display: inline-flex;
    background: var(--cqbp-green);
    color: #fff;
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
    white-space: nowrap;
  }
  .cqbp__deal--free { background: var(--cqbp-gold); }

  @media (max-width: 480px) {
    .cqbp__grid { gap: 4px; }
    .cqbp__card { padding: 8px 4px 6px; }
    .cqbp__qty { font-size: 18px; }
    .cqbp__price { font-size: 13px; }
    .cqbp__popular { font-size: 7px; padding: 2px 6px; }
    .cqbp__deal { font-size: 7px; padding: 2px 5px; }
  }
</style>

<div class="cqbp"
     data-base="{{ cqbp_base }}"
     data-sub="{{ cqbp_sub }}"
     data-t2-pct="{{ cqbp_t2_pct }}"
     data-t3-free="{{ cqbp_t3_free }}"
     data-currency="{{ cart.currency.iso_code }}">
  <div class="cqbp__heading">{{ cqbp_t_heading }}</div>
  <div class="cqbp__grid">
    <div class="cqbp__card is-active" data-tier="1" data-qty="1" role="radio" aria-checked="true" tabindex="0">
      <span class="cqbp__supply">{{ cqbp_t_supply_30 }}</span>
      <span class="cqbp__label">
        <span class="cqbp__qty">1</span>
        <span class="cqbp__qty-label">{{ cqbp_t_jar }}</span>
      </span>
      <span class="cqbp__price-row">
        <span class="cqbp__price cqbp__price--base">{{ cqbp_base | money | replace: '.', ',' }}</span>
        <span class="cqbp__price cqbp__price--sub">{{ cqbp_t1_sub_each | money | replace: '.', ',' }}</span>
        <span class="cqbp__pct-badge">{{ cqbp_t_sub_off }}</span>
      </span>
    </div>

    <div class="cqbp__card" data-tier="2" data-qty="2" {% if cqbp_pop == '2' %}data-popular="true"{% endif %} role="radio" aria-checked="false" tabindex="0">
      {% if cqbp_pop == '2' %}<span class="cqbp__popular">{{ cqbp_t_popular }}</span>{% endif %}
      <span class="cqbp__supply">{{ cqbp_t_supply_60 }}</span>
      <span class="cqbp__label">
        <span class="cqbp__qty">2</span>
        <span class="cqbp__qty-label">{{ cqbp_t_jars }}</span>
      </span>
      <span class="cqbp__price-row">
        <span class="cqbp__price cqbp__price--base">{{ cqbp_t2_each | money | replace: '.', ',' }}<span class="cqbp__each">{{ cqbp_t_each }}</span></span>
        <span class="cqbp__price cqbp__price--sub">{{ cqbp_t2_sub_each | money | replace: '.', ',' }}<span class="cqbp__each">{{ cqbp_t_each }}</span></span>
        <span class="cqbp__pct-badge">{{ cqbp_t_sub_off }}</span>
      </span>
      <span class="cqbp__deal">{{ cqbp_t_discount }}</span>
    </div>

    <div class="cqbp__card" data-tier="3" data-qty="3" {% if cqbp_pop == '3' %}data-popular="true"{% endif %} role="radio" aria-checked="false" tabindex="0">
      {% if cqbp_pop == '3' %}<span class="cqbp__popular">{{ cqbp_t_best_deal }}</span>{% endif %}
      <span class="cqbp__supply">{{ cqbp_t_supply_90 }}</span>
      <span class="cqbp__label">
        <span class="cqbp__qty">3</span>
        <span class="cqbp__qty-label">{{ cqbp_t_jars }}</span>
      </span>
      <span class="cqbp__price-row">
        <span class="cqbp__price cqbp__price--base">{{ cqbp_t3_each | money | replace: '.', ',' }}<span class="cqbp__each">{{ cqbp_t_each }}</span></span>
        <span class="cqbp__price cqbp__price--sub">{{ cqbp_t3_sub_each | money | replace: '.', ',' }}<span class="cqbp__each">{{ cqbp_t_each }}</span></span>
        <span class="cqbp__pct-badge">{{ cqbp_t_sub_off }}</span>
      </span>
      <span class="cqbp__deal cqbp__deal--free">{{ cqbp_t_free }}</span>
    </div>
  </div>
</div>

<script>
(function() {
  var bp = document.querySelector('.cqbp');
  if (!bp) return;

  var cards = bp.querySelectorAll('.cqbp__card');
  var base = parseInt(bp.dataset.base, 10);
  var sub = parseInt(bp.dataset.sub, 10);
  var t2Pct = parseInt(bp.dataset.t2Pct, 10);
  var t3Free = bp.dataset.t3Free === 'true';
  var tier = 1;

  function fmt(cents) {
    try {
      var s = new Intl.NumberFormat(document.documentElement.lang || 'nl', {
        style: 'currency', currency: bp.dataset.currency || 'EUR'
      }).format(cents / 100);
      return s.replace('.', ',');
    } catch (e) { return '\u20AC' + (cents / 100).toFixed(2).replace('.', ','); }
  }

  function otTotal(t) {
    if (t === 1) return base;
    if (t === 2) return Math.round(base * (100 - t2Pct) / 100) * 2;
    if (t === 3) return t3Free ? base * 2 : Math.round(base * 67 / 100) * 3;
    return base;
  }
  function subTotal(t) {
    if (t === 3 && t3Free) return sub * 2;
    return sub * t;
  }

  function currentSubscribe() {
    return bp.getAttribute('data-subscribe') === 'true';
  }

  function syncMainPrice() {
    // When a tier is changed we also need to refresh the top-of-page price
    // so it stays in sync with the currently selected tier + subscribe state.
    var priceBlock = document.querySelector('.wt-product__info') || document;
    var finals = priceBlock.querySelectorAll('.wt-product__price__final');
    var compares = priceBlock.querySelectorAll('.wt-product__price__compare');
    var subscribe = currentSubscribe();
    if (subscribe) {
      finals.forEach(function(el) { el.textContent = fmt(subTotal(tier)); });
      compares.forEach(function(el) { el.textContent = fmt(otTotal(tier)); el.classList.remove('hidden'); });
    } else {
      finals.forEach(function(el) { el.textContent = fmt(otTotal(tier)); });
      compares.forEach(function(el) { el.classList.add('hidden'); });
    }
  }

  function injectBundleProperty(t) {
    var form = document.querySelector('product-form form') || document.querySelector('form[action*="/cart/add"]');
    if (!form) return;
    var existing = form.querySelector('input[name="properties[_bundle_tier]"]');
    if (t <= 1) {
      if (existing) existing.remove();
      return;
    }
    if (!existing) {
      existing = document.createElement('input');
      existing.type = 'hidden';
      existing.name = 'properties[_bundle_tier]';
      form.appendChild(existing);
    }
    existing.value = t;
  }

  function select(t) {
    tier = t;
    cards.forEach(function(c) {
      var sel = parseInt(c.dataset.tier, 10) === t;
      c.classList.toggle('is-active', sel);
      c.setAttribute('aria-checked', sel ? 'true' : 'false');
    });
    var qi = document.querySelector('product-form .js-counter-quantity')
          || document.querySelector('product-form input[name="quantity"]')
          || document.querySelector('.js-counter-quantity')
          || document.querySelector('input[name="quantity"]');
    if (qi) {
      qi.value = t;
      qi.dispatchEvent(new Event('change', { bubbles: true }));
      qi.dispatchEvent(new Event('input', { bubbles: true }));
    }
    injectBundleProperty(t);
    syncMainPrice();
  }

  cards.forEach(function(c) {
    c.addEventListener('click', function() { select(parseInt(c.dataset.tier, 10)); });
    c.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(parseInt(c.dataset.tier, 10)); }
    });
  });

  // Sync with the v4 subscribe checkbox widget (cqsw).
  // Subscribe widget dispatches `cqsw:change` with detail.subscribe on toggle.
  document.addEventListener('cqsw:change', function(e) {
    var subscribe = !!(e && e.detail && e.detail.subscribe);
    bp.setAttribute('data-subscribe', subscribe ? 'true' : 'false');
    syncMainPrice();
  });
})();
</script>
