{% assign any_addon = false %}
{% assign addon_count = 0 %}
{% for i in (1..2) %}
  {% assign show_key = 'drawer_addon_' | append: i | append: '_show' %}
  {% if settings[show_key] %}
    {% assign any_addon = true %}
    {% assign addon_count = addon_count | plus: 1 %}
  {% endif %}
{% endfor %}

{%- comment -%}
  CALQIX Rebuild Kit bundle card: shown as a dedicated add-on when enabled
  in Theme Editor and the combi (FlowCore + OralBiome Pro) is not yet
  complete in the cart. Clicking ADD opens the flavor picker modal via
  data-cq-rk-open (handled by calqix-rebuild-kit-bundle.js).
{%- endcomment -%}
{%- assign rk_show = false -%}
{%- if settings.cq_rk_enable and cart != empty -%}
  {%- assign rk_has_flowcore = false -%}
  {%- assign rk_has_oralbiome = false -%}
  {%- for line in cart.items -%}
    {%- assign lh = line.product.handle | downcase -%}
    {%- if lh contains 'flowcore' -%}
      {%- assign rk_has_flowcore = true -%}
    {%- endif -%}
    {%- if line.product.template_suffix == 'oralbiome' -%}
      {%- assign rk_has_oralbiome = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- unless rk_has_flowcore and rk_has_oralbiome -%}
    {%- assign rk_show = true -%}
    {%- assign any_addon = true -%}
    {%- assign addon_count = addon_count | plus: 1 -%}
  {%- endunless -%}
{%- endif -%}
{%- assign rk_pct = settings.cq_rk_discount_pct | default: 30 -%}

{% if any_addon %}
  <div
    class="wt-cart__addons wt-cart__addons--collapsible"
    aria-label="{{ 'calqix_cart.addons_heading' | t }}"
  >
    {%- comment -%}
      Desktop shows the static heading inline. Mobile replaces it with a
      tappable trigger that toggles the collapsible content below. Both
      live in the DOM simultaneously; responsive CSS hides whichever one
      isn't relevant for the current viewport.
    {%- endcomment -%}
    <p class="wt-cart__addons__heading wt-cart__addons__heading--static">
      {{ 'calqix_cart.addons_heading' | t }}
    </p>
    <button
      type="button"
      class="wt-cart__addons__trigger"
      aria-expanded="false"
      aria-controls="wt-cart-addons-content"
    >
      <span class="wt-cart__addons__trigger-label">
        {{ 'calqix_cart.addons_heading' | t }}
      </span>
      <span class="wt-cart__addons__count" aria-hidden="true">{{ addon_count }}</span>
      <svg
        class="wt-cart__addons__chevron"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <div class="wt-cart__addons__content" id="wt-cart-addons-content">
    <div class="wt-cart__addons__list">
      {%- if rk_show -%}
        {%- assign rk_title = 'calqix_cart.addon_rebuild_kit_title' | t -%}
        {%- if rk_title contains 'translation missing' -%}{%- assign rk_title = 'Complete the Rebuild Kit' -%}{%- endif -%}
        {%- assign rk_text = 'calqix_cart.addon_rebuild_kit_text' | t -%}
        {%- if rk_text contains 'translation missing' -%}{%- assign rk_text = 'Pair your OralBiome with a FlowCore colour for 30% off.' -%}{%- endif -%}
        {%- assign rk_badge = 'calqix_cart.addon_rebuild_kit_badge' | t -%}
        {%- if rk_badge contains 'translation missing' -%}{%- capture rk_badge -%}{{ rk_pct }}% OFF{%- endcapture -%}{%- endif -%}
        <article class="wt-cart__addon-card wt-cart__addon-card--rebuild-kit" data-cq-rk-addon-card>
          <div class="wt-cart__addon-card__copy">
            <p class="wt-cart__addon-card__title">{{ rk_title }}</p>
            <p class="wt-cart__addon-card__text">{{ rk_text }}</p>
          </div>
          <div class="wt-cart__addon-card__actions">
            <span class="wt-cart__addon-card__badge" aria-hidden="true">{{ rk_badge }}</span>
            <button
              type="button"
              class="wt-cart__addon-card__button"
              data-cq-rk-open
              aria-haspopup="dialog"
              aria-controls="cq-rk-picker"
            >
              {{ 'calqix_cart.addon_add' | t }}
            </button>
          </div>
        </article>
      {%- endif -%}
      {% for i in (1..2) %}
        {% assign show_key = 'drawer_addon_' | append: i | append: '_show' %}
        {% assign price_key = 'drawer_addon_' | append: i | append: '_price' %}
        {% assign product_key = 'drawer_addon_' | append: i | append: '_product' %}
        {% assign url_key = 'drawer_addon_' | append: i | append: '_url' %}

        {% if settings[show_key] %}
          {% assign addon_product = settings[product_key] %}
          {% assign addon_url = settings[url_key] %}
          {% assign final_url = addon_url %}
          {% if final_url == blank and addon_product != blank %}
            {% assign final_url = addon_product.url %}
          {% endif %}

          {% assign is_added = false %}
          {% if addon_product != blank %}
            {% for item in cart.items %}
              {% if item.product_id == addon_product.id %}
                {% assign is_added = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% assign is_priority_support = false %}
          {% if addon_product != blank %}
            {% assign addon_title_downcase = addon_product.title | downcase %}
            {% if addon_title_downcase contains 'priority support' %}
              {% assign is_priority_support = true %}
            {% endif %}
          {% endif %}

          {% assign is_in_use = false %}
          {% if is_priority_support and addon_product != blank and customer %}
            {% assign now_s = 'now' | date: '%s' | plus: 0 %}
            {% for order in customer.orders limit: 20 %}
              {% assign order_s = order.created_at | date: '%s' | plus: 0 %}
              {% assign age_s = now_s | minus: order_s %}
              {% if age_s < 2592000 %}
                {% for line_item in order.line_items %}
                  {% if line_item.product_id == addon_product.id %}
                    {% assign is_in_use = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% if is_in_use %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          <article
            class="wt-cart__addon-card"
            {% if addon_product != blank and addon_product.selected_or_first_available_variant != blank %}
              data-addon-variant-id="{{ addon_product.selected_or_first_available_variant.id }}"
            {% endif %}
          >
            {% assign cq_addon_title_key = 'calqix_cart.addon_' | append: i | append: '_title' %}
            {% assign cq_addon_text_key = 'calqix_cart.addon_' | append: i | append: '_text' %}
            {% assign cq_addon_price_key = 'calqix_cart.addon_' | append: i | append: '_price' %}
            <div class="wt-cart__addon-card__copy">
              <p class="wt-cart__addon-card__title">{{ cq_addon_title_key | t }}</p>
              <p class="wt-cart__addon-card__text">{{ cq_addon_text_key | t }}</p>
            </div>

            <div class="wt-cart__addon-card__actions">
              {% if addon_product != blank and is_priority_support == false %}
                <span class="wt-cart__addon-card__price">{{ addon_product.price | money }}</span>
              {% elsif settings[price_key] != blank %}
                <span class="wt-cart__addon-card__price">{{ cq_addon_price_key | t }}</span>
              {% endif %}
              {% if addon_product != blank and addon_product.selected_or_first_available_variant != blank %}
                <product-form class="wt-cart__addon-product-form" data-hide-errors="true">
                  <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" class="form">
                    <input
                      type="hidden"
                      name="id"
                      value="{{ addon_product.selected_or_first_available_variant.id }}"
                    >
                    <button
                      type="submit"
                      class="wt-cart__addon-card__button"
                      data-add-label="{{ 'calqix_cart.addon_add' | t }}"
                      data-added-label="{{ 'calqix_cart.addon_added' | t }}"
                      {% unless addon_product.selected_or_first_available_variant.available %}
                        disabled
                      {% endunless %}
                      {% if is_added or is_in_use %}
                        disabled
                      {% endif %}
                    >
                      {% if is_in_use %}
                        {{ 'calqix_cart.addon_in_use' | t }}
                      {% elsif is_added %}
                        {{ 'calqix_cart.addon_added' | t }}
                      {% elsif addon_product.selected_or_first_available_variant.available %}
                        {{ 'calqix_cart.addon_add' | t }}
                      {% else %}
                        {{ 'calqix_cart.addon_sold_out' | t }}
                      {% endif %}
                    </button>
                  </form>
                </product-form>
              {% elsif final_url != blank %}
                <a href="{{ final_url }}" class="wt-cart__addon-card__button">{{ 'calqix_cart.addon_view' | t }}</a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    </div>
  </div>

  {%- comment -%}
    The collapsible toggle handler is bound globally by
    `assets/cart-addons-collapsible.js`, loaded once via
    `snippets/cart-drawer.liquid`. Inlining it here previously caused a
    silent failure: when the cart drawer is rebuilt by Shopify section
    refresh (cart-drawer:refresh), the markup is injected via innerHTML
    and inline <script> tags are NOT executed by the browser, so the
    handler was missing on every drawer state after the first load.
  {%- endcomment -%}
{% endif %}
