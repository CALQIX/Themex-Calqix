{%- comment -%}
  CALQIX Tooth Atlas V2 - compact anatomy, tooth layers and function education.
{%- endcomment -%}

{%- liquid
  assign cx_atlas_eyebrow = 'homepage.tooth_atlas.eyebrow' | t
  assign cx_atlas_heading = 'homepage.tooth_atlas.heading_html' | t
  assign cx_atlas_lede = 'homepage.tooth_atlas.lede_html' | t
  assign cx_atlas_visual_label = 'homepage.tooth_atlas.visual_label' | t
  assign cx_atlas_cta = 'homepage.tooth_atlas.cta_text' | t
-%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section cx-tooth-atlas-v2" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-stack cx-section-header cx-atlas-v2-header" data-cx-stagger>
      {% render 'cx-eyebrow', text: cx_atlas_eyebrow %}
      <h2 class="cx-h2">{{ cx_atlas_heading }}</h2>
      <div class="cx-lede">{{ cx_atlas_lede }}</div>
    </div>

    <div class="cx-atlas-v2-shell" data-cx-stagger>
      <div class="cx-atlas-v2-visual" data-cx-atlas-visual data-cx-atlas-state="atlas-enamel" aria-label="{{ cx_atlas_visual_label }}">
        <div class="cx-atlas-v2-orbit" aria-hidden="true"></div>
        <div class="cx-atlas-v2-tooth" aria-hidden="true">
          <span class="cx-atlas-v2-shadow"></span>
          <svg class="cx-atlas-v2-tooth-illustration" viewBox="0 0 300 386" role="img" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="cxAtlasEnamelGlow-{{ section.id }}" cx="36%" cy="16%" r="72%">
                <stop offset="0" stop-color="#ffffff"/>
                <stop offset=".46" stop-color="#f7fcff"/>
                <stop offset="1" stop-color="#d8ebf8"/>
              </radialGradient>
              <linearGradient id="cxAtlasDentinGold-{{ section.id }}" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#fff4cf"/>
                <stop offset=".58" stop-color="#edd28a"/>
                <stop offset="1" stop-color="#d8b45d"/>
              </linearGradient>
              <linearGradient id="cxAtlasPulpBlue-{{ section.id }}" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#35a3dc"/>
                <stop offset=".5" stop-color="#0076c2"/>
                <stop offset="1" stop-color="#00375f"/>
              </linearGradient>
              <linearGradient id="cxAtlasRootIvory-{{ section.id }}" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#fbfdff"/>
                <stop offset=".58" stop-color="#e8f4fd"/>
                <stop offset="1" stop-color="#cfe4f3"/>
              </linearGradient>
              <linearGradient id="cxAtlasGumRose-{{ section.id }}" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#f7cfbf"/>
                <stop offset=".5" stop-color="#ebb29b"/>
                <stop offset="1" stop-color="#f7d5c7"/>
              </linearGradient>
              <filter id="cxAtlasSoftShadow-{{ section.id }}" x="-25%" y="-20%" width="150%" height="150%">
                <feDropShadow dx="0" dy="18" stdDeviation="16" flood-color="#002549" flood-opacity=".16"/>
              </filter>
            </defs>
            <g filter="url(#cxAtlasSoftShadow-{{ section.id }})">
              <g class="cx-atlas-svg-gum" data-cx-atlas-part="atlas-gumline">
                <path d="M28 166 C58 130 100 142 130 164 C144 174 156 174 170 164 C202 141 244 130 272 166 C284 184 270 211 242 214 C207 218 186 199 151 199 C115 199 94 218 59 214 C31 211 16 184 28 166 Z" fill="url(#cxAtlasGumRose-{{ section.id }})"/>
                <path d="M37 169 C82 184 116 184 150 172 C184 184 218 184 263 169" fill="none" stroke="#ffffff" stroke-opacity=".28" stroke-width="5" stroke-linecap="round"/>
              </g>
              <g class="cx-atlas-svg-root" data-cx-atlas-part="atlas-root">
                <path d="M83 151 C83 179 74 199 73 229 C72 281 85 347 115 368 C134 381 140 325 145 280 C149 239 149 203 139 174 Z" fill="url(#cxAtlasRootIvory-{{ section.id }})" stroke="#8dc8ea" stroke-opacity=".42" stroke-width="2"/>
                <path d="M217 151 C217 179 226 199 227 229 C228 281 215 347 185 368 C166 381 160 325 155 280 C151 239 151 203 161 174 Z" fill="url(#cxAtlasRootIvory-{{ section.id }})" stroke="#8dc8ea" stroke-opacity=".42" stroke-width="2"/>
                <path d="M150 188 C144 233 143 296 148 360" fill="none" stroke="#7fbfe5" stroke-opacity=".28" stroke-width="2"/>
                <path d="M150 188 C156 233 157 296 152 360" fill="none" stroke="#ffffff" stroke-opacity=".52" stroke-width="2"/>
              </g>
              <g class="cx-atlas-svg-dentin" data-cx-atlas-part="atlas-dentin">
                <path d="M81 55 C96 25 126 34 143 50 C148 55 152 55 157 50 C174 34 204 25 219 55 C240 96 218 145 193 165 C178 177 169 196 169 219 L131 219 C131 196 122 177 107 165 C82 145 60 96 81 55 Z" fill="url(#cxAtlasDentinGold-{{ section.id }})" opacity=".72"/>
                <path d="M103 74 C118 54 137 65 150 78 C163 65 182 54 197 74 C210 98 196 129 178 141 C166 150 159 163 158 181 L142 181 C141 163 134 150 122 141 C104 129 90 98 103 74 Z" fill="#fff8de" opacity=".42"/>
              </g>
              <g class="cx-atlas-svg-pulp" data-cx-atlas-part="atlas-pulp">
                <path d="M129 91 C137 81 144 84 150 95 C156 84 163 81 171 91 C181 104 173 128 161 143 C156 150 154 168 154 202 C154 246 164 310 182 350" fill="none" stroke="url(#cxAtlasPulpBlue-{{ section.id }})" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M150 143 C144 178 144 246 118 348" fill="none" stroke="url(#cxAtlasPulpBlue-{{ section.id }})" stroke-width="10" stroke-linecap="round"/>
                <path d="M150 143 C156 178 156 246 182 348" fill="none" stroke="#006daf" stroke-opacity=".6" stroke-width="8" stroke-linecap="round"/>
              </g>
              <g class="cx-atlas-svg-enamel" data-cx-atlas-part="atlas-enamel">
                <path d="M67 52 C82 13 120 20 141 40 C147 46 153 46 159 40 C180 20 218 13 233 52 C252 100 230 151 201 173 C183 187 177 207 176 229 C169 221 159 216 150 216 C141 216 131 221 124 229 C123 207 117 187 99 173 C70 151 48 100 67 52 Z" fill="url(#cxAtlasEnamelGlow-{{ section.id }})" stroke="#a9d7ef" stroke-width="2.5"/>
                <path d="M88 60 C104 34 126 44 143 61 C148 66 152 66 157 61 C174 44 196 34 212 60 C226 91 212 126 188 143 C172 155 160 163 150 181 C140 163 128 155 112 143 C88 126 74 91 88 60 Z" fill="none" stroke="#53b4e8" stroke-opacity=".36" stroke-width="3"/>
                <path d="M89 55 C100 31 124 39 141 58" fill="none" stroke="#ffffff" stroke-opacity=".76" stroke-width="7" stroke-linecap="round"/>
                <path d="M166 51 C184 38 204 44 215 68" fill="none" stroke="#ffffff" stroke-opacity=".56" stroke-width="6" stroke-linecap="round"/>
              </g>
              <path class="cx-atlas-svg-outline" d="M67 52 C82 13 120 20 141 40 C147 46 153 46 159 40 C180 20 218 13 233 52 C252 100 230 151 201 173 C183 187 177 207 176 229 C178 270 202 342 185 368 C166 381 160 325 155 280 C153 258 152 237 150 219 C148 237 147 258 145 280 C140 325 134 381 115 368 C98 356 86 331 80 301 C74 272 72 246 73 229 C76 206 117 187 99 173 C70 151 48 100 67 52 Z" fill="none" stroke="#002549" stroke-opacity=".16" stroke-width="2.5"/>
            </g>
          </svg>
          <span class="cx-atlas-v2-signal" aria-hidden="true"></span>
        </div>
        <div class="cx-atlas-v2-slide-meter" aria-hidden="true">
          <span data-cx-atlas-meter="atlas-enamel" class="cx-is-active"></span>
          <span data-cx-atlas-meter="atlas-dentin"></span>
          <span data-cx-atlas-meter="atlas-pulp"></span>
          <span data-cx-atlas-meter="atlas-root"></span>
          <span data-cx-atlas-meter="atlas-gumline"></span>
        </div>
        <div class="cx-atlas-v2-callouts">
          <span data-cx-atlas-callout="atlas-enamel" class="cx-is-active" style="--x: 10%; --y: 21%;">{{ 'homepage.tooth_atlas.callout_enamel' | t }}</span>
          <span data-cx-atlas-callout="atlas-dentin" style="--x: 72%; --y: 28%;">{{ 'homepage.tooth_atlas.callout_dentin' | t }}</span>
          <span data-cx-atlas-callout="atlas-pulp" style="--x: 12%; --y: 60%;">{{ 'homepage.tooth_atlas.callout_pulp' | t }}</span>
          <span data-cx-atlas-callout="atlas-root" style="--x: 63%; --y: 76%;">{{ 'homepage.tooth_atlas.callout_root' | t }}</span>
          <span data-cx-atlas-callout="atlas-gumline" style="--x: 68%; --y: 49%;">{{ 'homepage.tooth_atlas.layer_5_tab' | t }}</span>
        </div>
        <div class="cx-atlas-v2-nutrition">
          <p>{{ 'homepage.tooth_atlas.feed_system' | t }}</p>
          <span>{{ 'homepage.tooth_atlas.nutrient_1' | t }}</span>
          <span>{{ 'homepage.tooth_atlas.nutrient_2' | t }}</span>
          <span>{{ 'homepage.tooth_atlas.nutrient_3' | t }}</span>
          <span>{{ 'homepage.tooth_atlas.nutrient_4' | t }}</span>
          <span>{{ 'homepage.tooth_atlas.nutrient_5' | t }}</span>
        </div>
      </div>

      <div class="cx-atlas-v2-panel" data-cx-tooth-atlas>
        <div class="cx-atlas-v2-tabs" role="tablist" aria-label="{{ 'homepage.tooth_atlas.tabs_label' | t }}">
          <button type="button" class="cx-atlas-v2-tab cx-is-active" data-cx-tooth-pill="atlas-enamel" role="tab" aria-selected="true">
            <span>01</span> {{ 'homepage.tooth_atlas.layer_1_tab' | t }}
          </button>
          <button type="button" class="cx-atlas-v2-tab" data-cx-tooth-pill="atlas-dentin" role="tab" aria-selected="false">
            <span>02</span> {{ 'homepage.tooth_atlas.layer_2_tab' | t }}
          </button>
          <button type="button" class="cx-atlas-v2-tab" data-cx-tooth-pill="atlas-pulp" role="tab" aria-selected="false">
            <span>03</span> {{ 'homepage.tooth_atlas.layer_3_tab' | t }}
          </button>
          <button type="button" class="cx-atlas-v2-tab" data-cx-tooth-pill="atlas-root" role="tab" aria-selected="false">
            <span>04</span> {{ 'homepage.tooth_atlas.layer_4_tab' | t }}
          </button>
          <button type="button" class="cx-atlas-v2-tab" data-cx-tooth-pill="atlas-gumline" role="tab" aria-selected="false">
            <span>05</span> {{ 'homepage.tooth_atlas.layer_5_tab' | t }}
          </button>
        </div>

        <div class="cx-atlas-v2-panels">
          <article class="cx-atlas-v2-layer cx-is-active" data-cx-tooth-panel="atlas-enamel" role="tabpanel">
            <div class="cx-eyebrow">{{ 'homepage.tooth_atlas.layer_1_eyebrow' | t }}</div>
            <h3>{{ 'homepage.tooth_atlas.layer_1_title' | t }}</h3>
            <p>{{ 'homepage.tooth_atlas.layer_1_desc' | t }}</p>
            <dl>
              <div><dt>{{ 'homepage.tooth_atlas.maintain_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_1_maintain' | t }}</dd></div>
              <div><dt>{{ 'homepage.tooth_atlas.eat_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_1_eat' | t }}</dd></div>
            </dl>
          </article>

          <article class="cx-atlas-v2-layer" data-cx-tooth-panel="atlas-dentin" role="tabpanel">
            <div class="cx-eyebrow">{{ 'homepage.tooth_atlas.layer_2_eyebrow' | t }}</div>
            <h3>{{ 'homepage.tooth_atlas.layer_2_title' | t }}</h3>
            <p>{{ 'homepage.tooth_atlas.layer_2_desc' | t }}</p>
            <dl>
              <div><dt>{{ 'homepage.tooth_atlas.maintain_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_2_maintain' | t }}</dd></div>
              <div><dt>{{ 'homepage.tooth_atlas.eat_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_2_eat' | t }}</dd></div>
            </dl>
          </article>

          <article class="cx-atlas-v2-layer" data-cx-tooth-panel="atlas-pulp" role="tabpanel">
            <div class="cx-eyebrow">{{ 'homepage.tooth_atlas.layer_3_eyebrow' | t }}</div>
            <h3>{{ 'homepage.tooth_atlas.layer_3_title' | t }}</h3>
            <p>{{ 'homepage.tooth_atlas.layer_3_desc' | t }}</p>
            <dl>
              <div><dt>{{ 'homepage.tooth_atlas.maintain_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_3_maintain' | t }}</dd></div>
              <div><dt>{{ 'homepage.tooth_atlas.eat_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_3_eat' | t }}</dd></div>
            </dl>
          </article>

          <article class="cx-atlas-v2-layer" data-cx-tooth-panel="atlas-root" role="tabpanel">
            <div class="cx-eyebrow">{{ 'homepage.tooth_atlas.layer_4_eyebrow' | t }}</div>
            <h3>{{ 'homepage.tooth_atlas.layer_4_title' | t }}</h3>
            <p>{{ 'homepage.tooth_atlas.layer_4_desc' | t }}</p>
            <dl>
              <div><dt>{{ 'homepage.tooth_atlas.maintain_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_4_maintain' | t }}</dd></div>
              <div><dt>{{ 'homepage.tooth_atlas.eat_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_4_eat' | t }}</dd></div>
            </dl>
          </article>

          <article class="cx-atlas-v2-layer" data-cx-tooth-panel="atlas-gumline" role="tabpanel">
            <div class="cx-eyebrow">{{ 'homepage.tooth_atlas.layer_5_eyebrow' | t }}</div>
            <h3>{{ 'homepage.tooth_atlas.layer_5_title' | t }}</h3>
            <p>{{ 'homepage.tooth_atlas.layer_5_desc' | t }}</p>
            <dl>
              <div><dt>{{ 'homepage.tooth_atlas.maintain_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_5_maintain' | t }}</dd></div>
              <div><dt>{{ 'homepage.tooth_atlas.eat_label' | t }}</dt><dd>{{ 'homepage.tooth_atlas.layer_5_eat' | t }}</dd></div>
            </dl>
          </article>
        </div>
      </div>
    </div>

    <div class="cx-atlas-v2-role-lab" data-cx-tooth-role-lab>
      <div class="cx-atlas-v2-role-switches" role="tablist" aria-label="{{ 'homepage.tooth_atlas.role_grid_label' | t }}">
        <button type="button" class="cx-atlas-v2-role-pill cx-is-active" data-cx-tooth-role="role-incisors" role="tab" aria-selected="true">{{ 'homepage.tooth_atlas.role_1_name' | t }}</button>
        <button type="button" class="cx-atlas-v2-role-pill" data-cx-tooth-role="role-canines" role="tab" aria-selected="false">{{ 'homepage.tooth_atlas.role_2_name' | t }}</button>
        <button type="button" class="cx-atlas-v2-role-pill" data-cx-tooth-role="role-premolars" role="tab" aria-selected="false">{{ 'homepage.tooth_atlas.role_3_name' | t }}</button>
        <button type="button" class="cx-atlas-v2-role-pill" data-cx-tooth-role="role-molars" role="tab" aria-selected="false">{{ 'homepage.tooth_atlas.role_4_name' | t }}</button>
        <button type="button" class="cx-atlas-v2-role-pill" data-cx-tooth-role="role-wisdom" role="tab" aria-selected="false">{{ 'homepage.tooth_atlas.role_5_name' | t }}</button>
      </div>

      <div class="cx-atlas-v2-arch" data-cx-tooth-arch="role-incisors" aria-hidden="true">
        <span class="cx-arch-tooth cx-incisor cx-is-active"></span>
        <span class="cx-arch-tooth cx-canine"></span>
        <span class="cx-arch-tooth cx-premolar"></span>
        <span class="cx-arch-tooth cx-molar"></span>
        <span class="cx-arch-tooth cx-wisdom"></span>
      </div>
    </div>

    <div class="cx-atlas-v2-role-grid" aria-label="{{ 'homepage.tooth_atlas.role_grid_label' | t }}">
      <article class="cx-is-active" data-cx-tooth-role-panel="role-incisors">
        <span>{{ 'homepage.tooth_atlas.role_1_name' | t }}</span>
        <h3>{{ 'homepage.tooth_atlas.role_1_title' | t }}</h3>
        <p>{{ 'homepage.tooth_atlas.role_1_desc' | t }}</p>
      </article>
      <article data-cx-tooth-role-panel="role-canines">
        <span>{{ 'homepage.tooth_atlas.role_2_name' | t }}</span>
        <h3>{{ 'homepage.tooth_atlas.role_2_title' | t }}</h3>
        <p>{{ 'homepage.tooth_atlas.role_2_desc' | t }}</p>
      </article>
      <article data-cx-tooth-role-panel="role-premolars">
        <span>{{ 'homepage.tooth_atlas.role_3_name' | t }}</span>
        <h3>{{ 'homepage.tooth_atlas.role_3_title' | t }}</h3>
        <p>{{ 'homepage.tooth_atlas.role_3_desc' | t }}</p>
      </article>
      <article data-cx-tooth-role-panel="role-molars">
        <span>{{ 'homepage.tooth_atlas.role_4_name' | t }}</span>
        <h3>{{ 'homepage.tooth_atlas.role_4_title' | t }}</h3>
        <p>{{ 'homepage.tooth_atlas.role_4_desc' | t }}</p>
      </article>
      <article data-cx-tooth-role-panel="role-wisdom">
        <span>{{ 'homepage.tooth_atlas.role_5_name' | t }}</span>
        <h3>{{ 'homepage.tooth_atlas.role_5_title' | t }}</h3>
        <p>{{ 'homepage.tooth_atlas.role_5_desc' | t }}</p>
      </article>
    </div>

    <div class="cx-atlas-v2-body-note">
      <strong>{{ 'homepage.tooth_atlas.body_note_label' | t }}</strong>
      <span>{{ 'homepage.tooth_atlas.body_note_text' | t }}</span>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="cx-atlas-v2-cta">
        <a class="cx-atlas-v2-button" href="{{ section.settings.cta_link | default: '#' }}">
          {{ cx_atlas_cta }}
          <span aria-hidden="true">-></span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .cx-tooth-atlas-v2 {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(247, 250, 255, .9), rgba(255, 255, 255, 1) 34%, rgba(241, 247, 255, .72));
  }

  .cx-tooth-atlas-v2::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 37, 73, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 37, 73, .045) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
    pointer-events: none;
  }

  .cx-tooth-atlas-v2 .cx-container { position: relative; z-index: 1; }
  .cx-atlas-v2-header { max-width: 820px; margin-inline: auto; }

  .cx-atlas-v2-shell {
    display: grid;
    grid-template-columns: minmax(330px, .9fr) minmax(420px, 1.1fr);
    gap: clamp(18px, 3vw, 34px);
    align-items: stretch;
    margin-top: clamp(26px, 5vw, 58px);
    min-width: 0;
  }

  .cx-atlas-v2-visual,
  .cx-atlas-v2-panel {
    min-width: 0;
    border: 1px solid rgba(0, 37, 73, .16);
    border-radius: 24px;
    background: rgba(255, 255, 255, .82);
    box-shadow: 0 26px 70px rgba(0, 37, 73, .08);
    backdrop-filter: blur(18px);
  }

  .cx-atlas-v2-visual {
    position: relative;
    min-height: 490px;
    overflow: hidden;
    isolation: isolate;
  }

  .cx-atlas-v2-orbit {
    position: absolute;
    inset: 58px 34px 104px;
    border-radius: 42% 42% 48% 48%;
    background:
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, .92) 0 12%, transparent 13%),
      radial-gradient(circle at 50% 45%, rgba(0, 118, 194, .13), transparent 48%),
      linear-gradient(150deg, rgba(255, 255, 255, .96), rgba(226, 239, 252, .62));
    border: 1px solid rgba(0, 118, 194, .14);
    transform: rotate(-2deg);
  }

  .cx-atlas-v2-tooth {
    position: absolute;
    left: 50%;
    top: 48px;
    width: min(70%, 330px);
    height: 392px;
    transform: translateX(-50%);
    filter: drop-shadow(0 26px 34px rgba(0, 37, 73, .12));
  }

  .cx-atlas-v2-tooth-illustration {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cx-atlas-v2-tooth-illustration [data-cx-atlas-part] {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 420ms var(--cx-ease-silk),
      transform 520ms var(--cx-ease-silk),
      filter 520ms var(--cx-ease-silk);
  }

  .cx-atlas-svg-enamel { opacity: .96; }
  .cx-atlas-svg-dentin { opacity: .76; }
  .cx-atlas-svg-pulp { opacity: .86; }
  .cx-atlas-svg-root { opacity: .88; }
  .cx-atlas-svg-gum { opacity: .86; }

  .cx-atlas-v2-crown,
  .cx-atlas-v2-enamel,
  .cx-atlas-v2-dentin,
  .cx-atlas-v2-pulp,
  .cx-atlas-v2-root,
  .cx-atlas-v2-gum {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .cx-atlas-v2-crown {
    top: 0;
    width: 230px;
    height: 176px;
    border-radius: 48% 52% 38% 40% / 58% 58% 36% 38%;
    background:
      radial-gradient(circle at 27% 18%, rgba(255,255,255,.98) 0 14%, transparent 15%),
      radial-gradient(circle at 73% 19%, rgba(255,255,255,.96) 0 13%, transparent 14%),
      radial-gradient(circle at 50% 6%, rgba(255,255,255,.98) 0 20%, transparent 21%),
      linear-gradient(145deg, #ffffff 0%, #f7fbff 34%, #e6f2fd 70%, #d5e8f6 100%);
    border: 2px solid rgba(0, 37, 73, .12);
    box-shadow:
      inset 22px -26px 52px rgba(0, 118, 194, .14),
      inset -20px 18px 36px rgba(255, 255, 255, .92),
      0 18px 48px rgba(0, 37, 73, .12);
    overflow: hidden;
  }

  .cx-atlas-v2-crown::before {
    content: "";
    position: absolute;
    left: 17px;
    right: 17px;
    top: 20px;
    height: 84px;
    border-radius: 50% 50% 34% 34%;
    background:
      radial-gradient(circle at 50% 42%, rgba(209, 170, 84, .18), transparent 44%),
      linear-gradient(145deg, rgba(255,255,255,.72), rgba(225,241,255,.42));
    border: 2px solid rgba(0, 118, 194, .22);
    box-shadow: inset 0 0 26px rgba(0, 118, 194, .08);
  }

