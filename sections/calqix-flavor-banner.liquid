{%- comment -%} Per-flavor particle preset overrides (operator-driven via blocks). {%- endcomment -%}
{%- capture particle_presets_json -%}
{
{%- assign preset_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'flavor_particle_preset' -%}
    {%- if preset_count > 0 -%},{%- endif -%}
    {{ block.settings.flavor_key | json }}: {
      "shape": {{ block.settings.shape | json }},
      "color": {{ block.settings.color | json }},
      "density_mult": {{ block.settings.density_mult | default: 100 | divided_by: 100.0 }},
      "scale_mult": {{ block.settings.scale_mult | default: 100 | divided_by: 100.0 }}
    }
    {%- assign preset_count = preset_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
}
{%- endcapture -%}

{%- comment -%} Particle + jar config for the JS init. {%- endcomment -%}
{%- capture fb_config_json -%}
{
  "enable_particles": {{ section.settings.enable_particles | json }},
  "particle_density": {{ section.settings.particle_density | default: 55 }},
  "particle_speed": {{ section.settings.particle_speed | default: 60 }},
  "particle_opacity": {{ section.settings.particle_opacity | default: 55 }},
  "enable_jars": {{ section.settings.enable_jars | json }},
  "enable_parallax": {{ section.settings.enable_parallax | json }},
  "parallax_strength": {{ section.settings.parallax_strength | default: 35 }},
  "enable_headline_reveal": {{ section.settings.enable_headline_reveal | json }},
  "enable_cursor_glow": {{ section.settings.enable_cursor_glow | json }}
}
{%- endcapture -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  #cq-fb-{{ section.id }} {
    --fb-accent: #4ABFA3;
    --fb-bg: #0F3A34;
    --fb-orb-x: 25%;
    --fb-orb-y: 30%;
    --fb-cream: #F7F4EC;
    --fb-gold: #C9A84C;
    position: relative;
    background: var(--fb-bg);
    color: var(--fb-cream);
    font-family: 'DM Sans', Arial, sans-serif;
    overflow: hidden;
    transition: background 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #cq-fb-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--fb-orb-x) var(--fb-orb-y),
      color-mix(in srgb, var(--fb-accent) 45%, transparent),
      transparent 55%
    );
    opacity: 0.8;
    transition: background 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  #cq-fb-{{ section.id }} .cq-fb__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 48px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 960px) {
    #cq-fb-{{ section.id }} .cq-fb__inner {
      grid-template-columns: 1fr;
      padding: 56px 24px;
      gap: 40px;
    }
  }
  #cq-fb-{{ section.id }} .cq-fb__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(247, 244, 236, 0.6);
    margin-bottom: 22px;
    font-weight: 500;
  }
  #cq-fb-{{ section.id }} .cq-fb__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--fb-accent);
    transition: background 0.6s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(38px, 5.6vw, 68px);
    line-height: 1.03;
    color: var(--fb-cream);
    margin: 0 0 18px;
    font-weight: 400;
  }
  #cq-fb-{{ section.id }} .cq-fb__title em {
    font-style: italic;
    color: var(--fb-accent);
    transition: color 0.6s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__sub {
    font-size: 16px;
    line-height: 1.62;
    color: rgba(247, 244, 236, 0.76);
    margin: 0 0 36px;
    max-width: 520px;
  }

  /* Chips */
  #cq-fb-{{ section.id }} .cq-fb__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }
  #cq-fb-{{ section.id }} .cq-fb__chip {
    background: rgba(247, 244, 236, 0.08);
    color: var(--fb-cream);
    border: 1px solid rgba(247, 244, 236, 0.16);
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    font-family: inherit;
  }
  #cq-fb-{{ section.id }} .cq-fb__chip:hover {
    background: rgba(247, 244, 236, 0.14);
    border-color: rgba(247, 244, 236, 0.28);
  }
  #cq-fb-{{ section.id }} .cq-fb__chip[aria-selected="true"] {
    background: var(--fb-accent);
    color: var(--fb-bg);
    border-color: var(--fb-accent);
    font-weight: 600;
  }

  /* Right column: rich flavor stage (hero image + orbiting lozenges + aura) */
  #cq-fb-{{ section.id }} .cq-fb__display {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #cq-fb-{{ section.id }} .cq-fb__stage {
    position: relative;
    width: min(360px, 84vw);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #cq-fb-{{ section.id }} .cq-fb__stage--swap {
    transform: scale(0.92) rotate(-3deg);
  }

  /* Aura: pulsing radial glow in flavor color */
  #cq-fb-{{ section.id }} .cq-fb__stage-aura {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      color-mix(in srgb, var(--fb-accent) 45%, transparent) 0%,
      color-mix(in srgb, var(--fb-accent) 18%, transparent) 35%,
      transparent 65%);
    filter: blur(12px);
    animation: cqFbStageAura 4.2s ease-in-out infinite;
    transition: background 0.8s ease;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes cqFbStageAura {
    0%, 100% { transform: scale(0.94); opacity: 0.7; }
    50% { transform: scale(1.08); opacity: 1; }
  }

  /* Hero image (fruit + lozenges, from OpenAI) */
  #cq-fb-{{ section.id }} .cq-fb__stage-hero {
    position: relative;
    width: 72%;
    height: 72%;
    object-fit: contain;
    z-index: 2;
    filter: drop-shadow(0 28px 48px color-mix(in srgb, var(--fb-accent) 35%, rgba(0,0,0,0.35)));
    animation: cqFbStageFloat 5.2s ease-in-out infinite;
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #cq-fb-{{ section.id }} .cq-fb__stage--swap .cq-fb__stage-hero {
    opacity: 0;
    transform: translateY(12px);
  }
  @keyframes cqFbStageFloat {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-10px) rotate(1deg); }
  }

  /* Orbiting lozenge pills — 6 around the hero, different sizes + offsets */
  #cq-fb-{{ section.id }} .cq-fb__stage-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: cqFbOrbitRotate 24s linear infinite;
    z-index: 1;
  }
  #cq-fb-{{ section.id }} .cq-fb__lozenge {
    position: absolute;
    display: block;
    border-radius: 999px;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--fb-accent) 85%, white) 0%,
      var(--fb-accent) 50%,
      color-mix(in srgb, var(--fb-accent) 65%, black) 100%);
    box-shadow:
      0 6px 14px color-mix(in srgb, var(--fb-accent) 45%, rgba(0,0,0,0.35)),
      inset 0 2px 4px rgba(255,255,255,0.35),
      inset 0 -2px 3px rgba(0,0,0,0.18);
    opacity: 0.92;
    transition: background 0.6s ease, box-shadow 0.6s ease;
    animation: cqFbLozengePulse 3.6s ease-in-out infinite;
  }
  /* Counter-rotate lozenges to stay upright while orbit rotates */
  #cq-fb-{{ section.id }} .cq-fb__stage-orbit .cq-fb__lozenge {
    animation: cqFbLozengePulse 3.6s ease-in-out infinite, cqFbLozengeCounter 24s linear infinite;
  }
  @keyframes cqFbLozengeCounter {
    from { transform: rotate(0) translateZ(0); }
    to { transform: rotate(-360deg) translateZ(0); }
  }
  @keyframes cqFbLozengePulse {
    0%, 100% { box-shadow: 0 6px 14px color-mix(in srgb, var(--fb-accent) 45%, rgba(0,0,0,0.35)), inset 0 2px 4px rgba(255,255,255,0.35), inset 0 -2px 3px rgba(0,0,0,0.18); }
    50% { box-shadow: 0 10px 22px color-mix(in srgb, var(--fb-accent) 65%, rgba(0,0,0,0.4)), inset 0 2px 4px rgba(255,255,255,0.45), inset 0 -2px 3px rgba(0,0,0,0.2); }
  }
  @keyframes cqFbOrbitRotate {
    from { transform: rotate(0); }
    to { transform: rotate(360deg); }
  }

  /* Per-lozenge positions + sizes (anchored to orbit container) */
  #cq-fb-{{ section.id }} .cq-fb__lozenge--o1 { top: 6%; left: 18%; width: 34px; height: 16px; transform: rotate(-18deg); animation-delay: 0s, 0s; }
  #cq-fb-{{ section.id }} .cq-fb__lozenge--o2 { top: 8%; right: 14%; width: 40px; height: 19px; transform: rotate(22deg); animation-delay: 0.5s, 0s; }
  #cq-fb-{{ section.id }} .cq-fb__lozenge--o3 { top: 44%; right: 4%; width: 30px; height: 14px; transform: rotate(-6deg); animation-delay: 1s, 0s; }
  #cq-fb-{{ section.id }} .cq-fb__lozenge--o4 { bottom: 10%; right: 22%; width: 38px; height: 18px; transform: rotate(-28deg); animation-delay: 1.5s, 0s; }
  #cq-fb-{{ section.id }} .cq-fb__lozenge--o5 { bottom: 8%; left: 18%; width: 32px; height: 15px; transform: rotate(14deg); animation-delay: 2s, 0s; }
  #cq-fb-{{ section.id }} .cq-fb__lozenge--o6 { top: 42%; left: 2%; width: 36px; height: 17px; transform: rotate(-10deg); animation-delay: 2.5s, 0s; }

  /* Mobile: smaller stage */
  @media (max-width: 860px) {
    #cq-fb-{{ section.id }} .cq-fb__stage { width: min(260px, 74vw); }
    #cq-fb-{{ section.id }} .cq-fb__lozenge { transform: scale(0.8); }
  }
  #cq-fb-{{ section.id }} .cq-fb__meta {
    margin-top: 28px;
    text-align: center;
  }
  #cq-fb-{{ section.id }} .cq-fb__flavor-name {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 24px;
    color: var(--fb-cream);
    margin-bottom: 6px;
    transition: opacity 0.3s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__flavor-desc {
    font-size: 14px;
    color: rgba(247, 244, 236, 0.72);
    max-width: 320px;
    margin: 0 auto 20px;
    line-height: 1.55;
    transition: opacity 0.3s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__meta--swap .cq-fb__flavor-name,
  #cq-fb-{{ section.id }} .cq-fb__meta--swap .cq-fb__flavor-desc {
    opacity: 0;
  }
  #cq-fb-{{ section.id }} .cq-fb__price {
    font-size: 14px;
    color: rgba(247, 244, 236, 0.56);
    margin-bottom: 18px;
  }
  #cq-fb-{{ section.id }} .cq-fb__price strong {
    color: var(--fb-cream);
    font-weight: 600;
    font-size: 18px;
  }

  /* CTA buttons */
  #cq-fb-{{ section.id }} .cq-fb__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }
  #cq-fb-{{ section.id }} .cq-fb__cta {
    background: var(--fb-accent);
    color: var(--fb-bg);
    border: none;
    border-radius: 8px;
    padding: 14px 40px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.6s ease;
    letter-spacing: 0.02em;
  }
  #cq-fb-{{ section.id }} .cq-fb__cta:hover:not([disabled]) {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.25);
  }
  #cq-fb-{{ section.id }} .cq-fb__cta[aria-busy="true"] {
    opacity: 0.7;
    cursor: wait;
  }
  #cq-fb-{{ section.id }} .cq-fb__cta-sub {
    background: transparent;
    color: rgba(247, 244, 236, 0.82);
    border: 1px solid rgba(247, 244, 236, 0.24);
    padding: 10px 32px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__cta-sub:hover:not([disabled]) {
    background: rgba(247, 244, 236, 0.08);
    border-color: rgba(247, 244, 236, 0.4);
  }
  #cq-fb-{{ section.id }} .cq-fb__error {
    margin-top: 10px;
    font-size: 12px;
    color: #FFB0B0;
    display: none;
    text-align: center;
  }
  #cq-fb-{{ section.id }} .cq-fb__error[data-visible="true"] {
    display: block;
  }

  /* ========== UPGRADE: particles + jars + cursor glow + reveals ========== */

  /* Background particle canvas */
  #cq-fb-{{ section.id }} .cq-fb__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: var(--fb-particle-opacity, 0.55);
    transition: opacity 0.8s ease;
  }

  /* Cursor-following glow */
  #cq-fb-{{ section.id }} .cq-fb__cursor-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--fb-accent) 32%, transparent), transparent 62%);
    pointer-events: none;
    z-index: 1;
    transform: translate3d(-50%, -50%, 0);
    left: 50%;
    top: 40%;
    opacity: 0;
    transition: opacity 0.5s ease, background 0.8s ease;
    filter: blur(8px);
    mix-blend-mode: screen;
  }
  #cq-fb-{{ section.id }}[data-cursor-visible="true"] .cq-fb__cursor-glow {
    opacity: 0.65;
  }

  /* Floating jars layer */
  #cq-fb-{{ section.id }} .cq-fb__jars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar {
    position: absolute;
    left: var(--jar-x, 10%);
    top: var(--jar-y, 20%);
    width: var(--jar-size, 140px);
    height: auto;
    opacity: calc(var(--jar-opacity, 100) / 100);
    will-change: transform, opacity;
    animation: cqFbJarFloat var(--jar-duration, 10s) ease-in-out infinite;
    animation-delay: var(--jar-delay, 0s);
    filter: drop-shadow(0 24px 36px rgba(0, 0, 0, 0.35));
    transition: opacity 0.6s ease, filter 0.6s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar img,
  #cq-fb-{{ section.id }} .cq-fb__jar svg {
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--glow::before {
    content: '';
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, var(--jar-glow, var(--fb-accent)), transparent 62%);
    filter: blur(18px);
    opacity: 0.55;
    z-index: -1;
    transition: background 0.8s ease, opacity 0.6s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--dimmed {
    opacity: calc(var(--jar-opacity, 100) / 100 * 0.35);
    filter: drop-shadow(0 24px 36px rgba(0,0,0,0.35)) saturate(0.6);
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--dimmed::before {
    opacity: 0.15;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--pulse {
    animation: cqFbJarFloat var(--jar-duration, 10s) ease-in-out infinite, cqFbJarPulse 0.8s ease-out;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--highlight {
    z-index: 5;
    filter: drop-shadow(0 30px 48px color-mix(in srgb, var(--fb-accent) 55%, rgba(0,0,0,0.35))) brightness(1.12);
    opacity: 1 !important;
    animation: cqFbJarHover var(--jar-duration, 10s) ease-in-out infinite;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--highlight::before {
    opacity: 0.95 !important;
    background: radial-gradient(circle at 50% 50%, var(--jar-glow, var(--fb-accent)), transparent 55%);
    animation: cqFbJarGlowPulse 1.8s ease-in-out infinite;
  }
  #cq-fb-{{ section.id }} .cq-fb__jar--highlight img,
  #cq-fb-{{ section.id }} .cq-fb__jar--highlight svg {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    transform: scale(1.18);
  }

  @keyframes cqFbJarFloat {
    0%, 100% {
      transform: translate3d(var(--parallax-x, 0px), 0, 0) rotate(var(--jar-rot, 0deg));
    }
    50% {
      transform: translate3d(var(--parallax-x, 0px), calc(-1 * var(--jar-amp, 18px)), 0) rotate(calc(var(--jar-rot, 0deg) * -0.6));
    }
  }
  @keyframes cqFbJarHover {
    0%, 100% {
      transform: translate3d(var(--parallax-x, 0px), 0, 0) rotate(calc(var(--jar-rot, 0deg) * 0.8)) scale(1.04);
    }
    50% {
      transform: translate3d(var(--parallax-x, 0px), calc(-1 * var(--jar-amp, 18px) * 1.4), 0) rotate(calc(var(--jar-rot, 0deg) * -0.4)) scale(1.08);
    }
  }
  @keyframes cqFbJarPulse {
    0% { filter: drop-shadow(0 24px 36px rgba(0,0,0,0.35)) brightness(1); }
    50% { filter: drop-shadow(0 28px 48px color-mix(in srgb, var(--fb-accent) 50%, rgba(0,0,0,0.35))) brightness(1.15); }
    100% { filter: drop-shadow(0 24px 36px rgba(0,0,0,0.35)) brightness(1); }
  }
  @keyframes cqFbJarGlowPulse {
    0%, 100% { filter: blur(18px); opacity: 0.75; }
    50% { filter: blur(26px); opacity: 1; }
  }

  /* Content layer above jars */
  #cq-fb-{{ section.id }} .cq-fb__inner {
    position: relative;
    z-index: 3;
  }

  /* Title reveal animation */
  #cq-fb-{{ section.id }} .cq-fb__title .cq-fb__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: 1.05;
    padding-bottom: 0.08em;
  }
  #cq-fb-{{ section.id }} .cq-fb__title .cq-fb__char {
    display: inline-block;
    transform: translateY(105%);
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-i, 0) * 28ms);
  }
  #cq-fb-{{ section.id }}[data-revealed="true"] .cq-fb__title .cq-fb__char {
    transform: translateY(0);
  }

  /* Chip micro-interactions */
  #cq-fb-{{ section.id }} .cq-fb__chip {
    position: relative;
    overflow: hidden;
  }
  #cq-fb-{{ section.id }} .cq-fb__chip::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 30px;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.28) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform 0.6s ease;
    pointer-events: none;
  }
  #cq-fb-{{ section.id }} .cq-fb__chip:hover::after {
    transform: translateX(120%);
  }
  #cq-fb-{{ section.id }} .cq-fb__chip[aria-selected="true"] {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--fb-accent) 50%, transparent);
  }

  /* ATC ripple/shimmer */
  #cq-fb-{{ section.id }} .cq-fb__cta {
    position: relative;
    overflow: hidden;
  }
  #cq-fb-{{ section.id }} .cq-fb__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 35%, rgba(255,255,255,0.35) 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 0.8s ease;
  }
  #cq-fb-{{ section.id }} .cq-fb__cta:hover::after {
    transform: translateX(120%);
  }

  /* Reduced motion: disable all idle + float animations */
  @media (prefers-reduced-motion: reduce) {
    #cq-fb-{{ section.id }} .cq-fb__jar,
    #cq-fb-{{ section.id }} .cq-fb__stage-aura,
    #cq-fb-{{ section.id }} .cq-fb__stage-hero,
    #cq-fb-{{ section.id }} .cq-fb__stage-orbit,
    #cq-fb-{{ section.id }} .cq-fb__lozenge,
    #cq-fb-{{ section.id }} .cq-fb__title .cq-fb__char,
    #cq-fb-{{ section.id }} .cq-fb__cta::after,
    #cq-fb-{{ section.id }} .cq-fb__chip::after {
      animation: none !important;
      transition: none !important;
    }
    #cq-fb-{{ section.id }} .cq-fb__title .cq-fb__char {
      transform: none !important;
    }
    #cq-fb-{{ section.id }} .cq-fb__particles,
    #cq-fb-{{ section.id }} .cq-fb__cursor-glow {
      display: none !important;
    }
  }
</style>

<section id="cq-fb-{{ section.id }}" class="cq-fb" aria-labelledby="cq-fb-title-{{ section.id }}" data-revealed="false">
  {%- if section.settings.enable_particles -%}
    <canvas class="cq-fb__particles" data-cq-fb-particles aria-hidden="true"></canvas>
  {%- endif -%}
  {%- if section.settings.enable_cursor_glow -%}
    <div class="cq-fb__cursor-glow" data-cq-fb-cursor aria-hidden="true"></div>
  {%- endif -%}
  {%- if section.settings.enable_jars -%}
    <div class="cq-fb__jars" data-cq-fb-jars aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- if block.type == 'floating_jar' -%}
          {%- liquid
            assign jar_img = blank
            assign jar_asset_url = blank
            assign img_src = block.settings.image_source | default: 'auto'

            if img_src == 'override' and block.settings.image_override != blank
              assign jar_img = block.settings.image_override
            elsif img_src == 'product' and block.settings.product != blank and block.settings.product.featured_image != blank
              assign jar_img = block.settings.product.featured_image
            elsif img_src == 'generated' and block.settings.tie_to_flavor != blank
              assign flavor_slug = block.settings.tie_to_flavor | replace: '_', '-'
              assign asset_name = 'calqix-jar-' | append: flavor_slug | append: '.png'
              assign jar_asset_url = asset_name | asset_url
            else
              if block.settings.image_override != blank
                assign jar_img = block.settings.image_override
              elsif block.settings.product != blank and block.settings.product.featured_image != blank
                assign jar_img = block.settings.product.featured_image
              elsif block.settings.tie_to_flavor != blank
                assign flavor_slug = block.settings.tie_to_flavor | replace: '_', '-'
                assign asset_name = 'calqix-jar-' | append: flavor_slug | append: '.png'
                assign jar_asset_url = asset_name | asset_url
              endif
            endif
            assign jar_alt = block.settings.product.title | default: block.settings.tie_to_flavor | default: ''
          -%}
          {%- if jar_img != blank or jar_asset_url != blank -%}
            <div class="cq-fb__jar{% if block.settings.enable_glow %} cq-fb__jar--glow{% endif %}"
                 data-cq-fb-jar
                 data-flavor="{{ block.settings.tie_to_flavor | default: '' }}"
                 data-z="{{ block.settings.z_depth | default: 0 }}"
                 style="--jar-x: {{ block.settings.x_pct | default: 15 }}%;
                        --jar-y: {{ block.settings.y_pct | default: 20 }}%;
                        --jar-size: {{ block.settings.size_px | default: 140 }}px;
                        --jar-amp: {{ block.settings.float_amplitude_px | default: 18 }}px;
                        --jar-duration: {{ block.settings.float_duration_s | default: 10 }}s;
                        --jar-delay: {{ block.settings.delay_s | default: 0 }}s;
                        --jar-rot: {{ block.settings.rotation_deg | default: 6 }}deg;
                        --jar-opacity: {{ block.settings.opacity_pct | default: 100 }};
                        {% if block.settings.glow_color != blank %}--jar-glow: {{ block.settings.glow_color }};{% endif %}
                        z-index: {{ block.settings.z_depth | default: 0 | plus: 5 }};"
                 {{ block.shopify_attributes }}>
              {%- if jar_img != blank -%}
                {{ jar_img | image_url: width: 480 | image_tag:
                    loading: 'lazy',
                    widths: '180,240,320,480,640',
                    sizes: '(min-width: 960px) 280px, 40vw',
                    alt: jar_alt }}
              {%- else -%}
                <img src="{{ jar_asset_url }}" alt="{{ jar_alt }}" loading="lazy" decoding="async" width="480" height="480">
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="cq-fb__inner">
    <div class="cq-fb__content">
      <div class="cq-fb__eyebrow">{{ 'homepage_sections.flavor_banner.eyebrow' | t }}</div>

      <h2 id="cq-fb-title-{{ section.id }}" class="cq-fb__title">
        {{ 'homepage_sections.flavor_banner.heading_line_1' | t }}<br>
        {{ 'homepage_sections.flavor_banner.heading_line_2_prefix' | t }}<em>{{ 'homepage_sections.flavor_banner.heading_line_2_accent' | t }}</em> {{ 'homepage_sections.flavor_banner.heading_line_2_suffix' | t }}
      </h2>

      <p class="cq-fb__sub">
        {{ 'homepage_sections.flavor_banner.subheading' | t }}
      </p>

      <div class="cq-fb__chips" role="tablist" aria-label="{{ 'homepage_sections.flavor_banner.eyebrow' | t }}">
        {%- if fm != blank -%}<button class="cq-fb__chip" role="tab" data-cq-fb-chip="freshmint" aria-selected="true">{{ 'homepage_sections.flavor_banner.flavors.freshmint.name' | t }}</button>{%- endif -%}
        {%- if gr != blank -%}<button class="cq-fb__chip" role="tab" data-cq-fb-chip="grape" aria-selected="false">{{ 'homepage_sections.flavor_banner.flavors.grape.name' | t }}</button>{%- endif -%}
        {%- if pe != blank -%}<button class="cq-fb__chip" role="tab" data-cq-fb-chip="peach" aria-selected="false">{{ 'homepage_sections.flavor_banner.flavors.peach.name' | t }}</button>{%- endif -%}
        {%- if co != blank -%}<button class="cq-fb__chip" role="tab" data-cq-fb-chip="citrus_orange" aria-selected="false">{{ 'homepage_sections.flavor_banner.flavors.citrus_orange.name' | t }}</button>{%- endif -%}
        {%- if cm != blank -%}<button class="cq-fb__chip" role="tab" data-cq-fb-chip="cool_mint" aria-selected="false">{{ 'homepage_sections.flavor_banner.flavors.cool_mint.name' | t }}</button>{%- endif -%}
      </div>
    </div>

    <div class="cq-fb__display">
      <div class="cq-fb__stage" data-cq-fb-stage aria-hidden="true">
        <div class="cq-fb__stage-orbit">
          <span class="cq-fb__lozenge cq-fb__lozenge--o1"></span>
          <span class="cq-fb__lozenge cq-fb__lozenge--o2"></span>
          <span class="cq-fb__lozenge cq-fb__lozenge--o3"></span>
          <span class="cq-fb__lozenge cq-fb__lozenge--o4"></span>
          <span class="cq-fb__lozenge cq-fb__lozenge--o5"></span>
          <span class="cq-fb__lozenge cq-fb__lozenge--o6"></span>
        </div>
        <div class="cq-fb__stage-aura"></div>
        <img class="cq-fb__stage-hero" data-cq-fb-hero
             src="{{ 'calqix-hero-freshmint.png' | asset_url }}"
             alt=""
             width="320" height="320"
             loading="eager" decoding="async">
      </div>
    </div>
  </div>

  <div class="cq-fb__inner" style="padding-top: 0; padding-bottom: 56px; grid-template-columns: 1fr; gap: 0;">
    <div class="cq-fb__meta" data-cq-fb-meta>
      <div class="cq-fb__flavor-name" data-cq-fb-name>{{ 'homepage_sections.flavor_banner.flavors.freshmint.name' | t }}</div>
      <div class="cq-fb__flavor-desc" data-cq-fb-desc>{{ 'homepage_sections.flavor_banner.flavors.freshmint.description' | t }}</div>
      <div class="cq-fb__price">
        <strong data-cq-fb-price>{{ default_price | money }}</strong>
      </div>
      <div class="cq-fb__actions">
        <button type="button"
                class="cq-fb__cta"
                data-cq-fb-atc
                aria-label="{{ 'homepage_sections.flavor_banner.cta_primary' | t }}">
          {{ 'homepage_sections.flavor_banner.cta_primary' | t }}
        </button>
        {%- if sp_default != blank -%}
          <button type="button"
                  class="cq-fb__cta-sub"
                  data-cq-fb-atc-subscribe
                  aria-label="{{ 'homepage_sections.flavor_banner.cta_subscribe' | t }}">
            {{ 'homepage_sections.flavor_banner.cta_subscribe' | t }} · −{{ sub_discount_pct }}%
          </button>
        {%- endif -%}
      </div>
      <div class="cq-fb__error" data-cq-fb-error role="alert"></div>
    </div>
  </div>
</section>

<script id="cq-fb-data-{{ section.id }}" type="application/json">{{ flavors_json }}</script>

<script>
(function() {
  'use strict';
  var root = document.getElementById('cq-fb-{{ section.id }}');
  if (!root) return;

  var dataEl = document.getElementById('cq-fb-data-{{ section.id }}');
  if (!dataEl) return;

  var flavors;
  try { flavors = JSON.parse(dataEl.textContent); } catch (e) { return; }
  if (!flavors || flavors.length === 0) return;

  var byKey = {};
  for (var i = 0; i < flavors.length; i++) byKey[flavors[i].key] = flavors[i];

  var current = flavors[0];

  var chips = root.querySelectorAll('[data-cq-fb-chip]');
  var stage = root.querySelector('[data-cq-fb-stage]');
  var hero = root.querySelector('[data-cq-fb-hero]');
  var meta = root.querySelector('[data-cq-fb-meta]');
  var nameEl = root.querySelector('[data-cq-fb-name]');
  var descEl = root.querySelector('[data-cq-fb-desc]');
  var priceEl = root.querySelector('[data-cq-fb-price]');
  var atcBtn = root.querySelector('[data-cq-fb-atc]');
  var subBtn = root.querySelector('[data-cq-fb-atc-subscribe]');
  var errEl = root.querySelector('[data-cq-fb-error]');

  function showError(msg) {
    if (!errEl) return;
    errEl.textContent = msg;
    errEl.setAttribute('data-visible', 'true');
    setTimeout(function() { errEl.removeAttribute('data-visible'); }, 6000);
  }

  function applyFlavor(key) {
    var f = byKey[key];
    if (!f) return;
    current = f;

    root.style.setProperty('--fb-accent', f.accent);
    root.style.setProperty('--fb-bg', f.background);
    root.style.setProperty('--fb-orb-x', f.orb_x + '%');
    root.style.setProperty('--fb-orb-y', f.orb_y + '%');

    for (var i = 0; i < chips.length; i++) {
      chips[i].setAttribute('aria-selected', chips[i].getAttribute('data-cq-fb-chip') === key ? 'true' : 'false');
    }

    // Animate stage + hero image swap
    if (stage) {
      stage.classList.add('cq-fb__stage--swap');
      setTimeout(function() {
        if (hero) {
          var slug = (f.key || '').replace('_', '-');
          // Derive next hero URL by substituting the filename in the current src.
          var current = hero.getAttribute('src') || '';
          var next = current.replace(/calqix-hero-[a-z-]+\.png/, 'calqix-hero-' + slug + '.png');
          if (next !== current) hero.setAttribute('src', next);
          hero.setAttribute('alt', f.name || '');
        }
        stage.classList.remove('cq-fb__stage--swap');
      }, 350);
    }
    if (meta) {
      meta.classList.add('cq-fb__meta--swap');
      setTimeout(function() {
        if (nameEl) nameEl.textContent = f.name;
        if (descEl) descEl.textContent = f.description;
        if (priceEl) priceEl.textContent = f.price_formatted;
        meta.classList.remove('cq-fb__meta--swap');
      }, 200);
    }
  }

  function atc(useSellingPlan) {
    var btn = useSellingPlan ? subBtn : atcBtn;
    if (!btn) return;
    if (btn.getAttribute('aria-busy') === 'true') return;
    if (!current || !current.variant_id) {
      showError('{{ "homepage_sections.flavor_banner.error_generic" | t }}');
      return;
    }

    btn.setAttribute('aria-busy', 'true');

    var item = { id: Number(current.variant_id), quantity: 1 };
    if (useSellingPlan && current.selling_plan_id) {
      item.selling_plan = Number(current.selling_plan_id);
    }

    var cartDrawer = document.querySelector('cart-drawer');
    var sectionsList = [];
    if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
      sectionsList = cartDrawer.getSectionsToRender().map(function(s) { return s.id; });
    }

    var body = { items: [item] };
    if (sectionsList.length) {
      body.sections = sectionsList.join(',');
      body.sections_url = window.location.pathname;
    }

    fetch((window.routes && window.routes.cart_add_url) || '/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/javascript',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: JSON.stringify(body),
    })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
      .then(function(r) {
        if (!r.ok) {
          showError(r.data.description || r.data.message || '{{ "homepage_sections.flavor_banner.error_generic" | t }}');
          return;
        }
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS === 'object') {
          publish(PUB_SUB_EVENTS.cartUpdate, {
            source: 'calqix-flavor-banner',
            productVariantId: current.variant_id,
            cartData: r.data,
          });
        }
        if (cartDrawer && typeof cartDrawer.renderContents === 'function' && r.data.sections) {
          cartDrawer.renderContents(r.data, true);
        } else {
          document.dispatchEvent(new CustomEvent('cart-drawer:refresh', {
            detail: { response: r.data },
            bubbles: true,
            composed: true,
          }));
        }
      })
      .catch(function(err) {
        console.error('[calqix-flavor-banner]', err);
        showError('{{ "homepage_sections.flavor_banner.error_generic" | t }}');
      })
      .finally(function() {
        btn.removeAttribute('aria-busy');
      });
  }

  // Shared helper: highlight (or clear) jars tied to a specific flavor key.
  function setJarHighlight(flavorKey, on) {
    if (!flavorKey) return;
    var all = root.querySelectorAll('[data-cq-fb-jar]');
    for (var i = 0; i < all.length; i++) {
      var tie = all[i].getAttribute('data-flavor') || '';
      if (tie === flavorKey) {
        if (on) all[i].classList.add('cq-fb__jar--highlight');
        else all[i].classList.remove('cq-fb__jar--highlight');
      }
    }
  }

  for (var j = 0; j < chips.length; j++) {
    (function(chip) {
      var chipFlavor = chip.getAttribute('data-cq-fb-chip');
      chip.addEventListener('click', function() {
        applyFlavor(chipFlavor);
      });
      chip.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          var next = chip.nextElementSibling;
          if (next && next.getAttribute('data-cq-fb-chip')) { next.focus(); next.click(); }
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          var prev = chip.previousElementSibling;
          if (prev && prev.getAttribute('data-cq-fb-chip')) { prev.focus(); prev.click(); }
        }
      });

      // Mouse hover: highlight matching jars
      chip.addEventListener('mouseenter', function() { setJarHighlight(chipFlavor, true); });
      chip.addEventListener('mouseleave', function() { setJarHighlight(chipFlavor, false); });
      // Keyboard focus parity
      chip.addEventListener('focus', function() { setJarHighlight(chipFlavor, true); });
      chip.addEventListener('blur', function() { setJarHighlight(chipFlavor, false); });
      // Touch (mobile): brief highlight on tap-down, clear on release + timeout
      chip.addEventListener('touchstart', function() { setJarHighlight(chipFlavor, true); }, { passive: true });
      chip.addEventListener('touchend', function() {
        setTimeout(function() { setJarHighlight(chipFlavor, false); }, 1200);
      }, { passive: true });
      chip.addEventListener('touchcancel', function() { setJarHighlight(chipFlavor, false); }, { passive: true });
    })(chips[j]);
  }

  if (atcBtn) atcBtn.addEventListener('click', function() { atc(false); });
  if (subBtn) subBtn.addEventListener('click', function() { atc(true); });

  // ======================================================================
  // UPGRADE: particles + jar parallax + headline reveal + cursor glow
  // ======================================================================

  var fbConfig;
  try { fbConfig = {{ fb_config_json }}; } catch (e) { fbConfig = { enable_particles: true, particle_density: 55, particle_speed: 60, particle_opacity: 55, enable_jars: true, enable_parallax: true, parallax_strength: 35, enable_headline_reveal: true, enable_cursor_glow: true }; }

  var particlePresets;
  try { particlePresets = {{ particle_presets_json }}; } catch (e) { particlePresets = {}; }

  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Default shape per flavor key
  var DEFAULT_SHAPE_MAP = {
    freshmint: 'leaf',
    grape: 'berry',
    peach: 'petal',
    citrus_orange: 'wedge',
    cool_mint: 'crystal'
  };

  // Apply particle opacity as CSS var
  root.style.setProperty('--fb-particle-opacity', (fbConfig.particle_opacity / 100).toFixed(2));

  // --- Headline reveal ------------------------------------------------------
  (function setupHeadlineReveal() {
    if (!fbConfig.enable_headline_reveal || reducedMotion) {
      root.setAttribute('data-revealed', 'true');
      return;
    }
    var titleEl = root.querySelector('.cq-fb__title');
    if (!titleEl) return;

    function wrapChars(node, indexOffset) {
      var idx = indexOffset || 0;
      var children = Array.prototype.slice.call(node.childNodes);
      children.forEach(function(child) {
        if (child.nodeType === Node.TEXT_NODE) {
          var text = child.nodeValue;
          if (!text || !text.trim()) return;
          var words = text.split(/(\s+)/);
          var frag = document.createDocumentFragment();
          words.forEach(function(w) {
            if (!w) return;
            if (/^\s+$/.test(w)) {
              frag.appendChild(document.createTextNode(w));
              return;
            }
            var wSpan = document.createElement('span');
            wSpan.className = 'cq-fb__word';
            for (var i = 0; i < w.length; i++) {
              var c = document.createElement('span');
              c.className = 'cq-fb__char';
              c.style.setProperty('--char-i', idx++);
              c.textContent = w[i];
              wSpan.appendChild(c);
            }
            frag.appendChild(wSpan);
          });
          node.replaceChild(frag, child);
        } else if (child.nodeType === Node.ELEMENT_NODE && child.tagName !== 'BR') {
          idx = wrapChars(child, idx);
        }
      });
      return idx;
    }
    try { wrapChars(titleEl); } catch (e) { /* noop */ }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(ent) {
          if (ent.isIntersecting) {
            root.setAttribute('data-revealed', 'true');
            io.disconnect();
          }
        });
      }, { threshold: 0.15 });
      io.observe(root);
    } else {
      root.setAttribute('data-revealed', 'true');
    }
  })();

  // --- Jar parallax + active-flavor highlight -------------------------------
  var jars = Array.prototype.slice.call(root.querySelectorAll('[data-cq-fb-jar]'));
  var parallaxTargetX = 0;
  var parallaxTargetY = 0;
  var parallaxCurrentX = 0;
  var parallaxCurrentY = 0;

  function updateJarFlavorStates(activeKey) {
    if (!jars.length) return;
    var anyTied = jars.some(function(j) { return (j.getAttribute('data-flavor') || '') !== ''; });
    jars.forEach(function(jar) {
      var tie = jar.getAttribute('data-flavor') || '';
      if (!anyTied) return;
      if (tie && tie === activeKey) {
        jar.classList.add('cq-fb__jar--pulse');
        jar.classList.remove('cq-fb__jar--dimmed');
        setTimeout(function() { jar.classList.remove('cq-fb__jar--pulse'); }, 900);
      } else if (tie && tie !== activeKey) {
        jar.classList.add('cq-fb__jar--dimmed');
      } else {
        jar.classList.remove('cq-fb__jar--dimmed');
      }
    });
  }

  if (fbConfig.enable_jars && fbConfig.enable_parallax && !reducedMotion && jars.length) {
    var strength = (fbConfig.parallax_strength || 35) / 100;
    var rect = null;
    function refreshRect() { rect = root.getBoundingClientRect(); }
    refreshRect();
    window.addEventListener('resize', refreshRect, { passive: true });
    window.addEventListener('scroll', refreshRect, { passive: true });

    root.addEventListener('mousemove', function(e) {
      if (!rect) refreshRect();
      var nx = ((e.clientX - rect.left) / rect.width) - 0.5;
      var ny = ((e.clientY - rect.top) / rect.height) - 0.5;
      parallaxTargetX = nx * 40 * strength;
      parallaxTargetY = ny * 24 * strength;
    }, { passive: true });

    root.addEventListener('mouseleave', function() {
      parallaxTargetX = 0;
      parallaxTargetY = 0;
    });

    function tick() {
      parallaxCurrentX += (parallaxTargetX - parallaxCurrentX) * 0.08;
      parallaxCurrentY += (parallaxTargetY - parallaxCurrentY) * 0.08;
      jars.forEach(function(jar) {
        var z = parseFloat(jar.getAttribute('data-z')) || 0;
        var depth = 1 + (z * 0.12);
        jar.style.setProperty('--parallax-x', (parallaxCurrentX * depth).toFixed(2) + 'px');
        jar.style.setProperty('--parallax-y', (parallaxCurrentY * depth).toFixed(2) + 'px');
      });
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  // --- Cursor glow ----------------------------------------------------------
  var cursorGlow = root.querySelector('[data-cq-fb-cursor]');
  if (cursorGlow && fbConfig.enable_cursor_glow && !reducedMotion) {
    var glowX = 0, glowY = 0, glowTargetX = 0, glowTargetY = 0;
    root.addEventListener('mouseenter', function() {
      root.setAttribute('data-cursor-visible', 'true');
    });
    root.addEventListener('mouseleave', function() {
      root.removeAttribute('data-cursor-visible');
    });
    root.addEventListener('mousemove', function(e) {
      var r = root.getBoundingClientRect();
      glowTargetX = e.clientX - r.left;
      glowTargetY = e.clientY - r.top;
    }, { passive: true });
    function glowTick() {
      glowX += (glowTargetX - glowX) * 0.12;
      glowY += (glowTargetY - glowY) * 0.12;
      cursorGlow.style.left = glowX + 'px';
      cursorGlow.style.top = glowY + 'px';
      requestAnimationFrame(glowTick);
    }
    requestAnimationFrame(glowTick);
  }

  // --- Particle engine ------------------------------------------------------
  var canvas = root.querySelector('[data-cq-fb-particles]');
  var particles = [];
  var particlesRunning = false;

  function drawShape(ctx, shape, size) {
    ctx.beginPath();
    switch (shape) {
      case 'leaf':
        // Mint leaf: pointed oval
        ctx.moveTo(0, -size);
        ctx.bezierCurveTo(size * 0.7, -size * 0.8, size * 0.6, size * 0.6, 0, size);
        ctx.bezierCurveTo(-size * 0.6, size * 0.6, -size * 0.7, -size * 0.8, 0, -size);
        ctx.closePath();
        ctx.fill();
        // vein
        ctx.save();
        ctx.strokeStyle = 'rgba(0,0,0,0.18)';
        ctx.lineWidth = Math.max(1, size * 0.06);
        ctx.beginPath();
        ctx.moveTo(0, -size * 0.9);
        ctx.lineTo(0, size * 0.9);
        ctx.stroke();
        ctx.restore();
        break;
      case 'berry':
        // Filled circle + highlight
        ctx.arc(0, 0, size, 0, Math.PI * 2);
        ctx.fill();
        ctx.save();
        ctx.fillStyle = 'rgba(255,255,255,0.35)';
        ctx.beginPath();
        ctx.arc(-size * 0.3, -size * 0.35, size * 0.22, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
        break;
      case 'petal':
        // Teardrop / petal
        ctx.moveTo(0, -size);
        ctx.bezierCurveTo(size * 0.9, -size * 0.3, size * 0.5, size, 0, size);
        ctx.bezierCurveTo(-size * 0.5, size, -size * 0.9, -size * 0.3, 0, -size);
        ctx.closePath();
        ctx.fill();
        break;
      case 'wedge':
        // Citrus wedge: pie slice
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, size, -Math.PI * 0.35, Math.PI * 0.35);
        ctx.closePath();
        ctx.fill();
        ctx.save();
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.lineWidth = Math.max(1, size * 0.08);
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(size * Math.cos(0), 0);
        ctx.stroke();
        ctx.restore();
        break;
      case 'crystal':
        // Hexagon
        for (var i = 0; i < 6; i++) {
          var a = (Math.PI / 3) * i - Math.PI / 2;
          var x = Math.cos(a) * size;
          var y = Math.sin(a) * size;
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.fill();
        break;
      case 'droplet':
        ctx.moveTo(0, -size);
        ctx.bezierCurveTo(size, -size * 0.2, size * 0.8, size, 0, size);
        ctx.bezierCurveTo(-size * 0.8, size, -size, -size * 0.2, 0, -size);
        ctx.closePath();
        ctx.fill();
        break;
      case 'circle':
      default:
        ctx.arc(0, 0, size, 0, Math.PI * 2);
        ctx.fill();
        break;
    }
  }

  function hexToRgba(hex, alpha) {
    if (!hex) return 'rgba(255,255,255,' + alpha + ')';
    var h = hex.replace('#', '');
    if (h.length === 3) h = h.split('').map(function(c) { return c + c; }).join('');
    var r = parseInt(h.substr(0, 2), 16);
    var g = parseInt(h.substr(2, 2), 16);
    var b = parseInt(h.substr(4, 2), 16);
    if (isNaN(r) || isNaN(g) || isNaN(b)) return 'rgba(255,255,255,' + alpha + ')';
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

  function particleConfigFor(flavor) {
    var preset = particlePresets && particlePresets[flavor.key];
    return {
      shape: (preset && preset.shape) || DEFAULT_SHAPE_MAP[flavor.key] || 'circle',
      color: (preset && preset.color) || flavor.accent || '#ffffff',
      densityMult: (preset && preset.density_mult) || 1,
      scaleMult: (preset && preset.scale_mult) || 1
    };
  }

  function setupParticles() {
    if (!canvas || !fbConfig.enable_particles || reducedMotion) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var w = 0, h = 0;
    var lastT = 0;
    var cfg = particleConfigFor(current);

    function resize() {
      var r = root.getBoundingClientRect();
      w = Math.max(320, r.width);
      h = Math.max(280, r.height);
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function makeParticle() {
      var baseSize = 7 + Math.random() * 16;
      return {
        x: Math.random() * w,
        y: h + Math.random() * 80,
        vx: (Math.random() - 0.5) * 0.25,
        vy: -(0.1 + Math.random() * 0.35) * (fbConfig.particle_speed / 60),
        rot: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.015,
        size: baseSize * cfg.scaleMult,
        alpha: 0.35 + Math.random() * 0.55,
        sway: Math.random() * Math.PI * 2,
        swaySpeed: 0.5 + Math.random() * 0.8,
        color: cfg.color,
        shape: cfg.shape,
        life: 0,
        maxLife: 18 + Math.random() * 14
      };
    }

    function spawnParticles() {
      var target = Math.round(fbConfig.particle_density * cfg.densityMult);
      target = Math.max(10, Math.min(target, 180));
      while (particles.length < target) particles.push(makeParticle());
      while (particles.length > target) particles.pop();
    }

    function rebuild() {
      cfg = particleConfigFor(current);
      // Gracefully fade over: mark existing for quick exit
      particles.forEach(function(p) { p.maxLife = Math.min(p.maxLife, p.life + 2.5); });
      // Spawn fresh particles for new color
      var extra = Math.round(fbConfig.particle_density * cfg.densityMult);
      for (var i = 0; i < extra; i++) particles.push(makeParticle());
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();
    spawnParticles();

    function frame(t) {
      if (!lastT) lastT = t;
      var dt = Math.min((t - lastT) / 1000, 0.06);
      lastT = t;

      ctx.clearRect(0, 0, w, h);

      for (var i = particles.length - 1; i >= 0; i--) {
        var p = particles[i];
        p.life += dt;
        p.sway += dt * p.swaySpeed;
        p.x += p.vx + Math.sin(p.sway) * 0.3;
        p.y += p.vy;
        p.rot += p.rotSpeed;

        var lifeProgress = p.life / p.maxLife;
        var alphaMul = 1;
        if (lifeProgress < 0.1) alphaMul = lifeProgress / 0.1;
        else if (lifeProgress > 0.85) alphaMul = Math.max(0, (1 - lifeProgress) / 0.15);

        if (p.y < -40 || p.life > p.maxLife || p.x < -60 || p.x > w + 60) {
          particles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = hexToRgba(p.color, p.alpha * alphaMul);
        drawShape(ctx, p.shape, p.size);
        ctx.restore();
      }

      // Top up particles to target
      var target = Math.round(fbConfig.particle_density * cfg.densityMult);
      target = Math.max(10, Math.min(target, 180));
      while (particles.length < target) particles.push(makeParticle());

      if (particlesRunning) requestAnimationFrame(frame);
    }

    particlesRunning = true;
    requestAnimationFrame(frame);

    // Expose rebuild to outer scope via closure
    root._cqFbRebuildParticles = rebuild;

    // Pause when out of viewport to save CPU
    if ('IntersectionObserver' in window) {
      var visIO = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting && !particlesRunning) {
            particlesRunning = true;
            lastT = 0;
            requestAnimationFrame(frame);
          } else if (!e.isIntersecting) {
            particlesRunning = false;
          }
        });
      }, { threshold: 0.05 });
      visIO.observe(root);
    }
  }

  // Hook applyFlavor to also rebuild particles + jar states
  var baseApplyFlavor = applyFlavor;
  applyFlavor = function(key) {
    baseApplyFlavor(key);
    updateJarFlavorStates(key);
    if (typeof root._cqFbRebuildParticles === 'function') {
      root._cqFbRebuildParticles();
    }
  };

  setupParticles();

  // Initialize with first flavor
  if (flavors[0]) applyFlavor(flavors[0].key);
})();
</script>

