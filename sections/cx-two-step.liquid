{%- comment -%}
  CALQIX Navy Rebuild — Two-step protocol explainer.
  Source: _incoming/calqix-web-upgrade/handoff/source/components/bundle.jsx → TwoStep
{%- endcomment -%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section cx-two-step-section" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-stack cx-section-header" data-cx-stagger>
      {% render 'cx-eyebrow', text: section.settings.eyebrow %}
      <h2 class="cx-h2">{{ section.settings.heading }}</h2>
      <div class="cx-lede">{{ section.settings.lede }}</div>
      {% render 'cx-section-cta', section: section %}
    </div>

    <div class="cx-two-step-grid" data-cx-col2 data-cx-stagger>
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <article class="cx-two-step-card" style="--cx-step-index: '{{ forloop.index }}';" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="cx-two-step-media">
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
                <span class="cx-two-step-media-sheen" aria-hidden="true"></span>
              </div>
            {%- else -%}
              {% render 'cx-placeholder', ratio: '16/9', label: block.settings.label, radius: 'var(--cx-r-md)' %}
            {%- endif -%}
            <div class="cx-two-step-copy">
              <div class="cx-two-step-label-row">
                <span class="cx-two-step-number">0{{ forloop.index }}</span>
                <div class="cx-eyebrow">{{ block.settings.step_label }}</div>
              </div>
              <h3 class="cx-h3 cx-two-step-title">{{ block.settings.title }}</h3>
              <div class="cx-two-step-desc">{{ block.settings.desc }}</div>
            </div>
            <div class="cx-two-step-stats">
              {%- for i in (1..3) -%}
                {%- assign v_key = 'stat_' | append: i | append: '_value' -%}
                {%- assign l_key = 'stat_' | append: i | append: '_label' -%}
                {%- assign stat_v = block.settings[v_key] -%}
                {%- assign stat_l = block.settings[l_key] -%}
                {%- if stat_v != blank -%}
                  <div class="cx-two-step-stat">
                    <div class="cx-two-step-stat-v">{{ stat_v }}</div>
                    <div class="cx-two-step-stat-label">{{ stat_l }}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .cx-two-step-section {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, #edf5ff 0%, #f7fbff 46%, #ffffff 100%),
      var(--cx-page);
  }
  .cx-two-step-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,37,73,0.038) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,37,73,0.038) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 82%, transparent 100%);
    pointer-events: none;
  }
  .cx-two-step-section::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 160px;
    width: min(62vw, 820px);
    height: min(62vw, 820px);
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,118,194,0.10) 0%, rgba(201,165,90,0.08) 28%, transparent 66%);
    filter: blur(12px);
    pointer-events: none;
  }
  .cx-two-step-section .cx-container {
    position: relative;
    z-index: 1;
  }
  .cx-two-step-section .cx-section-header {
    align-items: center;
    text-align: center;
    gap: 18px;
    margin-bottom: clamp(34px, 5vw, 58px);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .cx-two-step-section .cx-section-header .cx-h2 {
    max-width: 18ch;
    letter-spacing: 0;
    line-height: 0.98;
  }
  .cx-two-step-section .cx-section-header .cx-lede {
    max-width: 62ch;
    color: var(--cx-ink-soft);
    font-size: clamp(15.5px, 1.25vw, 19px);
    line-height: 1.58;
  }
  .cx-two-step-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 2.2vw, 28px);
  }
  .cx-two-step-grid::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 44px;
    bottom: 44px;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(0,67,129,0.24), rgba(201,165,90,0.44), transparent);
    transform: translateX(-50%) scaleY(0);
    transform-origin: top;
    transition: transform 1000ms var(--cx-ease-silk);
    pointer-events: none;
  }
  .cx-in .cx-two-step-grid::before,
  .cx-two-step-section.cx-in .cx-two-step-grid::before {
    transform: translateX(-50%) scaleY(1);
  }
  .cx-two-step-card {
    position: relative;
    isolation: isolate;
    border: 1px solid rgba(0,67,129,0.20);
    border-radius: 26px;
    padding: clamp(18px, 2.4vw, 30px);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.92) 0%, rgba(246,250,255,0.92) 58%, rgba(236,245,255,0.84) 100%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow:
      0 28px 82px -58px rgba(0,37,73,0.64),
      inset 0 1px 0 rgba(255,255,255,0.92);
    overflow: hidden;
    transform: translateY(0);
    transition:
      transform 440ms var(--cx-ease-silk),
      border-color 440ms var(--cx-ease-silk),
      box-shadow 440ms var(--cx-ease-silk);
  }
  .cx-two-step-card::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 25px;
    background:
      radial-gradient(circle at 18% 0%, rgba(255,255,255,0.94), transparent 34%),
      linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.46) 44%, transparent 58%);
    pointer-events: none;
    z-index: -1;
  }
  .cx-two-step-card::after {
    content: "";
    position: absolute;
    left: 28px;
    right: 28px;
    top: 0;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent 0%, var(--cx-gold) 28%, var(--cx-forest) 52%, transparent 100%);
    opacity: 0.7;
  }
  .cx-two-step-card:hover {
    transform: translate3d(0, -5px, 0);
    border-color: rgba(0,118,194,0.30);
    box-shadow:
      0 34px 92px -56px rgba(0,37,73,0.78),
      inset 0 1px 0 rgba(255,255,255,0.94);
  }
  .cx-two-step-media {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255,255,255,0.88), rgba(231,241,253,0.72));
    box-shadow: 0 18px 48px -38px rgba(0,37,73,0.52);
    aspect-ratio: 16 / 9;
  }
  .cx-two-step-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.01);
    transition:
      transform 760ms var(--cx-ease-silk),
      filter 760ms var(--cx-ease-silk);
  }
  .cx-two-step-card:hover .cx-two-step-media img {
    transform: scale(1.045);
    filter: saturate(1.04) contrast(1.03);
  }
  .cx-two-step-media-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 4%, rgba(255,255,255,0.36) 45%, transparent 64%);
    transform: translateX(-120%);
    transition: transform 900ms var(--cx-ease-lux);
    pointer-events: none;
  }
  .cx-two-step-card:hover .cx-two-step-media-sheen {
    transform: translateX(120%);
  }
  .cx-two-step-copy {
    display: grid;
    gap: 10px;
  }
  .cx-two-step-label-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cx-two-step-number {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cx-forest-3);
    color: #ffffff;
    font-family: var(--cx-f-display);
    font-size: 12px;
    line-height: 1;
    box-shadow: 0 0 0 7px rgba(0,37,73,0.08);
    flex: 0 0 auto;
  }
  .cx-two-step-title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.02;
  }
  .cx-two-step-desc {
    margin: 0;
    color: var(--cx-ink-soft);
    font-size: clamp(14.5px, 1.05vw, 16.5px);
    line-height: 1.58;
    max-width: 58ch;
  }
  .cx-two-step-desc p {
    margin: 0;
  }
  .cx-two-step-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid rgba(0,67,129,0.16);
  }
  .cx-two-step-stat {
    min-height: 74px;
    padding: 12px 10px;
    border: 1px solid rgba(0,67,129,0.10);
    border-radius: 16px;
    background: rgba(255,255,255,0.66);
    box-shadow: 0 14px 34px -30px rgba(0,37,73,0.48);
  }
  .cx-two-step-stat-v {
    font-family: var(--cx-f-display);
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 0.96;
    color: var(--cx-gold-ink);
    margin-bottom: 7px;
  }
  .cx-two-step-stat-label {
    color: var(--cx-ink-mute);
    font-family: var(--cx-f-mono);
    font-size: 9.5px;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .cx-two-step-grid {
      grid-template-columns: 1fr;
      max-width: 720px;
      margin: 0 auto;
    }
    .cx-two-step-grid::before {
      left: 27px;
      top: 30px;
      bottom: 30px;
      transform: scaleY(0);
    }
    .cx-in .cx-two-step-grid::before,
    .cx-two-step-section.cx-in .cx-two-step-grid::before {
      transform: scaleY(1);
    }
    .cx-two-step-card {
      margin-left: 22px;
    }
  }

  @media (max-width: 640px) {
    .cx-two-step-section {
      padding-top: 44px;
      padding-bottom: 46px;
    }
    .cx-two-step-section .cx-section-header {
      text-align: left;
      align-items: flex-start;
      margin-bottom: 28px;
    }
    .cx-two-step-section .cx-section-header .cx-h2 {
      max-width: 12ch;
      font-size: clamp(38px, 12vw, 56px);
    }
    .cx-two-step-grid {
      gap: 16px;
    }
    .cx-two-step-card {
      margin-left: 16px;
      border-radius: 20px;
      padding: 14px;
      gap: 15px;
    }
    .cx-two-step-card::after {
      left: 18px;
      right: 18px;
    }
    .cx-two-step-media {
      border-radius: 15px;
      aspect-ratio: 4 / 3;
    }
    .cx-two-step-label-row {
      align-items: flex-start;
    }
    .cx-two-step-number {
      width: 30px;
      height: 30px;
      font-size: 11px;
      box-shadow: 0 0 0 6px rgba(0,37,73,0.08);
    }
    .cx-two-step-title {
      max-width: none;
      font-size: clamp(26px, 8vw, 34px);
    }
    .cx-two-step-stats {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .cx-two-step-stat {
      min-height: 0;
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
    }
    .cx-two-step-stat-v {
      margin: 0;
      font-size: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-two-step-grid::before,
    .cx-two-step-card,
    .cx-two-step-media img,
    .cx-two-step-media-sheen {
      transition: none;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "CX Two-step",
  "tag": "section",
  "class": "cx-section-two-step",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The CALQIX protocol" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Two steps. <em>One outcome.</em></p>" },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>Flowcore cleans where your toothbrush can't reach. OralBiome Pro rebuilds the enamel surface. The protocol only works when both steps work together.</p>" },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" },

    { "type": "header", "content": "Button (optional)" },
    { "type": "text", "id": "btn_text", "label": "Button text" },
    { "type": "url", "id": "btn_url", "label": "Button link" },
    {
      "type": "select", "id": "btn_style", "label": "Button style",
      "default": "inline",
      "options": [
        { "value": "gold",   "label": "Gold (filled)" },
        { "value": "navy",   "label": "Navy (filled)" },
        { "value": "ghost",  "label": "Outline" },
        { "value": "inline", "label": "Inline arrow" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "step_label", "label": "Step label", "default": "STEP 01 · EVENING RITUAL" },
        { "type": "text", "id": "title", "label": "Title", "default": "First, clean deeply" },
        { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Flowcore delivers 1,600 micro-pulses per minute along the gumline — the precision jet reaches 6mm below the gumline where your brush stops.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "label", "label": "Placeholder label", "default": "FLOWCORE IRRIGATOR" },

        { "type": "header", "content": "Stat 1" },
        { "type": "text", "id": "stat_1_value", "label": "Value", "default": "1,600" },
        { "type": "text", "id": "stat_1_label", "label": "Label", "default": "Pulses/min" },

        { "type": "header", "content": "Stat 2" },
        { "type": "text", "id": "stat_2_value", "label": "Value", "default": "6 mm" },
        { "type": "text", "id": "stat_2_label", "label": "Label", "default": "Below the gumline" },

        { "type": "header", "content": "Stat 3" },
        { "type": "text", "id": "stat_3_value", "label": "Value", "default": "3" },
        { "type": "text", "id": "stat_3_label", "label": "Label", "default": "Clinical modes" }
      ]
    }
  ],
  "max_blocks": 2,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "step", "settings": {} },
      { "type": "step", "settings": {
          "step_label": "STEP 02 · IMMEDIATELY AFTER",
          "title": "Then rebuild",
          "desc": "<p>Nano-hydroxyapatite binds directly to the now-clean enamel surface. Peer-reviewed studies show on average 40% less sensitivity after 4 weeks.</p>",
          "label": "ORALBIOME PRO · TABS",
          "stat_1_value": "20–50", "stat_1_label": "nm particle size",
          "stat_2_value": "40%",   "stat_2_label": "Less sensitivity",
          "stat_3_value": "28",    "stat_3_label": "Days to visible"
      } }
    ]
  }
}
{% endschema %}
