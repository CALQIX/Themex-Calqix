        ${review.verified ? `<span class="cqr-verified"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>${escapeHtml(verifiedLabel)}</span>` : ''}
        <div class="cqr-stars">${buildStars(review.stars || 5)}</div>
        ${tag ? `<span class="cqr-tag">${escapeHtml(tag)}</span>` : ''}
        <span class="cqr-quote-mark">"</span>
        <p class="cqr-body">${escapeHtml(body)}</p>
        <div class="cqr-author">
          <div class="cqr-avatar">${escapeHtml((review.name || '').slice(0, 1))}</div>
          <div>
            <span class="cqr-name">${escapeHtml(review.name)}</span>
            <span class="cqr-date">${escapeHtml(date)}</span>
          </div>
        </div>
      </div>
    `;
  }

  let cards = [];
  let cur = 0;
  let drag = false;
  let sx = 0;
  let dx = 0;
  let activeFilter = 'all';

  const getVis = () => {
    const width = track.parentElement.offsetWidth;
    return width < 480 ? 1 : width < 820 ? 2 : 3;
  };
  const getW = () => cards[0] ? cards[0].offsetWidth + 20 : 380;
  const maxIdx = () => Math.max(0, cards.length - getVis());

  function goTo(index) {
    cur = Math.max(0, Math.min(index, maxIdx()));
    track.style.transform = `translateX(-${cur * getW()}px)`;
    if (dotsEl) dotsEl.querySelectorAll('.cqr-dot').forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === cur));
    if (prev) prev.disabled = cur === 0;
    if (next) next.disabled = cur >= maxIdx();
  }

  function buildDots() {
    if (!dotsEl) return;
    dotsEl.innerHTML = '';
    for (let i = 0; i <= maxIdx(); i++) {
      const button = document.createElement('button');
      button.className = 'cqr-dot' + (i === cur ? ' active' : '');
      button.addEventListener('click', () => goTo(i));
      dotsEl.appendChild(button);
    }
  }

  function getFilteredReviews(filter) {
    let reviews = localizedContent.reviews.slice();

    if (filter === 'recent') {
      reviews.sort((a, b) => String(b.sortValue || '').localeCompare(String(a.sortValue || '')));
      return reviews;
    }

    if (filter !== 'all') {
      reviews = reviews.filter((review) => review.filter === filter);
    }

    return reviews;
  }

  function renderCards(filter) {
    const reviews = getFilteredReviews(filter);
    track.innerHTML = reviews.map((review) => buildReviewCard(review)).join('');
    cards = Array.from(track.querySelectorAll('.cqr-card'));
    cur = 0;
    buildDots();
    goTo(0);
  }

  if (prev) prev.addEventListener('click', () => goTo(cur - 1));
  if (next) next.addEventListener('click', () => goTo(cur + 1));

  if (filters) {
    filters.querySelectorAll('.cqr-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.filter || 'all';
        filters.querySelectorAll('.cqr-filter').forEach((item) => item.classList.remove('active'));
        btn.classList.add('active');
        renderCards(activeFilter);
      });
    });
  }

  track.addEventListener('mousedown', (event) => {
    drag = true;
    sx = event.clientX;
    track.style.transition = 'none';
  });
  window.addEventListener('mousemove', (event) => {
    if (!drag) return;
    dx = event.clientX - sx;
    track.style.transform = `translateX(${-cur * getW() + dx}px)`;
  });
  window.addEventListener('mouseup', () => {
    if (!drag) return;
    drag = false;
    track.style.transition = '';
    dx < -60 ? goTo(cur + 1) : dx > 60 ? goTo(cur - 1) : goTo(cur);
    dx = 0;
  });
  track.addEventListener('touchstart', (event) => {
    drag = true;
    sx = event.touches[0].clientX;
    track.style.transition = 'none';
  }, { passive: true });
  track.addEventListener('touchmove', (event) => {
    if (!drag) return;
    dx = event.touches[0].clientX - sx;
    track.style.transform = `translateX(${-cur * getW() + dx}px)`;
  }, { passive: true });
  track.addEventListener('touchend', () => {
    if (!drag) return;
    drag = false;
    track.style.transition = '';
    dx < -50 ? goTo(cur + 1) : dx > 50 ? goTo(cur - 1) : goTo(cur);
    dx = 0;
  });

  renderAggregate();
  renderFilters();
  renderCards(activeFilter);
  window.addEventListener('resize', () => {
    buildDots();
    goTo(Math.min(cur, maxIdx()));
  });
})();
</script>

