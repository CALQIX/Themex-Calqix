  if (!scope || !track) return;

  const titlePlainEl = scope.querySelector('.cqr-title-plain');
  const titleItalicEl = scope.querySelector('.cqr-title-italic');
  const eyebrowEl = scope.querySelector('.cqr-eyebrow');
  const reviewCountNumberEl = scope.querySelector('.cqr-agg-count-number');
  const reviewCountLabelEl = scope.querySelector('.cqr-agg-count-label');
  const AVG = parseFloat(localizedContent.sectionSettings.avgScore || '{{ section.settings.avg_score }}') || 5;

  function localizedValue(value) {
    if (Array.isArray(value)) return value;
    if (!value || typeof value !== 'object') return value || '';
    return value[activeLocale] || value.en || '';
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderAggregate() {
    if (eyebrowEl) eyebrowEl.textContent = localizedValue(localizedContent.sectionSettings.eyebrow);
    if (titlePlainEl) titlePlainEl.textContent = localizedValue(localizedContent.sectionSettings.titlePlain);
    if (titleItalicEl) titleItalicEl.textContent = localizedValue(localizedContent.sectionSettings.titleItalic);
    if (reviewCountNumberEl) reviewCountNumberEl.textContent = localizedContent.sectionSettings.reviewCount;
    if (reviewCountLabelEl) reviewCountLabelEl.textContent = localizedValue(localizedContent.sectionSettings.reviewLabel);

    if (aggEl) {
      aggEl.innerHTML = '';
      for (let i = 1; i <= 5; i++) {
        const sv = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        sv.setAttribute('viewBox', '0 0 24 24');
        sv.setAttribute('width', '14');
        sv.setAttribute('height', '14');
        sv.style.fill = i <= Math.round(AVG) ? '{{ color_star }}' : '{{ color_star | color_modify: "alpha", 0.2 }}';
        sv.innerHTML = '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>';
        aggEl.appendChild(sv);
      }
    }
  }

  function renderFilters() {
    if (!filters) return;
    const labels = localizedValue(localizedContent.sectionSettings.filterTabs);
    filters.querySelectorAll('.cqr-filter').forEach((btn, index) => {
      btn.textContent = labels[index] || btn.textContent;
      btn.dataset.filter = filterKeys[index] || btn.dataset.filter || 'all';
    });
  }

  function buildStars(rating) {
    let starsHtml = '';
    for (let i = 1; i <= 5; i++) {
      starsHtml += `<svg class="cqr-star${i <= rating ? '' : ' empty'}" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>`;
    }
    return starsHtml;
  }

  function buildReviewCard(review) {
    const verifiedLabel = localizedValue(localizedContent.sectionSettings.verifiedLabel);
    const tag = localizedValue(review.tag);
