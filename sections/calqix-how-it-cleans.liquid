                {% if section.settings.show_svg_annotations %}
                  {% case chc_annotation_type %}
                    {% when 'angle' %}
                      <svg class="chc-overlay chc-overlay--angle" viewBox="0 0 420 420" aria-hidden="true" focusable="false">
                        <path class="chc-angle-path" pathLength="100" d="M 150 252 A 70 70 0 0 1 220 182"></path>
                        <text class="chc-angle-label" x="232" y="176">90°</text>
                      </svg>
                    {% when 'stream' %}
                      <svg class="chc-overlay chc-overlay--stream" viewBox="0 0 420 420" aria-hidden="true" focusable="false">
                        <path class="chc-stream-line" d="M 210 84 L 210 256"></path>
                        <path class="chc-stream-flow" d="M 210 92 L 210 248"></path>
                        <line class="chc-depth-line" x1="118" y1="278" x2="282" y2="278"></line>
