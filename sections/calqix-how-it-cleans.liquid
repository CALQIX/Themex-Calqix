                        <circle class="chc-pulse-ring chc-pulse-ring--2" cx="210" cy="210" r="30"></circle>
                        <circle class="chc-pulse-ring chc-pulse-ring--3" cx="210" cy="210" r="30"></circle>
                      </svg>
                  {% endcase %}
                {% endif %}
