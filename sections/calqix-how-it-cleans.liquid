                      </svg>
                    {% when 'particles' %}
                      <svg class="chc-overlay chc-overlay--particles" viewBox="0 0 420 420" aria-hidden="true" focusable="false">
                        <circle class="chc-particle chc-particle--1" cx="210" cy="190" r="4"></circle>
                        <circle class="chc-particle chc-particle--2" cx="210" cy="190" r="4"></circle>
                        <circle class="chc-particle chc-particle--3" cx="210" cy="190" r="4"></circle>
                      </svg>
                    {% when 'pulse' %}
                      <svg class="chc-overlay chc-overlay--pulse" viewBox="0 0 420 420" aria-hidden="true" focusable="false">
