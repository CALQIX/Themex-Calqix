{%- comment -%}
  CALQIX FlowCore — How It Cleans section
  Version: 2.0
  Schema: fully editable via Shopify theme editor
  Last updated: {{ 'now' | date: '%Y-%m-%d' }}
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} {
    --chc-section-bg: {{ section.settings.section_background_color }};
    --chc-heading-color: {{ section.settings.heading_color }};
    --chc-eyebrow-color: {{ section.settings.eyebrow_color }};
    --chc-pill-active-bg: {{ section.settings.pill_active_bg }};
    --chc-pill-active-text: {{ section.settings.pill_active_text }};
    --chc-pill-inactive-bg: {{ section.settings.pill_inactive_bg }};
    --chc-pill-inactive-text: {{ section.settings.pill_inactive_text }};
    --chc-image-max-width: {{ section.settings.image_max_width }}px;
    --chc-image-frame-bg: {{ section.settings.image_background_color }};
    --chc-image-radius: {{ section.settings.image_border_radius }}px;
    --chc-annotation-color: {{ section.settings.annotation_color }};
    --chc-callout-bg: {{ section.settings.callout_background }};
    --chc-callout-border: {{ section.settings.callout_border_color }};
    --chc-callout-text: {{ section.settings.callout_text_color }};
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} {
    background: var(--chc-section-bg);
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} *,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-shell {
    width: min(100%, 1200px);
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-label {
    margin: 0;
    text-align: center;
    font-family: "DM Sans", sans-serif;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chc-eyebrow-color);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-heading {
    margin: 8px auto 48px;
    max-width: 760px;
    text-align: center;
    font-family: "DM Serif Display", serif;
    font-size: 36px;
    line-height: 1.1;
    font-weight: 400;
    color: var(--chc-heading-color);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-nav {
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-nav-track {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding-bottom: 14px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pill {
    position: relative;
    z-index: 1;
    border: 0;
    border-radius: 20px;
    padding: 8px 20px;
    background: var(--chc-pill-inactive-bg);
    color: var(--chc-pill-inactive-text);
    font-family: "DM Sans", sans-serif;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pill:hover:not(.is-active),
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pill:focus-visible:not(.is-active) {
    background: rgba(201, 168, 76, 0.12);
    color: #1A3B5C;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pill:focus-visible,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-progress-dot:focus-visible,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta:focus-visible {
    outline: 2px solid var(--chc-annotation-color);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pill.is-active {
    background: var(--chc-pill-active-bg);
    color: var(--chc-pill-active-text);
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(201, 168, 76, 0.25);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pill-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 999px;
    background: #C9A84C;
    opacity: 0;
    transform: translateX(0);
    transition: transform 200ms ease, width 200ms ease, opacity 200ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stage {
    display: grid;
    align-items: start;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel {
    position: relative;
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, var(--chc-image-max-width)) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing {
    visibility: visible;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 250ms ease-out, transform 250ms ease-out, visibility 0ms linear;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 150ms ease-in, transform 150ms ease-in, visibility 0ms linear;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-media-slot,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-copy-slot {
    opacity: 0;
    transform: translateY(12px);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-media-slot {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 250ms ease-out, transform 250ms ease-out;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-copy-slot {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 250ms ease-out 60ms, transform 250ms ease-out 60ms;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-media-slot,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-copy-slot {
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 150ms ease-in, transform 150ms ease-in;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-media-frame {
    position: relative;
    overflow: visible;
    width: 100%;
    max-width: var(--chc-image-max-width);
    margin: 0 auto;
    padding: 24px;
    border: 1px solid rgba(26, 59, 92, 0.08);
    border-radius: var(--chc-image-radius);
    background: var(--chc-image-frame-bg);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-media-frame:hover {
    border-color: rgba(201, 168, 76, 0.4);
    box-shadow: 0 8px 32px rgba(26, 59, 92, 0.08);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-image {
    display: block;
    width: 100%;
    max-width: calc(var(--chc-image-max-width) - 48px);
    max-height: calc(var(--chc-image-max-width) - 48px);
    margin: 0 auto;
    height: auto;
    object-fit: contain;
    transform: scale(1);
    transform-origin: center;
    transition: transform 300ms ease;
    will-change: auto;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-media-frame:hover .chc-image {
    transform: scale(1.02);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-copy-slot {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-step-label {
    display: inline-flex;
    flex-wrap: wrap;
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--chc-eyebrow-color);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-step-char {
    display: inline-block;
    opacity: 1;
    transform: translateY(0);
    will-change: auto;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-title {
    margin: 6px 0 0;
    font-family: "DM Serif Display", serif;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 400;
    color: var(--chc-heading-color);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body {
    margin-top: 18px;
    font-family: "DM Sans", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #4B5563;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body p {
    margin: 0 0 14px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body ul,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body ol {
    margin: 0 0 14px;
    padding-left: 22px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-body li + li {
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-callout {
    position: relative;
    margin-top: 20px;
    padding: 14px 16px 14px 20px;
    border-radius: 6px;
    background: var(--chc-callout-bg);
    color: var(--chc-callout-text);
    font-family: "DM Sans", sans-serif;
    font-size: 13px;
    line-height: 1.65;
    font-style: italic;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 350ms ease-out 260ms, transform 350ms ease-out 260ms, filter 150ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-callout::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 999px;
    background: var(--chc-callout-border);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 300ms ease-out 260ms;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-callout {
    opacity: 1;
    transform: translateX(0);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-callout::before {
    transform: scaleY(1);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-callout:hover {
    filter: brightness(1.02);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
    border-radius: 6px;
    padding: 14px 28px;
    border: none;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    text-decoration: none;
    transform: translateY(0);
    transition: background-color 250ms ease, color 250ms ease, border-color 250ms ease, box-shadow 250ms ease, transform 250ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(26, 59, 92, 0.15);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta:active {
    transform: translateY(0);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta--navy {
    background: #1A3B5C;
    color: #FFFFFF;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta--navy:hover {
    background: #C9A84C;
    color: #1A3B5C;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta--gold {
    background: #C9A84C;
    color: #1A3B5C;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta--gold:hover {
    background: #b8963f;
    color: #1A3B5C;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta--outline {
    background: transparent;
    color: #1A3B5C;
    border: 1.5px solid #1A3B5C;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-cta--outline:hover {
    background: #1A3B5C;
    color: #FFFFFF;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-angle-path,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stream-line,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stream-flow,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-depth-line,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-particle,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pulse-ring {
    stroke: var(--chc-annotation-color);
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-angle-path {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-angle-label,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-depth-label {
    font-family: "DM Sans", sans-serif;
    font-size: 11px;
    fill: var(--chc-annotation-color);
    opacity: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stream-line,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stream-flow,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-depth-line {
    fill: none;
    stroke-linecap: round;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stream-line {
    stroke-width: 1.5;
    stroke-dasharray: 170;
    stroke-dashoffset: 170;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-stream-flow {
    stroke-width: 2;
    stroke-dasharray: 6 30;
    stroke-dashoffset: 0;
    opacity: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-depth-line {
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-particle {
    fill: var(--chc-annotation-color);
    stroke: none;
    opacity: 0;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-pulse-ring {
    fill: none;
    stroke-width: 1.5;
    opacity: 0;
  }

  @keyframes chc-angle-draw {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes chc-angle-hide {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: 100;
    }
  }

  @keyframes chc-stream-draw {
    from {
      stroke-dashoffset: 170;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes chc-stream-flow {
    from {
      stroke-dashoffset: 72;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes chc-particle-a {
    0% {
      transform: translate(0, 0);
      opacity: 1;
    }
    69% {
      opacity: 0;
    }
    100% {
      transform: translate(-24px, -10px);
      opacity: 0;
    }
  }

  @keyframes chc-particle-b {
    0% {
      transform: translate(0, 0);
      opacity: 1;
    }
    69% {
      opacity: 0;
    }
    100% {
      transform: translate(-20px, 16px);
      opacity: 0;
    }
  }

  @keyframes chc-particle-c {
    0% {
      transform: translate(0, 0);
      opacity: 1;
    }
    69% {
      opacity: 0;
    }
    100% {
      transform: translate(24px, 14px);
      opacity: 0;
    }
  }

  @keyframes calqix-pulse {
    0% {
      r: 30;
      opacity: 0.4;
    }
    100% {
      r: 100;
      opacity: 0;
    }
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--angle .chc-angle-path {
    animation: chc-angle-draw 600ms ease-out forwards;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--angle .chc-angle-label {
    opacity: 1;
    transition: opacity 200ms ease 500ms;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-overlay--angle .chc-angle-path {
    animation: chc-angle-hide 300ms ease-in forwards;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-overlay--angle .chc-angle-label {
    opacity: 0;
    transition: opacity 200ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--stream .chc-stream-line {
    animation: chc-stream-draw 800ms ease-in-out forwards;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--stream .chc-depth-line,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--stream .chc-depth-label {
    opacity: 1;
    transition: opacity 200ms ease 800ms;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--stream .chc-stream-flow {
    opacity: 1;
    animation: chc-stream-flow 1.2s linear 800ms infinite;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-overlay--stream .chc-stream-flow,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-overlay--stream .chc-depth-line,
  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-overlay--stream .chc-depth-label {
    opacity: 0;
    animation: none;
    transition: opacity 200ms ease;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--particles .chc-particle--1 {
    animation: chc-particle-a 1300ms ease-out infinite;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--particles .chc-particle--2 {
    animation: chc-particle-b 1300ms ease-out 250ms infinite;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-active .chc-overlay--particles .chc-particle--3 {
    animation: chc-particle-c 1300ms ease-out 450ms infinite;
  }

  #shopify-section-{{ section.id }} #calqix-how-it-cleans-{{ section.id }} .chc-panel.is-outgoing .chc-overlay--particles .chc-particle {
    animation: none;
    opacity: 0;
