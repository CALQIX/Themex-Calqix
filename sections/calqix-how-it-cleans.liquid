<script>
  (function() {
    var root = document.getElementById('calqix-how-it-cleans-{{ section.id }}');
    if (!root || root.dataset.chcInitialized === 'true') return;
    root.dataset.chcInitialized = 'true';

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var indicator = root.querySelector('.chc-pill-indicator');
    var pills = Array.prototype.slice.call(root.querySelectorAll('.chc-pill'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.chc-progress-dot'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('.chc-panel'));
    var autoAdvanceEnabled = {{ section.settings.auto_advance | json }};
    var autoAdvanceDelay = {{ section.settings.auto_advance_delay | times: 1000 | json }};
    var activeIndex = 0;
    var isTransitioning = false;
    var autoTimer = null;

    if (!pills.length || !panels.length) return;

    function setTemporaryWillChange(element, value, duration) {
      if (!element) return;
      if (element._chcWillChangeTimer) window.clearTimeout(element._chcWillChangeTimer);
      element.style.willChange = value;
      if (typeof duration === 'number') {
        element._chcWillChangeTimer = window.setTimeout(function() {
          element.style.willChange = 'auto';
        }, duration);
      }
    }

    function splitStepLabel(panel) {
      var label = panel.querySelector('.chc-step-label');
      if (!label || label.dataset.chcSplit === 'true') return;
      var text = label.textContent || '';
      label.dataset.chcSplit = 'true';
      label.setAttribute('aria-label', text);
      label.textContent = '';
      Array.prototype.forEach.call(text.split(''), function(character) {
        var span = document.createElement('span');
        span.className = 'chc-step-char';
        span.textContent = character === ' ' ? '\u00A0' : character;
        label.appendChild(span);
      });
    }

    function animateStepLabel(panel) {
      if (prefersReducedMotion) return;
      var chars = Array.prototype.slice.call(panel.querySelectorAll('.chc-step-char'));
      if (!chars.length) return;
      chars.forEach(function(char) {
        char.style.transition = 'none';
        char.style.opacity = '0';
        char.style.transform = 'translateY(4px)';
      });
      window.requestAnimationFrame(function() {
        chars.forEach(function(char, index) {
          setTemporaryWillChange(char, 'transform', 220 + (index * 30));
          char.style.transition = 'opacity 150ms ease, transform 150ms ease';
          char.style.transitionDelay = (index * 30) + 'ms';
          char.style.opacity = '1';
          char.style.transform = 'translateY(0)';
        });
      });
    }

    function updateIndicator(immediate) {
      if (!indicator || window.innerWidth < 640) {
        if (indicator) indicator.style.opacity = '0';
        return;
      }
      var activePill = pills[activeIndex];
      if (!activePill) return;
      if (immediate || prefersReducedMotion) {
        indicator.style.transition = 'none';
      } else {
        indicator.style.transition = 'transform 200ms ease, width 200ms ease, opacity 200ms ease';
      }
      indicator.style.width = activePill.offsetWidth + 'px';
      indicator.style.transform = 'translateX(' + activePill.offsetLeft + 'px)';
      indicator.style.opacity = '1';
      if (immediate || prefersReducedMotion) {
        window.requestAnimationFrame(function() {
          indicator.style.transition = 'transform 200ms ease, width 200ms ease, opacity 200ms ease';
        });
      }
    }

    function updateControls(index) {
      pills.forEach(function(pill, pillIndex) {
        var isActive = pillIndex === index;
        pill.classList.toggle('is-active', isActive);
        pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
        pill.setAttribute('tabindex', isActive ? '0' : '-1');
      });
      dots.forEach(function(dot, dotIndex) {
        var isActive = dotIndex === index;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      activeIndex = index;
      updateIndicator(false);
    }

    function normalisePanels() {
      panels.forEach(function(panel, index) {
        splitStepLabel(panel);
        var shouldBeActive = index === 0;
        panel.classList.toggle('is-active', shouldBeActive);
        panel.classList.remove('is-outgoing');
        panel.setAttribute('aria-hidden', shouldBeActive ? 'false' : 'true');
        panel.tabIndex = shouldBeActive ? 0 : -1;
      });
      updateControls(0);
      updateIndicator(true);
    }

    function stopAutoAdvance() {
      if (autoTimer) {
        window.clearTimeout(autoTimer);
        autoTimer = null;
      }
    }

    function startAutoAdvance() {
      if (!autoAdvanceEnabled || prefersReducedMotion || panels.length < 2 || isTransitioning) return;
      stopAutoAdvance();
      autoTimer = window.setTimeout(function() {
        transitionTo((activeIndex + 1) % panels.length);
      }, autoAdvanceDelay);
    }

    function activateImageForAnimation(panel) {
      if (prefersReducedMotion) return;
      var image = panel.querySelector('.chc-image');
      setTemporaryWillChange(image, 'transform', 340);
    }

    function transitionTo(index) {
      if (index === activeIndex || isTransitioning || !panels[index]) return;
      isTransitioning = true;
      stopAutoAdvance();

      var currentPanel = panels[activeIndex];
      var nextPanel = panels[index];
      var outgoingDuration = prefersReducedMotion ? 0 : 150;
      var incomingDuration = prefersReducedMotion ? 0 : 250;

      currentPanel.classList.remove('is-active');
      currentPanel.classList.add('is-outgoing');
      currentPanel.setAttribute('aria-hidden', 'true');
      currentPanel.tabIndex = -1;
      updateControls(index);

      window.setTimeout(function() {
        panels.forEach(function(panel, panelIndex) {
          if (panelIndex !== index) {
            panel.classList.remove('is-active');
            panel.classList.remove('is-outgoing');
            panel.setAttribute('aria-hidden', 'true');
            panel.tabIndex = -1;
          }
        });
        nextPanel.classList.add('is-active');
        nextPanel.classList.remove('is-outgoing');
        nextPanel.setAttribute('aria-hidden', 'false');
        nextPanel.tabIndex = 0;
        activeIndex = index;
        activateImageForAnimation(nextPanel);
        animateStepLabel(nextPanel);
        window.setTimeout(function() {
          isTransitioning = false;
          startAutoAdvance();
        }, incomingDuration + 120);
      }, outgoingDuration);
    }

    function bindHoverWillChange() {
      Array.prototype.slice.call(root.querySelectorAll('.chc-media-frame')).forEach(function(frame) {
        var image = frame.querySelector('.chc-image');
        if (!image) return;
        frame.addEventListener('mouseenter', function() {
          if (prefersReducedMotion) return;
          setTemporaryWillChange(image, 'transform');
        });
        frame.addEventListener('mouseleave', function() {
          if (image._chcWillChangeTimer) window.clearTimeout(image._chcWillChangeTimer);
          image._chcWillChangeTimer = window.setTimeout(function() {
            image.style.willChange = 'auto';
          }, 320);
        });
      });
    }

    function focusPill(index) {
      if (pills[index]) pills[index].focus();
    }

    pills.forEach(function(pill, index) {
      pill.addEventListener('click', function() {
        transitionTo(index);
      });
      pill.addEventListener('keydown', function(event) {
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          focusPill((index + 1) % pills.length);
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          focusPill((index - 1 + pills.length) % pills.length);
        } else if (event.key === 'Home') {
          event.preventDefault();
          focusPill(0);
        } else if (event.key === 'End') {
          event.preventDefault();
          focusPill(pills.length - 1);
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          transitionTo(index);
        }
      });
    });

    dots.forEach(function(dot, index) {
      dot.addEventListener('click', function() {
        transitionTo(index);
      });
    });

    window.addEventListener('resize', function() {
      updateIndicator(true);
    });

    normalisePanels();
    bindHoverWillChange();
    startAutoAdvance();
  })();
</script>
