<style>
  .ob-ingr {
    background: #0F2233;
    padding: 48px 0;
    overflow: hidden;
  }
  .ob-ingr__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-ingr__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .ob-ingr__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C9A84C;
    margin: 0 0 12px;
  }
  .ob-ingr__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.3;
  }
  .ob-ingr__carousel-wrap {
    position: relative;
  }
  .ob-ingr__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding-bottom: 4px;
  }
  .ob-ingr__track::-webkit-scrollbar { display: none; }
  .ob-ingr__card {
    flex: 0 0 calc(85% - 8px);
    min-width: 260px;
    background: rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 24px;
    scroll-snap-align: start;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .ob-ingr__card-image {
    width: 100px;
    height: 100px;
    margin: 0 auto 16px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ob-ingr__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ob-ingr__card-image svg {
    width: 48px;
    height: 48px;
  }
  .ob-ingr__card-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px;
    text-align: center;
  }
  .ob-ingr__card-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    margin: 0;
    flex: 1;
    text-align: center;
  }
  .ob-ingr__card-dose {
    display: inline-block;
    background: #C9A84C;
    color: #1A3B5C;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 50px;
    margin-top: 16px;
    align-self: center;
  }
  .ob-ingr__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #C9A84C;
    border: none;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.2s ease;
  }
  .ob-ingr__arrow:hover { background: #b8953f; }
  .ob-ingr__arrow svg { width: 18px; height: 18px; }
  .ob-ingr__arrow--prev { left: -16px; }
  .ob-ingr__arrow--next { right: -16px; }

  @media (min-width: 768px) {
    .ob-ingr__card { flex: 0 0 calc(33.33% - 11px); min-width: 260px; }
    .ob-ingr__arrow { display: flex; }
  }
  @media (min-width: 1024px) {
    .ob-ingr { padding: 80px 0; }
    .ob-ingr__heading { font-size: 36px; }
    .ob-ingr__card { flex: 0 0 calc(28% - 12px); }
    .ob-ingr__card-image { width: 120px; height: 120px; }
  }
</style>

<section class="ob-ingr" data-section-id="{{ section.id }}">
  <div class="ob-ingr__container">
    <div class="ob-ingr__header">
      <p class="ob-ingr__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ob-ingr__heading">{{ section.settings.heading }}</h2>
    </div>
    <div class="ob-ingr__carousel-wrap">
      <button type="button" class="ob-ingr__arrow ob-ingr__arrow--prev" aria-label="{{ section.settings.prev_label }}">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 4L6 9l5 5" stroke="#1A3B5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="ob-ingr__track">
        {%- for block in section.blocks -%}
          <div class="ob-ingr__card" {{ block.shopify_attributes }}>
            <div class="ob-ingr__card-image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 240 }}"
                  alt="{{ block.settings.name | escape }}"
                  loading="lazy"
                  width="120"
                  height="120"
                >
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="16" stroke="#C9A84C" stroke-width="1.5" stroke-dasharray="4 3"/><circle cx="24" cy="24" r="4" fill="#C9A84C" opacity="0.5"/></svg>
              {%- endif -%}
            </div>
            <h3 class="ob-ingr__card-name">{{ block.settings.name }}</h3>
            <p class="ob-ingr__card-desc">{{ block.settings.description }}</p>
            {%- if block.settings.dosage != blank -%}
              <span class="ob-ingr__card-dose">{{ block.settings.dosage }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <button type="button" class="ob-ingr__arrow ob-ingr__arrow--next" aria-label="{{ section.settings.next_label }}">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 4l5 5-5 5" stroke="#1A3B5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var track = section.querySelector('.ob-ingr__track');
    var prevBtn = section.querySelector('.ob-ingr__arrow--prev');
    var nextBtn = section.querySelector('.ob-ingr__arrow--next');
    if (!track) return;
    var scrollAmount = 300;
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "OB Ingredients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PREMIUM INGREDIENTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It\u2019s what\u2019s on the inside that counts." },
    { "type": "text", "id": "prev_label", "label": "Previous arrow label", "default": "Previous ingredient" },
    { "type": "text", "id": "next_label", "label": "Next arrow label", "default": "Next ingredient" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Description of the ingredient." },
        { "type": "text", "id": "dosage", "label": "Dosage badge", "default": "100M CFU" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "L. reuteri DSM 17938", "description": "The world\u2019s most studied oral probiotic strain. Colonizes the oral cavity and reduces harmful pathogens.", "dosage": "100M CFU" } },
        { "type": "ingredient", "settings": { "name": "L. reuteri ATCC PTA 5289", "description": "Works synergistically with DSM 17938 to support gum health and reduce inflammation.", "dosage": "100M CFU" } },
        { "type": "ingredient", "settings": { "name": "S. salivarius K12 (BLIS K12)", "description": "Produces antimicrobial peptides that target bacteria causing bad breath and throat infections.", "dosage": "1B CFU" } },
        { "type": "ingredient", "settings": { "name": "S. salivarius M18 (BLIS M18)", "description": "Produces urease and dextranase enzymes that neutralize pH and break down plaque.", "dosage": "500M CFU" } },
        { "type": "ingredient", "settings": { "name": "Xylitol", "description": "Natural sweetener that actively inhibits cavity-causing Streptococcus mutans bacteria.", "dosage": "500mg" } },
        { "type": "ingredient", "settings": { "name": "Natural Peppermint", "description": "Clean, refreshing taste without artificial flavors or sweeteners.", "dosage": "q.s." } }
      ]
    }
  ]
}
{% endschema %}
