<style>
  .ob-ingr {
    background: #0F2233;
    padding: 48px 0;
    overflow: hidden;
  }
  .ob-ingr__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-ingr__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .ob-ingr__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C9A84C;
    margin: 0 0 12px;
  }
  .ob-ingr__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.3;
  }
  .ob-ingr__carousel-wrap {
    position: relative;
  }
  .ob-ingr__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding-bottom: 4px;
  }
  .ob-ingr__track::-webkit-scrollbar { display: none; }
  .ob-ingr__card {
    flex: 0 0 calc(85% - 8px);
    min-width: 260px;
    background: rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 24px;
    scroll-snap-align: start;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .ob-ingr__card-image {
    width: 100px;
    height: 100px;
    margin: 0 auto 16px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ob-ingr__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ob-ingr__card-image svg {
    width: 48px;
    height: 48px;
  }
  .ob-ingr__card-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px;
    text-align: center;
  }
  .ob-ingr__card-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    margin: 0;
    flex: 1;
    text-align: center;
  }
  .ob-ingr__card-dose {
    display: inline-block;
    background: #C9A84C;
    color: #1A3B5C;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 50px;
    margin-top: 16px;
    align-self: center;
  }
  .ob-ingr__arrow {
    position: absolute;
    top: 50%;
    width: 68px;
    height: 42px;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(0, 37, 73, 0.96), rgba(15, 34, 51, 0.9)) padding-box,
      linear-gradient(135deg, rgba(201, 168, 76, 0.72), rgba(255, 255, 255, 0.18)) border-box;
    border: 1px solid transparent;
    color: #fff;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    opacity: 0;
    box-shadow: 0 18px 36px -24px rgba(0, 0, 0, 0.72), inset 0 1px 0 rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: opacity 0.28s ease, background 0.24s ease, color 0.24s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.24s ease;
    overflow: hidden;
  }
  .ob-ingr__arrow::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.24), transparent 46%);
    opacity: 0.78;
    pointer-events: none;
  }
  .ob-ingr__arrow::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 16px;
    height: 1px;
    background: currentColor;
    opacity: 0.62;
    pointer-events: none;
  }
  .ob-ingr__carousel-wrap:hover .ob-ingr__arrow,
  .ob-ingr__carousel-wrap:focus-within .ob-ingr__arrow {
    opacity: 0.92;
  }
  .ob-ingr__arrow:hover {
    color: #002549;
    background:
      linear-gradient(135deg, #d6b65a, #c9a84c) padding-box,
      linear-gradient(135deg, rgba(255, 255, 255, 0.6), rgba(201, 168, 76, 0.92)) border-box;
    box-shadow: 0 24px 42px -25px rgba(0, 0, 0, 0.78), 0 0 22px -8px rgba(201, 168, 76, 0.82);
  }
  .ob-ingr__arrow:active {
    opacity: 1;
  }
  .ob-ingr__arrow:focus-visible {
    outline: 2px solid rgba(201, 168, 76, 0.9);
    outline-offset: 3px;
    opacity: 1;
  }
  .ob-ingr__arrow svg {
    position: relative;
    z-index: 1;
    width: 22px;
    height: 22px;
    transition: transform 0.24s ease;
  }
  .ob-ingr__arrow svg path {
    stroke: currentColor !important;
    stroke-width: 2.25;
  }
  .ob-ingr__arrow--prev {
    left: -52px;
    transform: translateY(-50%) translateX(-10px) scale(0.96);
  }
  .ob-ingr__arrow--next {
    right: -52px;
    transform: translateY(-50%) translateX(10px) scale(0.96);
  }
  .ob-ingr__arrow--prev::after {
    right: 14px;
  }
  .ob-ingr__arrow--next::after {
    left: 14px;
  }
  .ob-ingr__carousel-wrap:hover .ob-ingr__arrow--prev,
  .ob-ingr__carousel-wrap:focus-within .ob-ingr__arrow--prev {
    transform: translateY(-50%) translateX(0) scale(1);
  }
  .ob-ingr__carousel-wrap:hover .ob-ingr__arrow--next,
  .ob-ingr__carousel-wrap:focus-within .ob-ingr__arrow--next {
    transform: translateY(-50%) translateX(0) scale(1);
  }
  .ob-ingr__arrow--prev:hover {
    transform: translateY(-50%) translateX(0) scale(1.05);
  }
  .ob-ingr__arrow--next:hover {
    transform: translateY(-50%) translateX(0) scale(1.05);
  }
  .ob-ingr__arrow--prev:active,
  .ob-ingr__arrow--next:active {
    transform: translateY(-50%) translateX(0) scale(0.97);
  }
  .ob-ingr__arrow--prev:hover svg {
    transform: translateX(-2px);
  }
  .ob-ingr__arrow--next:hover svg {
    transform: translateX(2px);
  }
  .ob-ingr__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 16px 0 0;
  }
  .ob-ingr__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(255,255,255,0.3); border: none; padding: 0;
    cursor: pointer; transition: background 0.2s ease;
  }
  .ob-ingr__dot.is-active { background: #C9A84C; }
  .ob-ingr__scroll-hint {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 10px 0 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.04em;
    animation: obIngrHintPulse 2s ease-in-out infinite;
    transition: opacity 0.4s ease;
  }
  .ob-ingr__scroll-hint.is-hidden { opacity: 0; pointer-events: none; }
  .ob-ingr__scroll-hint svg {
    width: 14px; height: 14px;
    animation: obIngrHintSlide 1.5s ease-in-out infinite;
  }
  @keyframes obIngrHintPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @keyframes obIngrHintSlide {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  @media (max-width: 767px) {
    .ob-ingr__scroll-hint { display: flex; }
  }
  @media (min-width: 768px) {
    .ob-ingr__card { flex: 0 0 calc(33.33% - 11px); min-width: 260px; }
    .ob-ingr__arrow { display: flex; }
    .ob-ingr__dots { display: none; }
  }
  @media (min-width: 1024px) {
    .ob-ingr { padding: 80px 0; }
    .ob-ingr__heading { font-size: 36px; }
    .ob-ingr__card { flex: 0 0 calc(28% - 12px); }
    .ob-ingr__card-image { width: 120px; height: 120px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- assign _ob_ingr_eyebrow = section.settings.eyebrow -%}
{%- assign _ob_ingr_heading = section.settings.heading -%}
{%- assign _ob_ingr_swipe = 'Swipe' -%}
{%- if _ob_lang == 'nl' or _ob_lang == 'de' or _ob_lang == 'fr' or _ob_lang == 'sv' or _ob_lang == 'nb' or _ob_lang == 'da' or _ob_lang == 'fi' -%}
  {%- assign _ob_ingr_eyebrow = 'calqix_oralbiome.ingredients.eyebrow' | t -%}
  {%- assign _ob_ingr_heading = 'calqix_oralbiome.ingredients.heading' | t -%}
  {%- if _ob_lang == 'nl' -%}{%- assign _ob_ingr_swipe = 'Veeg' -%}
  {%- elsif _ob_lang == 'de' -%}{%- assign _ob_ingr_swipe = 'Wischen' -%}
  {%- elsif _ob_lang == 'fr' -%}{%- assign _ob_ingr_swipe = 'Glissez' -%}
  {%- elsif _ob_lang == 'sv' -%}{%- assign _ob_ingr_swipe = 'Svep' -%}
  {%- elsif _ob_lang == 'nb' -%}{%- assign _ob_ingr_swipe = 'Sveip' -%}
  {%- elsif _ob_lang == 'da' -%}{%- assign _ob_ingr_swipe = 'Swipe' -%}
  {%- elsif _ob_lang == 'fi' -%}{%- assign _ob_ingr_swipe = 'Pyyhkaise' -%}
  {%- endif -%}
{%- endif -%}

<section class="ob-ingr" data-section-id="{{ section.id }}">
  <div class="ob-ingr__container">
    <div class="ob-ingr__header">
      <p class="ob-ingr__eyebrow">{{ _ob_ingr_eyebrow }}</p>
      <h2 class="ob-ingr__heading">{{ _ob_ingr_heading }}</h2>
    </div>
    <div class="ob-ingr__carousel-wrap">
      <button type="button" class="ob-ingr__arrow ob-ingr__arrow--prev" aria-label="{{ section.settings.prev_label }}">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 4L6 9l5 5" stroke="#1A3B5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="ob-ingr__track">
        {%- for block in section.blocks -%}
          {%- comment -%} Resolve fallback theme asset from ingredient name (case-insensitive, multi-locale keywords). {%- endcomment -%}
          {%- assign _ob_ing_name_lc = block.settings.name | downcase -%}
          {%- assign _ob_ing_asset = '' -%}
          {%- if _ob_ing_name_lc contains 'reuteri' and _ob_ing_name_lc contains 'dsm' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-l-reuteri.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'paracasei' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-l-paracasei.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'reuteri' and _ob_ing_name_lc contains 'atcc' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-l-paracasei.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'reuteri' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-l-reuteri.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'k12' or _ob_ing_name_lc contains 'blis k' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-s-salivarius-k12.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'm18' or _ob_ing_name_lc contains 'blis m' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-s-salivarius-m18.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'xylitol' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-xylitol.webp' -%}
          {%- elsif _ob_ing_name_lc contains 'peppermint' or _ob_ing_name_lc contains 'mint' or _ob_ing_name_lc contains 'munt' or _ob_ing_name_lc contains 'menthe' or _ob_ing_name_lc contains 'pfeffermin' -%}
            {%- assign _ob_ing_asset = 'ob-ingredient-peppermint.webp' -%}
          {%- endif -%}
          {%- if _ob_ing_asset == '' -%}
            {%- case forloop.index -%}
              {%- when 1 -%}{%- assign _ob_ing_asset = 'ob-ingredient-l-reuteri.webp' -%}
              {%- when 2 -%}{%- assign _ob_ing_asset = 'ob-ingredient-l-paracasei.webp' -%}
              {%- when 3 -%}{%- assign _ob_ing_asset = 'ob-ingredient-s-salivarius-k12.webp' -%}
              {%- when 4 -%}{%- assign _ob_ing_asset = 'ob-ingredient-s-salivarius-m18.webp' -%}
              {%- when 5 -%}{%- assign _ob_ing_asset = 'ob-ingredient-xylitol.webp' -%}
              {%- when 6 -%}{%- assign _ob_ing_asset = 'ob-ingredient-peppermint.webp' -%}
            {%- endcase -%}
          {%- endif -%}
          <div class="ob-ingr__card" {{ block.shopify_attributes }}>
            <div class="ob-ingr__card-image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 240 }}"
                  alt="{{ block.settings.name | escape }}"
                  loading="lazy"
                  width="120"
                  height="120"
                >
              {%- elsif _ob_ing_asset != '' -%}
                <img
                  src="{{ _ob_ing_asset | asset_url }}"
                  alt="{{ block.settings.name | escape }}"
                  loading="lazy"
                  width="120"
                  height="120"
                >
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="16" stroke="#C9A84C" stroke-width="1.5" stroke-dasharray="4 3"/><circle cx="24" cy="24" r="4" fill="#C9A84C" opacity="0.5"/></svg>
              {%- endif -%}
            </div>
            <h3 class="ob-ingr__card-name">{{ block.settings.name }}</h3>
            <p class="ob-ingr__card-desc">{{ block.settings.description }}</p>
            {%- if block.settings.dosage != blank -%}
              <span class="ob-ingr__card-dose">{{ block.settings.dosage }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <button type="button" class="ob-ingr__arrow ob-ingr__arrow--next" aria-label="{{ section.settings.next_label }}">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 4l5 5-5 5" stroke="#1A3B5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="ob-ingr__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="ob-ingr__dot{% if forloop.first %} is-active{% endif %}" data-card="{{ forloop.index0 }}" aria-label="{{ block.settings.name }}"></button>
      {%- endfor -%}
    </div>
    <div class="ob-ingr__scroll-hint" data-ob-ingr-hint>
      <span>{{ _ob_ingr_swipe }}</span>
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var track = section.querySelector('.ob-ingr__track');
    var prevBtn = section.querySelector('.ob-ingr__arrow--prev');
    var nextBtn = section.querySelector('.ob-ingr__arrow--next');
    var hint = section.querySelector('[data-ob-ingr-hint]');
    if (!track) return;

    var cards = track.querySelectorAll('.ob-ingr__card');
    var dots = section.querySelectorAll('.ob-ingr__dot');
    var autoTimer = null;
    var paused = false;
    var hintDismissed = false;

    function getStep() {
      var card = cards[0];
      if (!card) return 300;
      return card.offsetWidth + 16;
    }

    function scrollNext() {
      var max = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft >= max - 4) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      }
    }

    function scrollPrev() {
      var max = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft <= 4) {
        track.scrollTo({ left: max, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', scrollPrev);
    if (nextBtn) nextBtn.addEventListener('click', scrollNext);

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(function() {
        if (!paused) scrollNext();
      }, 3000);
    }
    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }

    track.addEventListener('mousedown', function() { paused = true; });
    track.addEventListener('mouseup', function() { paused = false; });
    track.addEventListener('mouseleave', function() { paused = false; });
    track.addEventListener('touchstart', function() { paused = true; }, { passive: true });
    track.addEventListener('touchend', function() { paused = false; });

    track.addEventListener('scroll', function() {
      if (!hintDismissed && hint) {
        hintDismissed = true;
        hint.classList.add('is-hidden');
      }
    }, { passive: true });

    if (dots.length > 0 && cards.length > 0) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var idx = Array.prototype.indexOf.call(cards, entry.target);
            dots.forEach(function(d, i) { d.classList.toggle('is-active', i === idx); });
          }
        });
      }, { root: track, threshold: 0.6 });
      cards.forEach(function(c) { io.observe(c); });
      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var idx = parseInt(dot.dataset.card);
          if (cards[idx]) cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
      });
    }

    var sectionObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) { startAuto(); } else { stopAuto(); }
      });
    }, { threshold: 0.15 });
    sectionObs.observe(section);
  })();
</script>

{% schema %}
{
  "name": "OB Ingredients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PREMIUM INGREDIENTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It\u2019s what\u2019s on the inside that counts." },
    { "type": "text", "id": "prev_label", "label": "Previous arrow label", "default": "Previous ingredient" },
    { "type": "text", "id": "next_label", "label": "Next arrow label", "default": "Next ingredient" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Description of the ingredient." },
        { "type": "text", "id": "dosage", "label": "Dosage badge", "default": "100M CFU" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "L. reuteri DSM 17938", "description": "The world\u2019s most studied oral probiotic strain. Colonizes the oral cavity and reduces harmful pathogens.", "dosage": "100M CFU" } },
        { "type": "ingredient", "settings": { "name": "L. reuteri ATCC PTA 5289", "description": "Works synergistically with DSM 17938 to support gum health and reduce inflammation.", "dosage": "100M CFU" } },
        { "type": "ingredient", "settings": { "name": "S. salivarius K12 (BLIS K12)", "description": "Produces antimicrobial peptides that target bacteria causing bad breath and throat infections.", "dosage": "1B CFU" } },
        { "type": "ingredient", "settings": { "name": "S. salivarius M18 (BLIS M18)", "description": "Produces urease and dextranase enzymes that neutralize pH and break down plaque.", "dosage": "500M CFU" } },
        { "type": "ingredient", "settings": { "name": "Xylitol", "description": "Natural sweetener that actively inhibits cavity-causing Streptococcus mutans bacteria.", "dosage": "500mg" } },
        { "type": "ingredient", "settings": { "name": "Natural Peppermint", "description": "Clean, refreshing taste without artificial flavors or sweeteners.", "dosage": "q.s." } }
      ]
    }
  ]
}
{% endschema %}
