{%- comment -%}
  CALQIX Navy Rebuild — Header (sticky, mega-menu, cart badge).
  Claude handoff: HEADER-SPEC.md §1-7.

  Two stacked layouts in a single section:
    1. Desktop (>900px): 3-col grid — logo | nav | actions
    2. Mobile (<=900px): topbar + slide-in drawer

  Cart triggers share the `.wt-cart__trigger` class so the existing
  <cart-drawer> (assets/cart-drawer.js) auto-binds click → toggle.
  Desktop cart keeps id `cart-icon-bubble` + counter
  `.wt-header__panel__counter` so theme code that writes to it still
  works. Mobile cart uses `data-cx-cart-counter-mirror` so
  cx-cart-sync.js mirrors the header count into it (and into the
  bottom bar counter) on every cart-update event.
{%- endcomment -%}

<header class="cx-root cx-header" data-cx-header>

  {%- comment -%} ---------- Desktop row (>= 901px) ---------- {%- endcomment -%}
  {%- liquid
    assign cx_logo_h_desktop = section.settings.logo_max_height_desktop | default: 32
    assign cx_logo_h_mobile = section.settings.logo_max_height_mobile | default: 28
    assign cx_logo_w_desktop = cx_logo_h_desktop | times: 6
    assign cx_logo_w_mobile = cx_logo_h_mobile | times: 6
    assign cx_logo_style_desktop = 'max-height:' | append: cx_logo_h_desktop | append: 'px;width:auto;display:block;'
    assign cx_logo_style_mobile = 'max-height:' | append: cx_logo_h_mobile | append: 'px;width:auto;display:block;'
  -%}
  <div class="cx-container cx-header-inner cx-header-inner--desktop">
    <a class="cx-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo_url != blank -%}
        <img src="{{ section.settings.logo_url }}" alt="{{ shop.name | escape }}" width="{{ cx_logo_w_desktop }}" height="{{ cx_logo_h_desktop }}" loading="eager" style="{{ cx_logo_style_desktop }}">
      {%- elsif section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', alt: shop.name, style: cx_logo_style_desktop }}
      {%- else -%}
        <span class="cx-logo-text">{{ section.settings.logo_text | default: 'CALQIX' }}</span>
      {%- endif -%}
    </a>

    <nav class="cx-nav" aria-label="Primary">
      {%- for block in section.blocks -%}
        {%- if block.type == 'mega' -%}
          <button type="button" class="cx-nav-link cx-nav-toggle" aria-expanded="false" data-cx-dropdown-toggle="{{ block.id }}" {{ block.shopify_attributes }}>
            <span class="cx-nav-label">{{ block.settings.label }}</span>
            <span class="cx-nav-chev" aria-hidden="true">{% render 'cx-icons', name: 'arrowDown', size: 14 %}</span>
          </button>
        {%- elsif block.type == 'link' -%}
          <a class="cx-nav-link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <span class="cx-nav-label">{{ block.settings.label }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="cx-header-actions">
      {%- comment -%}
        Search and locale/language have been moved OUT of the header:
          - Search removed per merchant request (task 3.2)
          - Locale/currency now lives in the announcement bar right side (task 3.1)
          - Mobile drawer keeps its own locale pickers (task 5.2)
      {%- endcomment -%}
      <a class="cx-icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        {% render 'cx-icons', name: 'userSlim', size: 20 %}
      </a>
      {%- comment -%}
        Desktop cart — primary counter source of truth (written by
        assets/cart-drawer.js on every cartUpdate). Keep both the id
        and the `wt-header__panel__counter` hooks intact.
      {%- endcomment -%}
      <a class="cx-icon-btn cx-icon-btn-cart wt-cart__trigger" id="cart-icon-bubble" href="{{ routes.cart_url }}" aria-label="Winkelmand">
        {% render 'cx-icons', name: 'bag', size: 20 %}
        {%- if cart.item_count > 0 -%}
          <span class="cx-cart-badge wt-header__panel__counter">{{ cart.item_count }}</span>
        {%- else -%}
          <span class="cx-cart-badge wt-header__panel__counter" hidden>0</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- comment -%} ---------- Mobile topbar (<=900px) ---------- {%- endcomment -%}
  <div class="cx-header-inner cx-header-inner--mobile">
    <button type="button" class="cx-m-iconbtn" data-cx-drawer-open aria-label="Menu openen" aria-controls="cx-mobile-drawer" aria-expanded="false">
      {% render 'cx-icons', name: 'hamburger', size: 16 %}
    </button>

    <a class="cx-m-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo_url != blank -%}
        <img src="{{ section.settings.logo_url }}" alt="{{ shop.name | escape }}" width="{{ cx_logo_w_mobile }}" height="{{ cx_logo_h_mobile }}" loading="eager" style="{{ cx_logo_style_mobile }}">
      {%- elsif section.settings.logo_mobile != blank -%}
        {{ section.settings.logo_mobile | image_url: width: 480 | image_tag: loading: 'eager', alt: shop.name, style: cx_logo_style_mobile }}
      {%- elsif section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', alt: shop.name, style: cx_logo_style_mobile }}
      {%- else -%}
        <span class="cx-logo-text">{{ section.settings.logo_text | default: 'CALQIX' }}</span>
      {%- endif -%}
    </a>

    <div class="cx-m-actions">
      {%- if section.settings.enable_search -%}
        <a class="cx-m-iconbtn" href="{{ routes.search_url }}" aria-label="Zoeken">
          {% render 'cx-icons', name: 'searchLeaf', size: 17 %}
        </a>
      {%- endif -%}
      <button type="button" class="cx-m-iconbtn cx-m-iconbtn--cart wt-cart__trigger" aria-label="Winkelmand ({{ cart.item_count }})" aria-controls="cart-drawer">
        {% render 'cx-icons', name: 'bag', size: 22 %}
        <span class="cx-m-badge wt-header__panel__counter"
              data-cx-cart-counter-mirror
              {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  {%- comment -%} ---------- Desktop mega panels ---------- {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'mega' -%}
      <div class="cx-mega-panel" data-cx-dropdown-panel="{{ block.id }}" hidden>
        <div class="cx-container cx-mega-grid">
          {%- for i in (1..4) -%}
            {%- assign eyebrow_key = 'eyebrow_' | append: i -%}
            {%- assign title_key = 'title_' | append: i -%}
            {%- assign desc_key = 'desc_' | append: i -%}
            {%- assign link_key = 'link_' | append: i -%}
            {%- assign card_eyebrow = block.settings[eyebrow_key] -%}
            {%- assign card_title = block.settings[title_key] -%}
            {%- if card_title != blank -%}
              <a class="cx-mega-card" href="{{ block.settings[link_key] | default: '#' }}">
                {%- if card_eyebrow != blank -%}<div class="cx-eyebrow">{{ card_eyebrow }}</div>{%- endif -%}
                <div class="cx-mega-card-title">{{ card_title }}</div>
                <div class="cx-mega-card-desc">{{ block.settings[desc_key] }}</div>
                <div class="cx-mega-card-cta">Bekijk {% render 'cx-icons', name: 'arrowRight', size: 12 %}</div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</header>

{%- comment -%} ---------- Mobile drawer (overlay + panel) ---------- {%- endcomment -%}
<div class="cx-drawer-overlay" data-cx-drawer-overlay hidden></div>
<aside class="cx-drawer cx-root"
       id="cx-mobile-drawer"
       data-cx-drawer
       aria-label="Hoofdnavigatie"
       aria-hidden="true"
       hidden>
  <header class="cx-drawer__head">
    {%- comment -%}
      Drawer logo is always the navy/blue Prime mark (per design feedback)
      so the white desktop wordmark doesn't carry over into the light
      drawer. Hardcoded so it stays consistent regardless of section
      settings on the theme editor.
    {%- endcomment -%}
    <a class="cx-drawer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <img
        src="https://cdn.shopify.com/s/files/1/1000/6262/6121/files/Header_Prime_logo_new_2026_nobg.png?v=1777014294"
        alt="{{ shop.name | escape }}"
        width="160" height="32"
        loading="lazy"
        decoding="async"
        style="max-height:32px;width:auto;display:block;">
    </a>
    <button type="button" class="cx-drawer__close" data-cx-drawer-close aria-label="Menu sluiten">
      {% render 'cx-icons', name: 'close', size: 14 %}
    </button>
  </header>

  {%- comment -%}
    Personalised greeting — only renders if logged in.
    Uses Shopify's `customer` object. `first_name` may be blank on B2B or
    invite-only accounts, fall back to full name then email local part.
    Styled: Playfair Display (mapped to --cx-f-display), gold colour.
  {%- endcomment -%}
  {%- if customer -%}
    {%- liquid
      assign cx_greet_name = customer.first_name
      if cx_greet_name == blank
        assign cx_greet_name = customer.name
      endif
      if cx_greet_name == blank
        assign cx_greet_name = customer.email | split: '@' | first
      endif
      assign cx_greet_morning   = 'cx.header.greeting.morning'   | t: name: cx_greet_name
      assign cx_greet_afternoon = 'cx.header.greeting.afternoon' | t: name: cx_greet_name
      assign cx_greet_evening   = 'cx.header.greeting.evening'   | t: name: cx_greet_name
    -%}
    {%- comment -%}
      Time-aware greeting. Server renders the afternoon variant as
      sensible default (Shopify's CDN cache strips the visitor TZ),
      and cx-motion.js swaps the textContent client-side based on
      `new Date().getHours()` (5–11 morning, 12–17 afternoon, else
      evening). Locale strings come from cx.header.greeting.* so each
      locale renders in its own language.
    {%- endcomment -%}
    <div class="cx-drawer__greeting"
         data-cx-greeting
         data-cx-greet-morning="{{ cx_greet_morning   | escape }}"
         data-cx-greet-afternoon="{{ cx_greet_afternoon | escape }}"
         data-cx-greet-evening="{{ cx_greet_evening   | escape }}">
      <span data-cx-greet-text>{{ cx_greet_afternoon }}</span>
    </div>
  {%- endif -%}

  <nav class="cx-drawer__nav" aria-label="Mobiele navigatie">
    {%- for block in section.blocks -%}
      {%- if block.type == 'mega' -%}
        <div class="cx-drawer__item" data-cx-accordion>
          <button type="button" class="cx-drawer__link cx-drawer__link--toggle" aria-expanded="false" data-cx-accordion-toggle>
            <span class="cx-drawer__link-title">{{ block.settings.label }}</span>
            <span class="cx-drawer__link-chev">{% render 'cx-icons', name: 'chevR', size: 14 %}</span>
          </button>
          <div class="cx-drawer__sub" hidden data-cx-accordion-body>
            {%- for i in (1..4) -%}
              {%- assign eyebrow_key = 'eyebrow_' | append: i -%}
              {%- assign title_key = 'title_' | append: i -%}
              {%- assign link_key = 'link_' | append: i -%}
              {%- assign s_title = block.settings[title_key] -%}
              {%- if s_title != blank -%}
                <a class="cx-drawer__sublink" href="{{ block.settings[link_key] | default: '#' }}" style="--cx-i: {{ forloop.index0 }};">
                  {%- assign s_eyebrow = block.settings[eyebrow_key] -%}
                  {%- if s_eyebrow != blank -%}
                    <span class="cx-drawer__sublink-eyebrow">{{ s_eyebrow }}</span>
                  {%- endif -%}
                  <span class="cx-drawer__sublink-title">{{ s_title }}</span>
                  <span class="cx-drawer__sublink-arrow">{% render 'cx-icons', name: 'arrowRight', size: 14 %}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- elsif block.type == 'link' -%}
        <a class="cx-drawer__link" href="{{ block.settings.link }}">
          <span class="cx-drawer__link-title">{{ block.settings.label }}</span>
          <span class="cx-drawer__link-arrow">{% render 'cx-icons', name: 'arrowRight', size: 14 %}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  {%- comment -%}
    Locale + language — single-row "chip" that opens a popup sheet with
    smooth animations. Country + language are both selectable in the same
    sheet. Uses Wonder's localization-form custom element for the form
    submission mechanics, so Shopify auto-redirects on selection.
  {%- endcomment -%}
  {%- if section.settings.show_localization -%}
    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      <div class="cx-drawer__locale">
        <button type="button" class="cx-locale-chip" data-cx-locale-open aria-haspopup="dialog" aria-expanded="false" aria-controls="cx-locale-sheet">
          <span class="cx-locale-chip__globe" aria-hidden="true">{% render 'cx-icons', name: 'globe', size: 16 %}</span>
          <span class="cx-locale-chip__text">
            {%- if localization.available_countries.size > 1 -%}
              <span class="cx-locale-chip__country">{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }} · {{ localization.country.name }}</span>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <span class="cx-locale-chip__lang">{{ localization.language.endonym_name | capitalize }}</span>
            {%- endif -%}
          </span>
          <span class="cx-locale-chip__chev" aria-hidden="true">{% render 'cx-icons', name: 'arrowDown', size: 12 %}</span>
        </button>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    Login / Account CTA — state-aware.
    - Logged out: "Log in" → /account/login (Shopify auto-redirects back after login via return_url)
    - Logged in:  "Mijn account" → /account
    Uses dark-blue forest-ink palette with subtle glow on hover.
  {%- endcomment -%}
  {%- if customer -%}
    <a class="cx-drawer__cta cx-drawer__cta--account" href="{{ routes.account_url }}">
      <span class="cx-drawer__cta-label">Mijn account</span>
      {% render 'cx-icons', name: 'arrowRight', size: 14 %}
    </a>
  {%- else -%}
    <a class="cx-drawer__cta cx-drawer__cta--login" href="{{ routes.account_login_url }}">
      <span class="cx-drawer__cta-label">Log in</span>
      {% render 'cx-icons', name: 'arrowRight', size: 14 %}
    </a>
  {%- endif -%}
</aside>

{%- comment -%} ---------- Locale sheet (popup) ---------- {%- endcomment -%}
{%- if section.settings.show_localization -%}
  {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
    <div class="cx-locale-sheet" id="cx-locale-sheet" role="dialog" aria-modal="true" aria-labelledby="cx-locale-sheet-title" data-cx-locale-sheet hidden>
      <div class="cx-locale-sheet__backdrop" data-cx-locale-close aria-hidden="true"></div>
      <div class="cx-locale-sheet__panel">
        <header class="cx-locale-sheet__head">
          <h2 class="cx-locale-sheet__title" id="cx-locale-sheet-title">{{ 'cx.header.locale.title' | t }}</h2>
          <button type="button" class="cx-locale-sheet__close" data-cx-locale-close aria-label="{{ 'cx.header.locale.close' | t }}">
            {% render 'cx-icons', name: 'close', size: 14 %}
          </button>
        </header>
        <div class="cx-locale-sheet__body">
          {%- if localization.available_countries.size > 1 -%}
            <section class="cx-locale-sheet__group">
              <h3 class="cx-locale-sheet__group-title">{{ 'cx.header.locale.country_currency' | t }}</h3>
              <localization-form>
                {%- form 'localization', id: 'CxSheetCountryForm' -%}
                  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                  <ul class="cx-locale-sheet__list" role="list">
                    {%- for country in localization.available_countries -%}
                      <li>
                        <a href="#" class="cx-locale-sheet__option{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}" data-value="{{ country.iso_code }}">
                          <span class="cx-locale-sheet__option-flag" aria-hidden="true">{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                          <span class="cx-locale-sheet__option-name">{{ country.name }}</span>
                          {%- if country.iso_code == localization.country.iso_code -%}
                            <span class="cx-locale-sheet__option-check" aria-hidden="true">{% render 'cx-icons', name: 'arrowRight', size: 12 %}</span>
                          {%- endif -%}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endform -%}
              </localization-form>
            </section>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <section class="cx-locale-sheet__group">
              <h3 class="cx-locale-sheet__group-title">{{ 'cx.header.locale.language' | t }}</h3>
              <localization-form>
                {%- form 'localization', id: 'CxSheetLangForm' -%}
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
                  <ul class="cx-locale-sheet__list" role="list">
                    {%- for language in localization.available_languages -%}
                      <li>
                        <a href="#" class="cx-locale-sheet__option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}" data-value="{{ language.iso_code }}" hreflang="{{ language.iso_code }}" lang="{{ language.iso_code }}">
                          <span class="cx-locale-sheet__option-name">{{ language.endonym_name | capitalize }}</span>
                          {%- if language.iso_code == localization.language.iso_code -%}
                            <span class="cx-locale-sheet__option-check" aria-hidden="true">{% render 'cx-icons', name: 'arrowRight', size: 12 %}</span>
                          {%- endif -%}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endform -%}
              </localization-form>
            </section>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<style>
  /* ================ Desktop ================ */
  .cx-header {
    background: var(--cx-forest-3);
    color: var(--cx-forest-ink);
    position: sticky; top: 0; z-index: 40;
    border-bottom: 1px solid rgba(242,247,255,0.08);
  }
  .cx-header-inner--desktop {
    height: 72px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .cx-header-inner--mobile { display: none; }

  .cx-logo { display: inline-flex; align-items: baseline; gap: 10px; color: var(--cx-forest-ink); }
  .cx-logo-text {
    font-family: var(--cx-f-display);
    font-size: 22px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cx-forest-ink);
  }
  .cx-nav {
    display: flex; gap: 36px; justify-content: center; align-items: center; flex-wrap: nowrap;
  }
  .cx-nav-link {
    font-family: var(--cx-f-display) !important;
    font-size: 15px; font-weight: 500;
    color: var(--cx-forest-ink);
    padding: 6px 0;
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; border: 0;
    cursor: pointer;
    line-height: 1.2;
    letter-spacing: 0.005em;
  }
  /* Make sure buttons (Products toggle) inherit the same Playfair Display
     as anchor nav-links — buttons reset font-family on some UAs. */
  button.cx-nav-link,
  .cx-nav-toggle,
  .cx-nav-label {
    font-family: var(--cx-f-display) !important;
    font-size: 15px;
    font-weight: 500;
  }
  .cx-nav-chev { display: inline-flex; transition: transform .2s ease; }
  .cx-nav-toggle.cx-is-open .cx-nav-chev { transform: rotate(180deg); }
  .cx-header-actions {
    display: flex; align-items: center; gap: 8px; justify-content: flex-end;
  }

  /* Locale + language pickers — reuse Wonder's .disclosure JS but restyle */
  .cx-localization { position: relative; }
  .cx-localization .disclosure__button {
    background: transparent;
    border: 0;
    color: var(--cx-forest-ink);
    font-family: var(--cx-f-display);
    font-size: 13px; font-weight: 500;
    padding: 6px 8px;
    display: inline-flex; align-items: center; gap: 4px;
    cursor: pointer;
    line-height: 1;
  }
  .cx-localization .disclosure__button:hover { opacity: 0.8; }
  .cx-localization .disclosure__list-wrapper {
    position: absolute; top: calc(100% + 4px); right: 0;
    background: var(--cx-page);
    color: var(--cx-forest-3);
    border: 1px solid var(--cx-rule);
    border-radius: 8px;
    box-shadow: var(--cx-shadow-card);
    min-width: 180px;
    max-height: 320px; overflow-y: auto;
    padding: 6px;
    z-index: 50;
  }
  .cx-localization .disclosure__list { list-style: none; padding: 0; margin: 0; }
  .cx-localization .disclosure__link {
    display: block;
    padding: 8px 10px;
    font-size: 13px;
    color: var(--cx-forest-3);
    text-decoration: none;
    border-radius: 6px;
  }
  .cx-localization .disclosure__link:hover,
  .cx-localization .disclosure__link--active {
    background: color-mix(in srgb, var(--cx-forest-3) 6%, transparent);
  }
  .cx-localization .localization-form__currency { color: var(--cx-ink-mute); margin-right: 4px; }
  .cx-icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; padding: 0;
    color: var(--cx-forest-ink);
    line-height: 0;
    position: relative;
    background: transparent; border: 0;
  }
  .cx-icon-btn:hover { opacity: 0.8; }
  .cx-cart-badge {
    position: absolute; top: -2px; right: -4px;
    background: var(--cx-gold); color: var(--cx-forest-3);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 12px; font-weight: 600; font-feature-settings: 'tnum' 1;
    border-radius: 999px;
    min-width: 20px; height: 20px; padding: 0 5px;
    box-sizing: border-box;
    display: inline-flex; align-items: center; justify-content: center;
    line-height: 1;
  }
  .cx-cart-badge[hidden] { display: none !important; }

  .cx-mega-panel {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--cx-page);
    border-top: 1px solid rgba(242,247,255,0.12);
    border-bottom: 1px solid var(--cx-rule);
    box-shadow: var(--cx-shadow-card);
    color: var(--cx-forest-3);
  }
  .cx-mega-grid {
    padding: 36px 28px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .cx-mega-card {
    display: flex; flex-direction: column; gap: 10px;
    color: var(--cx-forest-3);
  }
  .cx-mega-card-title {
    font-family: var(--cx-f-display);
    font-size: 22px; letter-spacing: -0.01em;
    color: var(--cx-forest-3);
  }
  .cx-mega-card-desc { font-size: 13px; max-width: 26ch; }
  .cx-mega-card-cta {
    margin-top: 6px;
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500;
  }

  /* ================ Mobile topbar ================ */
  @media (max-width: 900px) {
    .cx-header-inner--desktop { display: none; }
    .cx-header-inner--mobile {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 14px;
      padding: 12px 18px;
      background: rgba(0,37,73,0.98);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .cx-m-iconbtn {
      width: 38px; height: 38px; border-radius: 999px;
      border: 1px solid rgba(242,247,255,0.18);
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--cx-forest-ink);
      background: transparent;
      position: relative;
      cursor: pointer;
      line-height: 0;
      -webkit-tap-highlight-color: transparent;
    }
    .cx-m-iconbtn:active { transform: scale(0.94); }
    .cx-m-logo { display: inline-flex; justify-content: center; color: var(--cx-forest-ink); }
    .cx-m-actions { display: flex; gap: 6px; justify-content: flex-end; }
    .cx-m-badge {
      position: absolute; top: -4px; right: -4px;
      background: var(--cx-gold); color: var(--cx-forest-3);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 12px; font-weight: 600; font-feature-settings: 'tnum' 1;
      border-radius: 999px;
      min-width: 20px; height: 20px; padding: 0 5px;
      box-sizing: border-box;
      display: inline-flex; align-items: center; justify-content: center;
      line-height: 1;
    }
    .cx-m-badge[hidden] { display: none !important; }
    .cx-mega-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; padding: 24px 20px; }
  }

  /* ================ Mobile drawer ================ */
  /*
   * Hard rule: the drawer overlay is a MOBILE-ONLY layer. We keep it
   * out of the DOM render tree entirely outside of <=900px viewports
   * AND when it carries the [hidden] attribute. Previous attempts
   * tried to keep it rendered (display:block + opacity:0) so the
   * close fade-out could play, but every browser engine still
   * promotes a position:fixed full-viewport rgba layer to its own
   * compositing pass — which on some hardware leaves a faint navy
   * haze across the page even at opacity:0. Trade-off accepted:
   * we drop the 180ms fade-out, the panel still slides smoothly so
   * the lost overlay tween is visually negligible.
   */
  /* Overlay fade-in: starts at zero opacity + zero blur to keep the
     compositor work to a minimum until the drawer actually opens.
     `.cx-is-open` (mirrored from the drawer state by JS) ramps both
     to their final values over the same duration as the slide so the
     dim + blur arrive in lockstep with the panel. Close still snaps
     via [hidden]: display:none — see the long-form comment above. */
  .cx-drawer-overlay {
    position: fixed; inset: 0; z-index: 49;
    background: rgba(0, 20, 40, 0.45);
    pointer-events: auto;
    opacity: 0;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition:
      opacity 640ms cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 640ms cubic-bezier(0.16, 1, 0.3, 1),
      -webkit-backdrop-filter 640ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cx-drawer-overlay.cx-is-open {
    opacity: 1;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .cx-drawer-overlay[hidden] { display: none !important; }
  @media (min-width: 901px) {
    /* Drawer never opens on desktop, so guarantee zero contribution
       to the compositing tree at any moment. */
    .cx-drawer-overlay { display: none !important; }
  }

  .cx-drawer {
    position: fixed; top: 0; left: 0; bottom: 0;
    width: 84vw; max-width: 420px;
    z-index: 50;
    background: var(--cx-page);
    color: var(--cx-forest-3);
    padding: 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex; flex-direction: column;
    transform: translateX(-100%);
    /* Luxe silk slide — a longer 640ms ramp on a deep deceleration
       curve (cubic-bezier(0.16, 1, 0.3, 1)) so the panel glides into
       place instead of locking. Pairs with the synchronised overlay
       fade + blur ramp above for a single composed entrance. */
    transition:
      transform 640ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 640ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 0 0 rgba(0, 20, 40, 0);
    -webkit-overflow-scrolling: touch;
  }
  .cx-drawer[hidden] { display: none; }
  .cx-drawer.cx-is-open {
    transform: translateX(0);
    box-shadow:
      32px 0 96px -24px rgba(11, 37, 64, 0.45),
      1px 0 0 0 rgba(11, 37, 64, 0.05);
  }

  /* Stagger child fade-up so the drawer feels composed, not slammed open.
     Each child starts 12px right + transparent and slides into place
     ~80–320ms after the panel begins translating. */
  .cx-drawer__head,
  .cx-drawer__greeting,
  .cx-drawer__nav > *,
  .cx-drawer__locale,
  .cx-drawer__cta {
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 640ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 640ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cx-drawer.cx-is-open .cx-drawer__head      { transition-delay:  60ms; }
  .cx-drawer.cx-is-open .cx-drawer__greeting  { transition-delay: 110ms; }
  .cx-drawer.cx-is-open .cx-drawer__nav > *:nth-child(1) { transition-delay: 150ms; }
  .cx-drawer.cx-is-open .cx-drawer__nav > *:nth-child(2) { transition-delay: 190ms; }
  .cx-drawer.cx-is-open .cx-drawer__nav > *:nth-child(3) { transition-delay: 220ms; }
  .cx-drawer.cx-is-open .cx-drawer__nav > *:nth-child(4) { transition-delay: 250ms; }
  .cx-drawer.cx-is-open .cx-drawer__nav > *:nth-child(5) { transition-delay: 280ms; }
  .cx-drawer.cx-is-open .cx-drawer__nav > *:nth-child(n+6) { transition-delay: 310ms; }
  .cx-drawer.cx-is-open .cx-drawer__locale    { transition-delay: 340ms; }
  .cx-drawer.cx-is-open .cx-drawer__cta       { transition-delay: 370ms; }
  .cx-drawer.cx-is-open .cx-drawer__head,
  .cx-drawer.cx-is-open .cx-drawer__greeting,
  .cx-drawer.cx-is-open .cx-drawer__nav > *,
  .cx-drawer.cx-is-open .cx-drawer__locale,
  .cx-drawer.cx-is-open .cx-drawer__cta {
    opacity: 1;
    transform: translateX(0);
  }

  .cx-drawer__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 16px; margin-bottom: 8px;
    border-bottom: 1px solid var(--cx-rule);
  }
  .cx-drawer__logo { color: var(--cx-forest-3); }
  .cx-drawer__logo-text {
    font-family: var(--cx-f-display);
    font-size: 20px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cx-forest-3);
  }
  .cx-drawer__close {
    width: 36px; height: 36px; border-radius: 999px;
    border: 1px solid var(--cx-rule);
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; color: var(--cx-forest-3);
    cursor: pointer;
  }
  .cx-drawer__close:active { transform: scale(0.94); }

  .cx-drawer__nav { display: flex; flex-direction: column; }
  /* All linklist rows (anchors AND the Products <button> toggle) share the
     same dimensions so the column reads as a clean, evenly-spaced list. */
  .cx-drawer__link {
    display: flex; align-items: center; justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    min-height: 60px;
    padding: 18px 14px;
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--cx-rule);
    border-radius: 0;
    background: transparent;
    color: var(--cx-forest-3);
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    line-height: 1.2;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 360ms var(--cx-ease-silk),
      color 360ms var(--cx-ease-silk);
  }
  /* Hover / focus / press / open: gentle navy fill, text fades to ivory.
     No layout shift — only colour cross-fades — for a luxe feel. */
  .cx-drawer__link:hover,
  .cx-drawer__link:focus,
  .cx-drawer__link:focus-visible,
  .cx-drawer__link:active,
  .cx-drawer__item.cx-is-open > .cx-drawer__link--toggle {
    background-color: var(--cx-forest-3);
    color: #f2f7ff;
    outline: none;
  }
  .cx-drawer__link-title {
    font-family: var(--cx-f-display);
    font-size: 18px; font-weight: 500;
    line-height: 1.2;
    color: inherit;
    transition: color 360ms var(--cx-ease-silk);
  }
  .cx-drawer__link:hover .cx-drawer__link-title,
  .cx-drawer__link:focus .cx-drawer__link-title,
  .cx-drawer__link:focus-visible .cx-drawer__link-title,
  .cx-drawer__link:active .cx-drawer__link-title,
  .cx-drawer__item.cx-is-open > .cx-drawer__link--toggle .cx-drawer__link-title {
    color: #f2f7ff;
  }
  .cx-drawer__link-arrow,
  .cx-drawer__link-chev {
    display: inline-flex;
    color: var(--cx-ink-mute);
    transition:
      transform 360ms var(--cx-ease-silk),
      color 360ms var(--cx-ease-silk);
  }
  .cx-drawer__link:hover .cx-drawer__link-arrow,
  .cx-drawer__link:hover .cx-drawer__link-chev,
  .cx-drawer__link:focus .cx-drawer__link-arrow,
  .cx-drawer__link:focus .cx-drawer__link-chev,
  .cx-drawer__link:focus-visible .cx-drawer__link-arrow,
  .cx-drawer__link:focus-visible .cx-drawer__link-chev,
  .cx-drawer__link:active .cx-drawer__link-arrow,
  .cx-drawer__link:active .cx-drawer__link-chev,
  .cx-drawer__item.cx-is-open > .cx-drawer__link--toggle .cx-drawer__link-chev {
    color: #f2f7ff;
  }
  .cx-drawer__item.cx-is-open .cx-drawer__link-chev {
    transform: rotate(90deg);
  }

  /* Submenu container — height/opacity are animated by cx-motion.js.
     Keep display:flex always so JS can read scrollHeight; visibility is
     controlled via the [hidden] attribute (JS toggles it before/after the
     transition). */
  .cx-drawer__sub {
    display: flex; flex-direction: column;
    padding: 4px 0 10px 14px;
    height: 0;
    overflow: hidden;
    opacity: 0;
    will-change: height, opacity;
  }
  .cx-drawer__sub[hidden] { display: none; }
  .cx-drawer__item.cx-is-open .cx-drawer__sub:not([hidden]) {
    /* JS sets explicit height/opacity during the transition; once the
       transition completes JS clears them and the rules below render the
       fully-open final state. */
    height: auto;
    opacity: 1;
  }

  /* Staggered fade-in of sublinks once the parent expands. */
  .cx-drawer__item.cx-is-open .cx-drawer__sublink {
    animation: cx-drawer-sublink-in 480ms var(--cx-ease-silk) both;
    animation-delay: calc(var(--cx-i, 0) * 60ms + 80ms);
  }
  @keyframes cx-drawer-sublink-in {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-drawer__link,
    .cx-drawer__link-title,
    .cx-drawer__link-arrow,
    .cx-drawer__link-chev { transition: none; }
    .cx-drawer__item.cx-is-open .cx-drawer__sublink { animation: none; }
  }
  .cx-drawer__sublink {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "eyebrow arrow"
      "title arrow";
    align-items: center;
    gap: 2px 12px;
    padding: 12px 0;
    color: var(--cx-forest-3);
    border-bottom: 1px solid rgba(26,59,92,0.04);
  }
  .cx-drawer__sublink:last-child { border-bottom: 0; }
  .cx-drawer__sublink-eyebrow {
    grid-area: eyebrow;
    display: inline-block;
    font-family: var(--cx-f-display);
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    font-style: italic;
    color: var(--cx-gold-ink);
    margin-right: 6px;
  }
  .cx-drawer__sublink-title {
    grid-area: title;
    font-family: var(--cx-f-display);
    font-size: 16px; font-weight: 500;
    line-height: 1.2;
  }
  .cx-drawer__sublink-arrow {
    grid-area: arrow;
    color: var(--cx-ink-mute);
    align-self: center;
  }

  /* Personalised greeting (logged-in only).
     - Aligned to the same left edge as .cx-drawer__link (no left padding,
       inherits the parent .cx-drawer's 20px gutter).
     - Italic per design spec.
     - 20px padding-bottom for breathing room between the greeting and
       the link list (the first link still adds its own 14px padding-top,
       which gives a generous airy gap below the greeting). */
  .cx-drawer__greeting {
    padding: 10px 0 20px 0;
    font-family: var(--cx-f-display);
    font-style: italic;
    font-size: 20px; font-weight: 500;
    color: var(--cx-gold-ink);
    letter-spacing: 0.005em;
    line-height: 1.2;
  }
  .cx-drawer__greeting [data-cx-greet-text] { color: var(--cx-gold-ink); }

  /* Locale chip — single-row trigger */
  .cx-drawer__locale {
    padding: 14px 22px;
    margin-top: auto;
    border-top: 1px solid rgba(26,59,92,0.08);
  }
  .cx-locale-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    background: rgba(26,59,92,0.03);
    border: 1px solid rgba(26,59,92,0.08);
    border-radius: 12px;
    color: var(--cx-forest-3);
    font-family: var(--cx-f-display);
    font-size: 13.5px; font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .cx-locale-chip:hover {
    background: rgba(26,59,92,0.06);
    border-color: rgba(26,59,92,0.16);
  }
  .cx-locale-chip:active { transform: scale(0.98); }
  .cx-locale-chip__globe { display: inline-flex; color: var(--cx-gold-ink); flex: 0 0 auto; }
  .cx-locale-chip__text { flex: 1 1 auto; display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .cx-locale-chip__country { font-size: 13.5px; font-weight: 500; color: var(--cx-forest-3); line-height: 1.2; }
  .cx-locale-chip__lang { font-size: 11px; color: rgba(26,59,92,0.6); line-height: 1.2; }
  .cx-locale-chip__chev { color: rgba(26,59,92,0.4); flex: 0 0 auto; }

  /* Locale popup sheet */
  .cx-locale-sheet {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .cx-locale-sheet[data-open] {
    pointer-events: auto;
    opacity: 1;
  }
  .cx-locale-sheet[hidden] { display: none; }
  .cx-locale-sheet__backdrop {
    position: absolute; inset: 0;
    background: rgba(11,37,64,0.52);
    /* backdrop-filter is gated to [data-open] only — same compositing
       trap as .cx-drawer-overlay. Leaving it on the base rule means
       the blur leaks across the entire viewport between the
       sheet.hidden=false and requestAnimationFrame(data-open) frames
       in cx-motion.js, and again during the 320ms close fade. */
  }
  .cx-locale-sheet[data-open] .cx-locale-sheet__backdrop {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .cx-locale-sheet__panel {
    position: absolute;
    left: 50%; top: 50%;
    width: min(420px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    transform: translate(-50%, calc(-50% + 12px)) scale(0.96);
    background: var(--cx-page);
    border-radius: 20px;
    overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 32px 64px -24px rgba(11,37,64,0.35),
                0 0 0 1px rgba(26,59,92,0.05);
    opacity: 0;
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
  }
  .cx-locale-sheet[data-open] .cx-locale-sheet__panel {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  .cx-locale-sheet__head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(26,59,92,0.08);
  }
  .cx-locale-sheet__title {
    margin: 0;
    font-family: var(--cx-f-display);
    font-size: 18px; font-weight: 500;
    color: var(--cx-forest-3);
  }
  .cx-locale-sheet__close {
    background: transparent; border: 0; cursor: pointer;
    padding: 6px; margin: -6px;
    color: var(--cx-forest-3);
    line-height: 0; border-radius: 8px;
    transition: background 0.2s ease;
  }
  .cx-locale-sheet__close:hover { background: rgba(26,59,92,0.06); }
  .cx-locale-sheet__body {
    overflow-y: auto;
    padding: 8px 12px 16px;
  }
  .cx-locale-sheet__group { padding: 12px 8px 4px; }
  .cx-locale-sheet__group-title {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase;
    font-weight: 700;
    color: rgba(26,59,92,0.5);
    margin: 0 0 8px;
  }
  .cx-locale-sheet__list { list-style: none; margin: 0; padding: 0; }
  .cx-locale-sheet__option {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--cx-forest-3);
    text-decoration: none;
    font-family: var(--cx-f-display);
    font-size: 14px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .cx-locale-sheet__option:hover {
    background: rgba(26,59,92,0.05);
  }
  .cx-locale-sheet__option.is-active {
    background: rgba(61,139,255,0.09);
    color: var(--cx-forest-3);
  }
  .cx-locale-sheet__option-flag {
    flex: 0 0 auto;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--cx-gold-ink);
    min-width: 64px;
  }
  .cx-locale-sheet__option-name { flex: 1 1 auto; }
  .cx-locale-sheet__option-check { color: var(--cx-accent, #3d8bff); }

  /* Login / account CTA.
     Background = navy, label MUST be ivory white so it's readable on
     the dark navy fill (was using --cx-forest-ink which is almost the
     same shade as the bg → invisible label, see screenshot feedback). */
  .cx-drawer__cta {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 10px;
    padding: 16px 24px;
    background: var(--cx-forest-3);
    color: #f2f7ff;
    border-radius: 999px;
    font-family: var(--cx-f-display);
    font-size: 15px; font-weight: 500;
    text-align: center;
    margin: 14px 22px 22px;
    box-shadow: 0 10px 24px -12px rgba(26,59,92,0.35);
    transition: transform 0.2s ease, box-shadow 0.25s ease;
  }
  .cx-drawer__cta,
  .cx-drawer__cta:link,
  .cx-drawer__cta:visited,
  .cx-drawer__cta:hover,
  .cx-drawer__cta:focus { color: #f2f7ff; }
  .cx-drawer__cta-label { color: #f2f7ff; }
  .cx-drawer__cta svg { color: #f2f7ff; stroke: currentColor; }
  .cx-drawer__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 32px -12px rgba(26,59,92,0.45),
                0 0 22px -6px rgba(61,139,255,0.4);
  }
  .cx-drawer__cta:active { transform: translateY(0); }
  .cx-drawer__cta--account { background: var(--cx-forest-3); }
  .cx-drawer__cta--login   { background: var(--cx-forest-3); }

  @media (prefers-reduced-motion: reduce) {
    .cx-drawer, .cx-drawer-overlay,
    .cx-drawer__head, .cx-drawer__greeting,
    .cx-drawer__nav > *, .cx-drawer__locale, .cx-drawer__cta {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{% schema %}
{
  "name": "CX Header",
  "tag": "section",
  "class": "cx-section-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "text", "id": "logo_text", "label": "Logo tekst", "default": "CALQIX" },
    { "type": "text", "id": "logo_url", "label": "Logo CDN URL (wint van image picker)", "info": "Plak hier een volledige https:// image URL (bv. shopify CDN). Laat leeg om de image picker hieronder te gebruiken." },
    { "type": "image_picker", "id": "logo", "label": "Logo afbeelding (optioneel)" },
    { "type": "image_picker", "id": "logo_mobile", "label": "Logo mobiel (optioneel — valt terug op desktop logo)" },
    { "type": "range", "id": "logo_max_height_desktop", "label": "Logo hoogte (desktop)", "min": 16, "max": 100, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "logo_max_height_mobile", "label": "Logo hoogte (mobiel)", "min": 16, "max": 80, "step": 1, "unit": "px", "default": 28 },
    { "type": "header", "content": "Search" },
