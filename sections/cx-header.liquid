    { "type": "header", "content": "Locale + language" },
    { "type": "checkbox", "id": "show_localization", "label": "Land/taal selector tonen", "default": true, "info": "Desktop: pills rechts van nav. Mobile drawer: onderaan voor de CTA." },
    { "type": "header", "content": "Mobile drawer CTA" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop de Rebuild-kit" },
    { "type": "url",  "id": "cta_url",   "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigatie link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Over ons" },
        { "type": "url",  "id": "link",  "label": "Link" }
      ]
    },
    {
      "type": "mega",
      "name": "Mega-menu (4 kaarten)",
      "settings": [
