      --cts-navy-deep: {{ section.settings.color_navy_deep }};
      --cts-line: {{ section.settings.color_line }};
      --cts-aqua: {{ section.settings.color_aqua }};
      --cts-aqua-strong: {{ section.settings.color_aqua_strong }};
      --cts-green: {{ section.settings.color_green }};
      --cts-amber: {{ section.settings.color_amber }};
      --cts-bg-rgb: {{ section.settings.color_bg | color_extract: 'red' }}, {{ section.settings.color_bg | color_extract: 'green' }}, {{ section.settings.color_bg | color_extract: 'blue' }};
      --cts-surface-rgb: {{ section.settings.color_surface | color_extract: 'red' }}, {{ section.settings.color_surface | color_extract: 'green' }}, {{ section.settings.color_surface | color_extract: 'blue' }};
