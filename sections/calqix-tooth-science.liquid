      <button class="cts-mobile-sheet__close" type="button" data-ts-sheet-close aria-label="{{ 'sections.calqix_tooth_science.ui.mobileSheetCloseAriaLabel' | t }}">
        <span></span>
        <span></span>
      </button>

      <div class="cts-panel cts-panel--mobile">
        <div class="cts-panel__meta">
          <span class="cts-panel__badge" data-ts-tooth-pill>{{ 'sections.calqix_tooth_science.teeth.incisors.label' | t }}</span>
          <span class="cts-panel__badge cts-panel__badge--soft" data-ts-age-pill>{{ section.settings.young_label }}</span>
        </div>
        <div class="cts-panel__header">
          <p class="cts-panel__eyebrow" data-ts-layer-kicker>{{ 'sections.calqix_tooth_science.layers.overview.kicker' | t }}</p>
          <h3 class="cts-panel__title" data-ts-panel-title>{{ 'sections.calqix_tooth_science.teeth.incisors.overviewTitle' | t }}</h3>
          <p class="cts-panel__description" data-ts-panel-description></p>
        </div>
        <div class="cts-panel__cards">
          <article class="cts-info-card">
            <p class="cts-info-card__label">{{ 'sections.calqix_tooth_science.ui.functionLabel' | t }}</p>
            <p class="cts-info-card__value" data-ts-card-function></p>
          </article>
          <article class="cts-info-card">
            <p class="cts-info-card__label">{{ 'sections.calqix_tooth_science.ui.whyLabel' | t }}</p>
            <p class="cts-info-card__value" data-ts-card-why></p>
          </article>
          <article class="cts-info-card">
            <p class="cts-info-card__label">{{ 'sections.calqix_tooth_science.ui.careLabel' | t }}</p>
            <p class="cts-info-card__value" data-ts-card-care></p>
          </article>
          <article class="cts-info-card">
            <p class="cts-info-card__label">{{ 'sections.calqix_tooth_science.ui.riskLabel' | t }}</p>
            <p class="cts-info-card__value" data-ts-card-risk></p>
          </article>
          <article class="cts-info-card">
            <p class="cts-info-card__label">{{ 'sections.calqix_tooth_science.ui.tipLabel' | t }}</p>
            <p class="cts-info-card__value" data-ts-card-tip></p>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

