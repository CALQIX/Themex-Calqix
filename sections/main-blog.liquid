    --cols: {{ section.settings.columns_desktop }};
    --journal-navy: #002549;
    --journal-ink: #123554;
    --journal-muted: #5f7284;
    --journal-line: rgba(0, 37, 73, 0.14);
    --journal-blue: #eaf4fc;
    --journal-gold: #c9a84c;
    --journal-soft: #f7fbff;
    --journal-white: #ffffff;
  }

  [data-section-id="{{ section.id }}"] .main-blog__grid__item {
    --font-headline-scale-desk: {{ section.settings.size_heading | divided_by: 100.0 }};
    --font-headline-scale: {{ section.settings.size_heading_mobile | divided_by: 100.0 }};
  }

  [data-section-id="{{ section.id }}"].cx-journal {
    position: relative;
    overflow: hidden;
    margin-top: var(--section-gap-top, 20px);
    margin-bottom: var(--section-gap-bottom, 20px);
    color: var(--journal-ink);
    background:
      linear-gradient(rgba(0, 37, 73, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 37, 73, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, #f6fbff 0%, #ffffff 36%, #f8fbff 100%);
    background-size: 40px 40px, 40px 40px, auto;
  }

  .cx-journal__inner {
    width: min(1320px, calc(100vw - 48px));
    margin: 0 auto;
    padding: clamp(42px, 5vw, 76px) 0 clamp(56px, 7vw, 96px);
  }

  .cx-journal__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(330px, 0.8fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding-bottom: clamp(28px, 4vw, 54px);
    border-bottom: 1px solid var(--journal-line);
  }

  .cx-journal__eyebrow,
  .cx-journal-card__eyebrow,
  .cx-journal-rail__label {
    margin: 0 0 14px;
    color: var(--journal-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .cx-journal__title {
    max-width: 820px;
    margin: 0;
    color: var(--journal-navy);
    font-family: var(--font-heading-family);
    font-size: clamp(42px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: 0;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .cx-journal__lead {
    max-width: 700px;
    margin: 24px 0 0;
    color: var(--journal-ink);
    font-size: clamp(16px, 1.45vw, 20px);
    line-height: 1.75;
  }

  .cx-journal__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .cx-journal__stat {
    min-width: 150px;
    padding: 13px 16px;
    border: 1px solid var(--journal-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 18px 44px rgba(0, 37, 73, 0.06);
    backdrop-filter: blur(10px);
  }

  .cx-journal__stat strong {
    display: block;
    color: var(--journal-navy);
    font-family: var(--font-heading-family);
    font-size: 28px;
    line-height: 1;
  }

  .cx-journal__stat span {
    display: block;
    margin-top: 7px;
    color: var(--journal-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cx-journal__labnote {
    position: relative;
    border: 1px solid rgba(0, 37, 73, 0.16);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(238, 247, 255, 0.9)),
      var(--journal-white);
    box-shadow: 0 24px 70px rgba(0, 37, 73, 0.12);
    padding: clamp(22px, 3vw, 34px);
  }

  .cx-journal__labnote:before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    border-radius: 8px 0 0 8px;
    background: linear-gradient(180deg, var(--journal-gold), rgba(0, 37, 73, 0.92));
  }

  .cx-journal__labnote-title {
    margin: 0 0 12px;
    color: var(--journal-navy);
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 2.3vw, 34px);
    line-height: 1.08;
  }

  .cx-journal__labnote-link {
    color: inherit;
    text-decoration: none;
  }

  .cx-journal__labnote-copy {
    margin: 0 0 20px;
    color: var(--journal-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .cx-journal__signal {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--journal-navy);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cx-journal__signal:before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--journal-gold);
    box-shadow: 0 0 0 6px rgba(201, 168, 76, 0.14);
  }

  .cx-journal__topics {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 24px 0 30px;
    scrollbar-width: thin;
  }

  .cx-journal__topic {
    flex: 0 0 auto;
    border: 1px solid var(--journal-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--journal-navy);
    padding: 11px 18px;
    font-size: 13px;
    font-weight: 750;
    box-shadow: 0 12px 30px rgba(0, 37, 73, 0.05);
  }

  .cx-journal__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .cx-journal__feed {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .cx-journal-card {
    position: relative;
    min-width: 0;
    border: 1px solid var(--journal-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 48px rgba(0, 37, 73, 0.07);
    overflow: hidden;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .cx-journal-card:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 168, 76, 0.55);
    box-shadow: 0 28px 72px rgba(0, 37, 73, 0.14);
  }

  .cx-journal-card--featured {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    min-height: 420px;
    background:
      linear-gradient(135deg, #ffffff 0%, #f1f8ff 100%);
  }

  .cx-journal-card__media {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--journal-blue);
    aspect-ratio: 16 / 11;
  }

  .cx-journal-card--featured .cx-journal-card__media {
    height: 100%;
    min-height: 420px;
    aspect-ratio: auto;
  }

  .cx-journal-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 480ms ease;
  }

  .cx-journal-card:hover .cx-journal-card__media img {
    transform: scale(1.035);
  }

  .cx-journal-card__media-placeholder {
    width: 100%;
    height: 100%;
    min-height: 260px;
    display: grid;
    place-items: center;
    color: var(--journal-navy);
    background:
      linear-gradient(rgba(0, 37, 73, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 37, 73, 0.08) 1px, transparent 1px),
      #edf6ff;
    background-size: 24px 24px;
  }

  .cx-journal-card__content {
    padding: clamp(22px, 3vw, 34px);
  }

  .cx-journal-card--featured .cx-journal-card__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cx-journal-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 0 0 15px;
    color: var(--journal-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cx-journal-card__tag {
    color: var(--journal-gold);
  }

  .cx-journal-card__title {
    margin: 0;
    color: var(--journal-navy);
    font-family: var(--font-heading-family);
    font-size: clamp(26px, 2.5vw, 42px);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .cx-journal-card:not(.cx-journal-card--featured) .cx-journal-card__title {
    font-size: clamp(22px, 1.65vw, 30px);
    line-height: 1.08;
  }

  .cx-journal-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .cx-journal-card__excerpt {
    margin: 18px 0 0;
    color: var(--journal-ink);
    font-size: 15px;
    line-height: 1.7;
  }

  .cx-journal-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--journal-line);
  }

  .cx-journal-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--journal-navy);
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .cx-journal-card__cta:after {
    content: "";
    width: 26px;
    height: 1px;
    background: var(--journal-gold);
    transition: width 220ms ease;
  }

  .cx-journal-card:hover .cx-journal-card__cta:after {
    width: 40px;
  }

  .cx-journal-card__readtime {
    color: var(--journal-muted);
    font-size: 12px;
    font-weight: 700;
  }

  .cx-journal__rail {
    position: sticky;
    top: 112px;
    display: grid;
    gap: 16px;
  }

  .cx-journal-rail__panel {
    border: 1px solid var(--journal-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 18px 48px rgba(0, 37, 73, 0.07);
    padding: 22px;
  }

  .cx-journal-rail__title {
    margin: 0 0 10px;
    color: var(--journal-navy);
    font-family: var(--font-heading-family);
    font-size: 25px;
    line-height: 1.08;
  }

  .cx-journal-rail__copy {
    margin: 0;
    color: var(--journal-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .cx-journal-rail__list {
    display: grid;
    gap: 11px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .cx-journal-rail__item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    align-items: start;
    color: var(--journal-ink);
    font-size: 13px;
    line-height: 1.45;
  }

  .cx-journal-rail__item:before {
    content: "";
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 999px;
    background: var(--journal-gold);
    box-shadow: 0 0 0 5px rgba(201, 168, 76, 0.12);
  }

  .cx-journal .pagination-wrapper {
    grid-column: 1 / -1;
    margin-top: 32px;
  }

  @media screen and (max-width: 989px) {
    .cx-journal__hero,
    .cx-journal__body,
    .cx-journal-card--featured {
      grid-template-columns: 1fr;
    }

    .cx-journal__rail {
      position: static;
      order: -1;
    }

    .cx-journal-card--featured .cx-journal-card__media {
      min-height: 320px;
      aspect-ratio: 16 / 11;
    }
  }

  @media screen and (max-width: 749px) {
    .cx-journal__inner {
      width: min(100vw - 32px, 520px);
      padding-top: 32px;
      padding-bottom: 74px;
    }

    .cx-journal__hero-copy {
      text-align: center;
    }

    .cx-journal__title {
      max-width: 100%;
      font-size: clamp(34px, 9vw, 38px);
      line-height: 1.05;
    }

    .cx-journal__lead {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.65;
    }

    .cx-journal__stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-top: 22px;
    }

    .cx-journal__stat {
      min-width: 0;
      padding: 12px;
    }

    .cx-journal__stat strong {
      font-size: 22px;
    }

    .cx-journal__stat span {
      font-size: 9px;
      letter-spacing: 0.08em;
    }

    .cx-journal__topics {
      margin-left: -16px;
      margin-right: -16px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .cx-journal__feed {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .cx-journal-card__content {
      padding: 22px;
    }

    .cx-journal-card__title,
    .cx-journal-card:not(.cx-journal-card--featured) .cx-journal-card__title {
      font-size: 25px;
      line-height: 1.08;
    }

    .cx-journal-card__excerpt {
      font-size: 14px;
    }

    .cx-journal-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

{%- paginate blog.articles by 6 -%}
  <div class="main-article cx-journal" data-section-id="{{ section.id }}">
    <div class="cx-journal__inner">
      <div class="cx-journal__hero">
        <div class="cx-journal__hero-copy">
          <p class="cx-journal__eyebrow">{{ eyebrow }}</p>
          {% if section.settings.show_blog_title %}
            <h1 class="cx-journal__title">{{ heading }}</h1>
          {% endif %}
          <p class="cx-journal__lead"><strong>{{ hero_kicker }}</strong> {{ hero_copy }}</p>

          <div class="cx-journal__stats" aria-label="{{ index_label }}">
            <div class="cx-journal__stat">
              <strong>{{ article_count }}</strong>
              <span>{{ article_label }}</span>
            </div>
            <div class="cx-journal__stat">
              <strong>4</strong>
              <span>{{ theme_label }}</span>
            </div>
            <div class="cx-journal__stat">
              <strong>0</strong>
              <span>{{ overclaims_label }}</span>
            </div>
          </div>
        </div>

        {% if latest_article %}
          <aside class="cx-journal__labnote" aria-label="{{ latest_label }}">
            <p class="cx-journal__eyebrow">{{ latest_label }}</p>
            <h2 class="cx-journal__labnote-title">
              <a class="cx-journal__labnote-link" href="{{ latest_article.url }}">{{ latest_title | escape }}</a>
            </h2>
            <p class="cx-journal__labnote-copy">
              {{ latest_excerpt }}
            </p>
            <span class="cx-journal__signal">{{ evidence_label }}</span>
          </aside>
        {% endif %}
      </div>

      <div class="cx-journal__topics" aria-label="{{ index_label }}">
        <span class="cx-journal__topic">{{ theme_one }}</span>
        <span class="cx-journal__topic">{{ theme_two }}</span>
        <span class="cx-journal__topic">{{ theme_three }}</span>
        <span class="cx-journal__topic">{{ theme_four }}</span>
      </div>

      <div class="cx-journal__body">
        <div class="cx-journal__feed">
          {%- for article in blog.articles -%}
            {%- liquid
              assign article_words = article.content | strip_html | split: ' ' | size
              assign read_minutes = article_words | divided_by: 180
              if read_minutes < 1
                assign read_minutes = 1
              endif
              assign article_tag = article.tags.first
              assign display_title = article.title
              if article.excerpt.size > 0
                assign display_excerpt = article.excerpt | strip_html | truncatewords: 34
              else
                assign display_excerpt = article.content | strip_html | truncatewords: 34
              endif
              assign loading_mode = 'lazy'
              if forloop.first
                assign loading_mode = 'eager'
              endif

              case forloop.index
                when 1
                  case locale_code
                    when "nl"
                      assign display_title = "60 avonden, helder geteld: de nieuwe OralBiome Pro verpakking komt eraan"
                      assign display_excerpt = "OralBiome Pro krijgt een aluminium doordrukverpakking met 60 tabletten en een teller op de achterkant. Zo wordt je dagelijkse routine zichtbaarder en makkelijker vol te houden."
                    when "de"
                      assign display_title = "60 Abende, klar gezählt: die neue OralBiome Pro Packung kommt"
                      assign display_excerpt = "OralBiome Pro bekommt eine Aluminium-Durchdrückpackung mit 60 Lutschtabletten und einem Zähler auf der Rückseite. So lässt sich die tägliche Routine leichter verfolgen."
                    when "fr"
                      assign display_title = "60 soirs, clairement comptés : le nouveau pack OralBiome Pro arrive"
                      assign display_excerpt = "OralBiome Pro passe à un format aluminium de 60 pastilles avec un compteur au dos. La routine devient plus visible, plus simple et plus facile à tenir."
                    when "da"
                      assign display_title = "60 aftener, tydeligt talt: den nye OralBiome Pro pakke er på vej"
                      assign display_excerpt = "OralBiome Pro får en aluminiumspakke med 60 sugetabletter og en tæller på bagsiden. Det gør den daglige rutine mere synlig og lettere at holde fast i."
                    when "fi"
                      assign display_title = "60 iltaa, selkeästi laskettuna: uusi OralBiome Pro pakkaus on tulossa"
                      assign display_excerpt = "OralBiome Pro saa 60 imeskelytabletin alumiinipakkauksen, jonka takana on edistymislaskuri. Rutiini on helpompi nähdä, muistaa ja pitää mukana arjessa."
                    when "nb"
                      assign display_title = "60 kvelder, tydelig telt: den nye OralBiome Pro pakken kommer"
                      assign display_excerpt = "OralBiome Pro får en aluminiumspakke med 60 sugetabletter og en teller på baksiden. Slik blir den daglige rutinen mer synlig og enklere å holde."
                    when "sv"
                      assign display_title = "60 kvällar, tydligt räknade: den nya OralBiome Pro förpackningen är på väg"
                      assign display_excerpt = "OralBiome Pro får en aluminiumförpackning med 60 sugtabletter och en räknare på baksidan. Rutinen blir tydligare, synligare och lättare att hålla."
                    else
                      assign display_title = "60 Evenings, Clearly Counted: A New OralBiome Pro Pack Is Coming"
                      assign display_excerpt = "OralBiome Pro is moving to a 60-count aluminium push-through format with a clear progress counter, designed to make the daily ritual easier to follow."
                  endcase
                when 2
                  case locale_code
                    when "nl"
                      assign display_title = "Nano-hydroxyapatiet: het fluoride-alternatief met 40 jaar onderzoek"
                      assign display_excerpt = "Elke dag verliezen tanden mineralen. Nano-hydroxyapatiet lijkt op het mineraal in glazuur en laat zien waarom opbouwen anders voelt dan alleen beschermen."
                    when "de"
                      assign display_title = "Nano-Hydroxylapatit: die Fluorid-Alternative mit 40 Jahren Forschung"
                      assign display_excerpt = "Zähne verlieren täglich Mineralien. Nano-Hydroxylapatit ähnelt dem Mineral im Zahnschmelz und erklärt, warum Aufbau anders wirkt als reine Schutzpflege."
                    when "fr"
                      assign display_title = "Nano-hydroxyapatite : l’alternative au fluor soutenue par 40 ans de recherche"
                      assign display_excerpt = "Chaque jour, les dents perdent des minéraux. La nano-hydroxyapatite imite le minéral de l’émail et aide à comprendre une approche plus réparatrice."
                    when "da"
                      assign display_title = "Nano-hydroxyapatit: alternativet til fluorid med 40 års forskning"
                      assign display_excerpt = "Tænder mister mineraler hver dag. Nano-hydroxyapatit ligner mineralet i emaljen og forklarer, hvorfor genopbygning føles anderledes end ren beskyttelse."
                    when "fi"
                      assign display_title = "Nano-hydroksiapatiitti: fluorin vaihtoehto, jota tukee 40 vuoden tutkimus"
                      assign display_excerpt = "Hampaat menettävät mineraaleja joka päivä. Nano-hydroksiapatiitti muistuttaa kiilteen omaa mineraalia ja auttaa ymmärtämään, miksi uudelleenrakentava hoito tuntuu erilaiselta."
                    when "nb"
                      assign display_title = "Nano-hydroksyapatitt: fluoridalternativet med 40 års forskning"
                      assign display_excerpt = "Tennene mister mineraler hver dag. Nano-hydroksyapatitt ligner mineralet i emaljen og forklarer hvorfor oppbyggende pleie føles annerledes enn bare beskyttelse."
                    when "sv"
                      assign display_title = "Nano-hydroxiapatit: fluoridalternativet med 40 års forskning"
                      assign display_excerpt = "Tänder förlorar mineraler varje dag. Nano-hydroxiapatit liknar mineralet i emaljen och visar varför uppbyggande vård känns annorlunda än enbart skydd."
                    else
                      assign display_title = "Nano-Hydroxyapatite: The Fluoride Alternative Backed by 40 Years of Research"
                      assign display_excerpt = "Every day your teeth lose minerals. Nano-hydroxyapatite mirrors the mineral in enamel and helps explain why rebuilding can feel different from fluoride-only care."
                  endcase
                when 3
                  case locale_code
                    when "nl"
                      assign display_title = "De wetenschap achter je mondmicrobioom: waarom veel mondverzorging de balans mist"
                      assign display_excerpt = "Je mond is een ecosysteem, geen oppervlak dat je moet steriliseren. Ontdek hoe balans, biofilm en dagelijkse gewoontes frisse adem en rustiger tandvlees ondersteunen."
                    when "de"
                      assign display_title = "Die Wissenschaft deines oralen Mikrobioms: warum viele Mundpflegeroutinen die Balance verfehlen"
                      assign display_excerpt = "Dein Mund ist ein Ökosystem, keine Fläche zum Sterilisieren. Erfahre, wie Balance, Biofilm und Gewohnheiten frischen Atem und ruhigeres Zahnfleisch unterstützen."
                    when "fr"
                      assign display_title = "La science du microbiome oral : pourquoi tant de soins bucco-dentaires se trompent"
                      assign display_excerpt = "Votre bouche est un écosystème, pas une surface à stériliser. Comprenez comment l’équilibre, le biofilm et les habitudes quotidiennes soutiennent une bouche plus nette."
                    when "da"
                      assign display_title = "Videnskaben bag dit orale mikrobiom: hvorfor meget mundpleje rammer ved siden af"
                      assign display_excerpt = "Munden er et økosystem, ikke en overflade der skal steriliseres. Se hvordan balance, biofilm og daglige vaner støtter friskere ånde og roligere tandkød."
                    when "fi"
                      assign display_title = "Suun mikrobiomin tiede: miksi moni suunhoitorutiini ohittaa tasapainon"
                      assign display_excerpt = "Suu on ekosysteemi, ei pinta jota pitää steriloida. Lue, miten tasapaino, biofilmi ja päivittäiset tavat tukevat raikkaampaa hengitystä ja rauhallisempia ikeniä."
                    when "nb"
                      assign display_title = "Vitenskapen bak munnens mikrobiom: hvorfor mye munnpleie bommer på balansen"
                      assign display_excerpt = "Munnen er et økosystem, ikke en overflate som skal steriliseres. Se hvordan balanse, biofilm og daglige vaner støtter friskere pust og roligere tannkjøtt."
                    when "sv"
                      assign display_title = "Vetenskapen bakom munmikrobiomet: varför mycket munvård missar balansen"
                      assign display_excerpt = "Munnen är ett ekosystem, inte en yta som ska steriliseras. Se hur balans, biofilm och dagliga vanor stödjer fräschare andedräkt och lugnare tandkött."
                    else
                      assign display_title = "The Science of Your Oral Microbiome: Why Most Oral Care Gets It Wrong"
                      assign display_excerpt = "Your mouth is an ecosystem, not a surface to sterilise. Learn how balance, biofilm and daily habits shape fresher breath and calmer gums."
                  endcase
                when 4
                  case locale_code
                    when "nl"
                      assign display_title = "Bloedend tandvlees, helder uitgelegd"
                      assign display_excerpt = "Bloedend tandvlees is een signaal, geen mysterie. Deze gids legt uit wat irritatie vaak betekent en hoe een schonere routine gezonder weefsel ondersteunt."
                    when "de"
                      assign display_title = "Zahnfleischbluten, verständlich erklärt"
                      assign display_excerpt = "Zahnfleischbluten ist ein Signal, kein Rätsel. Dieser Guide erklärt, was Reizung oft bedeutet und wie eine saubere Routine gesundes Gewebe unterstützt."
                    when "fr"
                      assign display_title = "Gencives qui saignent, expliqué simplement"
                      assign display_excerpt = "Le saignement des gencives est un signal, pas un mystère. Ce guide explique ce que l’irritation indique souvent et comment une routine plus propre aide."
                    when "da"
                      assign display_title = "Blødende tandkød, klart forklaret"
                      assign display_excerpt = "Blødende tandkød er et signal, ikke et mysterium. Guiden forklarer, hvad irritation ofte betyder, og hvordan en renere rutine støtter sundere væv."
                    when "fi"
                      assign display_title = "Vuotavat ikenet, selkeästi selitettynä"
                      assign display_excerpt = "Ikenien vuoto on merkki, ei arvoitus. Opas kertoo, mitä ärsytys usein tarkoittaa ja miten puhtaampi rutiini tukee terveempää kudosta."
                    when "nb"
                      assign display_title = "Blødende tannkjøtt, enkelt forklart"
                      assign display_excerpt = "Blødende tannkjøtt er et signal, ikke et mysterium. Guiden forklarer hva irritasjon ofte betyr og hvordan en renere rutine støtter sunnere vev."
                    when "sv"
                      assign display_title = "Blödande tandkött, tydligt förklarat"
                      assign display_excerpt = "Blödande tandkött är en signal, inte ett mysterium. Guiden förklarar vad irritation ofta betyder och hur en renare rutin stödjer friskare vävnad."
                    else
                      assign display_title = "Bleeding Gums, Properly Explained"
                      assign display_excerpt = "Bleeding gums are a signal, not a mystery. This guide explains what irritation usually means and how a cleaner routine supports healthier tissue."
                  endcase
                when 5
                  case locale_code
                    when "nl"
                      assign display_title = "Gevoelige tanden"
                      assign display_excerpt = "Gevoeligheid begint vaak aan het oppervlak. Lees hoe glazuurslijtage, blootliggend dentine en dagelijkse zuren kou, zoet of poetsen scherp kunnen laten voelen."
                    when "de"
                      assign display_title = "Empfindliche Zähne"
                      assign display_excerpt = "Empfindlichkeit beginnt oft an der Oberfläche. Lies, wie Zahnschmelzabrieb, freiliegendes Dentin und tägliche Säuren Kälte, Süßes oder Putzen scharf wirken lassen."
                    when "fr"
                      assign display_title = "Dents sensibles"
                      assign display_excerpt = "La sensibilité commence souvent en surface. Découvrez comment l’usure de l’émail, la dentine exposée et les acides quotidiens rendent le froid ou le brossage plus vifs."
                    when "da"
                      assign display_title = "Følsomme tænder"
                      assign display_excerpt = "Følsomhed starter ofte i overfladen. Læs hvordan emaljeslid, blotlagt dentin og daglige syrer kan få kulde, sødt eller børstning til at føles skarpt."
                    when "fi"
                      assign display_title = "Vihlonta ja herkät hampaat"
                      assign display_excerpt = "Herkkyys alkaa usein pinnasta. Lue, miten kiilteen kuluminen, paljastunut dentiini ja arjen hapot voivat tehdä kylmästä, makeasta tai harjauksesta terävän tuntuisen."
                    when "nb"
                      assign display_title = "Sensitive tenner"
                      assign display_excerpt = "Sensitivitet starter ofte i overflaten. Les hvordan emaljeslitasje, eksponert dentin og daglige syrer kan få kulde, søtt eller børsting til å kjennes skarpt."
                    when "sv"
                      assign display_title = "Känsliga tänder"
                      assign display_excerpt = "Känslighet börjar ofta i ytan. Läs hur emaljslitage, blottat dentin och dagliga syror kan göra kyla, sött eller borstning skarpt."
                    else
                      assign display_title = "Teeth sensitivity"
                      assign display_excerpt = "Sensitivity often starts at the surface. Learn how enamel wear, exposed dentin and daily acids can make cold, sweet or brushing feel sharp."
                  endcase
                when 6
                  case locale_code
                    when "nl"
                      assign display_title = "Je glimlach vernieuwen: ondersteun je tandherstel op de juiste manier?"
                      assign display_excerpt = "Herstel begint met de juiste omstandigheden. Ontdek hoe mineralen, speeksel en een consequente routine kunnen bijdragen aan een sterker ogende glimlach."
                    when "de"
                      assign display_title = "Dein Lächeln erneuern: unterstützt du die Regeneration deiner Zähne richtig?"
                      assign display_excerpt = "Regeneration beginnt mit den richtigen Bedingungen. Erfahre, wie Mineralien, Speichel und eine konsequente Routine ein stärker wirkendes Lächeln unterstützen."
                    when "fr"
                      assign display_title = "Transformer votre sourire : soutenez-vous vraiment la régénération dentaire ?"
                      assign display_excerpt = "La régénération commence avec les bonnes conditions. Découvrez comment les minéraux, la salive et une routine régulière soutiennent un sourire plus fort."
                    when "da"
                      assign display_title = "Forvandl dit smil: støtter du tandens genopbygning rigtigt?"
                      assign display_excerpt = "Genopbygning starter med de rette betingelser. Se hvordan mineraler, spyt og en konsekvent rutine kan støtte et stærkere smil."
                    when "fi"
                      assign display_title = "Uudista hymysi: tuetko hampaiden palautumista oikein?"
                      assign display_excerpt = "Palautuminen alkaa oikeista olosuhteista. Tutustu siihen, miten mineraalit, sylki ja säännöllinen rutiini voivat tukea vahvemman näköistä hymyä."
                    when "nb"
                      assign display_title = "Forvandle smilet ditt: støtter du tannfornyelsen riktig?"
                      assign display_excerpt = "Fornyelse starter med riktige forhold. Se hvordan mineraler, spytt og en jevn rutine kan støtte et sterkere smil."
                    when "sv"
                      assign display_title = "Förnya ditt leende: stöttar du tandens återhämtning på rätt sätt?"
                      assign display_excerpt = "Återhämtning börjar med rätt förutsättningar. Se hur mineraler, saliv och en konsekvent rutin kan stödja ett starkare leende."
                    else
                      assign display_title = "Transform Your Smile: Are You Aiding Tooth Regeneration?"
                      assign display_excerpt = "Regeneration starts with the right conditions. Explore how minerals, saliva and a consistent routine can support a stronger-looking smile."
                  endcase
              endcase

              case forloop.index
                when 1
                  assign display_title = article_1_title
                  assign display_excerpt = article_1_excerpt
                when 2
                  assign display_title = article_2_title
                  assign display_excerpt = article_2_excerpt
                when 3
                  assign display_title = article_3_title
                  assign display_excerpt = article_3_excerpt
                when 4
                  assign display_title = article_4_title
                  assign display_excerpt = article_4_excerpt
                when 5
                  assign display_title = article_5_title
                  assign display_excerpt = article_5_excerpt
                when 6
                  assign display_title = article_6_title
                  assign display_excerpt = article_6_excerpt
              endcase
            -%}

            <article class="cx-journal-card{% if forloop.first %} cx-journal-card--featured{% endif %}">
              {% if section.settings.show_image and article.image %}
                <a class="cx-journal-card__media" href="{{ article.url }}" aria-label="{{ display_title | escape }}">
                  {{ article.image | image_url: width: 1400 | image_tag: loading: loading_mode, class: 'cx-journal-card__image', widths: '420, 640, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
                </a>
              {% elsif section.settings.show_image %}
                <a class="cx-journal-card__media" href="{{ article.url }}" aria-label="{{ display_title | escape }}">
                  <span class="cx-journal-card__media-placeholder">{{ eyebrow }}</span>
                </a>
              {% endif %}

              <div class="cx-journal-card__content">
                {% if forloop.first %}
                  <p class="cx-journal-card__eyebrow">{{ featured_label }}</p>
                {% endif %}
                <div class="cx-journal-card__meta">
                  {% if article_tag != blank %}
                    <span class="cx-journal-card__tag">{{ article_tag | escape }}</span>
                  {% endif %}
                  {% if section.settings.show_date %}
                    <span>{{ article.published_at | time_tag: format: 'date' }}</span>
                  {% endif %}
                </div>

                <h2 class="cx-journal-card__title">
                  <a href="{{ article.url }}">{{ display_title | escape }}</a>
                </h2>

                <p class="cx-journal-card__excerpt">
                  {%- if forloop.first -%}
                    {{ featured_copy }}
                  {%- endif -%}
                  {{ display_excerpt }}
                </p>

                <div class="cx-journal-card__footer">
                  <a class="cx-journal-card__cta" href="{{ article.url }}">{{ read_label }}</a>
                  <span class="cx-journal-card__readtime">{{ read_minutes }} {{ minutes_label }}</span>
                </div>
              </div>
            </article>
          {%- endfor -%}

          {%- if paginate.pages > 1 -%}
            {%- render 'pagination', paginate: paginate -%}
          {%- endif -%}
        </div>

        <aside class="cx-journal__rail" aria-label="{{ index_label }}">
          <div class="cx-journal-rail__panel">
            <p class="cx-journal-rail__label">{{ index_label }}</p>
            <h2 class="cx-journal-rail__title">{{ method_label }}</h2>
            <p class="cx-journal-rail__copy">{{ method_copy }}</p>
          </div>
          <div class="cx-journal-rail__panel">
            <p class="cx-journal-rail__label">{{ method_eyebrow }}</p>
            <h2 class="cx-journal-rail__title">{{ index_copy }}</h2>
            <ul class="cx-journal-rail__list">
              <li class="cx-journal-rail__item">{{ theme_one }}</li>
              <li class="cx-journal-rail__item">{{ theme_two }}</li>
              <li class="cx-journal-rail__item">{{ theme_three }}</li>
              <li class="cx-journal-rail__item">{{ theme_four }}</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_blog_title",
      "default": true,
      "label": "t:sections.main-blog.settings.show_blog_title.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label",
      "info": "t:sections.main-blog.settings.show_image.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.blocks.title.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": true,
      "label": "t:sections.main-blog.blocks.title.settings.show_author.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.2.label"
        },
        {
          "value": "3",
          "label": "t:sections.main-collection-product-grid.settings.columns_desktop.3.label"
        }
      ],
      "default": "3",
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "button_select",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.settings.settings.button_select.primary.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.settings.settings.button_select.secondary.label"
        },
        {
          "value": "link",
          "label": "t:sections.settings.settings.button_select.link.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.settings.settings.button_select.second_default.label"
    },
    {
      "type": "range",
      "id": "size_heading",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading.label",
      "unit": "%"
    },
    {
      "type": "range",
      "id": "size_heading_mobile",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading-mobile.label",
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "t:sections.global.margin-top"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "t:sections.global.margin-bottom",
      "info": "t:sections.separator.settings.separator-bottom.info"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
