{% assign background_rgb = section.settings['color-bg-overlay'] | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}
{% liquid
  assign cq_is_impressum_page = false
  assign cq_show_impressum = false

  if page.handle == 'impressum'
    assign cq_is_impressum_page = true
  endif

  assign cq_is_about_page = false
  assign cq_request_path = request.path
  if page.id == 156646211913 or page.handle == 'about-us' or page.handle == 'over-ons' or page.handle == 'uber-uns' or page.handle == 'a-propos' or template.suffix == 'about-us' or cq_request_path contains '/pages/about-us' or cq_request_path contains '/pages/over-ons' or cq_request_path contains '/pages/uber-uns' or cq_request_path contains '/pages/a-propos'
    assign cq_is_about_page = true
  endif

  if localization.country.iso_code == 'DE'
    assign cq_show_impressum = true
  endif
%}
<style>
  section[id="shopify-section-{{ section.id }}"]{
      {% if section.settings.full-width-enabled %}
        --border-radius: 0;
      {% endif %}

      {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ section.settings.color-bg-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: {{ section.settings['color-overlay-opacity'] | divided_by: 100.0 }};
      {% endif %}

      {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.color-body-text }};
      {% endif %}

      {% if section.settings.margin-top %}
          --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
          --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}

      --font-headline-scale-desk: {{ section.settings.size_heading | divided_by: 100.0 }};

      --font-headline-scale: {{ section.settings.size_heading_mobile | divided_by: 100.0 }};

  }

  {% if cq_is_impressum_page %}
    #shopify-section-{{ section.id }} .cq-impressum {
      --cq-navy: #1a3b5c;
      --cq-navy-deep: #0d1c2b;
      --cq-accent: #4a8ec2;
      --cq-gold: #e8c96a;
      --cq-surface: #ffffff;
      --cq-surface-soft: #f6f9fc;
      --cq-border: rgba(26, 59, 92, 0.12);
      --cq-text-soft: rgba(13, 28, 43, 0.74);
      --cq-shadow: 0 14px 38px rgba(13, 28, 43, 0.06);
      background:
        radial-gradient(circle at top right, rgba(74, 142, 194, 0.08), transparent 34%),
        linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
      color: var(--cq-navy-deep);
      padding: clamp(48px, 7vw, 96px) 0;
    }

    #shopify-section-{{ section.id }} .cq-impressum .page-width {
      max-width: 1180px;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    #shopify-section-{{ section.id }} .cq-impressum__shell {
      max-width: 980px;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .cq-impressum__eyebrow {
      display: inline-flex;
      align-items: center;
      min-height: 34px;
      padding: 0 14px;
      margin-bottom: 18px;
      border: 1px solid var(--cq-border);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.9);
      color: var(--cq-accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .cq-impressum__hero {
      margin-bottom: 26px;
    }

    #shopify-section-{{ section.id }} .cq-impressum__title {
      margin: 0 0 14px;
      color: var(--cq-navy);
      font-size: clamp(40px, 6vw, 64px);
      line-height: 1.02;
      letter-spacing: -0.03em;
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .cq-impressum__lead {
      max-width: 760px;
      margin: 0;
      color: var(--cq-text-soft);
      font-size: clamp(17px, 2vw, 20px);
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .cq-impressum__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }

    #shopify-section-{{ section.id }} .cq-impressum__meta span {
      display: inline-flex;
      align-items: center;
      min-height: 34px;
      padding: 0 12px;
      border-radius: 999px;
      background: rgba(46, 109, 164, 0.08);
      color: var(--cq-navy);
      font-size: 13px;
      font-weight: 600;
    }

    #shopify-section-{{ section.id }} .cq-impressum__notice,
    #shopify-section-{{ section.id }} .cq-impressum__block,
    #shopify-section-{{ section.id }} .cq-impressum__card {
      border: 1px solid var(--cq-border);
      border-radius: 24px;
      background: var(--cq-surface);
      box-shadow: var(--cq-shadow);
      content-visibility: auto;
    }

    #shopify-section-{{ section.id }} .cq-impressum__notice,
    #shopify-section-{{ section.id }} .cq-impressum__block {
      margin-bottom: 22px;
      padding: 22px 24px;
    }

    #shopify-section-{{ section.id }} .cq-impressum__block--soft {
      background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    }

    #shopify-section-{{ section.id }} .cq-impressum__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 22px;
    }

    #shopify-section-{{ section.id }} .cq-impressum__card {
      height: 100%;
      padding: 24px;
    }

    #shopify-section-{{ section.id }} .cq-impressum__notice p,
    #shopify-section-{{ section.id }} .cq-impressum__block p,
    #shopify-section-{{ section.id }} .cq-impressum__card p,
    #shopify-section-{{ section.id }} .cq-impressum__card address {
      margin: 0;
      color: var(--cq-text-soft);
      font-size: 16px;
      line-height: 1.8;
      font-style: normal;
    }

    #shopify-section-{{ section.id }} .cq-impressum__card h2,
    #shopify-section-{{ section.id }} .cq-impressum__block h2 {
      margin: 0 0 12px;
      color: var(--cq-navy);
      font-size: 20px;
      line-height: 1.25;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    #shopify-section-{{ section.id }} .cq-impressum a {
      color: var(--cq-accent);
      text-decoration: none;
      border-bottom: 1px solid rgba(74, 142, 194, 0.24);
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .cq-impressum a:hover,
    #shopify-section-{{ section.id }} .cq-impressum a:focus-visible {
      color: var(--cq-navy);
      border-color: rgba(26, 59, 92, 0.3);
      outline: none;
    }

    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .cq-impressum__grid {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .cq-impressum__title {
        font-size: 42px;
      }

      #shopify-section-{{ section.id }} .cq-impressum__notice,
      #shopify-section-{{ section.id }} .cq-impressum__block,
      #shopify-section-{{ section.id }} .cq-impressum__card {
        padding: 20px;
        border-radius: 20px;
      }
    }
  {% endif %}

  {% if cq_is_about_page %}
    #shopify-section-{{ section.id }} .cq-about {
      --cq-navy: #1a3b5c;
      --cq-deep: #092743;
      --cq-muted: rgba(26, 59, 92, 0.72);
      --cq-soft: #f4f8fc;
      --cq-line: rgba(26, 59, 92, 0.14);
      --cq-gold: #d4b46e;
      color: var(--cq-deep);
      background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
      padding: clamp(44px, 6vw, 88px) 0 clamp(56px, 7vw, 96px);
    }

    #shopify-section-{{ section.id }} .cq-about__wrap {
      max-width: 1060px;
      margin: 0 auto;
      padding: 0 24px;
    }

    #shopify-section-{{ section.id }} .cq-about__eyebrow {
      display: inline-flex;
      margin-bottom: 16px;
      color: var(--cq-gold);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .cq-about__title {
      max-width: 780px;
      margin: 0;
      color: var(--cq-navy);
      font-family: var(--cx-f-display, "Playfair Display", serif);
      font-size: clamp(40px, 6vw, 76px);
      line-height: 0.98;
      font-weight: 500;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .cq-about__lead {
      max-width: 760px;
      margin: 22px 0 0;
      color: var(--cq-muted);
      font-size: clamp(16px, 2vw, 20px);
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .cq-about__intro {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(22px, 5vw, 56px);
      margin-top: clamp(34px, 6vw, 72px);
      padding-top: clamp(28px, 5vw, 48px);
      border-top: 1px solid var(--cq-line);
    }

    #shopify-section-{{ section.id }} .cq-about__intro p,
    #shopify-section-{{ section.id }} .cq-about__body p {
      margin: 0;
      color: var(--cq-muted);
      font-size: 15px;
      line-height: 1.85;
    }

    #shopify-section-{{ section.id }} .cq-about__intro p + p {
      margin-top: 16px;
    }

    #shopify-section-{{ section.id }} .cq-about__section {
      margin-top: clamp(42px, 7vw, 76px);
      padding-top: clamp(30px, 5vw, 48px);
      border-top: 1px solid var(--cq-line);
    }

    #shopify-section-{{ section.id }} .cq-about__section-title {
      margin: 0 0 22px;
      color: var(--cq-navy);
      font-family: var(--cx-f-display, "Playfair Display", serif);
      font-size: clamp(26px, 3.4vw, 38px);
      line-height: 1.1;
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .cq-about__pillars {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      overflow: hidden;
      border: 1px solid var(--cq-line);
      border-radius: 8px;
      background: var(--cq-line);
    }

    #shopify-section-{{ section.id }} .cq-about__pillar {
      min-height: 100%;
      padding: 24px;
      background: rgba(255, 255, 255, 0.92);
    }

    #shopify-section-{{ section.id }} .cq-about__num {
      margin-bottom: 18px;
      color: rgba(26, 59, 92, 0.18);
      font-family: var(--cx-f-display, "Playfair Display", serif);
      font-size: 40px;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .cq-about__pillar h3,
    #shopify-section-{{ section.id }} .cq-about__team h3 {
      margin: 0 0 9px;
      color: var(--cq-navy);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .cq-about__pillar p,
    #shopify-section-{{ section.id }} .cq-about__team p {
      margin: 0;
      color: var(--cq-muted);
      font-size: 14px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .cq-about__science {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.95fr);
      gap: clamp(26px, 5vw, 60px);
      align-items: center;
    }

    #shopify-section-{{ section.id }} .cq-about__formula {
      padding: clamp(24px, 4vw, 42px);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0)),
        var(--cq-deep);
      color: #fff;
    }

    #shopify-section-{{ section.id }} .cq-about__formula-main {
      margin-bottom: 10px;
      font-family: var(--cx-f-display, "Playfair Display", serif);
      font-size: clamp(25px, 3vw, 38px);
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .cq-about__formula-sub {
      color: rgba(255,255,255,0.54);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .cq-about__team-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      max-width: 760px;
    }

    #shopify-section-{{ section.id }} .cq-about__team {
      padding: 22px;
      border: 1px solid var(--cq-line);
      border-radius: 8px;
      background: rgba(255,255,255,0.88);
    }

    #shopify-section-{{ section.id }} .cq-about__mission {
      margin-top: clamp(46px, 7vw, 84px);
      padding: clamp(30px, 5vw, 54px);
      border-radius: 8px;
      background: var(--cq-navy);
      color: #fff;
    }

    #shopify-section-{{ section.id }} .cq-about__mission p {
      max-width: 720px;
      margin: 0;
      color: rgba(255,255,255,0.82);
      font-family: var(--cx-f-display, "Playfair Display", serif);
      font-size: clamp(24px, 4vw, 38px);
      line-height: 1.25;
    }

    @media (max-width: 760px) {
      #shopify-section-{{ section.id }} .cq-about__intro,
      #shopify-section-{{ section.id }} .cq-about__science,
      #shopify-section-{{ section.id }} .cq-about__team-grid {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .cq-about__pillars {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .cq-about__wrap {
        padding: 0 20px;
      }
    }
  {% endif %}
</style>

{% if cq_is_impressum_page %}
  {% if cq_show_impressum %}
    <section class="cq-impressum">
      <div class="page-width">
        <div class="cq-impressum__shell">
          <span class="cq-impressum__eyebrow">Deutschland · Rechtliche Anbieterkennzeichnung</span>

          <header class="cq-impressum__hero">
            <h1 class="cq-impressum__title">Impressum</h1>
            <p class="cq-impressum__lead">
              Pflichtangaben für den deutschen Markt im klaren, klinischen CALQIX-Stil.
            </p>
            <div class="cq-impressum__meta">
              <span>CALQIX</span>
              <span>Kesekesa Holding B.V.</span>
              <span>Deutschland</span>
            </div>
          </header>

          <div class="cq-impressum__notice">
            <p>
              <strong>Hinweis zur Marke:</strong>
              CALQIX ist die Gründermarke und der operative Markenauftritt. Rechtlich verantwortlicher Diensteanbieter dieser Website ist die
              <strong>Kesekesa Holding B.V.</strong>
            </p>
          </div>

          <div class="cq-impressum__grid">
            <article class="cq-impressum__card">
              <h2>Anbieter</h2>
              <address>
                Kesekesa Holding B.V.<br>
                CALQIX<br>
                3824 KG Amersfoort<br>
                Niederlande
              </address>
            </article>

            <article class="cq-impressum__card">
              <h2>Vertreten durch</h2>
              <p>Hediveleck Kesekesa (DGA)</p>
            </article>

            <article class="cq-impressum__card">
              <h2>Kontakt</h2>
              <p>
                E-Mail: <a href="mailto:info@calqix.com">info@calqix.com</a><br>
                Website: <a href="https://www.calqix.com">www.calqix.com</a><br>
                Weitere Kontaktmöglichkeit: Kontaktformular oder Live-Chat über die Website
              </p>
            </article>

            <article class="cq-impressum__card">
              <h2>Handelsregister</h2>
              <p>
                Eingetragen bei der Kamer van Koophandel (Niederlande)<br>
                KvK-Nummer: 98836196
              </p>
            </article>

            <article class="cq-impressum__card">
              <h2>Umsatzsteuer</h2>
              <p>
                Umsatzsteuer-Identifikationsnummer gemäß Art. 9c MwStSystRL:<br>
                NL005357319B89
              </p>
            </article>

            <article class="cq-impressum__card">
              <h2>Verantwortlich für den Inhalt</h2>
              <address>
                Hediveleck Kesekesa<br>
                Kesekesa Holding B.V.<br>
                CALQIX<br>
                3824 KG Amersfoort<br>
                Niederlande
              </address>
            </article>
          </div>

          <div class="cq-impressum__block">
            <h2>Verbraucherstreitbeilegung</h2>
            <p>
              Wir sind weder verpflichtet noch bereit, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
            </p>
          </div>

          <div class="cq-impressum__block cq-impressum__block--soft">
            <h2>Rechtlicher Hinweis</h2>
            <p>
              Dieses Impressum gilt für den deutschen Markt und wird ausschließlich innerhalb des Shopify-Marktes Deutschland ausgespielt.
            </p>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{% elsif cq_is_about_page %}
  <section class="cq-about">
    <div class="cq-about__wrap">
      <span class="cq-about__eyebrow">{{ 'calqix_about.hero_eyebrow' | t }}</span>
      <h1 class="cq-about__title">{{ 'calqix_about.hero_title' | t }}</h1>
      <p class="cq-about__lead">{{ 'calqix_about.hero_lead' | t }}</p>

      <div class="cq-about__intro">
        <div>
          <p>{{ 'calqix_about.origin_p1' | t }}</p>
          <p>{{ 'calqix_about.origin_p2' | t }}</p>
        </div>
        <div>
          <p>{{ 'calqix_about.origin_p3' | t }}</p>
          <p>{{ 'calqix_about.origin_p4' | t }}</p>
        </div>
      </div>

      <div class="cq-about__section">
        <h2 class="cq-about__section-title">{{ 'calqix_about.pillars_title' | t }}</h2>
        <div class="cq-about__pillars">
          {%- for i in (1..3) -%}
            {%- assign title_key = 'calqix_about.pillar_' | append: i | append: '_title' -%}
            {%- assign text_key = 'calqix_about.pillar_' | append: i | append: '_text' -%}
            <article class="cq-about__pillar">
              <div class="cq-about__num">0{{ i }}</div>
              <h3>{{ title_key | t }}</h3>
              <p>{{ text_key | t }}</p>
            </article>
          {%- endfor -%}
        </div>
      </div>

      <div class="cq-about__section cq-about__science">
        <div class="cq-about__body">
          <h2 class="cq-about__section-title">{{ 'calqix_about.science_title' | t }}</h2>
          <p>{{ 'calqix_about.science_p1' | t }}</p>
          <p>{{ 'calqix_about.science_p2' | t }}</p>
        </div>
        <div class="cq-about__formula" aria-label="{{ 'calqix_about.formula_label' | t }}">
          <div class="cq-about__formula-main">Ca10(PO4)6(OH)2</div>
          <div class="cq-about__formula-sub">{{ 'calqix_about.formula_label' | t }}</div>
        </div>
      </div>

      <div class="cq-about__section">
        <h2 class="cq-about__section-title">{{ 'calqix_about.team_title' | t }}</h2>
        <div class="cq-about__team-grid">
          <article class="cq-about__team">
            <h3>{{ 'calqix_about.team_1_name' | t }}</h3>
            <p><strong>{{ 'calqix_about.team_1_role' | t }}</strong></p>
            <p>{{ 'calqix_about.team_1_text' | t }}</p>
          </article>
          <article class="cq-about__team">
            <h3>{{ 'calqix_about.team_2_name' | t }}</h3>
            <p><strong>{{ 'calqix_about.team_2_role' | t }}</strong></p>
            <p>{{ 'calqix_about.team_2_text' | t }}</p>
          </article>
        </div>
      </div>

      <div class="cq-about__mission">
        <p>{{ 'calqix_about.mission' | t }}</p>
      </div>
    </div>
  </section>
{% else %}
  <div
    data-section-id="{{ section.id }}"
    class="wt-page {% if section.settings.compact-size-enabled == true %}  wt-page--compact{% endif %}"
  >
    <h1 class="wt-page__title">
      {{ page.title | escape }}
    </h1>
    <div class="rte wt-page__wrapper">
      {{ page.content }}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.page.main_name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "compact-size-enabled",
      "label": "Use compact size for big screens",
      "default": true
    },
    {
      "type": "range",
      "id": "size_heading",
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 140,
      "label": "t:sections.settings.settings.size-heading.label",
      "unit": "%"
    },
    {
      "type": "range",
      "id": "size_heading_mobile",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading-mobile.label",
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "color-bg-overlay",
      "default": "transparent",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "range",
      "id": "color-overlay-opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.settings.settings.background-opacity.label"
    },
    {
      "type": "header",
