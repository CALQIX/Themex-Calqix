{%- comment -%}
  CALQIX Navy Rebuild — Journal (latest 3 blog articles).
  Source: _incoming/calqix-web-upgrade/handoff/source/components/body.jsx → Journal
{%- endcomment -%}

{%- assign cx_blog = blogs[section.settings.blog] -%}
{%- liquid
  assign cx_journal_eyebrow = 'homepage.journal.eyebrow' | t
  assign cx_journal_heading = 'homepage.journal.heading_html' | t
  assign cx_journal_lede = 'homepage.journal.lede' | t
  assign cx_journal_cta = 'homepage.journal.cta_text' | t
  assign cx_journal_start = 'homepage.journal.start_here' | t
  assign cx_journal_next = 'homepage.journal.read_next' | t
  assign cx_journal_read = 'homepage.journal.read_label' | t
-%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section cx-journal-v2" id="journal" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-journal-header">
      <div class="cx-stack cx-gap-sm">
        {% render 'cx-eyebrow', text: cx_journal_eyebrow %}
        <h2 class="cx-h2 cx-journal-heading">{{ cx_journal_heading }}</h2>
        <p class="cx-journal-lede">{{ cx_journal_lede }}</p>
      </div>
      {%- if section.settings.cta_text != blank -%}
        {%- assign cx_journal_href = section.settings.cta_link | default: cx_blog.url | default: '#' -%}
        {%- assign cx_btn_kind = section.settings.cta_style | default: 'inline' -%}
        {%- case cx_btn_kind -%}
          {%- when 'gold' -%}<a class="cx-btn cx-btn-gold" href="{{ cx_journal_href }}">{{ cx_journal_cta }} <span class="cx-arrow"></span></a>
          {%- when 'navy' -%}<a class="cx-btn cx-btn-primary" href="{{ cx_journal_href }}">{{ cx_journal_cta }} <span class="cx-arrow"></span></a>
          {%- when 'ghost' -%}<a class="cx-btn cx-btn-ghost" href="{{ cx_journal_href }}">{{ cx_journal_cta }} <span class="cx-arrow"></span></a>
          {%- else -%}<a class="cx-btn-inline" href="{{ cx_journal_href }}">{{ cx_journal_cta }} <span class="cx-arrow"></span></a>
        {%- endcase -%}
      {%- endif -%}
    </div>

    <div class="cx-journal-guide" aria-label="Journal reading themes">
      <span>{{ 'homepage.journal.theme_1' | t }}</span>
      <span>{{ 'homepage.journal.theme_2' | t }}</span>
      <span>{{ 'homepage.journal.theme_3' | t }}</span>
      <span>{{ 'homepage.journal.theme_4' | t }}</span>
    </div>

    <div class="cx-journal-grid" data-cx-col3 data-cx-stagger>
      {%- if cx_blog.articles.size > 0 -%}
        {%- for article in cx_blog.articles limit: 3 -%}
          <a href="{{ article.url }}" class="cx-journal-card{% if forloop.first %} cx-journal-card-featured{% endif %} cx-lux-lift">
            {%- if article.image != blank -%}
              <div class="cx-journal-media">
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title, class: 'cx-journal-img' }}
                <span class="cx-journal-media-badge">{% if forloop.first %}{{ cx_journal_start }}{% else %}{{ cx_journal_next }}{% endif %}</span>
              </div>
            {%- else -%}
              {% render 'cx-placeholder', ratio: '4/3', label: article.tags.first | upcase, radius: 'var(--cx-r-md)' %}
            {%- endif -%}
            <div class="cx-journal-meta-row">
              <span>{{ article.published_at | date: '%d %b %Y' | upcase }}</span>
              {%- if article.tags.size > 0 -%}
                <span class="cx-journal-tag">{{ article.tags.first | upcase }}</span>
              {%- endif -%}
            </div>
            <h3 class="cx-journal-title">{{ article.title }}</h3>
            <p class="cx-journal-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
            <span class="cx-journal-read">{{ cx_journal_read }} <span class="cx-arrow"></span></span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback: show 3 block placeholders {%- endcomment -%}
        {%- for block in section.blocks limit: 3 -%}
          {%- if block.type == 'placeholder_post' -%}
            <a href="{{ block.settings.link | default: '#' }}" class="cx-journal-card{% if forloop.first %} cx-journal-card-featured{% endif %} cx-lux-lift" {{ block.shopify_attributes }}>
              {% render 'cx-placeholder', ratio: '4/3', label: block.settings.tag, radius: 'var(--cx-r-md)' %}
              <div class="cx-journal-meta-row">
                <span>{{ block.settings.date }}</span>
                <span class="cx-journal-tag">{{ block.settings.tag }}</span>
              </div>
              <h3 class="cx-journal-title">{{ block.settings.title }}</h3>
              <p class="cx-journal-excerpt">{{ block.settings.excerpt }}</p>
              <span class="cx-journal-read">{{ cx_journal_read }} <span class="cx-arrow"></span></span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .cx-journal-v2 {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 16%, rgba(0, 118, 194, .1), transparent 30%),
      linear-gradient(180deg, #edf5ff 0%, #f8fbff 48%, #eef6ff 100%);
  }

  .cx-journal-v2::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 37, 73, .04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 37, 73, .04) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
    pointer-events: none;
  }

  .cx-journal-v2 .cx-container { position: relative; z-index: 1; }

  .cx-journal-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(24px, 5vw, 70px);
    margin-bottom: 20px;
  }

  .cx-journal-heading { max-width: 12ch; }

  .cx-journal-lede {
    max-width: 560px;
    margin: 6px 0 0;
    color: #1d3d60;
    font-size: 17px;
    line-height: 1.55;
  }

  .cx-journal-header .cx-btn-inline {
    border-radius: 999px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, .72);
    border: 1px solid rgba(0, 37, 73, .12);
    box-shadow: 0 14px 36px rgba(0, 37, 73, .07);
  }

  .cx-journal-guide {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 28px;
  }

  .cx-journal-guide span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(0, 37, 73, .12);
    border-radius: 999px;
    background: rgba(255, 255, 255, .72);
    color: #16385b;
    font-size: 12px;
    font-weight: 800;
  }

  .cx-journal-grid {
    display: grid;
    grid-template-columns: 1.08fr 1fr 1fr;
    gap: clamp(16px, 2.4vw, 28px);
  }

  .cx-journal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 100%;
    padding: 14px 14px 18px;
    border-radius: 20px;
    border: 1px solid rgba(0, 37, 73, .12);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(246, 251, 255, .82)),
      radial-gradient(circle at 86% 8%, rgba(0, 118, 194, .1), transparent 28%);
    color: var(--cx-ink);
    box-shadow: 0 22px 60px rgba(0, 37, 73, .08);
    text-decoration: none;
    overflow: hidden;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
  }

  .cx-journal-card::after {
    content: "";
    position: absolute;
    inset: auto -44px -54px auto;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 118, 194, .16), transparent 65%);
    opacity: 0;
    transition: opacity .3s ease, transform .3s ease;
  }

  .cx-journal-card:hover {
    transform: translateY(-6px);
    border-color: rgba(0, 118, 194, .32);
    box-shadow: 0 30px 76px rgba(0, 37, 73, .14);
  }

  .cx-journal-card:hover::after {
    opacity: 1;
    transform: translate(-10px, -10px);
  }

  .cx-journal-card-featured {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .94), rgba(240, 248, 255, .88)),
      radial-gradient(circle at 20% 0%, rgba(209, 170, 84, .14), transparent 32%);
  }

  .cx-journal-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1.28;
    background: var(--cx-page-2);
  }

  .cx-journal-card-featured .cx-journal-media { aspect-ratio: 1.22; }

  .cx-journal-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 52%, rgba(0, 37, 73, .34)),
      radial-gradient(circle at 20% 18%, rgba(255, 255, 255, .24), transparent 34%);
    pointer-events: none;
  }

  .cx-journal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    transition: transform .55s ease, filter .55s ease;
  }

  .cx-journal-card:hover .cx-journal-img {
    transform: scale(1.06);
    filter: saturate(1.08) contrast(1.03);
  }

  .cx-journal-media-badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    padding: 0 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .9);
    color: #002549;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
    box-shadow: 0 12px 32px rgba(0, 37, 73, .16);
  }

  .cx-journal-meta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--cx-f-mono);
    font-size: 10.5px;
    color: #6d87a3;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .cx-journal-tag { color: #8a6a2a; }

  .cx-journal-title {
    margin: 0;
    color: #002549;
    font-family: var(--cx-f-display);
    font-size: clamp(23px, 2vw, 30px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .cx-journal-card:not(.cx-journal-card-featured) .cx-journal-title {
    font-size: clamp(21px, 1.6vw, 25px);
  }

  .cx-journal-excerpt {
    margin: 0;
    color: #1d3d60;
    font-size: 14.5px;
    line-height: 1.55;
  }

  .cx-journal-read {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    background: #002549;
    color: #fff;
    font-size: 13.5px;
    font-weight: 900;
    box-shadow: 0 14px 34px rgba(0, 37, 73, .17);
    transition: transform .28s ease, background .28s ease;
  }

  .cx-journal-card:hover .cx-journal-read {
    transform: translateY(-2px);
    background: #0076c2;
  }

  @media (max-width: 980px) {
    .cx-journal-header { grid-template-columns: 1fr; align-items: start; }
    .cx-journal-heading { max-width: 15ch; }
    .cx-journal-grid {
      display: flex;
      overflow-x: auto;
      padding: 2px 2px 18px;
      scroll-snap-type: x mandatory;
    }
    .cx-journal-card {
      flex: 0 0 min(82vw, 380px);
      scroll-snap-align: start;
    }
  }

  @media (max-width: 640px) {
    .cx-journal-v2 { padding-top: 56px; padding-bottom: 58px; }
    .cx-journal-header { margin-bottom: 16px; }
    .cx-journal-lede { font-size: 14.5px; line-height: 1.48; }
    .cx-journal-guide {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 8px;
      margin-bottom: 16px;
    }
    .cx-journal-guide span { flex: 0 0 auto; }
    .cx-journal-card {
      flex-basis: min(78vw, 320px);
      border-radius: 18px;
      padding: 12px 12px 16px;
      gap: 13px;
    }
    .cx-journal-media,
    .cx-journal-card-featured .cx-journal-media {
      aspect-ratio: 1.18;
      border-radius: 14px;
    }
    .cx-journal-title { font-size: 24px; }
    .cx-journal-card:not(.cx-journal-card-featured) .cx-journal-title { font-size: 22px; }
    .cx-journal-excerpt { font-size: 13.5px; }
    .cx-journal-read { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "CX Journal",
  "tag": "section",
  "class": "cx-section-journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Science Journal" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Layered knowledge, <em>clearly told.</em></p>" },
    { "type": "textarea", "id": "lede", "label": "Short intro", "default": "Short, evidence-led reads for people who want to understand what actually changes their mouth." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "read_label", "label": "Read-article link label", "default": "Read article" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "All articles" },
    { "type": "url",  "id": "cta_link", "label": "Button link (empty = use blog URL)" },
    {
      "type": "select", "id": "cta_style", "label": "Button style",
      "default": "inline",
      "options": [
        { "value": "gold",   "label": "Gold (filled)" },
        { "value": "navy",   "label": "Navy (filled)" },
        { "value": "ghost",  "label": "Outline" },
        { "value": "inline", "label": "Inline arrow" }
      ]
    },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "placeholder_post",
      "name": "Fallback post",
      "settings": [
        { "type": "text", "id": "date", "label": "Date", "default": "15 APR 2026" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "SCIENCE" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nano-hydroxyapatite: the fluoride alternative" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "You lose enamel every day. 87% of experts see nano-HA as the alternative route." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "placeholder_post", "settings": { "date": "15 APR 2026", "tag": "SCIENCE", "title": "Nano-hydroxyapatite: the fluoride alternative with 40 years of research", "excerpt": "You lose enamel every day. 87% of experts see nano-HA as the fluoride-free, clinically supported alternative route." } },
      { "type": "placeholder_post", "settings": { "date": "02 APR 2026", "tag": "ROUTINE", "title": "The science behind your oral microbiome",     "excerpt": "Your mouth hosts 700 bacterial species in a fragile balance. Here's how to protect it." } },
      { "type": "placeholder_post", "settings": { "date": "18 MAR 2026", "tag": "HEALTH",  "title": "Bleeding gums explained",                    "excerpt": "Is gum bleeding while brushing okay? On the difference between healthy cleaning and disturbance." } }
    ]
  }
}
{% endschema %}
