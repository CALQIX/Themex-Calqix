{%- comment -%}
  CALQIX Navy Rebuild — Journal (latest 3 blog articles).
  Source: _incoming/calqix-web-upgrade/handoff/source/components/body.jsx → Journal
{%- endcomment -%}

{%- assign cx_blog = blogs[section.settings.blog] -%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section cx-section-cream" id="journal" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-journal-header">
      <div class="cx-stack cx-gap-sm">
        {% render 'cx-eyebrow', text: section.settings.eyebrow %}
        <h2 class="cx-h2 cx-journal-heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.cta_text != blank -%}
        {%- assign cx_journal_href = section.settings.cta_link | default: cx_blog.url | default: '#' -%}
        {%- assign cx_btn_kind = section.settings.cta_style | default: 'inline' -%}
        {%- case cx_btn_kind -%}
          {%- when 'gold' -%}<a class="cx-btn cx-btn-gold" href="{{ cx_journal_href }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
          {%- when 'navy' -%}<a class="cx-btn cx-btn-primary" href="{{ cx_journal_href }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
          {%- when 'ghost' -%}<a class="cx-btn cx-btn-ghost" href="{{ cx_journal_href }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
          {%- else -%}<a class="cx-btn-inline" href="{{ cx_journal_href }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
        {%- endcase -%}
      {%- endif -%}
    </div>

    <div class="cx-journal-grid" data-cx-col3 data-cx-stagger>
      {%- if cx_blog.articles.size > 0 -%}
        {%- for article in cx_blog.articles limit: 3 -%}
          <a href="{{ article.url }}" class="cx-journal-card cx-lux-lift">
            {%- if article.image != blank -%}
              <div class="cx-journal-media">
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title, class: 'cx-journal-img' }}
              </div>
            {%- else -%}
              {% render 'cx-placeholder', ratio: '4/3', label: article.tags.first | upcase, radius: 'var(--cx-r-md)' %}
            {%- endif -%}
            <div class="cx-journal-meta-row">
              <span>{{ article.published_at | date: '%d %b %Y' | upcase }}</span>
              {%- if article.tags.size > 0 -%}
                <span class="cx-journal-tag">{{ article.tags.first | upcase }}</span>
              {%- endif -%}
            </div>
            <h3 class="cx-journal-title">{{ article.title }}</h3>
            <p class="cx-journal-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
            <span class="cx-btn-inline cx-journal-read">{{ section.settings.read_label | default: 'Read article' }} <span class="cx-arrow"></span></span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback: show 3 block placeholders {%- endcomment -%}
        {%- for block in section.blocks limit: 3 -%}
          {%- if block.type == 'placeholder_post' -%}
            <a href="{{ block.settings.link | default: '#' }}" class="cx-journal-card cx-lux-lift" {{ block.shopify_attributes }}>
              {% render 'cx-placeholder', ratio: '4/3', label: block.settings.tag, radius: 'var(--cx-r-md)' %}
              <div class="cx-journal-meta-row">
                <span>{{ block.settings.date }}</span>
                <span class="cx-journal-tag">{{ block.settings.tag }}</span>
              </div>
              <h3 class="cx-journal-title">{{ block.settings.title }}</h3>
              <p class="cx-journal-excerpt">{{ block.settings.excerpt }}</p>
              <span class="cx-btn-inline cx-journal-read">{{ section.settings.read_label | default: 'Read article' }} <span class="cx-arrow"></span></span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .cx-journal-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 40px; gap: 24px; flex-wrap: wrap;
  }
  .cx-journal-heading { max-width: 14ch; }
  .cx-journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .cx-journal-card {
    display: flex; flex-direction: column; gap: 18px;
    padding: 14px; margin: -14px;
    border-radius: var(--cx-r-md);
    border: 1px solid transparent;
    color: var(--cx-ink);
  }
  .cx-journal-media { border-radius: var(--cx-r-md); overflow: hidden; aspect-ratio: 4/3; background: var(--cx-page-2); }
  .cx-journal-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cx-journal-meta-row {
    display: flex; gap: 14px;
    font-family: var(--cx-f-mono); font-size: 11px;
    color: var(--cx-ink-mute); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .cx-journal-tag { color: var(--cx-gold-ink); }
  .cx-journal-title { font-family: var(--cx-f-display); font-size: 22px; margin: 0; letter-spacing: -0.01em; line-height: 1.2; }
  .cx-journal-excerpt { margin: 0; font-size: 14.5px; color: var(--cx-ink-soft); }
  .cx-journal-read { margin-top: 4px; }
</style>

{% schema %}
{
  "name": "CX Journal",
  "tag": "section",
  "class": "cx-section-journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Science Journal" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Layered knowledge, <em>clearly told.</em></p>" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "read_label", "label": "Read-article link label", "default": "Read article" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "All articles" },
    { "type": "url",  "id": "cta_link", "label": "Button link (empty = use blog URL)" },
    {
      "type": "select", "id": "cta_style", "label": "Button style",
      "default": "inline",
      "options": [
        { "value": "gold",   "label": "Gold (filled)" },
        { "value": "navy",   "label": "Navy (filled)" },
        { "value": "ghost",  "label": "Outline" },
        { "value": "inline", "label": "Inline arrow" }
      ]
    },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "placeholder_post",
      "name": "Fallback post",
      "settings": [
        { "type": "text", "id": "date", "label": "Date", "default": "15 APR 2026" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "SCIENCE" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nano-hydroxyapatite: the fluoride alternative" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "You lose enamel every day. 87% of experts see nano-HA as the alternative route." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "placeholder_post", "settings": { "date": "15 APR 2026", "tag": "SCIENCE", "title": "Nano-hydroxyapatite: the fluoride alternative with 40 years of research", "excerpt": "You lose enamel every day. 87% of experts see nano-HA as the fluoride-free, clinically supported alternative route." } },
      { "type": "placeholder_post", "settings": { "date": "02 APR 2026", "tag": "ROUTINE", "title": "The science behind your oral microbiome",     "excerpt": "Your mouth hosts 700 bacterial species in a fragile balance. Here's how to protect it." } },
      { "type": "placeholder_post", "settings": { "date": "18 MAR 2026", "tag": "HEALTH",  "title": "Bleeding gums explained",                    "excerpt": "Is gum bleeding while brushing okay? On the difference between healthy cleaning and disturbance." } }
    ]
  }
}
{% endschema %}
