{%- comment -%}
  CALQIX Navy Rebuild — Feature grid (accordion spec list).
  Source: _incoming/calqix-web-upgrade/handoff/source/components/features.jsx → FeatureGrid
{%- endcomment -%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-feature-grid" data-cx-col2>
      <div class="cx-stack cx-gap-md" data-cx-stagger>
        {% render 'cx-eyebrow', text: section.settings.eyebrow %}
        <h2 class="cx-h2">{{ section.settings.heading }}</h2>
        <div class="cx-lede">{{ section.settings.lede }}</div>

        <div class="cx-feature-accordion" data-cx-accordion>
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="cx-feature-item{% if forloop.first %} cx-is-open{% endif %}" data-cx-accordion-item {{ block.shopify_attributes }}>
                <button type="button" class="cx-feature-toggle" data-cx-accordion-toggle aria-expanded="{%- if forloop.first -%}true{%- else -%}false{%- endif -%}">
                  <span class="cx-feature-toggle-left">
                    <span class="cx-feature-num">0{{ forloop.index }}</span>
                    <span class="cx-feature-title">{{ block.settings.title }}</span>
                  </span>
                  <span class="cx-feature-toggle-ic cx-feature-toggle-ic-open">{% render 'cx-icons', name: 'minus', size: 18 %}</span>
                  <span class="cx-feature-toggle-ic cx-feature-toggle-ic-closed">{% render 'cx-icons', name: 'plus', size: 18 %}</span>
                </button>
                <div class="cx-feature-body" data-cx-accordion-body{% unless forloop.first %} hidden{% endunless %}>
                  <div class="cx-feature-tag">{{ block.settings.tag }}</div>
                  <div class="cx-feature-desc">{{ block.settings.desc }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_text != blank -%}
          {%- assign cx_btn_kind = section.settings.cta_style | default: 'inline' -%}
          {%- case cx_btn_kind -%}
            {%- when 'gold' -%}<a class="cx-btn cx-btn-gold cx-feature-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- when 'navy' -%}<a class="cx-btn cx-btn-primary cx-feature-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- when 'ghost' -%}<a class="cx-btn cx-btn-ghost cx-feature-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- else -%}<a class="cx-btn-inline cx-feature-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
          {%- endcase -%}
        {%- endif -%}
      </div>

      <div class="cx-feature-media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'cx-feature-img' }}
        {%- else -%}
          {% render 'cx-placeholder', on_dark: true, ratio: '4/5', label: section.settings.image_label, radius: 'var(--cx-r-lg)' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .cx-feature-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 72px; align-items: center; }
  .cx-feature-accordion { border-top: 1px solid var(--cx-rule); margin-top: 12px; }
  .cx-feature-item { border-bottom: 1px solid var(--cx-rule); }
  .cx-feature-toggle {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 22px 0; color: var(--cx-forest-2); text-align: left;
    background: transparent; border: 0; cursor: pointer;
  }
  .cx-feature-toggle-left { display: flex; gap: 20px; align-items: baseline; }
  .cx-feature-num { font-family: var(--cx-f-display); font-style: italic; font-size: 14px; color: var(--cx-gold-ink); }
  .cx-feature-title { font-family: var(--cx-f-display); font-size: 22px; }
  .cx-feature-toggle-ic-open { display: none; }
  .cx-feature-item.cx-is-open .cx-feature-toggle-ic-open { display: inline-flex; }
  .cx-feature-item.cx-is-open .cx-feature-toggle-ic-closed { display: none; }
  .cx-feature-body { padding: 0 0 22px 52px; font-size: 15px; color: var(--cx-ink-soft); max-width: 56ch; }
  .cx-feature-tag {
    font-family: var(--cx-f-display); font-style: italic;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cx-gold-ink); margin-bottom: 8px;
  }
  .cx-feature-cta { margin-top: 12px; }
  .cx-feature-img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--cx-r-lg); }
</style>

{% schema %}
{
  "name": "CX Feature Grid",
  "tag": "section",
  "class": "cx-section-feature-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Down to the last detail" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Engineered into <em>every ingredient.</em></p>" },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>Every part of the protocol is rebuilt from scratch — from the crystal size of hydroxyapatite to the pulse rate of the irrigator.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "View all specs" },
    { "type": "url",  "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "cta_style", "label": "Button style",
      "default": "inline",
      "options": [
        { "value": "gold",   "label": "Gold (filled)" },
        { "value": "navy",   "label": "Navy (filled)" },
        { "value": "ghost",  "label": "Outline" },
        { "value": "inline", "label": "Inline arrow" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "FORMULA · CRYSTAL STRUCTURE" },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "ACTIVE INGREDIENT" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nano-HA crystal formula" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "The same mineral composition as your enamel — 20–50 nm for optimal integration with the surface." }
      ]
    }
  ],
  "max_blocks": 8,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "feature", "settings": { "tag": "ACTIVE INGREDIENT", "title": "Nano-HA crystal formula",  "desc": "The same mineral composition as your enamel — 20–50 nm for optimal integration with the surface." } },
      { "type": "feature", "settings": { "tag": "FLOWCORE SPEC",     "title": "1,600 pulses per minute",  "desc": "Precision jet with a 0.6 mm diameter. Designed to reach 6 mm below the gumline where your brush stops." } },
      { "type": "feature", "settings": { "tag": "FORMULA",           "title": "Vegan & fluoride-free",    "desc": "Without fluoride, SLS or parabens. Formulated with naturally sourced ingredients, safe for the whole family." } },
      { "type": "feature", "settings": { "tag": "RESEARCH",          "title": "Peer-reviewed science",    "desc": "Every formula backed by 40+ years of clinical research. Not trend-driven, evidence-based." } },
      { "type": "feature", "settings": { "tag": "CERTIFIED",         "title": "CE-certified",             "desc": "EU medical-device certification. Meets dental standards across Europe." } },
      { "type": "feature", "settings": { "tag": "PROOF",             "title": "Clinically tested",        "desc": "Independently tested for effectiveness and safety. Results verified against ISO standards." } }
    ]
  }
}
{% endschema %}
