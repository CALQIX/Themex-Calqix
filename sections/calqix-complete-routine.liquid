{% assign cq_protocol_product = all_products['calqix-nano-ha-tablets'] %}
{% assign cq_lang = request.locale.iso_code | downcase | slice: 0, 2 %}
{% assign cq_flowcore_handles = 'calqix-flowcore,flowcore-white,flowcore-green,flowcore-pink' | split: ',' %}
{% assign cq_is_flowcore = false %}
{% if product != blank and cq_flowcore_handles contains product.handle %}
  {% assign cq_is_flowcore = true %}
{% endif %}

{% if cq_protocol_product != blank and cq_protocol_product.available %}
  {% assign cq_protocol_variant = cq_protocol_product.selected_or_first_available_variant %}
  {% assign cq_flowcore_image = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_image %}
  {% assign ccr_label = 'THE CALQIX PROTOCOL' %}
  {% assign ccr_title = 'Clean the surface. Then rebuild it.' %}
  {% assign ccr_subtitle = 'FlowCore clears the path. CALQIX nano-HA tablets finish the job. Together, they form the only routine proven to support enamel remineralisation at a clinical level.' %}
  {% assign ccr_step_1 = 'Step 01' %}
  {% assign ccr_step_2 = 'Step 02' %}
  {% assign ccr_flowcore_desc = 'Cordless oral irrigator, 1,600 pulses/min, 6mm subgingival reach.' %}
  {% assign ccr_flowcore_status = 'In your cart' %}
  {% assign ccr_tablet_desc = 'Fluoride-free enamel remineralisation. 30-day supply, monthly subscription.' %}
  {% assign ccr_button_label = 'Add to routine' %}
  {% assign ccr_link_label = 'Or shop the complete routine →' %}
  {% if cq_is_flowcore %}
    {% case cq_lang %}
      {% when 'nl' %}
        {% assign ccr_label = 'HET CALQIX-PROTOCOL' %}
        {% assign ccr_title = 'Reinig het oppervlak. Herstel het daarna.' %}
        {% assign ccr_subtitle = 'FlowCore maakt de weg vrij. CALQIX nano-HA-tabletten maken het proces af. Samen vormen ze de enige routine die klinisch bewezen glazuurremineralisatie ondersteunt.' %}
        {% assign ccr_step_1 = 'Stap 01' %}
        {% assign ccr_step_2 = 'Stap 02' %}
        {% assign ccr_flowcore_desc = 'Draadloze monddouche, 1.600 pulsaties/min, 6 mm subgingivale reikwijdte.' %}
        {% assign ccr_flowcore_status = 'In je winkelwagen' %}
        {% assign ccr_tablet_desc = 'Fluoridevrije glazuurremineralisatie. Voorraad voor 30 dagen, maandelijks abonnement.' %}
        {% assign ccr_button_label = 'Toevoegen aan routine' %}
        {% assign ccr_link_label = 'Of shop de volledige routine' %}
      {% when 'de' %}
        {% assign ccr_label = 'DAS CALQIX-PROTOKOLL' %}
        {% assign ccr_title = 'Reinige die Oberfläche. Baue sie dann wieder auf.' %}
        {% assign ccr_subtitle = 'FlowCore schafft den Zugang. CALQIX nano-HA-Tabletten vollenden den Prozess. Zusammen bilden sie die einzige Routine, die klinisch nachweislich die Remineralisierung des Zahnschmelzes unterstützt.' %}
        {% assign ccr_step_1 = 'Schritt 01' %}
        {% assign ccr_step_2 = 'Schritt 02' %}
        {% assign ccr_flowcore_desc = 'Kabellose Munddusche, 1.600 Pulsationen/Min, 6 mm subgingivale Reichweite.' %}
        {% assign ccr_flowcore_status = 'In deinem Warenkorb' %}
        {% assign ccr_tablet_desc = 'Fluoridfreie Remineralisierung des Zahnschmelzes. 30-Tage-Vorrat, monatliches Abonnement.' %}
        {% assign ccr_button_label = 'Zur Routine hinzufügen' %}
        {% assign ccr_link_label = 'Oder die vollständige Routine shoppen' %}
      {% when 'fr' %}
        {% assign ccr_label = 'LE PROTOCOLE CALQIX' %}
        {% assign ccr_title = 'Nettoyez la surface. Puis reconstruisez-la.' %}
        {% assign ccr_subtitle = 'FlowCore libère la voie. Les comprimés CALQIX nano-HA complètent le travail. Ensemble, ils forment la seule routine dont l’efficacité à soutenir la reminéralisation de l’émail est démontrée à un niveau clinique.' %}
        {% assign ccr_step_1 = 'Étape 01' %}
        {% assign ccr_step_2 = 'Étape 02' %}
        {% assign ccr_flowcore_desc = 'Hydropulseur sans fil, 1 600 pulsations/min, portée sous-gingivale de 6 mm.' %}
        {% assign ccr_flowcore_status = 'Dans votre panier' %}
        {% assign ccr_tablet_desc = 'Reminéralisation de l’émail sans fluor. Réserve de 30 jours, abonnement mensuel.' %}
        {% assign ccr_button_label = 'Ajouter à la routine' %}
        {% assign ccr_link_label = 'Ou acheter la routine complète' %}
      {% when 'sv' %}
        {% assign ccr_label = 'CALQIX-PROTOKOLLET' %}
        {% assign ccr_title = 'Rengbr ytan. Bygg sedan upp den.' %}
        {% assign ccr_subtitle = 'FlowCore banar vagen. CALQIX nano-HA-tabletter fullfbljer jobbet. Tillsammans bildar de den enda rutinen som ar bevisad att stodja emalj-remineralisering pa klinisk niva.' %}
        {% assign ccr_step_1 = 'Steg 01' %}
        {% assign ccr_step_2 = 'Steg 02' %}
        {% assign ccr_flowcore_desc = 'Tradlbs mundusch, 1 600 pulser/min, 6 mm subgingival rackning.' %}
        {% assign ccr_flowcore_status = 'I din varukorg' %}
        {% assign ccr_tablet_desc = 'Fluoridfri emalj-remineralisering. 30 dagars forrad, manadsabonnemang.' %}
        {% assign ccr_button_label = 'Lagg till i rutinen' %}
        {% assign ccr_link_label = 'Eller handla hela rutinen' %}
      {% when 'nb' %}
        {% assign ccr_label = 'CALQIX-PROTOKOLLEN' %}
        {% assign ccr_title = 'Rens overflaten. Bygg den opp igjen.' %}
        {% assign ccr_subtitle = 'FlowCore baner vei. CALQIX nano-HA-tabletter fullforer jobben. Sammen utgjor de den eneste rutinen som er bevist a stotte emaljeremineralisering pa klinisk niva.' %}
        {% assign ccr_step_1 = 'Trinn 01' %}
        {% assign ccr_step_2 = 'Trinn 02' %}
        {% assign ccr_flowcore_desc = 'Tradlos munndusj, 1 600 pulsasjoner/min, 6 mm subgingival rekkevidde.' %}
        {% assign ccr_flowcore_status = 'I handlekurven din' %}
        {% assign ccr_tablet_desc = 'Fluoridfri emaljeremineralisering. 30 dagers forsyning, manedlig abonnement.' %}
        {% assign ccr_button_label = 'Legg til i rutinen' %}
        {% assign ccr_link_label = 'Eller handle hele rutinen' %}
      {% when 'da' %}
        {% assign ccr_label = 'CALQIX-PROTOKOLLEN' %}
        {% assign ccr_title = 'Rens overfladen. Genopbyg den derefter.' %}
        {% assign ccr_subtitle = 'FlowCore baner vejen. CALQIX nano-HA-tabletter fuldforer opgaven. Sammen danner de den eneste rutine, der er bevist at stotte emaljeremineralisering pa klinisk niveau.' %}
        {% assign ccr_step_1 = 'Trin 01' %}
        {% assign ccr_step_2 = 'Trin 02' %}
        {% assign ccr_flowcore_desc = 'Tradlos mundbruser, 1 600 pulser/min, 6 mm subgingival rakkevidde.' %}
        {% assign ccr_flowcore_status = 'I din indkobskurv' %}
        {% assign ccr_tablet_desc = 'Fluoridfri emaljeremineralisering. 30 dages forsyning, manedsabonnement.' %}
        {% assign ccr_button_label = 'Tilf0j til rutinen' %}
        {% assign ccr_link_label = 'Eller shop hele rutinen' %}
      {% when 'fi' %}
        {% assign ccr_label = 'CALQIX-PROTOKOLLA' %}
        {% assign ccr_title = 'Puhdista pinta. Rakenna se sitten uudelleen.' %}
        {% assign ccr_subtitle = 'FlowCore raivaa tien. CALQIX nano-HA-tabletit viimeistelevat tyon. Yhdessa ne muodostavat ainoan rutiinin, joka on todistettu tukevan kiilteen remineralisaatiota kliinisella tasolla.' %}
        {% assign ccr_step_1 = 'Vaihe 01' %}
        {% assign ccr_step_2 = 'Vaihe 02' %}
        {% assign ccr_flowcore_desc = 'Langaton suusuihku, 1 600 pulssia/min, 6 mm subgingivaalinen ulottuvuus.' %}
        {% assign ccr_flowcore_status = 'Ostoskorissasi' %}
        {% assign ccr_tablet_desc = 'Fluoriditon kiilteen remineralisaatio. 30 paivan erä, kuukausitilaus.' %}
        {% assign ccr_button_label = 'Lisää rutiiniin' %}
        {% assign ccr_link_label = 'Tai osta koko rutiini' %}
    {% endcase %}
  {% endif %}
  <section id="calqix-complete-routine-{{ section.id }}" class="calqix-complete-routine">
    <style>
      #calqix-complete-routine-{{ section.id }} {
        background: #1a3b5c;
        padding: 48px 0;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-shell {
        width: min(100%, 1200px);
        margin: 0 auto;
        padding: 0 20px;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-label {
        margin: 0;
        text-align: center;
        color: #c9a84c;
        font-family: "DM Sans", sans-serif;
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-title {
        margin: 8px 0 0;
        text-align: center;
        color: #ffffff;
        font-family: "DM Serif Display", serif;
        font-size: 32px;
        line-height: 1.1;
        font-weight: 400;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-subtitle {
        margin: 16px auto 36px;
        max-width: 520px;
        text-align: center;
        color: rgba(255, 255, 255, 0.75);
        font-family: "DM Sans", sans-serif;
        font-size: 15px;
        line-height: 1.7;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        max-width: 720px;
        margin: 0 auto;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-card {
        min-width: 0;
        padding: 24px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.06);
      }

      #calqix-complete-routine-{{ section.id }} .ccr-card--flowcore {
        border: 1px solid rgba(201, 168, 76, 0.3);
      }

      #calqix-complete-routine-{{ section.id }} .ccr-card--tablet {
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      #calqix-complete-routine-{{ section.id }} .ccr-image-wrap {
        margin-bottom: 18px;
        border-radius: 12px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.04);
        aspect-ratio: 1 / 1;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-step {
        margin: 0 0 8px;
        color: #c9a84c;
        font-family: "DM Sans", sans-serif;
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-name {
        margin: 0 0 8px;
        color: #ffffff;
        font-family: "DM Serif Display", serif;
        font-size: 22px;
        line-height: 1.15;
        font-weight: 400;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-desc {
        margin: 0 0 16px;
        color: rgba(255, 255, 255, 0.65);
        font-family: "DM Sans", sans-serif;
        font-size: 13px;
        line-height: 1.6;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-price {
        color: #ffffff;
        font-family: "DM Sans", sans-serif;
        font-size: 15px;
        line-height: 1.4;
        font-weight: 500;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-status {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 3px 10px;
        border-radius: 20px;
        background: #c9a84c;
        color: #1a3b5c;
        font-family: "DM Sans", sans-serif;
        font-size: 11px;
        line-height: 1.3;
        font-weight: 600;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-product-form {
        display: block;
        width: 100%;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-product-form form {
        margin: 0;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-product-form .product-form__error-message-wrapper {
        margin-bottom: 12px;
        color: #ffffff;
        font-family: "DM Sans", sans-serif;
        font-size: 12px;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-button {
        width: 100%;
        min-height: 48px;
        border: 0;
        border-radius: 6px;
        background: #c9a84c;
        color: #1a3b5c;
        font-family: "DM Sans", sans-serif;
        font-size: 14px;
        line-height: 1.4;
        font-weight: 500;
        cursor: pointer;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-button:hover {
        background: #d6b86b;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-link-row {
        margin-top: 24px;
        text-align: center;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-link {
        color: rgba(255, 255, 255, 0.5);
        font-family: "DM Sans", sans-serif;
        font-size: 13px;
        line-height: 1.5;
        text-decoration: none;
      }

      #calqix-complete-routine-{{ section.id }} .ccr-link:hover {
        text-decoration: underline;
      }

      @media (max-width: 767px) {
        #calqix-complete-routine-{{ section.id }} .ccr-shell {
          padding: 0 12px;
        }

        #calqix-complete-routine-{{ section.id }} .ccr-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <div class="ccr-shell">
      <p class="ccr-label">{{ ccr_label }}</p>
      <h2 class="ccr-title">{{ ccr_title }}</h2>
      <p class="ccr-subtitle">{{ ccr_subtitle }}</p>

      <div class="ccr-grid">
        <article class="ccr-card ccr-card--flowcore">
          <div class="ccr-image-wrap">
            {% if cq_flowcore_image != blank %}
              {{ cq_flowcore_image | image_url: width: 720 | image_tag: class: 'ccr-image', loading: 'lazy', widths: '360, 540, 720', sizes: '(max-width: 767px) 100vw, 340px', alt: product.title }}
            {% endif %}
          </div>
          <p class="ccr-step">{{ ccr_step_1 }}</p>
          <h3 class="ccr-name">FlowCore</h3>
          <p class="ccr-desc">{{ ccr_flowcore_desc }}</p>
          <div class="ccr-bottom">
            <span class="ccr-price">{{ product.selected_or_first_available_variant.price | money }}</span>
            <span class="ccr-status">{{ ccr_flowcore_status }}</span>
          </div>
        </article>

        <article class="ccr-card ccr-card--tablet">
          <div class="ccr-image-wrap">
            {% if cq_protocol_product.featured_image != blank %}
              {{ cq_protocol_product.featured_image | image_url: width: 720 | image_tag: class: 'ccr-image', loading: 'lazy', widths: '360, 540, 720', sizes: '(max-width: 767px) 100vw, 340px', alt: cq_protocol_product.title }}
            {% endif %}
          </div>
          <p class="ccr-step">{{ ccr_step_2 }}</p>
          <h3 class="ccr-name">CALQIX Nano-HA Tablets</h3>
          <p class="ccr-desc">{{ ccr_tablet_desc }}</p>
          <p class="ccr-price">{{ cq_protocol_variant.price | money }}</p>
          <product-form class="ccr-product-form" data-hide-errors="false">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
            <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" class="form" data-type="add-to-cart-form">
              <input type="hidden" name="id" value="{{ cq_protocol_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" name="add" class="ccr-button">
                <span>{{ ccr_button_label }}</span>
                {% render 'button-loading-indicator' %}
              </button>
            </form>
          </product-form>
        </article>
      </div>

      <div class="ccr-link-row">
        <a class="ccr-link" href="{{ routes.all_products_collection_url }}">{{ ccr_link_label }}</a>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "CALQIX Complete Routine",
  "settings": [],
  "presets": [
    {
      "name": "CALQIX Complete Routine"
    }
  ]
}
{% endschema %}
