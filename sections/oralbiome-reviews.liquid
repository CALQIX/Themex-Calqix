<style>
  .ob-reviews { background: #F4F5F7; padding: 48px 16px; }
  .ob-reviews__container { max-width: 1000px; margin: 0 auto; padding: 0; }
  .ob-reviews__header { text-align: center; margin-bottom: 32px; }
  .ob-reviews__eyebrow { font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 3px; color: #C9A84C; margin: 0 0 12px; }
  .ob-reviews__heading { font-family: 'DM Serif Display', serif; font-size: 28px; color: #1A3B5C; margin: 0 0 32px; line-height: 1.3; }
  .ob-reviews__aggregate { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 24px; }
  .ob-reviews__big-number { font-family: 'DM Serif Display', serif; font-size: 44px; color: #1A3B5C; line-height: 1; }
  .ob-reviews__agg-stars { display: flex; gap: 2px; }
  .ob-reviews__agg-stars svg { width: 22px; height: 22px; }
  .ob-reviews__count { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #6B7280; }
  .ob-reviews__breakdown { max-width: 400px; margin: 0 auto 32px; }
  .ob-reviews__bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
  .ob-reviews__bar-label { font-family: 'DM Sans', sans-serif; font-size: 12px; color: #6B7280; width: 30px; text-align: right; flex-shrink: 0; }
  .ob-reviews__bar-track { flex: 1; height: 8px; background: #E5E7EB; border-radius: 4px; overflow: hidden; }
  .ob-reviews__bar-fill { height: 8px; background: #C9A84C; border-radius: 4px; transition: width 0.6s ease; }
  .ob-reviews__bar-count { font-family: 'DM Sans', sans-serif; font-size: 12px; color: #6B7280; width: 24px; text-align: right; flex-shrink: 0; }
  .ob-reviews__filters { display: flex; justify-content: center; gap: 8px; margin-bottom: 32px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; flex-wrap: nowrap; padding: 0 0 4px; }
  .ob-reviews__filters::-webkit-scrollbar { display: none; }
  .ob-reviews__filter-btn { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; padding: 8px 20px; border: 1px solid #E5E7EB; border-radius: 50px; background: #fff; color: #6B7280; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; flex-shrink: 0; }
  .ob-reviews__filter-btn:hover { border-color: #1A3B5C; background: #1A3B5C; color: #fff; }
  .ob-reviews__filter-btn.is-active { background: #1A3B5C; color: #fff; border-color: #1A3B5C; }
  .ob-reviews__grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .ob-reviews__card { background: #fff; border: 1px solid #E5E7EB; border-radius: 8px; padding: 20px; opacity: 0; transform: translateY(12px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .ob-reviews__card.is-visible { opacity: 1; transform: translateY(0); }
  .ob-reviews__card-stars { display: flex; gap: 1px; }
  .ob-reviews__card-stars svg { width: 14px; height: 14px; }
  .ob-reviews__card-title { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; color: #1A3B5C; margin: 12px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ob-reviews__card-body { font-family: 'DM Sans', sans-serif; font-size: 13px; color: #6B7280; line-height: 1.6; margin: 8px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ob-reviews__card-body.is-expanded { -webkit-line-clamp: unset; }
  .ob-reviews__read-more { background: none; border: none; font-family: 'DM Sans', sans-serif; font-size: 12px; color: #C9A84C; cursor: pointer; padding: 0; margin-top: 6px; display: none; }
  .ob-reviews__read-more:hover { text-decoration: underline; }
  .ob-reviews__read-more.is-needed { display: inline; }
  .ob-reviews__card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; padding-top: 12px; border-top: 1px solid #F3F4F6; }
  .ob-reviews__card-reviewer { display: flex; flex-direction: column; }
  .ob-reviews__card-name { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600; color: #1A3B5C; }
  .ob-reviews__card-country { font-family: 'DM Sans', sans-serif; font-size: 11px; color: #6B7280; }
  .ob-reviews__card-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .ob-reviews__card-verified { display: inline-flex; align-items: center; gap: 4px; background: #F0FDF4; color: #2E7D32; font-family: 'DM Sans', sans-serif; font-size: 11px; padding: 2px 8px; border-radius: 50px; }
  .ob-reviews__card-date { font-family: 'DM Sans', sans-serif; font-size: 11px; color: #D1D5DB; }
  .ob-reviews__show-more { display: block; margin: 32px auto 0; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 12px 32px; border: 1px solid #1A3B5C; border-radius: 4px; background: transparent; color: #1A3B5C; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; }
  .ob-reviews__show-more:hover { background: #1A3B5C; color: #fff; }
  .ob-reviews__write { display: block; margin: 16px auto 0; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 12px 32px; border: 1px solid #C9A84C; border-radius: 4px; background: transparent; color: #C9A84C; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; text-decoration: none; text-align: center; }
  .ob-reviews__write:hover { background: #C9A84C; color: #1A3B5C; }

  /* ── Review Modal ── */
  .ob-review-modal { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,0.6); backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.25s ease; }
  .ob-review-modal.is-open { display: flex; opacity: 1; }
  .ob-review-modal__box { position: relative; background: #fff; border-radius: 12px; max-width: 480px; width: 92vw; max-height: 90vh; overflow-y: auto; padding: 32px 28px 28px; box-shadow: 0 16px 48px rgba(0,0,0,0.2); }
  .ob-review-modal__close { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border: none; background: none; cursor: pointer; color: #6B7280; font-size: 20px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: background 0.2s; }
  .ob-review-modal__close:hover { background: #F3F4F6; }
  .ob-review-modal__title { font-family: 'DM Serif Display', serif; font-size: 22px; color: #1A3B5C; margin: 0 0 4px; }
  .ob-review-modal__subtitle { font-family: 'DM Sans', sans-serif; font-size: 13px; color: #6B7280; margin: 0 0 20px; }
  .ob-review-modal__field { margin-bottom: 14px; }
  .ob-review-modal__label { display: block; font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 600; color: #1A3B5C; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
  .ob-review-modal__input, .ob-review-modal__textarea { width: 100%; font-family: 'DM Sans', sans-serif; font-size: 14px; border: 1px solid #E5E7EB; border-radius: 6px; padding: 10px 12px; color: #1A3B5C; transition: border-color 0.2s; box-sizing: border-box; }
  .ob-review-modal__input:focus, .ob-review-modal__textarea:focus { border-color: #C9A84C; outline: none; }
  .ob-review-modal__textarea { min-height: 90px; resize: vertical; }
  .ob-review-modal__stars { display: flex; gap: 4px; cursor: pointer; }
  .ob-review-modal__star { width: 28px; height: 28px; color: #E5E7EB; transition: color 0.15s; }
  .ob-review-modal__star.is-active { color: #C9A84C; }
  .ob-review-modal__star:hover { color: #C9A84C; }
  .ob-review-modal__submit { width: 100%; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600; padding: 12px; border: none; border-radius: 6px; background: #1A3B5C; color: #fff; cursor: pointer; transition: background 0.2s; margin-top: 4px; }
  .ob-review-modal__submit:hover { background: #15304D; }
  .ob-review-modal__submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .ob-review-modal__success { text-align: center; padding: 24px 0; }
  .ob-review-modal__success-icon { width: 56px; height: 56px; margin: 0 auto 16px; color: #2E7D32; }
  .ob-review-modal__success-heading { font-family: 'DM Serif Display', serif; font-size: 20px; color: #1A3B5C; margin: 0 0 8px; }
  .ob-review-modal__success-text { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #6B7280; margin: 0; }
  @media (max-width: 480px) { .ob-review-modal__box { padding: 24px 20px 20px; } }
  .ob-reviews__judgeme { margin-top: 32px; }
  @media (max-width: 767px) {
    .ob-reviews__filters { justify-content: flex-start; padding: 0 16px 4px; }
  }
  @media (min-width: 768px) {
    .ob-reviews { padding: 48px 0; }
    .ob-reviews__container { padding: 0 20px; }
    .ob-reviews__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .ob-reviews__aggregate { flex-direction: column; gap: 8px; }
    .ob-reviews__big-number { font-size: 56px; }
    .ob-reviews__card { padding: 24px; }
  }
  @media (min-width: 1024px) {
    .ob-reviews { padding: 80px 0; }
    .ob-reviews__heading { font-size: 36px; }
    .ob-reviews__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- assign _ob_rev_eyebrow = section.settings.eyebrow -%}
{%- assign _ob_rev_heading = section.settings.heading -%}
{%- assign _ob_rev_write = section.settings.write_review_text -%}
{%- if _ob_lang == 'nl' or _ob_lang == 'de' or _ob_lang == 'fr' or _ob_lang == 'sv' or _ob_lang == 'nb' or _ob_lang == 'da' or _ob_lang == 'fi' -%}
  {%- assign _ob_rev_eyebrow = 'calqix_oralbiome.reviews.eyebrow' | t -%}
  {%- assign _ob_rev_heading = 'calqix_oralbiome.reviews.heading' | t -%}
  {%- assign _ob_rev_write = 'calqix_oralbiome.reviews.write_review' | t -%}
{%- endif -%}

<section class="ob-reviews" id="oralbiome-reviews" data-section-id="{{ section.id }}">
  <div class="ob-reviews__container">
    <div class="ob-reviews__header">
      <p class="ob-reviews__eyebrow">{{ _ob_rev_eyebrow }}</p>
      <h2 class="ob-reviews__heading">{{ _ob_rev_heading }}</h2>
      <div class="ob-reviews__aggregate">
        <span class="ob-reviews__big-number">{{ section.settings.avg_rating }}</span>
        <div class="ob-reviews__agg-stars">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24" fill="#C9A84C"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {%- endfor -%}
        </div>
        <span class="ob-reviews__count">{{ section.settings.based_on_text }}</span>
      </div>
      <div class="ob-reviews__breakdown" data-ob-breakdown></div>
    </div>

    {%- if section.settings.show_filters -%}
      <div class="ob-reviews__filters" role="tablist" data-ob-filters></div>
    {%- endif -%}

    {%- if section.settings.use_judgeme -%}
      <div class="ob-reviews__judgeme">
        <div id="judgeme_product_reviews" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
      </div>
    {%- else -%}
      <div class="ob-reviews__grid" data-ob-grid></div>
      <button type="button" class="ob-reviews__show-more" data-ob-show-more>{{ section.settings.show_more_label }}</button>
      <button type="button" class="ob-reviews__write" data-ob-open-review>{{ _ob_rev_write }}</button>
    {%- endif -%}
  </div>
</section>

<!-- Review Modal -->
<div class="ob-review-modal" id="ob-review-modal-{{ section.id }}" aria-hidden="true" role="dialog">
  <div class="ob-review-modal__box">
    <button class="ob-review-modal__close" aria-label="Close" data-ob-close-review>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div data-ob-review-form>
      <h3 class="ob-review-modal__title">{{ _ob_rev_write }}</h3>
      <p class="ob-review-modal__subtitle">{{ 'calqix_oralbiome.reviews.review_modal_subtitle' | t | default: 'Share your experience with OralBiome Pro' }}</p>
      <form method="post" action="/contact#contact_form" data-ob-review-form-el>
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="\u2713">
        <input type="hidden" name="contact[subject]" value="New Review: {{ product.title | escape }}">
        <input type="hidden" name="contact[tags]" value="review">
        <div class="ob-review-modal__field">
          <label class="ob-review-modal__label">{{ 'calqix_oralbiome.reviews.rating_label' | t | default: 'Rating' }}</label>
          <div class="ob-review-modal__stars" data-ob-stars>
            {%- for i in (1..5) -%}
              <svg class="ob-review-modal__star{% if i <= 5 %} is-active{% endif %}" data-star="{{ i }}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
          </div>
          <input type="hidden" name="contact[rating]" value="5" data-ob-rating-input>
        </div>
        <div class="ob-review-modal__field">
          <label class="ob-review-modal__label" for="ob-review-name">{{ 'calqix_oralbiome.reviews.name_label' | t | default: 'Name' }}</label>
          <input class="ob-review-modal__input" type="text" id="ob-review-name" name="contact[name]" required>
        </div>
        <div class="ob-review-modal__field">
          <label class="ob-review-modal__label" for="ob-review-email">{{ 'calqix_oralbiome.reviews.email_label' | t | default: 'Email' }}</label>
          <input class="ob-review-modal__input" type="email" id="ob-review-email" name="contact[email]" required>
        </div>
        <div class="ob-review-modal__field">
          <label class="ob-review-modal__label" for="ob-review-title">{{ 'calqix_oralbiome.reviews.title_label' | t | default: 'Review title' }}</label>
          <input class="ob-review-modal__input" type="text" id="ob-review-title" name="contact[review_title]" required>
        </div>
        <div class="ob-review-modal__field">
          <label class="ob-review-modal__label" for="ob-review-body">{{ 'calqix_oralbiome.reviews.body_label' | t | default: 'Your review' }}</label>
          <textarea class="ob-review-modal__textarea" id="ob-review-body" name="contact[body]" rows="4" required></textarea>
        </div>
        <button type="submit" class="ob-review-modal__submit" data-ob-review-submit>{{ 'calqix_oralbiome.reviews.submit_review' | t | default: 'Submit Review' }}</button>
      </form>
    </div>
    <div class="ob-review-modal__success" style="display:none" data-ob-review-success>
      <svg class="ob-review-modal__success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
      <h3 class="ob-review-modal__success-heading">{{ 'calqix_oralbiome.reviews.thank_you_title' | t | default: 'Thank you!' }}</h3>
      <p class="ob-review-modal__success-text">{{ 'calqix_oralbiome.reviews.thank_you_text' | t | default: 'Your review has been submitted and will be reviewed by our team.' }}</p>
    </div>
  </div>
</div>

<script>
(function(){
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;
  var useJudgeme = {{ section.settings.use_judgeme | json }};
  if (useJudgeme) return;

  var R = [
    {id:1,n:"Juliette J.",cc:"BE",co:"Belgium",r:5,t:"Geen bloedend tandvlees meer",b:"Na vijf weken elke avond één tablet voor het slapen. Bij het flossen blijft de spoelbak eindelijk schoon.",tg:["gum_health"],d:"2026-03-19"},
    {id:2,n:"Manon L.",cc:"FR",co:"France",r:5,t:"Doux pour gencives fragiles",b:"J'ai les gencives très réactives, le moindre produit me pique. Là ça fond tranquillement, sans irritation. Nette amélioration après un mois.",tg:["gum_health"],d:"2026-03-18"},
    {id:3,n:"Valentina M.",cc:"AT",co:"Austria",r:4,t:"Mehr als ein Kaugummi",b:"Kaugummis kaschieren nur. Das hier geht an die Ursache. Bei Meetings am Nachmittag fühle ich mich sicherer.",tg:["fresh_breath"],d:"2026-03-18"},
    {id:4,n:"Marieke v.",cc:"NL",co:"Netherlands",r:4,t:"Rustig tandvlees",b:"Mijn tandvlees reageert op alles, dus ik ben voorzichtig. Deze tablet doet niks naars, lost gewoon op. Mondhygiënist vond het er rustiger uitzien.",tg:["gum_health"],d:"2026-03-17"},
    {id:5,n:"Anna M.",cc:"AT",co:"Austria",r:5,t:"Braucht Geduld",b:"Erste Woche: nichts. Ab Woche drei war der metallische Geschmack weg. In Woche fünf hat das Zahnfleisch aufgehört zu bluten.",tg:["gum_health"],d:"2026-03-17"},
    {id:6,n:"Louise M.",cc:"BE",co:"Belgium",r:5,t:"Gencives rétablies",b:"Six semaines, une pastille par soir. Mon dentiste a confirmé le changement au dernier contrôle. Je continue.",tg:["gum_health"],d:"2026-03-16"},
    {id:7,n:"Raphaël M.",cc:"FR",co:"France",r:5,t:"Moins de plaque",b:"L'hygiéniste a remarqué nettement moins de plaque au dernier détartrage. Rien d'autre changé — juste ceci le soir.",tg:["gum_health"],d:"2026-03-16"},
    {id:8,n:"David S.",cc:"DE",co:"Germany",r:5,t:"Abo läuft reibungslos",b:"Seit vier Monaten im Monatsabo. Immer pünktlich, ordentlich verpackt. Produkt wirkt konstant, keine Überraschungen.",tg:["subscription"],d:"2026-03-16"},
    {id:9,n:"Iris B.",cc:"NL",co:"Netherlands",r:5,t:"Gemakkelijk mee op reis",b:"Geen vloeistof, hoeft niet in de koeling. Gaat gewoon mee in de toilettas. Eén tablet voor het slapen en klaar.",tg:["general"],d:"2026-03-14"},
    {id:10,n:"Lukas S.",cc:"AT",co:"Austria",r:4,t:"Studienlage überzeugt",b:"L. reuteri ist in über siebzig klinischen Studien untersucht. Das ist kein Marketing, das ist Evidenz. Deshalb habe ich es überhaupt probiert.",tg:["general"],d:"2026-03-13"},
    {id:11,n:"Katharina B.",cc:"AT",co:"Austria",r:5,t:"Chronischer Mundgeruch lässt nach",b:"Seit über zehn Jahren ein Thema, nichts hat dauerhaft geholfen. Das erste Produkt, das die Ursache angeht statt zu überdecken.",tg:["fresh_breath"],d:"2026-03-12"},
    {id:12,n:"Stefan P.",cc:"AT",co:"Austria",r:4,t:"Fundiertes Produkt",b:"Was mich überzeugt hat, ist die Forschung dahinter. L. reuteri, M18, klinisch getestet. Bei den meisten Pastillen fehlt so etwas.",tg:["general"],d:"2026-03-12"},
    {id:13,n:"Jonas K.",cc:"DE",co:"Germany",r:4,t:"Weniger Belag beim Termin",b:"Bei der halbjährlichen Kontrolle sagte die Prophylaxe: deutlich weniger Plaque. Einzige Änderung in der Routine war diese Tablette.",tg:["gum_health"],d:"2026-03-11"},
    {id:14,n:"Jan R.",cc:"DE",co:"Germany",r:5,t:"Mild und unkompliziert",b:"Eine Tablette vor dem Schlafen auf die Zunge, löst sich in zwei bis drei Minuten. Dezent mintig. Passt einfach in die Routine.",tg:["general"],d:"2026-03-11"},
    {id:15,n:"Leon W.",cc:"DE",co:"Germany",r:5,t:"Endlich etwas gegen schlechten Atem",b:"Jahrelang trotz Zähneputzen und Mundspülung unangenehmer Atem. Nach vier Wochen spürbar besser. Offenbar geht es an die Ursache.",tg:["fresh_breath"],d:"2026-03-11"},
    {id:16,n:"Bram S.",cc:"NL",co:"Netherlands",r:5,t:"Na drie weken verschil",b:"Eerste twee weken weinig gemerkt. Vanaf week drie minder plaque-opbouw en steviger tandvlees. Kwestie van doorzetten.",tg:["gum_health"],d:"2026-03-10"},
    {id:17,n:"Lisa P.",cc:"AT",co:"Austria",r:5,t:"Sanft zu empfindlichem Zahnfleisch",b:"Mein Zahnfleisch reagiert auf so gut wie alles. Diese Pastille brennt nicht, lässt sich einfach lutschen. Beschwerden sind zurückgegangen.",tg:["gum_health"],d:"2026-03-10"},
    {id:18,n:"Elena M.",cc:"BE",co:"Belgium",r:4,t:"Sur recommandation du dentiste",b:"Ma dentiste à Liège a suggéré un probiotique oral pour ma gingivite récurrente. Deux mois maintenant, les saignements ont diminué.",tg:["gum_health","subscription"],d:"2026-03-10"},
    {id:19,n:"Johanna W.",cc:"DE",co:"Germany",r:5,t:"Preis geht in Ordnung",b:"19,95 € pro Monat im Abo — etwa 67 Cent am Tag. Weniger als ein Kaffee. Für die Wirkung finde ich das fair.",tg:["subscription"],d:"2026-03-09"},
    {id:20,n:"Ruben S.",cc:"NL",co:"Netherlands",r:5,t:"Tandvlees stabiel na 6 weken",b:"Al jaren bloedend tandvlees bij het poetsen. Na zes weken dagelijks: voorbij. Tandarts bevestigde het bij de controle.",tg:["gum_health"],d:"2026-03-08"},
    {id:21,n:"Sebastian P.",cc:"AT",co:"Austria",r:5,t:"Anfangs skeptisch",b:"Orale Probiotika klangen nach Wellness-Trend. Eine Dose zum Testen bestellt. Nach vier Wochen war der Mundgeruch merklich besser. Jetzt im Abo.",tg:["fresh_breath","subscription"],d:"2026-03-08"},
    {id:22,n:"Lisa S.",cc:"NL",co:"Netherlands",r:4,t:"Geen roze spoelbak meer",b:"Bij het flossen zag ik altijd roze in de wasbak. Na een weekje of vier was dat weg. Voor mij het duidelijkste teken dat het werkt.",tg:["gum_health"],d:"2026-03-08"},
    {id:23,n:"Franziska L.",cc:"DE",co:"Germany",r:5,t:"Besser als alkoholische Spülung",b:"Jahrelang Listerine benutzt. Seit ich weiß, dass die auch die guten Bakterien killt, gewechselt. Mund fühlt sich weniger trocken an.",tg:["general"],d:"2026-03-07"},
    {id:24,n:"Anna V.",cc:"NL",co:"Netherlands",r:5,t:"Praktisch abonnement",b:"Elke maand een nieuwe pot, 20% korting. Instellen en vergeten. Via mijn account kan ik pauzeren als ik op vakantie ga.",tg:["subscription"],d:"2026-03-07"},
    {id:25,n:"Chloé D.",cc:"FR",co:"France",r:5,t:"Gencives plus calmes",b:"Saignements au brossage depuis des années. Six semaines avec OralBiome, plus rien. Confirmé par ma dentiste au contrôle.",tg:["gum_health"],d:"2026-03-07"},
    {id:26,n:"Bram d.",cc:"NL",co:"Netherlands",r:5,t:"Milde muntsmaak",b:"De tablet lost op in twee à drie minuten, smaakt rustig muntig. Niet opdringerig. Past prima na het poetsen.",tg:["general"],d:"2026-03-05"},
    {id:27,n:"Stijn D.",cc:"NL",co:"Netherlands",r:4,t:"Levering altijd op tijd",b:"Drie maanden abonnement. Komt op de dag zelf, netjes verpakt. Werkt gewoon door, geen omkijken naar.",tg:["subscription"],d:"2026-03-05"},
    {id:28,n:"Jonas S.",cc:"DE",co:"Germany",r:4,t:"Empfehlung vom Zahnarzt",b:"Mein Zahnarzt in Köln meinte, orale Probiotika könnten bei meiner wiederkehrenden Gingivitis helfen. Nach drei Monaten sind die Werte besser.",tg:["gum_health","subscription"],d:"2026-03-04"},
    {id:29,n:"Lisa B.",cc:"NL",co:"Netherlands",r:5,t:"Eerst sceptisch, nu niet meer",b:"Dacht: weer zo'n wellness-hype. Eén potje besteld om te testen. Na een maand duidelijk minder slechte adem. Abonnement aangezet.",tg:["fresh_breath","subscription"],d:"2026-03-04"},
    {id:30,n:"Olivia W.",cc:"BE",co:"Belgium",r:5,t:"Abo simpel geregeld",b:"Instellen, vergeten, elke maand komt er een potje. De 20% korting helpt. Mondwater-abo heb ik kunnen opzeggen.",tg:["subscription"],d:"2026-03-04"},
    {id:31,n:"Joris M.",cc:"NL",co:"Netherlands",r:5,t:"Advies van de tandarts",b:"Mijn tandarts raadde orale probiotica aan bij terugkerende gingivitis. Drie maanden verder gaat het stukken beter.",tg:["gum_health","subscription"],d:"2026-03-04"},
    {id:32,n:"Lena F.",cc:"DE",co:"Germany",r:5,t:"Seriöse Zusammensetzung",b:"Kein Zucker, keine künstlichen Süßstoffe, keine komischen Füllstoffe. Xylit als einziges Süßungsmittel ist sinnvoll. Lese Etiketten genau, hier passt es.",tg:["general"],d:"2026-03-02"},
    {id:33,n:"Milan J.",cc:"BE",co:"Belgium",r:5,t:"Tandarts in Gent raadde het aan",b:"Terugkerende tandvleesontsteking, niks hielp lang. Drie maanden nu, stabiel. De tandarts was verrast.",tg:["gum_health","subscription"],d:"2026-03-02"},
    {id:34,n:"Elias K.",cc:"DE",co:"Germany",r:4,t:"Wir benutzen es beide",b:"Meine Frau und ich. Auch unsere 12-Jährige bekommt eine vor dem Schlafen. Geschmack ist für Kinder angenehm mild. Familienabo wäre nett.",tg:["general","subscription"],d:"2026-03-01"},
    {id:35,n:"Paul S.",cc:"DE",co:"Germany",r:5,t:"Deutlich weniger Belag",b:"Ich baue zwischen den Reinigungen schnell Plaque auf. Nach zwei Monaten sagte die Prophylaxe: deutlich reduziert. M18-Stamm scheint zu wirken.",tg:["gum_health"],d:"2026-03-01"},
    {id:36,n:"Johanna S.",cc:"DE",co:"Germany",r:5,t:"Morgens kein Problem mehr",b:"Morgenatem war mir peinlich. Jetzt nicht mehr. Subtil, aber konstant. Mund fühlt sich insgesamt sauberer an.",tg:["fresh_breath"],d:"2026-02-28"},
    {id:37,n:"Lena W.",cc:"DE",co:"Germany",r:5,t:"Reisetauglich",b:"Keine Flüssigkeit, kein Kühlen nötig. Passt in jede Kulturtasche. Eine Tablette vor dem Schlafen, fertig. Einfacher als Mundspülung.",tg:["general"],d:"2026-02-27"},
    {id:38,n:"Joris P.",cc:"NL",co:"Netherlands",r:5,t:"Ochtendadem veel minder",b:"Vooral 's ochtends merk ik het verschil. Niet meer die bedompte lucht bij het wakker worden. Eén tablet voor het slapen, meer niet.",tg:["fresh_breath"],d:"2026-02-27"},
    {id:39,n:"Anna B.",cc:"AT",co:"Austria",r:4,t:"Forschung im Hintergrund",b:"Was mich überzeugt hat, ist die Studienlage. Die meisten Supplements haben kaum Vergleichbares. Wirkt durchdacht.",tg:["general"],d:"2026-02-26"},
    {id:40,n:"Femke D.",cc:"NL",co:"Netherlands",r:5,t:"Minder aanslag bij controle",b:"De mondhygiënist zag bij de halfjaarlijkse controle duidelijk minder aanslag. Alleen deze tablet is erbij gekomen in mijn routine.",tg:["gum_health"],d:"2026-02-26"},
    {id:41,n:"Anna W.",cc:"AT",co:"Austria",r:5,t:"Zahnfleisch blutet nicht mehr",b:"Beim Flossen war immer Blut dabei, das war mein Maßstab. Nach vier Wochen war das vorbei. Messbar, nicht eingebildet.",tg:["gum_health"],d:"2026-02-25"},
    {id:42,n:"Sebastian M.",cc:"AT",co:"Austria",r:5,t:"Abo macht es einfach",b:"Einmal einrichten, dann vergessen. Jeden Monat eine neue Dose. Rabatt im Abo ist ein netter Bonus. Spüle nicht mehr nötig.",tg:["subscription"],d:"2026-02-24"},
    {id:43,n:"Anna G.",cc:"AT",co:"Austria",r:5,t:"Von der Zahnärztin empfohlen",b:"Meine Zahnärztin in Wien hat orale Probiotika bei wiederkehrender Gingivitis vorgeschlagen. Drei Monate später ist das Zahnfleisch deutlich gesünder.",tg:["gum_health","subscription"],d:"2026-02-22"},
    {id:44,n:"Lukas H.",cc:"AT",co:"Austria",r:5,t:"Ideal unterwegs",b:"Keine Flüssigkeit, keine Kühlung. Für Dienstreisen perfekt. Eine Tablette am Abend und gut. Handlicher als Mundspülung im Koffer.",tg:["general"],d:"2026-02-22"},
    {id:45,n:"Helena B.",cc:"AT",co:"Austria",r:4,t:"Preislich in Ordnung",b:"Im Abo unter einem Euro pro Tag. Wenn ich zusammenrechne, was ich vorher an Spülung und Kaugummi ausgegeben habe, ist es eher günstiger.",tg:["subscription"],d:"2026-02-22"},
    {id:46,n:"Hannah H.",cc:"DE",co:"Germany",r:5,t:"Sanft, reizt nichts",b:"Habe sehr empfindliches Zahnfleisch, viele Pflegeprodukte brennen. Diese Pastille nicht. Löst sich in Ruhe auf, Zahnfleisch wird ruhiger.",tg:["gum_health"],d:"2026-02-21"},
    {id:47,n:"Sophia N.",cc:"DE",co:"Germany",r:5,t:"Abo unkompliziert",b:"Jeden Monat automatisch da. Pausieren geht direkt im Account. Die zwanzig Prozent Rabatt sind im Alltag spürbar.",tg:["subscription"],d:"2026-02-20"},
    {id:48,n:"Ruben H.",cc:"NL",co:"Netherlands",r:4,t:"Smaak valt mee",b:"Was bang voor een vieze medicijnsmaak. Valt mee — milde munt, lost rustig op. Doe het nu automatisch als laatste stap voor het slapen.",tg:["general"],d:"2026-02-20"},
    {id:49,n:"Sebastian G.",cc:"AT",co:"Austria",r:5,t:"Nichts anderes hat gereicht",b:"Jede Mundspülung durchprobiert, nichts hat das Zahnfleischbluten dauerhaft gestoppt. Nach drei Wochen hier hat die Dentalhygienikerin es selbst gemerkt.",tg:["gum_health"],d:"2026-02-19"},
    {id:50,n:"Jasper B.",cc:"NL",co:"Netherlands",r:5,t:"Mondwater eruit gegooid",b:"Las dat alcoholspoelingen ook de goede bacteriën doden. Overgestapt op dit. Mond voelt minder droog en geïrriteerd.",tg:["general"],d:"2026-02-19"},
    {id:51,n:"Lucas V.",cc:"NL",co:"Netherlands",r:5,t:"Makkelijk mee op reis",b:"Geen vloeistof, geen koeling. Gaat mee op werkreizen zonder gedoe. Eén tablet voor het slapen, meer niet.",tg:["general"],d:"2026-02-18"},
    {id:52,n:"Tobias B.",cc:"DE",co:"Germany",r:4,t:"Klare Inhaltsstoffe",b:"Kein Zucker, keine künstlichen Süßstoffe, keine Füllstoffe, die ich nicht kenne. Lese jedes Etikett — hier stimmt es. Xylit ist sogar zahnfreundlich.",tg:["general"],d:"2026-02-18"},
    {id:53,n:"Manon T.",cc:"FR",co:"France",r:5,t:"Halitose sous contrôle",b:"Mauvaise haleine chronique depuis des années, aucun bain de bouche ne tenait. Premier produit qui travaille la cause. Cinq semaines, amélioration nette.",tg:["fresh_breath"],d:"2026-02-18"},
    {id:54,n:"Matthias B.",cc:"AT",co:"Austria",r:4,t:"Atem morgens deutlich besser",b:"Der Unterschied ist morgens am größten. Kein unangenehmer Atem beim Aufwachen. Dezent, aber dauerhaft.",tg:["fresh_breath"],d:"2026-02-17"},
    {id:55,n:"Pieter V.",cc:"NL",co:"Netherlands",r:5,t:"Handig abonnement",b:"Iedere maand een nieuwe pot op de mat, 20% korting. Geen gedoe met herhaalbestellen. Gewoon automatisch.",tg:["subscription"],d:"2026-02-17"},
    {id:56,n:"Lukas W.",cc:"AT",co:"Austria",r:5,t:"Langsam, aber messbar",b:"Keine Wunder erwartet. Nach sechs Wochen hat mein Zahnarzt aber gesagt, die Zahnfleischtaschen sind kleiner geworden. Das ist messbar.",tg:["gum_health","subscription"],d:"2026-02-17"},
    {id:57,n:"Vera M.",cc:"NL",co:"Netherlands",r:4,t:"Geduld nodig",b:"Eerste week niks gemerkt. Ergens rond week drie was die metaalachtige smaak weg. Tandvlees stabiel sinds week vijf.",tg:["gum_health"],d:"2026-02-17"},
    {id:58,n:"Axel G.",cc:"BE",co:"Belgium",r:5,t:"Remplace mon bain de bouche",b:"J'ai laissé tomber le bain de bouche à l'alcool. OralBiome rééquilibre au lieu de tout détruire. Ma bouche est moins sèche.",tg:["general"],d:"2026-02-17"},
    {id:59,n:"Leonie H.",cc:"DE",co:"Germany",r:5,t:"Zahnarzt hat zugestimmt",b:"Meine Zahnärztin in Hamburg hat orale Probiotika vorgeschlagen. CALQIX war das glaubwürdigste Produkt, das ich gefunden habe. Drei Monate — alles besser.",tg:["gum_health","subscription"],d:"2026-02-16"},
    {id:60,n:"Charlotte G.",cc:"BE",co:"Belgium",r:5,t:"Enfin quelque chose qui tient",b:"Tous les bains de bouche essayés, rien de durable. Trois semaines avec OralBiome, mon hygiéniste a vu la différence avant que je ne dise rien.",tg:["gum_health"],d:"2026-02-16"}
  ];
  var R2 = [
    {id:61,n:"Tobias F.",cc:"DE",co:"Germany",r:4,t:"Unterwegs unkompliziert",b:"Keine Flüssigkeit, kein Kühlen. Für Geschäftsreisen ideal. Eine Tablette vor dem Schlafen, fertig. Handlicher als Mundspülung.",tg:["general"],d:"2026-02-15"},
    {id:62,n:"Max B.",cc:"NL",co:"Netherlands",r:5,t:"Ochtendadem aangepakt",b:"Mijn partner merkte het eerder dan ik. Stukken minder ochtendadem sinds een maand. Poetsen, flossen, tablet — klaar.",tg:["fresh_breath"],d:"2026-02-15"},
    {id:63,n:"Noah S.",cc:"DE",co:"Germany",r:5,t:"Abo gut pausierbar",b:"Musste wegen Urlaub einen Monat aussetzen. Über den Account pausiert, kein Aufwand. Nächsten Monat wieder automatisch geliefert.",tg:["subscription"],d:"2026-02-14"},
    {id:64,n:"Thomas d.",cc:"NL",co:"Netherlands",r:5,t:"Resultaat kost tijd",b:"Eerste twee weken nauwelijks verschil. Vanaf week vier werd het duidelijk: minder bloedend tandvlees bij het flossen, frisser mondgevoel.",tg:["gum_health"],d:"2026-02-14"},
    {id:65,n:"Michiel V.",cc:"NL",co:"Netherlands",r:4,t:"Liever dit dan mondwater",b:"Mondwater heb ik eruit gedaan. Dit herstelt het evenwicht in plaats van alles weg te branden. Minder droog gevoel in mijn mond.",tg:["general"],d:"2026-02-14"},
    {id:66,n:"Emma P.",cc:"FR",co:"France",r:5,t:"Mieux qu'un chewing-gum",b:"Les chewing-gums camouflent. Là ça travaille le fond. Je suis en clientèle toute la journée, l'après-midi ça tient encore.",tg:["fresh_breath"],d:"2026-02-12"},
    {id:67,n:"Leon B.",cc:"DE",co:"Germany",r:4,t:"Zahnfleisch blutet nicht mehr",b:"Jahrelang Blut beim Flossen. Nach fünf Wochen täglich ist es weg. Meine Prophylaxe-Fachkraft hat es beim Termin von selbst angesprochen.",tg:["gum_health"],d:"2026-02-12"},
    {id:68,n:"Tess D.",cc:"NL",co:"Netherlands",r:4,t:"Frissere adem, vooral 's ochtends",b:"De ochtendadem is duidelijk minder. Mijn vriend merkte het als eerste. Eén tablet voor het slapen, simpel.",tg:["fresh_breath"],d:"2026-02-12"},
    {id:69,n:"Daan v.",cc:"NL",co:"Netherlands",r:5,t:"Abo scheelt gedoe",b:"Eén keer instellen en vergeten. Elke maand een nieuwe pot op de mat. 20% korting is mooi meegenomen. Mondwater heb ik opgezegd.",tg:["subscription"],d:"2026-02-11"},
    {id:70,n:"Sophia W.",cc:"DE",co:"Germany",r:5,t:"Geschmack ist okay",b:"Hatte Bedenken wegen Medizingeschmack. Ist aber nicht so: milde Minze, löst sich in zwei bis drei Minuten. Routine-tauglich.",tg:["general"],d:"2026-02-11"},
    {id:71,n:"Sophia S.",cc:"DE",co:"Germany",r:4,t:"Lieferung ohne Probleme",b:"Seit vier Monaten im Monatsabo. Immer pünktlich, sauber verpackt. Produkt wirkt bei mir konstant, Mundgesundheit stetig besser.",tg:["subscription"],d:"2026-02-11"},
    {id:72,n:"Nina D.",cc:"NL",co:"Netherlands",r:5,t:"Ochtendadem weg",b:"Ochtendadem was vervelend, vooral naast mijn partner. Sinds vier weken nauwelijks meer. Eén tablet voor het slapen is de hele moeite.",tg:["fresh_breath"],d:"2026-02-11"},
    {id:73,n:"Moritz B.",cc:"DE",co:"Germany",r:5,t:"Milde Minze",b:"Die Pastille löst sich in zwei bis drei Minuten, dezent mintig. Passt gut nach dem Zähneputzen in die Abendroutine.",tg:["general"],d:"2026-02-11"},
    {id:74,n:"Leonie N.",cc:"DE",co:"Germany",r:4,t:"Nutzt die ganze Familie",b:"Meine Frau und ich, und unsere 14-Jährige nimmt es auch. Der Geschmack ist für Teenies mild genug. Familienabo mit Rabatt wäre eine Idee.",tg:["general","subscription"],d:"2026-02-11"},
    {id:75,n:"Elias B.",cc:"DE",co:"Germany",r:3,t:"Gut, könnte günstiger sein",b:"Wirkt, mein Atem ist merklich besser. Beim Einzelkauf finde ich den Preis allerdings hoch. Im Abo geht es, aber die Marge ist knapp.",tg:["fresh_breath","subscription"],d:"2026-02-11"},
    {id:76,n:"Lotte d.",cc:"NL",co:"Netherlands",r:5,t:"Geen alcohol-mondwater meer",b:"Las dat alcoholmondwater ook het goede wegpoetst. Overgestapt op dit. Mond voelt minder droog en geïrriteerd.",tg:["general"],d:"2026-02-10"},
    {id:77,n:"Valentina B.",cc:"AT",co:"Austria",r:5,t:"Messbarer Fortschritt",b:"Erwartungen waren gering. Nach sechs Wochen hat mein Zahnarzt gesagt, die Zahnfleischtaschen sind zurückgegangen. Bleibe im Abo.",tg:["gum_health","subscription"],d:"2026-02-09"},
    {id:78,n:"Niels D.",cc:"NL",co:"Netherlands",r:4,t:"Slechte adem verbeterd",b:"Last van een hardnekkige slechte adem die niet wegging met poetsen. Na vier weken een stuk beter. Pakt de oorzaak aan.",tg:["fresh_breath"],d:"2026-02-09"},
    {id:79,n:"Katharina W.",cc:"AT",co:"Austria",r:4,t:"Abo leicht zu pausieren",b:"Wegen Urlaub einen Monat ausgesetzt. Über das Konto pausiert, null Aufwand. Nächster Monat kam wieder automatisch.",tg:["subscription"],d:"2026-02-09"},
    {id:80,n:"Lukas B.",cc:"AT",co:"Austria",r:5,t:"Die Forschung hat überzeugt",b:"L. reuteri nachgeschlagen vor dem Kauf. Über siebzig klinische Studien ist Evidenz. Und es zielt aufs orale Mikrobiom, nicht nur auf den Darm.",tg:["general"],d:"2026-02-08"},
    {id:81,n:"Tobias S.",cc:"DE",co:"Germany",r:4,t:"Lieferung läuft",b:"Drei Monate im Abo. Lieferung kommt rechtzeitig, sauber verpackt. Produkt wirkt stabil, keine Ausreißer.",tg:["subscription"],d:"2026-02-08"},
    {id:82,n:"Sanne D.",cc:"NL",co:"Netherlands",r:4,t:"Prijs is redelijk",b:"€19,95 per maand, iets van 65 cent per dag. Als ik het afzet tegen de mondwater en kauwgom van vroeger, scheelt het nauwelijks.",tg:["subscription"],d:"2026-02-06"},
    {id:83,n:"Julia d.",cc:"NL",co:"Netherlands",r:5,t:"Minder aanslag",b:"Ik bouw snel aanslag op tussen controles. Na twee maanden dagelijks merkte de mondhygiënist duidelijk minder. M18-stam doet blijkbaar wat.",tg:["gum_health"],d:"2026-02-05"},
    {id:84,n:"Max J.",cc:"NL",co:"Netherlands",r:5,t:"Ochtend is anders",b:"Het duidelijkste verschil is 's ochtends — geen muffe adem meer. Subtiel maar consistent. Eén tablet voor het slapen is genoeg.",tg:["fresh_breath"],d:"2026-02-05"},
    {id:85,n:"Tobias M.",cc:"DE",co:"Germany",r:5,t:"Braucht ein paar Wochen",b:"Erste Woche: nichts. Ab Woche drei war der metallische Geschmack weg. In Woche fünf hat das Zahnfleisch aufgehört zu bluten.",tg:["gum_health"],d:"2026-02-04"},
    {id:86,n:"Anouk D.",cc:"NL",co:"Netherlands",r:4,t:"Werkt echt",b:"Alles geprobeerd tegen bloedend tandvlees. Niks hield aan. Drie weken met OralBiome en de mondhygiënist merkte het uit zichzelf op.",tg:["gum_health"],d:"2026-02-04"},
    {id:87,n:"Stefan H.",cc:"AT",co:"Austria",r:5,t:"Morgenatem deutlich besser",b:"Meine Freundin hat es zuerst erwähnt. Seit einem Monat eine Pastille vor dem Schlafen. Zähneputzen, Zahnseide, Pastille — Routine.",tg:["fresh_breath"],d:"2026-02-04"},
    {id:88,n:"Emma D.",cc:"FR",co:"France",r:4,t:"Démarche scientifique",b:"Ce qui a pesé : la recherche derrière L. reuteri. Plus de soixante-dix études cliniques. Peu de compléments en ont autant.",tg:["general"],d:"2026-02-03"},
    {id:89,n:"Victor C.",cc:"BE",co:"Belgium",r:5,t:"Pour toute la famille",b:"Ma femme et moi, et aussi notre fille de douze ans. Le goût est suffisamment doux pour les enfants qui savent le laisser fondre.",tg:["general","subscription"],d:"2026-02-02"},
    {id:90,n:"Anna K.",cc:"DE",co:"Germany",r:4,t:"Weniger Zahnstein",b:"Bei der halbjährlichen Kontrolle sagte die Prophylaxe: merklich weniger Belag. Nichts anderes in der Routine geändert, nur diese Pastille dazu.",tg:["gum_health"],d:"2026-01-31"},
    {id:91,n:"Léa D.",cc:"FR",co:"France",r:5,t:"Recommandé par ma dentiste",b:"Gingivite qui revient régulièrement, ma dentiste m'a orientée vers les probiotiques oraux. Deux mois avec OralBiome, saignements en nette baisse.",tg:["gum_health","subscription"],d:"2026-01-31"},
    {id:92,n:"Lucas L.",cc:"FR",co:"France",r:4,t:"Fini le bain de bouche",b:"J'ai arrêté le bain de bouche à l'alcool. Celui-ci rééquilibre au lieu de tout détruire. Ma bouche est moins asséchée.",tg:["general"],d:"2026-01-30"},
    {id:93,n:"Pieter d.",cc:"NL",co:"Netherlands",r:5,t:"Abonnement werkt zoals het hoort",b:"Elke maand automatisch, 20% korting ten opzichte van losse koop. Instellen en vergeten. Pauzeren of stoppen kan op elk moment.",tg:["subscription"],d:"2026-01-30"},
    {id:94,n:"Sanne B.",cc:"NL",co:"Netherlands",r:3,t:"Prima maar prijzig",b:"Doet wat het moet — adem is merkbaar frisser. Losse aankoop vind ik vrij prijzig, abo is schappelijker. Zou zelf iets lager zitten.",tg:["fresh_breath","subscription"],d:"2026-01-28"},
    {id:95,n:"Tess V.",cc:"NL",co:"Netherlands",r:5,t:"Adem 's ochtends stukken beter",b:"Mijn partner merkte dat de ochtendadem dramatisch is verbeterd. Inmiddels een vaste stap voor het slapen — poetsen, flossen, tablet.",tg:["fresh_breath"],d:"2026-01-26"},
    {id:96,n:"Eline d.",cc:"NL",co:"Netherlands",r:5,t:"Simpel in gebruik",b:"Eén tabletje voor het slapen op de tong laten oplossen. Lichte muntsmaak, niet opdringerig. Past in mijn avondroutine.",tg:["general"],d:"2026-01-26"},
    {id:97,n:"David B.",cc:"DE",co:"Germany",r:5,t:"Geschmack in Ordnung",b:"War skeptisch wegen kreidigem Medizingeschmack. Ist nicht so — milde Minze, löst sich in zwei bis drei Minuten.",tg:["general"],d:"2026-01-26"},
    {id:98,n:"Eva V.",cc:"NL",co:"Netherlands",r:5,t:"Halitose onder controle",b:"Chronische slechte adem, meer dan tien jaar. Alles geprobeerd. Dit is het eerste product dat echt aan de oorzaak lijkt te werken.",tg:["fresh_breath"],d:"2026-01-25"},
    {id:99,n:"Olivia J.",cc:"BE",co:"Belgium",r:5,t:"Handig voor op reis",b:"Geen vloeistoffen, geen koeling nodig. Reis veel voor werk, gaat mee in de toilettas. Eén tablet voor het slapen en ik ben klaar.",tg:["general"],d:"2026-01-24"},
    {id:100,n:"Anouk d.",cc:"NL",co:"Netherlands",r:5,t:"Merkbaar verschil na 6 weken",b:"Ik ben kritisch op supplementen. Resultaten zijn er wel: minder bloedend tandvlees, frissere adem, tandarts bevestigt het.",tg:["gum_health","fresh_breath"],d:"2026-01-24"},
    {id:101,n:"Sem d.",cc:"NL",co:"Netherlands",r:5,t:"Zes weken, wel verschil",b:"Eerst sceptisch. Na zes weken minder bloedend tandvlees, frissere adem, tandarts ziet het ook. Blijf het gebruiken.",tg:["gum_health","fresh_breath"],d:"2026-01-23"},
    {id:102,n:"Valentina W.",cc:"AT",co:"Austria",r:5,t:"Halitose endlich im Griff",b:"Chronischer Mundgeruch seit Jahren. Kein Mundwasser hat langfristig geholfen. Dieses Produkt arbeitet an der Ursache. Nach fünf Wochen spürbar besser.",tg:["fresh_breath"],d:"2026-01-23"},
    {id:103,n:"Camille B.",cc:"FR",co:"France",r:5,t:"Prix honnête dans l'abonnement",b:"Dans l'abonnement, ça revient à moins d'un euro par jour. Pour une amélioration concrète en bouche, je trouve ça correct.",tg:["subscription"],d:"2026-01-22"},
    {id:104,n:"Liam M.",cc:"NL",co:"Netherlands",r:5,t:"Mondwater eruit",b:"Jarenlang spoeling gebruikt, mond bleef droog. Sinds ik dit neem voelt het beter. Rebalans in plaats van wegbranden.",tg:["general"],d:"2026-01-22"},
    {id:105,n:"Joris S.",cc:"NL",co:"Netherlands",r:4,t:"Tandvlees stabiel",b:"Jaren bloedend tandvlees bij het poetsen. Zes weken met OralBiome, eindelijk verandering. Tandarts bevestigde het bij de halfjaarlijkse.",tg:["gum_health"],d:"2026-01-21"},
    {id:106,n:"Finn M.",cc:"DE",co:"Germany",r:5,t:"Abo unkompliziert",b:"Automatische Monatslieferung. Pausieren und kündigen direkt im Account. Der Rabatt macht es preislich okay.",tg:["subscription"],d:"2026-01-21"},
    {id:107,n:"Julian S.",cc:"DE",co:"Germany",r:3,t:"Wirkt, aber teuer",b:"Funktioniert bei mir — schlechter Atem ist deutlich besser. Einzelkauf finde ich preislich grenzwertig, im Abo wird es akzeptabel.",tg:["fresh_breath","subscription"],d:"2026-01-20"},
    {id:108,n:"Tim B.",cc:"NL",co:"Netherlands",r:4,t:"Onderzoek overtuigde",b:"Heb L. reuteri opgezocht voor ik bestelde. Meer dan 70 klinische studies is serieus. Dit richt zich op het orale microbioom, niet alleen de darm.",tg:["general"],d:"2026-01-20"},
    {id:109,n:"Emilia S.",cc:"DE",co:"Germany",r:5,t:"Nach drei Wochen Veränderung",b:"Erste zwei Wochen nichts gespürt. Ab Woche drei weniger Belag, Zahnfleisch fester. Muss man aushalten, dann zahlt es sich aus.",tg:["gum_health"],d:"2026-01-20"},
    {id:110,n:"Nina B.",cc:"NL",co:"Netherlands",r:5,t:"Subtiel maar echt",b:"Verwachtte geen wonderen. Na zes weken zei mijn tandarts dat de pockets kleiner zijn. Dat is meetbaar, geen placebo.",tg:["gum_health","subscription"],d:"2026-01-20"},
    {id:111,n:"Liam d.",cc:"NL",co:"Netherlands",r:5,t:"Schoon etiket",b:"Geen suiker, geen kunstmatige zoetstoffen, geen rare vulstoffen. Lees elk etiket, dit klopt. Xylitol is zelfs gunstig voor je gebit.",tg:["general"],d:"2026-01-19"},
    {id:112,n:"Koen B.",cc:"NL",co:"Netherlands",r:4,t:"Beter dan mondwater",b:"Jarenlang Listerine. Sinds ik las dat het ook de goede bacteriën doodt ben ik gestopt. Dit herstelt juist. Minder droge mond.",tg:["general"],d:"2026-01-19"},
    {id:113,n:"Anna P.",cc:"AT",co:"Austria",r:4,t:"Abo ist praktisch",b:"Jeden Monat eine neue Dose im Briefkasten. Kein Nachbestellen, kein Vergessen. Der Rabatt macht es im Jahr spürbar günstiger.",tg:["subscription"],d:"2026-01-18"},
    {id:114,n:"Clara L.",cc:"DE",co:"Germany",r:4,t:"Skeptisch gestartet",b:"Orale Probiotika klangen nach Trend. Einzelpackung zum Testen. Nach vier Wochen war der Mundgeruch tatsächlich besser. Jetzt im Abo.",tg:["fresh_breath","subscription"],d:"2026-01-18"},
    {id:115,n:"Julia J.",cc:"NL",co:"Netherlands",r:5,t:"Doordacht samengesteld",b:"Wat me overtuigde is het onderzoek achter L. reuteri. Dat is niet niks. Voor supplementen is die onderbouwing zeldzaam.",tg:["general"],d:"2026-01-18"},
    {id:116,n:"Julia P.",cc:"NL",co:"Netherlands",r:5,t:"Geen mondwater meer",b:"Alcoholspoeling eruit. Dit herstelt de balans in plaats van alles weg te branden. Mond voelt minder droog.",tg:["general"],d:"2026-01-17"},
    {id:117,n:"Sarah H.",cc:"DE",co:"Germany",r:5,t:"War skeptisch, nicht mehr",b:"Probiotika für den Mund klang nach Hype. Eine Packung zum Ausprobieren. Nach vier Wochen war der chronische Mundgeruch besser. Jetzt im Abo.",tg:["fresh_breath","subscription"],d:"2026-01-16"},
    {id:118,n:"Marie S.",cc:"DE",co:"Germany",r:5,t:"Besser als Kaugummi",b:"Kaugummis kaschieren den Geruch. Das hier arbeitet am Problem. Bei Kundenterminen am Nachmittag macht das einen spürbaren Unterschied.",tg:["fresh_breath"],d:"2026-01-16"},
    {id:119,n:"Lisa V.",cc:"NL",co:"Netherlands",r:5,t:"Hele gezin gebruikt het",b:"Mijn man en ik, en onze dochter van veertien ook. Smaak is mild genoeg voor tieners. Een gezinsabo zou handig zijn.",tg:["general","subscription"],d:"2026-01-15"},
    {id:120,n:"Koen d.",cc:"NL",co:"Netherlands",r:4,t:"Kost tijd, maar dan ook echt",b:"Eerste twee weken niks gevoeld. Vanaf week vier werd het merkbaar: minder bloedend tandvlees, frisser mondgevoel. Even doorzetten.",tg:["gum_health"],d:"2026-01-15"}
  ];
  var reviews = R.concat(R2);

  /* ------------------------------------------------------------------ */
  /*  Cron-injected reviews                                              */
  /*                                                                    */
  /*  The daily QStash cron `/api/cron/ob-reviews-add` picks 2-4 random */
  /*  review templates from `calqix-capi/data/ob-review-pool.json` and  */
  /*  prepends them to the product metafield                            */
  /*  `product.metafields.calqix.ob_extra_reviews` (JSON array).        */
  /*  We parse + merge here so newly-added reviews appear without any   */
  /*  theme deploy. Malformed entries are silently skipped.             */
  /* ------------------------------------------------------------------ */
  try {
    {%- assign extra_reviews_raw = product.metafields.calqix.ob_extra_reviews -%}
    {%- if extra_reviews_raw -%}
      var extraJson = {{ extra_reviews_raw | json }};
      if (typeof extraJson === 'string' && extraJson.length > 0) {
        try {
          var parsed = JSON.parse(extraJson);
          if (Array.isArray(parsed)) {
            // Normalize each entry; keep only reviews with required fields.
            var cleaned = parsed.filter(function(r){
              return r && r.n && r.cc && r.co && r.r && r.t && r.b && r.d && Array.isArray(r.tg);
            });
            // Newest first (prepend). The cron itself should prepend, but we
            // defend against ordering drift by sorting on date desc.
            cleaned.sort(function(a, b){ return (a.d < b.d ? 1 : a.d > b.d ? -1 : 0); });
            reviews = cleaned.concat(reviews);
          }
        } catch (e) { /* silently ignore malformed metafield */ }
      } else if (Array.isArray(extraJson)) {
        // Metafield type `list.metaobject_reference` or similar may hand us an array directly.
        var cleaned2 = extraJson.filter(function(r){
          return r && r.n && r.cc && r.co && r.r && r.t && r.b && r.d && Array.isArray(r.tg);
        });
        cleaned2.sort(function(a, b){ return (a.d < b.d ? 1 : a.d > b.d ? -1 : 0); });
        reviews = cleaned2.concat(reviews);
      }
    {%- endif -%}
  } catch (e) { /* silently ignore */ }

  var PER_PAGE = 6;
  var currentFilter = 'all';
  var visibleCount = PER_PAGE;
  var grid = section.querySelector('[data-ob-grid]');
  var showMoreBtn = section.querySelector('[data-ob-show-more]');
  var filtersWrap = section.querySelector('[data-ob-filters]');
  var breakdownEl = section.querySelector('[data-ob-breakdown]');
  var FLAGS = {NL:'\u{1F1F3}\u{1F1F1}',DE:'\u{1F1E9}\u{1F1EA}',BE:'\u{1F1E7}\u{1F1EA}',AT:'\u{1F1E6}\u{1F1F9}',FR:'\u{1F1EB}\u{1F1F7}',SE:'\u{1F1F8}\u{1F1EA}',DK:'\u{1F1E9}\u{1F1F0}',NO:'\u{1F1F3}\u{1F1F4}',FI:'\u{1F1EB}\u{1F1EE}',IT:'\u{1F1EE}\u{1F1F9}',ES:'\u{1F1EA}\u{1F1F8}',PT:'\u{1F1F5}\u{1F1F9}',IE:'\u{1F1EE}\u{1F1EA}',GB:'\u{1F1EC}\u{1F1E7}',CH:'\u{1F1E8}\u{1F1ED}'};
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var STAR_GOLD = '<svg width="14" height="14" viewBox="0 0 24 24" fill="#C9A84C"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
  var STAR_GREY = '<svg width="14" height="14" viewBox="0 0 24 24" fill="#E5E7EB"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
  var CHECK_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="#2E7D32"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
  var readMoreLabel = {{ section.settings.read_more_label | json }};
  var readLessLabel = {{ section.settings.read_less_label | json }};
  var verifiedText = {{ section.settings.verified_text | json }};

  /* Rating breakdown */
  var counts = [0,0,0,0,0];
  reviews.forEach(function(r){ counts[r.r - 1]++; });
  var total = reviews.length;

  /* Dynamic "Based on N reviews" — grows when cron appends to metafield. */
  try {
    var countEl = section.querySelector('.ob-reviews__count');
    if (countEl) {
      var staticLabel = countEl.textContent || '';
      var m = staticLabel.match(/(\d+)/);
      if (m && parseInt(m[1], 10) !== total) {
        countEl.textContent = staticLabel.replace(/\d+/, String(total));
      }
    }
    /* Also keep the big aggregate average up to date. */
    var sum = 0;
    reviews.forEach(function(r){ sum += r.r; });
    var avg = total > 0 ? (sum / total) : 0;
    var avgStr = avg.toFixed(1);
    var bigEl = section.querySelector('.ob-reviews__big-number');
    if (bigEl) bigEl.textContent = avgStr;

    /* Sync the hero product-review-badge ("★★★★★ 4.7 · Based on 121 reviews")
       so it stays consistent with this section's computed numbers. The badge
       may appear multiple times on the page (mobile + desktop render paths),
       so update every match. */
    document.querySelectorAll('.prb__rating').forEach(function(el){
      el.textContent = avgStr;
    });
    document.querySelectorAll('.prb__count').forEach(function(el){
      var txt = el.textContent || '';
      if (/\d+/.test(txt)) {
        el.textContent = txt.replace(/\d+/, String(total));
      }
    });
    document.querySelectorAll('.prb').forEach(function(el){
      var aria = el.getAttribute('aria-label') || '';
      if (aria) {
        var newAria = aria.replace(/[\d.]+\s*out of/, avgStr + ' out of').replace(/—\s*\d+/, '— ' + String(total));
        el.setAttribute('aria-label', newAria);
      }
    });
  } catch (e) { /* silent */ }
  if (breakdownEl) {
    var html = '';
    for (var s = 5; s >= 1; s--) {
      var pct = total > 0 ? (counts[s-1] / total * 100).toFixed(1) : 0;
      html += '<div class="ob-reviews__bar-row"><span class="ob-reviews__bar-label">' + s + ' \u2605</span><div class="ob-reviews__bar-track"><div class="ob-reviews__bar-fill" style="width:' + pct + '%"></div></div><span class="ob-reviews__bar-count">' + counts[s-1] + '</span></div>';
    }
    breakdownEl.innerHTML = html;
  }

  /* Tag counts for filter buttons */
  var tagCounts = {all: total, gum_health: 0, fresh_breath: 0, subscription: 0};
  reviews.forEach(function(r){ r.tg.forEach(function(t){ if (tagCounts[t] !== undefined) tagCounts[t]++; }); });

  /* Render filter tabs */
  if (filtersWrap) {
    var filterAll = {{ section.settings.filter_all | json }};
    var filterGum = {{ section.settings.filter_gum | json }};
    var filterBreath = {{ section.settings.filter_breath | json }};
    var filterSub = {{ section.settings.filter_sub | json }};
    filtersWrap.innerHTML =
      '<button class="ob-reviews__filter-btn is-active" data-filter="all" role="tab" aria-selected="true">' + filterAll + ' (' + tagCounts.all + ')</button>' +
      '<button class="ob-reviews__filter-btn" data-filter="gum_health" role="tab" aria-selected="false">' + filterGum + ' (' + tagCounts.gum_health + ')</button>' +
      '<button class="ob-reviews__filter-btn" data-filter="fresh_breath" role="tab" aria-selected="false">' + filterBreath + ' (' + tagCounts.fresh_breath + ')</button>' +
      '<button class="ob-reviews__filter-btn" data-filter="subscription" role="tab" aria-selected="false">' + filterSub + ' (' + tagCounts.subscription + ')</button>';

    filtersWrap.querySelectorAll('.ob-reviews__filter-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        filtersWrap.querySelectorAll('.ob-reviews__filter-btn').forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-selected','false'); });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected','true');
        currentFilter = btn.dataset.filter;
        visibleCount = PER_PAGE;
        renderReviews();
      });
    });
  }

  function getFiltered() {
    if (currentFilter === 'all') return reviews;
    return reviews.filter(function(r){ return r.tg.indexOf(currentFilter) !== -1; });
  }

  function fmtDate(ds) {
    var d = new Date(ds);
    return d.getDate() + ' ' + MONTHS[d.getMonth()] + ' ' + d.getFullYear();
  }

  function renderReviews() {
    if (!grid) return;
    var filtered = getFiltered();
    var toShow = filtered.slice(0, visibleCount);
    grid.innerHTML = toShow.map(function(r) {
      var stars = '';
      for (var i = 0; i < 5; i++) stars += (i < r.r ? STAR_GOLD : STAR_GREY);
      var flag = FLAGS[r.cc] || '';
      return '<div class="ob-reviews__card"><div class="ob-reviews__card-stars">' + stars + '</div>' +
        '<h4 class="ob-reviews__card-title">' + r.t + '</h4>' +
        '<p class="ob-reviews__card-body" data-ob-body>' + r.b + '</p>' +
        '<button type="button" class="ob-reviews__read-more" data-ob-read-more>' + readMoreLabel + '</button>' +
        '<div class="ob-reviews__card-footer"><div class="ob-reviews__card-reviewer"><span class="ob-reviews__card-name">' + r.n + '</span><span class="ob-reviews__card-country">' + flag + ' ' + r.co + '</span></div>' +
        '<div class="ob-reviews__card-meta"><span class="ob-reviews__card-verified">' + CHECK_SVG + ' ' + verifiedText + '</span><span class="ob-reviews__card-date">' + fmtDate(r.d) + '</span></div></div></div>';
    }).join('');

    /* "Read more" detection */
    grid.querySelectorAll('.ob-reviews__card-body').forEach(function(body) {
      var btn = body.nextElementSibling;
      if (body.scrollHeight > body.clientHeight + 2) {
        btn.classList.add('is-needed');
      }
    });

    /* "Read more" toggle */
    grid.querySelectorAll('[data-ob-read-more]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = btn.previousElementSibling;
        body.classList.toggle('is-expanded');
        btn.textContent = body.classList.contains('is-expanded') ? readLessLabel : readMoreLabel;
      });
    });

    /* Show more button */
    if (showMoreBtn) {
      if (filtered.length <= visibleCount) {
        showMoreBtn.style.display = 'none';
      } else {
        showMoreBtn.style.display = '';
        var remaining = filtered.length - visibleCount;
        showMoreBtn.textContent = {{ section.settings.show_more_label | json }} + ' (' + remaining + ' remaining)';
      }
    }

    /* Animate cards in */
    requestAnimationFrame(function() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var cards = Array.from(grid.querySelectorAll('.ob-reviews__card:not(.is-visible)'));
            var idx = cards.indexOf(entry.target);
            entry.target.style.transitionDelay = ((idx % 3) * 0.08) + 's';
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, {threshold: 0.1});
      grid.querySelectorAll('.ob-reviews__card:not(.is-visible)').forEach(function(el){ observer.observe(el); });
    });
  }

  if (showMoreBtn) {
    showMoreBtn.addEventListener('click', function() {
      visibleCount += PER_PAGE;
      renderReviews();
    });
  }

  renderReviews();

  /* ── Review Modal ── */
  var reviewModal = document.getElementById('ob-review-modal-{{ section.id }}');
  var openBtn = section.querySelector('[data-ob-open-review]');
  var closeBtn = reviewModal ? reviewModal.querySelector('[data-ob-close-review]') : null;
  var starsWrap = reviewModal ? reviewModal.querySelector('[data-ob-stars]') : null;
  var ratingInput = reviewModal ? reviewModal.querySelector('[data-ob-rating-input]') : null;
  var formEl = reviewModal ? reviewModal.querySelector('[data-ob-review-form-el]') : null;
  var formWrap = reviewModal ? reviewModal.querySelector('[data-ob-review-form]') : null;
  var successWrap = reviewModal ? reviewModal.querySelector('[data-ob-review-success]') : null;

  function openReviewModal() {
    if (!reviewModal) return;
    reviewModal.classList.add('is-open');
    reviewModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeReviewModal() {
    if (!reviewModal) return;
    reviewModal.classList.remove('is-open');
    reviewModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openReviewModal);
  if (closeBtn) closeBtn.addEventListener('click', closeReviewModal);
  if (reviewModal) {
    reviewModal.addEventListener('click', function(e) {
      if (e.target === reviewModal) closeReviewModal();
    });
  }

  /* Star rating picker */
  if (starsWrap && ratingInput) {
    var stars = starsWrap.querySelectorAll('.ob-review-modal__star');
    function setRating(val) {
      ratingInput.value = val;
      stars.forEach(function(s) {
        s.classList.toggle('is-active', parseInt(s.dataset.star) <= val);
      });
    }
    stars.forEach(function(s) {
      s.addEventListener('click', function() { setRating(parseInt(s.dataset.star)); });
      s.addEventListener('mouseenter', function() {
        var v = parseInt(s.dataset.star);
        stars.forEach(function(st) { st.classList.toggle('is-active', parseInt(st.dataset.star) <= v); });
      });
    });
    starsWrap.addEventListener('mouseleave', function() {
      setRating(parseInt(ratingInput.value));
    });
  }

  /* AJAX form submit */
  if (formEl) {
    formEl.addEventListener('submit', function(e) {
      e.preventDefault();
      var submitBtn = formEl.querySelector('[data-ob-review-submit]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '...'; }
      var body = formEl.querySelector('[name="contact[body]"]');
      if (body && ratingInput) {
        body.value = '[Rating: ' + ratingInput.value + '/5]\n[Title: ' + (formEl.querySelector('[name="contact[review_title]"]').value || '') + ']\n\n' + body.value;
      }
      var formData = new FormData(formEl);
      fetch('/contact#contact_form', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'text/html' }
      }).then(function() {
        if (formWrap) formWrap.style.display = 'none';
        if (successWrap) successWrap.style.display = '';
        setTimeout(closeReviewModal, 3500);
      }).catch(function() {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Submit Review'; }
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "OB Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL RESULTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers are saying" },
    { "type": "text", "id": "avg_rating", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "based_on_text", "label": "Based on text", "default": "Based on 120 reviews" },
    { "type": "checkbox", "id": "use_judgeme", "label": "Use Judge.me widget", "default": false },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter tabs", "default": true },
    { "type": "text", "id": "filter_all", "label": "Filter: All", "default": "All" },
    { "type": "text", "id": "filter_gum", "label": "Filter: Gum Health", "default": "Gum Health" },
    { "type": "text", "id": "filter_breath", "label": "Filter: Fresh Breath", "default": "Fresh Breath" },
    { "type": "text", "id": "filter_sub", "label": "Filter: Subscription", "default": "Subscription" },
    { "type": "text", "id": "verified_text", "label": "Verified badge text", "default": "Verified" },
    { "type": "text", "id": "show_more_label", "label": "Show more reviews button", "default": "Show more reviews" },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "read_less_label", "label": "Read less label", "default": "Read less" },
    { "type": "text", "id": "write_review_text", "label": "Write review button", "default": "Write a Review" },
    { "type": "url", "id": "write_review_url", "label": "Write review URL" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Review body text." },
        { "type": "text", "id": "author", "label": "Author name", "default": "Customer" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
        { "type": "text", "id": "date", "label": "Date", "default": "2025-01-15" },
        { "type": "text", "id": "tags", "label": "Tags (comma-separated)", "default": "gum,breath" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Reviews"
    }
  ]
}
{% endschema %}
