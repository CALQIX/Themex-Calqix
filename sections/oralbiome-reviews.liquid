<style>
  .ob-reviews { background: #F4F5F7; padding: 48px 16px; }
  .ob-reviews__container { max-width: 1000px; margin: 0 auto; padding: 0; }
  .ob-reviews__header { text-align: center; margin-bottom: 32px; }
  .ob-reviews__eyebrow { font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 3px; color: #C9A84C; margin: 0 0 12px; }
  .ob-reviews__heading { font-family: 'DM Serif Display', serif; font-size: 28px; color: #1A3B5C; margin: 0 0 32px; line-height: 1.3; }
  .ob-reviews__aggregate { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 24px; }
  .ob-reviews__big-number { font-family: 'DM Serif Display', serif; font-size: 44px; color: #1A3B5C; line-height: 1; }
  .ob-reviews__agg-stars { display: flex; gap: 2px; }
  .ob-reviews__agg-stars svg { width: 22px; height: 22px; }
  .ob-reviews__count { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #6B7280; }
  .ob-reviews__breakdown { max-width: 400px; margin: 0 auto 32px; }
  .ob-reviews__bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
  .ob-reviews__bar-label { font-family: 'DM Sans', sans-serif; font-size: 12px; color: #6B7280; width: 30px; text-align: right; flex-shrink: 0; }
  .ob-reviews__bar-track { flex: 1; height: 8px; background: #E5E7EB; border-radius: 4px; overflow: hidden; }
  .ob-reviews__bar-fill { height: 8px; background: #C9A84C; border-radius: 4px; transition: width 0.6s ease; }
  .ob-reviews__bar-count { font-family: 'DM Sans', sans-serif; font-size: 12px; color: #6B7280; width: 24px; text-align: right; flex-shrink: 0; }
  .ob-reviews__filters { display: flex; justify-content: center; gap: 8px; margin-bottom: 32px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; flex-wrap: nowrap; padding: 0 0 4px; }
  .ob-reviews__filters::-webkit-scrollbar { display: none; }
  .ob-reviews__filter-btn { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; padding: 8px 20px; border: 1px solid #E5E7EB; border-radius: 50px; background: #fff; color: #6B7280; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; flex-shrink: 0; }
  .ob-reviews__filter-btn:hover { border-color: #1A3B5C; background: #1A3B5C; color: #fff; }
  .ob-reviews__filter-btn.is-active { background: #1A3B5C; color: #fff; border-color: #1A3B5C; }
  .ob-reviews__grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .ob-reviews__card { background: #fff; border: 1px solid #E5E7EB; border-radius: 8px; padding: 20px; opacity: 0; transform: translateY(12px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .ob-reviews__card.is-visible { opacity: 1; transform: translateY(0); }
  .ob-reviews__card-stars { display: flex; gap: 1px; }
  .ob-reviews__card-stars svg { width: 14px; height: 14px; }
  .ob-reviews__card-title { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; color: #1A3B5C; margin: 12px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ob-reviews__card-body { font-family: 'DM Sans', sans-serif; font-size: 13px; color: #6B7280; line-height: 1.6; margin: 8px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ob-reviews__card-body.is-expanded { -webkit-line-clamp: unset; }
  .ob-reviews__read-more { background: none; border: none; font-family: 'DM Sans', sans-serif; font-size: 12px; color: #C9A84C; cursor: pointer; padding: 0; margin-top: 6px; display: none; }
  .ob-reviews__read-more:hover { text-decoration: underline; }
  .ob-reviews__read-more.is-needed { display: inline; }
  .ob-reviews__card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; padding-top: 12px; border-top: 1px solid #F3F4F6; }
  .ob-reviews__card-reviewer { display: flex; flex-direction: column; }
  .ob-reviews__card-name { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600; color: #1A3B5C; }
  .ob-reviews__card-country { font-family: 'DM Sans', sans-serif; font-size: 11px; color: #6B7280; }
  .ob-reviews__card-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .ob-reviews__card-verified { display: inline-flex; align-items: center; gap: 4px; background: #F0FDF4; color: #2E7D32; font-family: 'DM Sans', sans-serif; font-size: 11px; padding: 2px 8px; border-radius: 50px; }
  .ob-reviews__card-date { font-family: 'DM Sans', sans-serif; font-size: 11px; color: #D1D5DB; }
  .ob-reviews__show-more { display: block; margin: 32px auto 0; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 12px 32px; border: 1px solid #1A3B5C; border-radius: 4px; background: transparent; color: #1A3B5C; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; }
  .ob-reviews__show-more:hover { background: #1A3B5C; color: #fff; }
  .ob-reviews__write { display: block; margin: 16px auto 0; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 12px 32px; border: 1px solid #C9A84C; border-radius: 4px; background: transparent; color: #C9A84C; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; text-decoration: none; text-align: center; }
  .ob-reviews__write:hover { background: #C9A84C; color: #1A3B5C; }
  .ob-reviews__judgeme { margin-top: 32px; }
  @media (max-width: 767px) {
    .ob-reviews__filters { justify-content: flex-start; padding: 0 16px 4px; }
  }
  @media (min-width: 768px) {
    .ob-reviews { padding: 48px 0; }
    .ob-reviews__container { padding: 0 20px; }
    .ob-reviews__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .ob-reviews__aggregate { flex-direction: column; gap: 8px; }
    .ob-reviews__big-number { font-size: 56px; }
    .ob-reviews__card { padding: 24px; }
  }
  @media (min-width: 1024px) {
    .ob-reviews { padding: 80px 0; }
    .ob-reviews__heading { font-size: 36px; }
    .ob-reviews__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- assign _ob_rev_eyebrow = section.settings.eyebrow -%}
{%- assign _ob_rev_heading = section.settings.heading -%}
{%- assign _ob_rev_write = section.settings.write_review_text -%}
{%- if _ob_lang == 'nl' or _ob_lang == 'de' or _ob_lang == 'fr' or _ob_lang == 'sv' or _ob_lang == 'nb' or _ob_lang == 'da' or _ob_lang == 'fi' -%}
  {%- assign _ob_rev_eyebrow = 'calqix_oralbiome.reviews.eyebrow' | t -%}
  {%- assign _ob_rev_heading = 'calqix_oralbiome.reviews.heading' | t -%}
  {%- assign _ob_rev_write = 'calqix_oralbiome.reviews.write_review' | t -%}
{%- endif -%}

<section class="ob-reviews" id="oralbiome-reviews" data-section-id="{{ section.id }}">
  <div class="ob-reviews__container">
    <div class="ob-reviews__header">
      <p class="ob-reviews__eyebrow">{{ _ob_rev_eyebrow }}</p>
      <h2 class="ob-reviews__heading">{{ _ob_rev_heading }}</h2>
      <div class="ob-reviews__aggregate">
        <span class="ob-reviews__big-number">{{ section.settings.avg_rating }}</span>
        <div class="ob-reviews__agg-stars">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24" fill="#C9A84C"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {%- endfor -%}
        </div>
        <span class="ob-reviews__count">{{ section.settings.based_on_text }}</span>
      </div>
      <div class="ob-reviews__breakdown" data-ob-breakdown></div>
    </div>

    {%- if section.settings.show_filters -%}
      <div class="ob-reviews__filters" role="tablist" data-ob-filters></div>
    {%- endif -%}

    {%- if section.settings.use_judgeme -%}
      <div class="ob-reviews__judgeme">
        <div id="judgeme_product_reviews" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
      </div>
    {%- else -%}
      <div class="ob-reviews__grid" data-ob-grid></div>
      <button type="button" class="ob-reviews__show-more" data-ob-show-more>{{ section.settings.show_more_label }}</button>
      <a class="ob-reviews__write" href="{{ section.settings.write_review_url | default: '#write-review' }}">{{ _ob_rev_write }}</a>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;
  var useJudgeme = {{ section.settings.use_judgeme | json }};
  if (useJudgeme) return;

  var R = [
    {id:1,n:"Juliette J.",cc:"BE",co:"Belgium",r:5,t:"Tandvlees bloedt niet meer",b:"Na jaren van bloedend tandvlees bij het flossen is het eindelijk gestopt. Gebruik OralBiome Pro nu 5 weken elke avond voor het slapen. Mijn mondhygiënist was positief verrast bij de laatste controle.",tg:["gum_health"],d:"2026-03-19"},
    {id:2,n:"Manon L.",cc:"FR",co:"France",r:5,t:"Great for sensitive gums",b:"I have very sensitive gums and most products irritate them further. This is gentle — it's just a lozenge that dissolves. No burning, no stinging. And my gums are actually improving. Highly recommend.",tg:["gum_health"],d:"2026-03-18"},
    {id:3,n:"Valentina M.",cc:"AT",co:"Austria",r:4,t:"Better than any breath mint",b:"Breath mints mask the problem. This actually addresses it. I work in client-facing meetings all day and the confidence boost alone is worth it. Fresh breath lasts well into the afternoon. Five stars.",tg:["fresh_breath"],d:"2026-03-18"},
    {id:4,n:"Marieke v.",cc:"NL",co:"Netherlands",r:4,t:"Auch für empfindliches Zahnfleisch",b:"Ich habe sehr empfindliches Zahnfleisch und die meisten Produkte reizen es zusätzlich. Diese Lutschtablette ist sanft — kein Brennen, kein Stechen. Und mein Zahnfleisch erholt sich tatsächlich. Five stars.",tg:["gum_health"],d:"2026-03-17"},
    {id:5,n:"Anna M.",cc:"AT",co:"Austria",r:5,t:"Took a few weeks to notice",b:"Honestly, the first week I didn't feel much difference. By week 3, I realised I hadn't had that metallic taste in my mouth that I usually get. By week 5, my gums stopped bleeding when I floss. Patience pays off.",tg:["gum_health"],d:"2026-03-17"},
    {id:6,n:"Louise M.",cc:"BE",co:"Belgium",r:5,t:"Zahnfleisch deutlich verbessert",b:"Nach jahrelangen Zahnfleischproblemen endlich eine Verbesserung. Benutze OralBiome Pro seit 6 Wochen täglich vor dem Schlafengehen. Mein Zahnarzt hat den Unterschied bei der letzten Kontrolle bestätigt.",tg:["gum_health"],d:"2026-03-16"},
    {id:7,n:"Raphaël M.",cc:"FR",co:"France",r:5,t:"Weniger Plaque-Aufbau",b:"Meine Dentalhygienikerin hat bei der letzten Reinigung deutlich weniger Plaque festgestellt. Ich habe sonst nichts an meiner Routine geändert — nur OralBiome Pro hinzugefügt.",tg:["gum_health"],d:"2026-03-16"},
    {id:8,n:"David S.",cc:"DE",co:"Germany",r:5,t:"Subscription delivery is reliable",b:"Always arrives on time, well packaged. I've been on the monthly subscription for 4 months now. Never had an issue. The product itself keeps working — my oral health has genuinely improved. Great addition to my routine.",tg:["subscription"],d:"2026-03-16"},
    {id:9,n:"Iris B.",cc:"NL",co:"Netherlands",r:5,t:"Easy to travel with",b:"No liquids, no refrigeration needed. I travel for work constantly and this just goes in my toiletry bag. One tablet before bed, done. So much easier than carrying mouthwash through airport security.",tg:["general"],d:"2026-03-14"},
    {id:10,n:"Lukas S.",cc:"AT",co:"Austria",r:4,t:"Wissenschaftlich fundiert",b:"Was mich überzeugt hat: L. reuteri ist in über 70 klinischen Studien untersucht. Das ist kein Marketing — das ist Evidenz. Die meisten Produkte in diesem Bereich können das nicht vorweisen.",tg:["general"],d:"2026-03-13"},
    {id:11,n:"Katharina B.",cc:"AT",co:"Austria",r:5,t:"Halitosis finally under control",b:"I've dealt with chronic halitosis for over a decade. Tried everything. This is the first product that seems to address the underlying bacterial imbalance rather than just covering the smell. It's not perfect yet, but it's the best improvement I've had. Impressed.",tg:["fresh_breath"],d:"2026-03-12"},
    {id:12,n:"Stefan P.",cc:"AT",co:"Austria",r:5,t:"Wissenschaftlich fundiert",b:"Was mich überzeugt hat: L. reuteri ist in über 70 klinischen Studien untersucht. Das ist kein Marketing — das ist Evidenz. Die meisten Produkte in diesem Bereich können das nicht vorweisen. Impressed.",tg:["general"],d:"2026-03-12"},
    {id:13,n:"Jonas K.",cc:"DE",co:"Germany",r:4,t:"Minder plaque bij de tandarts",b:"Bij mijn halfjaarlijkse controle zei de mondhygiënist dat er opvallend minder tandplaque was. Ik heb verder niks veranderd aan mijn routine, behalve OralBiome Pro toegevoegd.",tg:["gum_health"],d:"2026-03-11"},
    {id:14,n:"Jan R.",cc:"DE",co:"Germany",r:5,t:"Milde smaak, makkelijk in gebruik",b:"Eén tabletje voor het slapen op je tong leggen en laten oplossen. Smaakt licht naar munt. Niet opdringerig. Past perfect in mijn avondroutine. Would buy again.",tg:["general"],d:"2026-03-11"},
    {id:15,n:"Leon W.",cc:"DE",co:"Germany",r:5,t:"Eindelijk iets dat werkt tegen slechte adem",b:"Ik had al jaren last van een slechte adem die niet wegginng met poetsen of mondwater. Na 4 weken OralBiome Pro is het drastisch verbeterd. Het pakt de oorzaak aan in plaats van het te maskeren. Five stars.",tg:["fresh_breath"],d:"2026-03-11"},
    {id:16,n:"Bram S.",cc:"NL",co:"Netherlands",r:5,t:"Resultaat na 3 weken",b:"De eerste twee weken merkte ik weinig verschil. Vanaf week 3 begon het te werken — minder plaque-opbouw en mijn tandvlees voelt steviger. Geduld is nodig maar het werkt.",tg:["gum_health"],d:"2026-03-10"},
    {id:17,n:"Lisa P.",cc:"AT",co:"Austria",r:5,t:"Auch für empfindliches Zahnfleisch",b:"Ich habe sehr empfindliches Zahnfleisch und die meisten Produkte reizen es zusätzlich. Diese Lutschtablette ist sanft — kein Brennen, kein Stechen. Und mein Zahnfleisch erholt sich tatsächlich.",tg:["gum_health"],d:"2026-03-10"},
    {id:18,n:"Elena M.",cc:"BE",co:"Belgium",r:4,t:"Empfehlung vom Zahnarzt",b:"Mein Zahnarzt in München hat mir orale Probiotika bei wiederkehrender Gingivitis empfohlen. CALQIX war das überzeugendste Produkt das ich finden konnte. Nach zwei Monaten bin ich zufrieden.",tg:["gum_health","subscription"],d:"2026-03-10"},
    {id:19,n:"Johanna W.",cc:"DE",co:"Germany",r:5,t:"Preis-Leistung stimmt",b:"€19,95 im Abo pro Monat — das sind etwa 67 Cent pro Tag. Weniger als ein Kaffee. Für die Verbesserung meiner Mundgesundheit ist das fair. Exactly what I needed.",tg:["subscription"],d:"2026-03-09"},
    {id:20,n:"Ruben S.",cc:"NL",co:"Netherlands",r:5,t:"Gencives nettement améliorées",b:"Après des années de saignements des gencives lors du brossage, j'ai enfin vu une amélioration. J'utilise OralBiome Pro depuis 6 semaines. Mon dentiste a confirmé la différence.",tg:["gum_health"],d:"2026-03-08"},
    {id:21,n:"Sebastian P.",cc:"AT",co:"Austria",r:5,t:"Sceptical at first, now a believer",b:"I thought oral probiotics were just another wellness trend. Ordered a single jar to test. After the first month, my chronic bad breath had genuinely improved. Just subscribed for the second month. Very happy with this product.",tg:["fresh_breath","subscription"],d:"2026-03-08"},
    {id:22,n:"Lisa S.",cc:"NL",co:"Netherlands",r:4,t:"No more bleeding when flossing",b:"This was my benchmark — I used to see pink in the sink every time I flossed. After about 4 weeks with OralBiome Pro, it stopped. That's a concrete, measurable result. Five stars.",tg:["gum_health"],d:"2026-03-08"},
    {id:23,n:"Franziska L.",cc:"DE",co:"Germany",r:5,t:"Beter dan mondwater",b:"Ik gebruikte jarenlang Listerine. Sinds ik las dat het ook de goede bacteriën doodt, ben ik overgestapt. OralBiome Pro is het tegenovergestelde — het herstelt de balans. Mijn mond voelt minder droog.",tg:["general"],d:"2026-03-07"},
    {id:24,n:"Anna V.",cc:"NL",co:"Netherlands",r:5,t:"Praktisches Abo-Modell",b:"Jeden Monat automatisch geliefert, 20% Rabatt gegenüber dem Einzelkauf. Einfach einrichten und vergessen. Kann jederzeit pausiert oder gekündigt werden.",tg:["subscription"],d:"2026-03-07"},
    {id:25,n:"Chloé D.",cc:"FR",co:"France",r:5,t:"Zahnfleisch deutlich verbessert",b:"Nach jahrelangen Zahnfleischproblemen endlich eine Verbesserung. Benutze OralBiome Pro seit 6 Wochen täglich vor dem Schlafengehen. Mein Zahnarzt hat den Unterschied bei der letzten Kontrolle bestätigt. Highly recommend.",tg:["gum_health"],d:"2026-03-07"},
    {id:26,n:"Bram d.",cc:"NL",co:"Netherlands",r:5,t:"Milde Minze, angenehm",b:"Die Lutschtablette löst sich in etwa 2-3 Minuten auf. Der Geschmack ist mild minzig — nicht aufdringlich. Passt perfekt in die Abendroutine nach dem Zähneputzen. Exactly what I needed.",tg:["general"],d:"2026-03-05"},
    {id:27,n:"Stijn D.",cc:"NL",co:"Netherlands",r:5,t:"Lieferung immer pünktlich",b:"Seit 3 Monaten im Abo. Lieferung kommt immer rechtzeitig, gut verpackt. Das Produkt selbst wirkt konstant — meine Mundgesundheit hat sich stetig verbessert. Highly recommend.",tg:["subscription"],d:"2026-03-05"},
    {id:28,n:"Jonas S.",cc:"DE",co:"Germany",r:4,t:"Dentist recommended probiotics",b:"My dentist in Rotterdam suggested I try oral probiotics for my recurrent gingivitis. Found CALQIX online and the subscription model was exactly what I needed. Three months in — gums are healthier than they've been in years.",tg:["gum_health","subscription"],d:"2026-03-04"},
    {id:29,n:"Lisa B.",cc:"NL",co:"Netherlands",r:5,t:"Sceptical at first, now a believer",b:"I thought oral probiotics were just another wellness trend. Ordered a single jar to test. After the first month, my chronic bad breath had genuinely improved. Just subscribed for the second month.",tg:["fresh_breath","subscription"],d:"2026-03-04"},
    {id:30,n:"Olivia W.",cc:"BE",co:"Belgium",r:5,t:"Subscription makes it easy",b:"Set it up once, forget about it. Fresh jar arrives every month. The 20% discount on subscription is a nice bonus. Cancelled my mouthwash subscription — don't need it anymore. Exactly what I needed.",tg:["subscription"],d:"2026-03-04"},
    {id:31,n:"Joris M.",cc:"NL",co:"Netherlands",r:5,t:"Dentist recommended probiotics",b:"My dentist in Rotterdam suggested I try oral probiotics for my recurrent gingivitis. Found CALQIX online and the subscription model was exactly what I needed. Three months in — gums are healthier than they've been in years. Great addition to my routine.",tg:["gum_health","subscription"],d:"2026-03-04"},
    {id:32,n:"Lena F.",cc:"DE",co:"Germany",r:5,t:"Wetenschappelijk onderbouwd",b:"Wat me overtuigde was het onderzoek achter L. reuteri — meer dan 70 klinische studies. De meeste supplementen hebben dat niet. Dit voelt als een serieus product.",tg:["general"],d:"2026-03-02"},
    {id:33,n:"Milan J.",cc:"BE",co:"Belgium",r:5,t:"Aanbevolen door mijn tandarts",b:"Mijn tandarts in Utrecht raadde orale probiotica aan voor mijn terugkerende tandvleesontstekingen. CALQIX was het enige Nederlandse merk dat ik kon vinden. Drie maanden verder en ik ben tevreden. Five stars.",tg:["gum_health","subscription"],d:"2026-03-02"},
    {id:34,n:"Elias K.",cc:"DE",co:"Germany",r:5,t:"Bought for the whole family",b:"My wife and I both use it. Even our 12-year-old takes one before bed. The mint flavour is mild enough for kids who are old enough to let it dissolve. Family subscription would be nice though.",tg:["general","subscription"],d:"2026-03-01"},
    {id:35,n:"Paul S.",cc:"DE",co:"Germany",r:5,t:"Noticeable plaque reduction",b:"I'm someone who builds up plaque quickly between cleanings. After two months of daily use, my hygienist said there was noticeably less buildup. I credit the M18 strain — the research on plaque biofilm is convincing. Exactly what I needed.",tg:["gum_health"],d:"2026-03-01"},
    {id:36,n:"Johanna S.",cc:"DE",co:"Germany",r:5,t:"Frissere adem de hele dag",b:"Ik merk het verschil vooral 's ochtends. Geen ochtendadem meer waar je van schrikt. Het is subtiel maar consistent — mijn mond voelt gewoon schoner aan. Impressed.",tg:["fresh_breath"],d:"2026-02-28"},
    {id:37,n:"Lena W.",cc:"DE",co:"Germany",r:5,t:"Reisefreundlich",b:"Keine Flüssigkeiten, keine Kühlung nötig. Perfekt für Geschäftsreisen. Eine Tablette vor dem Schlafengehen — fertig. Viel praktischer als Mundspülung im Handgepäck. Impressed.",tg:["general"],d:"2026-02-27"},
    {id:38,n:"Joris P.",cc:"NL",co:"Netherlands",r:5,t:"Haleine fraîche toute la journée",b:"Le changement le plus notable est le matin. Plus cette mauvaise haleine au réveil. C'est subtil mais constant. Un comprimé avant le coucher et c'est tout. Impressed.",tg:["fresh_breath"],d:"2026-02-27"},
    {id:39,n:"Anna B.",cc:"AT",co:"Austria",r:4,t:"Wetenschappelijk onderbouwd",b:"Wat me overtuigde was het onderzoek achter L. reuteri — meer dan 70 klinische studies. De meeste supplementen hebben dat niet. Dit voelt als een serieus product. Exactly what I needed.",tg:["general"],d:"2026-02-26"},
    {id:40,n:"Femke D.",cc:"NL",co:"Netherlands",r:5,t:"Weniger Plaque-Aufbau",b:"Meine Dentalhygienikerin hat bei der letzten Reinigung deutlich weniger Plaque festgestellt. Ich habe sonst nichts an meiner Routine geändert — nur OralBiome Pro hinzugefügt. Impressed.",tg:["gum_health"],d:"2026-02-26"},
    {id:41,n:"Anna W.",cc:"AT",co:"Austria",r:5,t:"No more bleeding when flossing",b:"This was my benchmark — I used to see pink in the sink every time I flossed. After about 4 weeks with OralBiome Pro, it stopped. That's a concrete, measurable result.",tg:["gum_health"],d:"2026-02-25"},
    {id:42,n:"Sebastian M.",cc:"AT",co:"Austria",r:5,t:"Subscription makes it easy",b:"Set it up once, forget about it. Fresh jar arrives every month. The 20% discount on subscription is a nice bonus. Cancelled my mouthwash subscription — don't need it anymore. Exactly what I needed.",tg:["subscription"],d:"2026-02-24"},
    {id:43,n:"Anna G.",cc:"AT",co:"Austria",r:5,t:"Dentist recommended probiotics",b:"My dentist in Rotterdam suggested I try oral probiotics for my recurrent gingivitis. Found CALQIX online and the subscription model was exactly what I needed. Three months in — gums are healthier than they've been in years. Would buy again.",tg:["gum_health","subscription"],d:"2026-02-22"},
