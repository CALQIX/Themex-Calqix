    {id:116,n:"Julia P.",cc:"NL",co:"Netherlands",r:5,t:"Besser als Mundspülung",b:"Ich habe meine alkoholhaltige Mundspülung komplett ersetzt. OralBiome Pro stellt das Gleichgewicht wieder her, anstatt alles abzutöten. Mein Mund fühlt sich weniger trocken und gesünder an.",tg:["general"],d:"2026-01-17"},
    {id:117,n:"Sarah H.",cc:"DE",co:"Germany",r:5,t:"Skeptisch gestartet, jetzt überzeugt",b:"Orale Probiotika klangen für mich nach einem Wellness-Trend. Habe eine einzelne Packung bestellt um es zu testen. Nach 4 Wochen: der chronische Mundgeruch war tatsächlich besser. Jetzt im Abo.",tg:["fresh_breath","subscription"],d:"2026-01-16"},
    {id:118,n:"Marie S.",cc:"DE",co:"Germany",r:5,t:"Better than any breath mint",b:"Breath mints mask the problem. This actually addresses it. I work in client-facing meetings all day and the confidence boost alone is worth it. Fresh breath lasts well into the afternoon. Would buy again.",tg:["fresh_breath"],d:"2026-01-16"},
    {id:119,n:"Lisa V.",cc:"NL",co:"Netherlands",r:5,t:"Hele gezin gebruikt het",b:"Mijn vrouw en ik allebei, en onze dochter van 14 ook. De milde muntsmaak is prima voor tieners. Zou een gezinsabonnement met korting wel fijn vinden.",tg:["general","subscription"],d:"2026-01-15"},
    {id:120,n:"Koen d.",cc:"NL",co:"Netherlands",r:4,t:"Ergebnis braucht Geduld",b:"Die ersten zwei Wochen habe ich keinen großen Unterschied gespürt. Ab Woche 4 wurde es deutlich: weniger Zahnfleischbluten beim Flossen und ein frischeres Mundgefühl. Man muss Geduld haben.",tg:["gum_health"],d:"2026-01-15"}
  ];
  var reviews = R.concat(R2);

  var PER_PAGE = 6;
  var currentFilter = 'all';
  var visibleCount = PER_PAGE;
  var grid = section.querySelector('[data-ob-grid]');
  var showMoreBtn = section.querySelector('[data-ob-show-more]');
  var filtersWrap = section.querySelector('[data-ob-filters]');
  var breakdownEl = section.querySelector('[data-ob-breakdown]');
  var FLAGS = {NL:'\u{1F1F3}\u{1F1F1}',DE:'\u{1F1E9}\u{1F1EA}',BE:'\u{1F1E7}\u{1F1EA}',AT:'\u{1F1E6}\u{1F1F9}',FR:'\u{1F1EB}\u{1F1F7}'};
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var STAR_GOLD = '<svg width="14" height="14" viewBox="0 0 24 24" fill="#C9A84C"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
  var STAR_GREY = '<svg width="14" height="14" viewBox="0 0 24 24" fill="#E5E7EB"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
  var CHECK_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="#2E7D32"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
  var readMoreLabel = {{ section.settings.read_more_label | json }};
  var readLessLabel = {{ section.settings.read_less_label | json }};
  var verifiedText = {{ section.settings.verified_text | json }};

  /* Rating breakdown */
  var counts = [0,0,0,0,0];
  reviews.forEach(function(r){ counts[r.r - 1]++; });
  var total = reviews.length;
  if (breakdownEl) {
    var html = '';
    for (var s = 5; s >= 1; s--) {
      var pct = total > 0 ? (counts[s-1] / total * 100).toFixed(1) : 0;
      html += '<div class="ob-reviews__bar-row"><span class="ob-reviews__bar-label">' + s + ' \u2605</span><div class="ob-reviews__bar-track"><div class="ob-reviews__bar-fill" style="width:' + pct + '%"></div></div><span class="ob-reviews__bar-count">' + counts[s-1] + '</span></div>';
    }
    breakdownEl.innerHTML = html;
  }

  /* Tag counts for filter buttons */
  var tagCounts = {all: total, gum_health: 0, fresh_breath: 0, subscription: 0};
  reviews.forEach(function(r){ r.tg.forEach(function(t){ if (tagCounts[t] !== undefined) tagCounts[t]++; }); });

  /* Render filter tabs */
  if (filtersWrap) {
    var filterAll = {{ section.settings.filter_all | json }};
    var filterGum = {{ section.settings.filter_gum | json }};
    var filterBreath = {{ section.settings.filter_breath | json }};
    var filterSub = {{ section.settings.filter_sub | json }};
    filtersWrap.innerHTML =
      '<button class="ob-reviews__filter-btn is-active" data-filter="all" role="tab" aria-selected="true">' + filterAll + ' (' + tagCounts.all + ')</button>' +
      '<button class="ob-reviews__filter-btn" data-filter="gum_health" role="tab" aria-selected="false">' + filterGum + ' (' + tagCounts.gum_health + ')</button>' +
      '<button class="ob-reviews__filter-btn" data-filter="fresh_breath" role="tab" aria-selected="false">' + filterBreath + ' (' + tagCounts.fresh_breath + ')</button>' +
      '<button class="ob-reviews__filter-btn" data-filter="subscription" role="tab" aria-selected="false">' + filterSub + ' (' + tagCounts.subscription + ')</button>';

    filtersWrap.querySelectorAll('.ob-reviews__filter-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        filtersWrap.querySelectorAll('.ob-reviews__filter-btn').forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-selected','false'); });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected','true');
        currentFilter = btn.dataset.filter;
        visibleCount = PER_PAGE;
        renderReviews();
      });
    });
  }

  function getFiltered() {
    if (currentFilter === 'all') return reviews;
    return reviews.filter(function(r){ return r.tg.indexOf(currentFilter) !== -1; });
  }

  function fmtDate(ds) {
    var d = new Date(ds);
    return d.getDate() + ' ' + MONTHS[d.getMonth()] + ' ' + d.getFullYear();
  }

  function renderReviews() {
    if (!grid) return;
    var filtered = getFiltered();
    var toShow = filtered.slice(0, visibleCount);
    grid.innerHTML = toShow.map(function(r) {
      var stars = '';
      for (var i = 0; i < 5; i++) stars += (i < r.r ? STAR_GOLD : STAR_GREY);
      var flag = FLAGS[r.cc] || '';
      return '<div class="ob-reviews__card"><div class="ob-reviews__card-stars">' + stars + '</div>' +
        '<h4 class="ob-reviews__card-title">' + r.t + '</h4>' +
        '<p class="ob-reviews__card-body" data-ob-body>' + r.b + '</p>' +
        '<button type="button" class="ob-reviews__read-more" data-ob-read-more>' + readMoreLabel + '</button>' +
        '<div class="ob-reviews__card-footer"><div class="ob-reviews__card-reviewer"><span class="ob-reviews__card-name">' + r.n + '</span><span class="ob-reviews__card-country">' + flag + ' ' + r.co + '</span></div>' +
        '<div class="ob-reviews__card-meta"><span class="ob-reviews__card-verified">' + CHECK_SVG + ' ' + verifiedText + '</span><span class="ob-reviews__card-date">' + fmtDate(r.d) + '</span></div></div></div>';
    }).join('');

    /* "Read more" detection */
    grid.querySelectorAll('.ob-reviews__card-body').forEach(function(body) {
      var btn = body.nextElementSibling;
      if (body.scrollHeight > body.clientHeight + 2) {
        btn.classList.add('is-needed');
      }
    });

    /* "Read more" toggle */
    grid.querySelectorAll('[data-ob-read-more]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = btn.previousElementSibling;
        body.classList.toggle('is-expanded');
        btn.textContent = body.classList.contains('is-expanded') ? readLessLabel : readMoreLabel;
      });
    });

    /* Show more button */
    if (showMoreBtn) {
      if (filtered.length <= visibleCount) {
        showMoreBtn.style.display = 'none';
      } else {
        showMoreBtn.style.display = '';
        var remaining = filtered.length - visibleCount;
        showMoreBtn.textContent = {{ section.settings.show_more_label | json }} + ' (' + remaining + ' remaining)';
      }
    }

    /* Animate cards in */
    requestAnimationFrame(function() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var cards = Array.from(grid.querySelectorAll('.ob-reviews__card:not(.is-visible)'));
            var idx = cards.indexOf(entry.target);
            entry.target.style.transitionDelay = ((idx % 3) * 0.08) + 's';
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, {threshold: 0.1});
      grid.querySelectorAll('.ob-reviews__card:not(.is-visible)').forEach(function(el){ observer.observe(el); });
    });
  }

  if (showMoreBtn) {
    showMoreBtn.addEventListener('click', function() {
      visibleCount += PER_PAGE;
      renderReviews();
    });
  }

  renderReviews();
})();
</script>

{% schema %}
{
  "name": "OB Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL RESULTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers are saying" },
    { "type": "text", "id": "avg_rating", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "based_on_text", "label": "Based on text", "default": "Based on 120 reviews" },
    { "type": "checkbox", "id": "use_judgeme", "label": "Use Judge.me widget", "default": false },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter tabs", "default": true },
    { "type": "text", "id": "filter_all", "label": "Filter: All", "default": "All" },
    { "type": "text", "id": "filter_gum", "label": "Filter: Gum Health", "default": "Gum Health" },
    { "type": "text", "id": "filter_breath", "label": "Filter: Fresh Breath", "default": "Fresh Breath" },
    { "type": "text", "id": "filter_sub", "label": "Filter: Subscription", "default": "Subscription" },
    { "type": "text", "id": "verified_text", "label": "Verified badge text", "default": "Verified" },
    { "type": "text", "id": "show_more_label", "label": "Show more reviews button", "default": "Show more reviews" },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "read_less_label", "label": "Read less label", "default": "Read less" },
    { "type": "text", "id": "write_review_text", "label": "Write review button", "default": "Write a Review" },
    { "type": "url", "id": "write_review_url", "label": "Write review URL" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Review body text." },
        { "type": "text", "id": "author", "label": "Author name", "default": "Customer" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
        { "type": "text", "id": "date", "label": "Date", "default": "2025-01-15" },
        { "type": "text", "id": "tags", "label": "Tags (comma-separated)", "default": "gum,breath" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Reviews"
    }
  ]
}
{% endschema %}
