<style>
  .ob-safety {
    background: #FFFFFF;
    padding: 48px 0;
  }
  .ob-safety__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-safety__header {
    text-align: center;
    margin-bottom: 32px;
  }
  .ob-safety__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C9A84C;
    margin: 0 0 12px;
  }
  .ob-safety__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #1A3B5C;
    margin: 0;
    line-height: 1.3;
  }
  .ob-safety__card {
    max-width: 720px;
    margin: 0 auto;
    background: #F7F5F2;
    border-radius: 12px;
    padding: 28px 28px 24px;
    border: 1px solid rgba(26,59,92,0.06);
  }
  .ob-safety__intro {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: #1A3B5C;
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .ob-safety__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ob-safety__list li {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #4A5568;
    line-height: 1.55;
    padding-left: 22px;
    position: relative;
  }
  .ob-safety__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #C9A84C;
  }
  @media (min-width: 1024px) {
    .ob-safety { padding: 80px 0; }
    .ob-safety__heading { font-size: 36px; }
    .ob-safety__card { padding: 36px 40px 32px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- if _ob_lang == 'nl' or _ob_lang == 'de' or _ob_lang == 'fr' -%}
  {%- assign _su_eyebrow = 'calqix_oralbiome.safety.eyebrow' | t -%}
  {%- assign _su_heading = 'calqix_oralbiome.safety.heading' | t -%}
  {%- assign _su_intro = 'calqix_oralbiome.safety.intro' | t -%}
  {%- assign _su_item_1 = 'calqix_oralbiome.safety.item_1' | t -%}
  {%- assign _su_item_2 = 'calqix_oralbiome.safety.item_2' | t -%}
  {%- assign _su_item_3 = 'calqix_oralbiome.safety.item_3' | t -%}
  {%- assign _su_item_4 = 'calqix_oralbiome.safety.item_4' | t -%}
  {%- assign _su_item_5 = 'calqix_oralbiome.safety.item_5' | t -%}
  {%- assign _su_item_6 = 'calqix_oralbiome.safety.item_6' | t -%}
  {%- assign _su_item_7 = 'calqix_oralbiome.safety.item_7' | t -%}
  {%- assign _su_item_8 = 'calqix_oralbiome.safety.item_8' | t -%}
  {%- assign _su_item_9 = 'calqix_oralbiome.safety.item_9' | t -%}
{%- else -%}
  {%- assign _su_eyebrow = section.settings.eyebrow -%}
  {%- assign _su_heading = section.settings.heading -%}
  {%- assign _su_intro = section.settings.intro -%}
  {%- assign _su_item_1 = section.settings.item_1 -%}
  {%- assign _su_item_2 = section.settings.item_2 -%}
  {%- assign _su_item_3 = section.settings.item_3 -%}
  {%- assign _su_item_4 = section.settings.item_4 -%}
  {%- assign _su_item_5 = section.settings.item_5 -%}
  {%- assign _su_item_6 = section.settings.item_6 -%}
  {%- assign _su_item_7 = section.settings.item_7 -%}
  {%- assign _su_item_8 = section.settings.item_8 -%}
  {%- assign _su_item_9 = section.settings.item_9 -%}
{%- endif -%}

<section class="ob-safety" id="safety-usage">
  <div class="ob-safety__container">
    <div class="ob-safety__header">
      <p class="ob-safety__eyebrow">{{ _su_eyebrow }}</p>
      <h2 class="ob-safety__heading">{{ _su_heading }}</h2>
    </div>
    <div class="ob-safety__card">
      <p class="ob-safety__intro">{{ _su_intro }}</p>
      <ul class="ob-safety__list">
        <li>{{ _su_item_1 }}</li>
        <li>{{ _su_item_2 }}</li>
        <li>{{ _su_item_3 }}</li>
        <li>{{ _su_item_4 }}</li>
        <li>{{ _su_item_5 }}</li>
        <li>{{ _su_item_6 }}</li>
        <li>{{ _su_item_7 }}</li>
        <li>{{ _su_item_8 }}</li>
        <li>{{ _su_item_9 }}</li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OB Safety & Usage",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "IMPORTANT INFORMATION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Safety & Usage" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "OralBiome Pro is designed for daily oral care use as a dissolvable lozenge." },
    { "type": "textarea", "id": "item_1", "label": "Item 1", "default": "Food supplement. Recommended use: dissolve 1 lozenge daily after brushing and flossing." },
    { "type": "textarea", "id": "item_2", "label": "Item 2", "default": "Do not exceed the recommended daily dose. Food supplements should not be used as a substitute for a varied and balanced diet and a healthy lifestyle." },
    { "type": "textarea", "id": "item_3", "label": "Item 3", "default": "Keep out of reach of young children." },
    { "type": "textarea", "id": "item_4", "label": "Item 4", "default": "Contains xylitol. Excessive consumption may produce laxative effects." },
    { "type": "textarea", "id": "item_5", "label": "Item 5", "default": "Keep away from pets, especially dogs." },
    { "type": "textarea", "id": "item_6", "label": "Item 6", "default": "Do not give to children who cannot safely dissolve a lozenge. Choking risk applies to young children." },
    { "type": "textarea", "id": "item_7", "label": "Item 7", "default": "If you are pregnant, breastfeeding, taking medication, or have a medical condition, consult a healthcare professional before use." },
    { "type": "textarea", "id": "item_8", "label": "Item 8", "default": "Store in a cool, dry place below 25\u00b0C. Keep the container tightly closed." },
    { "type": "textarea", "id": "item_9", "label": "Item 9", "default": "For best results, use as part of a complete daily oral care routine including brushing and flossing." }
  ],
  "presets": [
    {
      "name": "OB Safety & Usage"
    }
  ]
}
{% endschema %}
