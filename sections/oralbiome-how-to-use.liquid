<style>
  .ob-howto {
    background:
      radial-gradient(circle at 18% 0%, rgba(201, 168, 76, 0.08), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, #f6f9fc 100%);
    padding: 58px 0;
    overflow: hidden;
  }
  .ob-howto__container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-howto__header {
    text-align: center;
    margin-bottom: 36px;
  }
  .ob-howto__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C9A84C;
    margin: 0 0 12px;
  }
  .ob-howto__heading {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(30px, 3vw, 44px);
    color: #002549;
    margin: 0;
    line-height: 1.08;
  }
  .ob-howto__steps {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0 10px;
  }
  .ob-howto__steps::-webkit-scrollbar { display: none; }
  .ob-howto__step {
    flex: 0 0 82%;
    min-width: 278px;
    scroll-snap-align: center;
    text-align: center;
    position: relative;
    opacity: 1;
    transform: none;
    padding: 18px 18px 20px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(246, 250, 254, 0.9)) padding-box,
      linear-gradient(145deg, rgba(0, 37, 73, 0.14), rgba(201, 168, 76, 0.34)) border-box;
    border: 1px solid transparent;
    border-radius: 18px;
    box-shadow: 0 18px 42px -34px rgba(0, 37, 73, 0.48);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    overflow: hidden;
  }
  .ob-howto__step::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(201, 168, 76, 0.1), transparent 38%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .ob-howto__step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .ob-howto__step-kicker {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 auto 14px;
    padding: 7px 12px;
    border: 1px solid rgba(201, 168, 76, 0.42);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    color: #9f7d27;
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    line-height: 1;
    text-transform: uppercase;
  }
  .ob-howto__step-kicker strong {
    color: #002549;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .ob-howto__step-visual {
    position: relative;
    display: inline-block;
    margin-bottom: 18px;
  }
  .ob-howto__step-image {
    position: relative;
    z-index: 1;
    width: min(62vw, 214px);
    height: min(62vw, 214px);
    border-radius: 50%;
    border: 1px solid rgba(201, 168, 76, 0.74);
    overflow: hidden;
    background: #F4F8FC;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 0 0 7px rgba(255, 255, 255, 0.35),
      0 16px 34px -24px rgba(0, 37, 73, 0.5);
  }
  .ob-howto__step-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ob-howto__step-image svg {
    width: 64px;
    height: 64px;
  }
  .ob-howto__step-title {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(17px, 1.35vw, 20px);
    font-weight: 700;
    color: #002549;
    margin: 0 0 8px;
    line-height: 1.25;
  }
  .ob-howto__step-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    color: #5f6f7f;
    line-height: 1.48;
    margin: 0;
    max-width: 260px;
    margin-left: auto;
    margin-right: auto;
  }
  .ob-howto__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 12px 0 0;
  }
  .ob-howto__dot {
    width: 18px;
    height: 4px;
    border-radius: 999px;
    background: rgba(0, 37, 73, 0.16);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.22s ease, background 0.22s ease;
  }
  .ob-howto__dot.is-active { width: 38px; background: #C9A84C; }
  .ob-howto__note {
    text-align: center;
    margin: 24px auto 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-style: italic;
    color: #6B7280;
    max-width: 620px;
  }

  @media (min-width: 768px) {
    .ob-howto__steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      overflow: visible;
      padding: 0;
    }
    .ob-howto__step { flex: none; min-width: 0; }
    .ob-howto__dots { display: none; }
  }
  @media (min-width: 1024px) {
    .ob-howto { padding: 92px 0 86px; }
    .ob-howto__header { margin-bottom: 44px; }
    .ob-howto__step {
      padding: 22px 18px 24px;
      border-radius: 20px;
    }
    .ob-howto__step:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 54px -38px rgba(0, 37, 73, 0.56);
    }
    .ob-howto__step:hover::before { opacity: 1; }
    .ob-howto__step-image { width: 208px; height: 208px; }
  }

  @media (max-width: 767px) {
    .ob-howto {
      padding: 54px 0 50px;
    }
    .ob-howto__container {
      padding: 0 0 0 18px;
    }
    .ob-howto__header,
    .ob-howto__note {
      padding-right: 18px;
    }
    .ob-howto__steps {
      padding-right: 18px;
    }
    .ob-howto__step-title {
      max-width: 240px;
      margin-left: auto;
      margin-right: auto;
    }
    .ob-howto__step-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  body.template-product-oralbiome .ob-benefits__card,
  body.template-product-oralbiome .ob-dt__row,
  body.template-product-oralbiome .ob-dt__verdict,
  body.template-product-oralbiome .ob-cm__card,
  body.template-product-oralbiome .ob-reviews__card,
  body.template-product-oralbiome .faq-item[data-animate] {
    opacity: 1 !important;
    transform: none !important;
  }

  body.template-product-oralbiome .ob-benefits__card::before {
    opacity: 1 !important;
  }

  @media (min-width: 1024px) {
    body.template-product-oralbiome .ob-benefits__grid,
    body.template-product-oralbiome .ob-howto__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }

    body.template-product-oralbiome .ob-howto__steps {
      gap: 24px !important;
    }

    body.template-product-oralbiome .ob-howto__step-image {
      width: 208px !important;
      height: 208px !important;
    }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- if _ob_lang != 'en' -%}
  {%- assign _ob_howto_eyebrow = 'calqix_oralbiome.steps.eyebrow' | t -%}
  {%- assign _ob_howto_heading = 'calqix_oralbiome.steps.heading' | t -%}
  {%- assign _ob_howto_note = 'calqix_oralbiome.steps.note' | t -%}
{%- else -%}
  {%- assign _ob_howto_eyebrow = section.settings.eyebrow -%}
  {%- assign _ob_howto_heading = section.settings.heading -%}
  {%- assign _ob_howto_note = section.settings.note -%}
{%- endif -%}
{%- assign _ob_howto_heading = section.settings.heading -%}

<section class="ob-howto" data-section-id="{{ section.id }}">
  <div class="ob-howto__container">
    <div class="ob-howto__header">
      <p class="ob-howto__eyebrow">{{ _ob_howto_eyebrow }}</p>
      <h2 class="ob-howto__heading">{{ _ob_howto_heading }}</h2>
    </div>
    <div class="ob-howto__steps">
      {%- for block in section.blocks -%}
        {%- comment -%} Resolve fallback theme asset by title keywords, falling back to forloop position. {%- endcomment -%}
        {%- assign _ob_step_title_lc = block.settings.title | downcase -%}
        {%- assign _ob_step_asset = '' -%}
        {%- if _ob_step_title_lc contains 'dissolve or brush' or _ob_step_title_lc contains 'dissolve and brush' -%}
          {%- assign _ob_step_asset = 'ob-step-03-dissolve-brush.png' -%}
        {%- elsif _ob_step_title_lc contains 'brush' or _ob_step_title_lc contains 'floss' or _ob_step_title_lc contains 'poets' or _ob_step_title_lc contains 'putz' or _ob_step_title_lc contains 'brosse' -%}
          {%- assign _ob_step_asset = 'ob-step-01-brush-floss.webp' -%}
        {%- elsif _ob_step_title_lc contains 'dissolve' or _ob_step_title_lc contains 'lozenge' or _ob_step_title_lc contains 'tongue' or _ob_step_title_lc contains 'tong' or _ob_step_title_lc contains 'zunge' or _ob_step_title_lc contains 'langue' or _ob_step_title_lc contains 'smelt' or _ob_step_title_lc contains 'tablet' -%}
          {%- assign _ob_step_asset = 'ob-step-02-dissolve-lozenge.webp' -%}
        {%- elsif _ob_step_title_lc contains 'colon' or _ob_step_title_lc contains 'probiot' or _ob_step_title_lc contains 'wait' or _ob_step_title_lc contains 'wacht' or _ob_step_title_lc contains 'wart' -%}
          {%- assign _ob_step_asset = 'ob-step-03-colonise.webp' -%}
        {%- endif -%}
        {%- if _ob_step_asset == '' -%}
          {%- case forloop.index -%}
            {%- when 1 -%}{%- assign _ob_step_asset = 'ob-step-01-brush-floss.webp' -%}
            {%- when 2 -%}{%- assign _ob_step_asset = 'ob-step-02-dissolve-lozenge.webp' -%}
            {%- when 3 -%}{%- assign _ob_step_asset = 'ob-step-03-dissolve-brush.png' -%}
            {%- when 4 -%}{%- assign _ob_step_asset = 'ob-step-03-colonise.webp' -%}
          {%- endcase -%}
        {%- endif -%}
        {%- if _ob_lang != 'en' -%}
          {%- capture _ob_step_title_key -%}calqix_oralbiome.steps.step{{ forloop.index }}_title{%- endcapture -%}
          {%- capture _ob_step_text_key -%}calqix_oralbiome.steps.step{{ forloop.index }}_text{%- endcapture -%}
          {%- assign _ob_step_title = _ob_step_title_key | t -%}
          {%- assign _ob_step_text = _ob_step_text_key | t -%}
          {%- if _ob_step_title contains 'translation missing' -%}
            {%- assign _ob_step_title = block.settings.title -%}
          {%- endif -%}
          {%- if _ob_step_text contains 'translation missing' -%}
            {%- assign _ob_step_text = block.settings.description -%}
          {%- endif -%}
        {%- else -%}
          {%- assign _ob_step_title = block.settings.title -%}
          {%- assign _ob_step_text = block.settings.description -%}
        {%- endif -%}
        {%- assign _ob_step_title_display = _ob_step_title -%}
        {%- if _ob_step_title contains ':' -%}
          {%- assign _ob_step_title_display = _ob_step_title | split: ':' | last | strip -%}
        {%- endif -%}
        <div class="ob-howto__step" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 150 }}ms">
          <div class="ob-howto__step-kicker">
            <span>Step</span>
            <strong>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</strong>
          </div>
          <div class="ob-howto__step-visual">
            <div class="ob-howto__step-image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 560 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 560 }} 560w"
                  sizes="280px"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="280"
                  height="280"
                >
              {%- elsif _ob_step_asset != '' -%}
                <img
                  src="{{ _ob_step_asset | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="280"
                  height="280"
                >
              {%- else -%}
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="20" stroke="#C9A84C" stroke-width="1.5" stroke-dasharray="4 3"/><text x="32" y="36" text-anchor="middle" font-family="DM Sans" font-size="14" fill="#C9A84C">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</text></svg>
              {%- endif -%}
            </div>
          </div>
          <h3 class="ob-howto__step-title">{{ _ob_step_title_display }}</h3>
          <p class="ob-howto__step-desc">{{ _ob_step_text }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="ob-howto__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="ob-howto__dot{% if forloop.first %} is-active{% endif %}" data-step="{{ forloop.index0 }}" aria-label="Step {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="ob-howto__note">{{ _ob_howto_note }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var stepsTrack = section.querySelector('.ob-howto__steps');
    var steps = section.querySelectorAll('.ob-howto__step');
    var dots = section.querySelectorAll('.ob-howto__dot');

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          steps.forEach(function(step) { step.classList.add('is-visible'); });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    if (stepsTrack) observer.observe(stepsTrack);

    if (stepsTrack && dots.length > 0) {
      var autoTimer = null;
      var autoIndex = 0;
      var isMobile = window.matchMedia('(max-width: 767px)');
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var idx = Array.prototype.indexOf.call(steps, entry.target);
            autoIndex = idx;
            dots.forEach(function(d, i) { d.classList.toggle('is-active', i === idx); });
          }
        });
      }, { root: stepsTrack, threshold: 0.6 });
      steps.forEach(function(s) { io.observe(s); });
      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var idx = parseInt(dot.dataset.step);
          if (steps[idx]) steps[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        });
      });

      function startAutoScroll() {
        if (!isMobile.matches || autoTimer || steps.length < 2) return;
        autoTimer = window.setInterval(function() {
          autoIndex = (autoIndex + 1) % steps.length;
          if (steps[autoIndex]) {
            steps[autoIndex].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        }, 3800);
      }

      function stopAutoScroll() {
        if (!autoTimer) return;
        window.clearInterval(autoTimer);
        autoTimer = null;
      }

      ['pointerdown', 'touchstart', 'focusin'].forEach(function(evt) {
        stepsTrack.addEventListener(evt, stopAutoScroll, { passive: true });
      });

      var sectionVisibility = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) startAutoScroll();
          else stopAutoScroll();
        });
      }, { threshold: 0.35 });
      sectionVisibility.observe(section);
      if (isMobile.addEventListener) {
        isMobile.addEventListener('change', function() {
          stopAutoScroll();
          startAutoScroll();
        });
      }
    }
  })();
</script>

{% schema %}
{
  "name": "OB How To Use",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR DAILY RITUAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "4 steps. 60 seconds. Done." },
    { "type": "text", "id": "note", "label": "Note below steps", "default": "For best results, use daily before bed. Each jar contains a 30-day supply." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Step description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB How To Use",
      "blocks": [
        { "type": "step", "settings": { "title": "Brush & Floss", "description": "Complete your regular oral hygiene routine as normal." } },
        { "type": "step", "settings": { "title": "Dissolve One Lozenge", "description": "Place one OralBiome Pro lozenge on your tongue. Let it dissolve slowly \u2014 do not chew." } },
        { "type": "step", "settings": { "title": "Let It Dissolve or Brush", "description": "Let the lozenge dissolve on your teeth, or gently brush it across your teeth with a toothbrush." } },
        { "type": "step", "settings": { "title": "Let Probiotics Colonize", "description": "Avoid eating or drinking for 30 minutes. The beneficial bacteria need time to colonize your oral cavity." } }
      ]
    }
  ]
}
{% endschema %}
