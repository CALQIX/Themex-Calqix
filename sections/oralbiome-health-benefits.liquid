<style>
  .ob-benefits {
    background: #F4F5F7;
    padding: 48px 0;
  }
  .ob-benefits__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-benefits__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .ob-benefits__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #C9A84C;
    margin: 0 0 12px;
  }
  .ob-benefits__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #1A3B5C;
    margin: 0;
    line-height: 1.3;
  }
  .ob-benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  /* ── Card base ── */
  .ob-benefits__card {
    background: #FFFFFF;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    border: 1px solid rgba(26,59,92,0.06);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    opacity: 0;
    transform: translateY(20px);
    position: relative;
    overflow: hidden;
  }
  .ob-benefits__card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, #C9A84C, rgba(201,168,76,0.2));
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .ob-benefits__card.is-visible::before { opacity: 1; }

  /* ── Unique per-tile mobile entrance animations ── */
  @keyframes ob-bene-slide-right {
    from { opacity: 0; transform: translateX(-30px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes ob-bene-slide-left {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes ob-bene-scale-up {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes ob-bene-fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes ob-bene-rotate-in {
    from { opacity: 0; transform: translateY(16px) rotate(-2deg); }
    to   { opacity: 1; transform: translateY(0) rotate(0); }
  }
  @keyframes ob-bene-pop {
    from { opacity: 0; transform: scale(0.9) translateY(12px); }
    60%  { transform: scale(1.03) translateY(-2px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes ob-bene-icon-pulse {
    0%, 100% { filter: drop-shadow(0 0 0 transparent); }
    50%      { filter: drop-shadow(0 0 8px rgba(201,168,76,0.4)); }
  }
  @keyframes ob-bene-gold-line {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  .ob-benefits__card.is-visible {
    animation-fill-mode: both;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .ob-benefits__card:nth-child(1).is-visible { animation-name: ob-bene-slide-right; animation-delay: 0s; }
  .ob-benefits__card:nth-child(2).is-visible { animation-name: ob-bene-slide-left;  animation-delay: 0.08s; }
  .ob-benefits__card:nth-child(3).is-visible { animation-name: ob-bene-scale-up;    animation-delay: 0.16s; }
  .ob-benefits__card:nth-child(4).is-visible { animation-name: ob-bene-rotate-in;   animation-delay: 0.24s; }
  .ob-benefits__card:nth-child(5).is-visible { animation-name: ob-bene-pop;         animation-delay: 0.32s; }
  .ob-benefits__card:nth-child(6).is-visible { animation-name: ob-bene-fade-up;     animation-delay: 0.40s; }

  /* ── Icon ── */
  .ob-benefits__card-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background: rgba(26,59,92,0.04);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    box-sizing: border-box;
  }
  .ob-benefits__card.is-visible .ob-benefits__card-icon {
    animation: ob-bene-icon-pulse 3s ease-in-out infinite;
  }
  .ob-benefits__card-icon svg {
    width: 100%;
    height: 100%;
  }

  /* ── Body (title + desc wrapper) ── */
  .ob-benefits__card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ob-benefits__card-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1A3B5C;
    margin: 0;
    line-height: 1.3;
  }
  .ob-benefits__card-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    color: #6B7280;
    line-height: 1.55;
    margin: 0;
  }

  /* ═══════════════════════════════════════
     Tablet (≥768px)
     ═══════════════════════════════════════ */
  @media (min-width: 768px) {
    .ob-benefits__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .ob-benefits__card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 28px;
      border-radius: 14px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .ob-benefits__card::before { display: none; }
    .ob-benefits__card-body { align-items: center; gap: 8px; }
    .ob-benefits__card-icon { width: 48px; height: 48px; }
    .ob-benefits__card-title { font-size: 18px; }
    .ob-benefits__card-desc { font-size: 14px; }
    .ob-benefits__card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
  }

  /* ═══════════════════════════════════════
     Desktop (≥1024px)
     ═══════════════════════════════════════ */
  @media (min-width: 1024px) {
    .ob-benefits { padding: 80px 0; }
    .ob-benefits__heading { font-size: 36px; }
    .ob-benefits__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
</style>

