<script>
  (function() {
    var cards = document.querySelectorAll('[data-section-id="{{ section.id }}"] .ob-benefits__card');
    if (!cards.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    cards.forEach(function(card) { observer.observe(card); });
  })();
</script>

{% schema %}
{
  "name": "OB Health Benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY ORALBIOME PRO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clinically studied benefits for your oral health" },
    { "type": "text", "id": "card_1_title", "label": "Card 1 title", "default": "Healthier Gums" },
    { "type": "textarea", "id": "card_1_desc", "label": "Card 1 description", "default": "L. reuteri DSM 17938 is proven in 70+ clinical studies to reduce gingival inflammation and bleeding." },
    { "type": "text", "id": "card_2_title", "label": "Card 2 title", "default": "Fresh Breath at the Source" },
    { "type": "textarea", "id": "card_2_desc", "label": "Card 2 description", "default": "BLIS K12 crowds out the sulphur-producing bacteria that cause halitosis \u2014 no masking, real results." },
    { "type": "text", "id": "card_3_title", "label": "Card 3 title", "default": "Plaque Defense" },
    { "type": "textarea", "id": "card_3_desc", "label": "Card 3 description", "default": "BLIS M18 produces enzymes that break down plaque biofilm and neutralize oral pH." },
    { "type": "text", "id": "card_4_title", "label": "Card 4 title", "default": "Immune Support" },
    { "type": "textarea", "id": "card_4_desc", "label": "Card 4 description", "default": "A balanced oral microbiome is your body\u2019s first line of defense. Support it daily." },
    { "type": "text", "id": "card_5_title", "label": "Card 5 title", "default": "Cavity Protection" },
    { "type": "textarea", "id": "card_5_desc", "label": "Card 5 description", "default": "Xylitol actively inhibits Streptococcus mutans, the primary bacteria responsible for tooth decay." },
    { "type": "text", "id": "card_6_title", "label": "Card 6 title", "default": "Whole-Body Connection" },
    { "type": "textarea", "id": "card_6_desc", "label": "Card 6 description", "default": "Research links oral microbiome health to cardiovascular, cognitive, and metabolic wellness." }
  ]
}
{% endschema %}
