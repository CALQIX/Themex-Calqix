{%- comment -%}
  CALQIX Navy Rebuild — Interactive tooth atlas (tab switcher).
  Source: _incoming/calqix-web-upgrade/handoff/source/components/body.jsx → TeethInteractive
{%- endcomment -%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-stack cx-section-header" data-cx-stagger>
      {% render 'cx-eyebrow', text: section.settings.eyebrow %}
      <h2 class="cx-h2">{{ section.settings.heading }}</h2>
      <div class="cx-lede">{{ section.settings.lede }}</div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cx-atlas" data-cx-tooth-atlas>
        <div class="cx-atlas-pills" role="tablist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tooth' -%}
              <button type="button"
                class="cx-pill cx-atlas-pill{% if forloop.first %} cx-is-active{% endif %}"
                data-cx-tooth-pill="{{ block.id }}"
                role="tab"
                aria-selected="{%- if forloop.first -%}true{%- else -%}false{%- endif -%}"
                {{ block.shopify_attributes }}>
                <span class="cx-atlas-pill-body">
                  <span class="cx-atlas-pill-name">{{ block.settings.name }}</span>
                  <span class="cx-atlas-pill-sub">{{ block.settings.sub }}</span>
                </span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="cx-atlas-display">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tooth' -%}
              <div class="cx-atlas-panel{% if forloop.first %} cx-is-active{% endif %}" data-cx-tooth-panel="{{ block.id }}" role="tabpanel">
                <div class="cx-atlas-anatomy">
                  <div class="cx-atlas-anatomy-title">{{ block.settings.name }}</div>
                  <div class="cx-atlas-anatomy-inner">
                    {%- if block.settings.anatomy_image != blank -%}
                      {{ block.settings.anatomy_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'cx-atlas-img' }}
                    {%- else -%}
                      {% render 'cx-placeholder', label: block.settings.name, radius: 'var(--cx-r-md)', style: 'width:100%;height:100%;' %}
                    {%- endif -%}
                  </div>
                </div>
                <div class="cx-atlas-text">
                  <div class="cx-eyebrow">Quick overview</div>
                  <h3 class="cx-h3">{{ block.settings.sub }}.</h3>
                  <p class="cx-atlas-desc">{{ block.settings.desc }}</p>
                  <div class="cx-atlas-block">
                    <div class="cx-eyebrow">Daily care</div>
                    <p>{{ block.settings.care }}</p>
                  </div>
                  <div class="cx-atlas-block">
                    <div class="cx-eyebrow">Did you know</div>
                    <p>{{ block.settings.fact }}</p>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_text != blank -%}
          <div class="cx-atlas-cta-wrap">
            {%- assign cx_btn_kind = section.settings.cta_style | default: 'navy' -%}
            {%- case cx_btn_kind -%}
              {%- when 'gold' -%}<a class="cx-btn cx-btn-gold" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
              {%- when 'ghost' -%}<a class="cx-btn cx-btn-ghost" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
              {%- when 'inline' -%}<a class="cx-btn-inline" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
              {%- else -%}<a class="cx-btn cx-btn-primary" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- endcase -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .cx-atlas-pills { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 32px; }
  .cx-atlas-pill { padding: 10px 18px; }
  .cx-atlas-pill-body { display: flex; flex-direction: column; text-align: left; gap: 2px; }
  .cx-atlas-pill-name { font-size: 13px; font-weight: 500; }
  .cx-atlas-pill-sub { font-size: 10.5px; opacity: .7; font-family: var(--cx-f-mono); letter-spacing: 0.08em; }
  .cx-atlas-display {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid var(--cx-rule);
    border-radius: var(--cx-r-lg);
    background: var(--cx-page-2);
    overflow: hidden;
  }
  .cx-atlas-panel { display: none; grid-column: 1 / -1; grid-template-columns: 1fr 1fr; gap: 0; }
  .cx-atlas-panel.cx-is-active { display: grid; }
  .cx-atlas-anatomy { padding: 48px; position: relative; min-height: 460px; }
  .cx-atlas-anatomy-title { font-family: var(--cx-f-display); font-size: 28px; font-style: italic; color: var(--cx-ink-soft); }
  .cx-atlas-anatomy-inner { position: absolute; inset: 80px 48px 80px 48px; }
  .cx-atlas-img { width: 100%; height: 100%; object-fit: contain; }
  .cx-atlas-text { padding: 48px; background: var(--cx-page); display: flex; flex-direction: column; gap: 24px; }
  .cx-atlas-desc { margin: 0; color: var(--cx-ink-soft); font-size: 15px; }
  .cx-atlas-block { border-top: 1px solid var(--cx-rule); padding-top: 20px; }
  .cx-atlas-block p { margin: 6px 0 0; font-size: 14.5px; }
  .cx-atlas-cta-wrap { text-align: center; margin-top: 32px; }
  @media (max-width: 900px) {
    .cx-atlas-display { grid-template-columns: 1fr; }
    .cx-atlas-panel.cx-is-active { grid-template-columns: 1fr; }
    .cx-atlas-anatomy { padding: 32px; min-height: 300px; }
    .cx-atlas-anatomy-inner { inset: 60px 32px 32px 32px; }
    .cx-atlas-text { padding: 32px; }
  }
</style>

{% schema %}
{
  "name": "CX Tooth Atlas",
  "tag": "section",
  "class": "cx-section-tooth-atlas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tooth atlas" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Understand how your <em>teeth really work.</em></p>" },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>Explore every tooth type and its role in one interactive view.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Discover CALQIX oral care" },
    { "type": "url",  "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "cta_style", "label": "Button style",
      "default": "navy",
      "options": [
        { "value": "gold",   "label": "Gold (filled)" },
        { "value": "navy",   "label": "Navy (filled)" },
        { "value": "ghost",  "label": "Outline" },
        { "value": "inline", "label": "Inline arrow" }
      ]
    },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "tooth",
      "name": "Tooth type",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Incisors" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "First bite" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Incisors sit at the front and are used to bite into food — think fruit, vegetables and crusty bread. They show wear first." },
        { "type": "textarea", "id": "care", "label": "Daily care", "default": "Daily cleaning prioritises the gumline and acid load." },
        { "type": "textarea", "id": "fact", "label": "Did you know", "default": "The thin biting edge shows wear first — watch for edge translucency." },
        { "type": "image_picker", "id": "anatomy_image", "label": "Anatomy image (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "tooth", "settings": {
          "name": "Incisors", "sub": "First bite",
          "desc": "Incisors sit at the front and are used to bite into food — think fruit, vegetables and crusty bread. They show wear first.",
          "care": "Daily cleaning prioritises the gumline and acid load.",
          "fact": "The thin biting edge shows wear first — watch for edge translucency." } },
      { "type": "tooth", "settings": {
          "name": "Canines", "sub": "Tear & separate",
          "desc": "The strongest and longest roots in your mouth. Canines guide your bite and protect neighbouring teeth from overload.",
          "care": "Focus on the enamel–cementum line — corner wear is an early signal.",
          "fact": "Canines carry the heaviest chewing force through their roots." } },
      { "type": "tooth", "settings": {
          "name": "Premolars", "sub": "Break & grind",
          "desc": "Two cusps and flat surfaces handle the first coarse grinding. Sensitive to acidic drinks in the grooves.",
          "care": "Flossing all the way around is essential — the gaps trap plaque easily.",
          "fact": "Grooves hold plaque up to 3× longer than smooth surfaces." } },
      { "type": "tooth", "settings": {
          "name": "Molars", "sub": "Final grind",
          "desc": "Wide chewing surfaces do the real work. Molars carry up to 90% of your chewing force.",
          "care": "Clean all four chewing surfaces every day — especially the back ones.",
          "fact": "First molars erupt around age 6 — they need to last a lifetime." } },
      { "type": "tooth", "settings": {
          "name": "Wisdom teeth", "sub": "Late erupters",
          "desc": "The last to erupt (17–25 years). Often impacted or partially visible, making them hard to clean.",
          "care": "Irrigation reaches where the brush can't — critical around the flap.",
          "fact": "Roughly 35% of people never develop wisdom teeth." } }
    ]
  }
}
{% endschema %}
