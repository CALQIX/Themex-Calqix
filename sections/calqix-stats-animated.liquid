{% assign csa_source_1 = 'J. Clinical Dentistry, 2019' %}
{% assign csa_label_2 = 'Subgingival reach' %}
{% assign csa_source_2 = 'Below the gumline' %}
{% assign csa_label_3 = 'Better than string floss' %}
{% assign csa_source_3 = 'Cochrane Review, 2021' %}
{% assign csa_label_4 = 'Deeper interdental cleaning' %}
{% assign csa_source_4 = 'ADA, 2020' %}
{% assign csa_link_label = 'View the full clinical evidence →' %}
{% if cq_is_flowcore %}
  {% case cq_lang %}
    {% when 'nl' %}
      {% assign csa_label_1 = 'Plaqueverwijdering' %}
      {% assign csa_label_2 = 'Subgingivale reikwijdte' %}
      {% assign csa_source_2 = 'Onder de tandvleesrand' %}
      {% assign csa_label_3 = 'Beter dan flossdraad' %}
      {% assign csa_label_4 = 'Diepere interdentale reiniging' %}
      {% assign csa_link_label = 'Bekijk het volledige klinische bewijs' %}
    {% when 'de' %}
      {% assign csa_label_1 = 'Plaqueentfernung' %}
      {% assign csa_label_2 = 'Subgingivale Reichweite' %}
      {% assign csa_source_2 = 'Unter dem Zahnfleischrand' %}
      {% assign csa_label_3 = 'Besser als Zahnseide' %}
      {% assign csa_label_4 = 'Tiefere Reinigung der Zahnzwischenräume' %}
      {% assign csa_link_label = 'Vollständige klinische Evidenz ansehen' %}
    {% when 'fr' %}
      {% assign csa_label_1 = 'Élimination de la plaque' %}
      {% assign csa_label_2 = 'Portée sous-gingivale' %}
      {% assign csa_source_2 = 'Sous le rebord gingival' %}
      {% assign csa_label_3 = 'Plus efficace que le fil dentaire' %}
      {% assign csa_label_4 = 'Nettoyage interdentaire plus profond' %}
      {% assign csa_link_label = 'Voir l’ensemble des preuves cliniques' %}
    {% when 'sv' %}
      {% assign csa_label_1 = 'Plackborttagning' %}
      {% assign csa_label_2 = 'Subgingival rackning' %}
      {% assign csa_source_2 = 'Under tandkottsranden' %}
      {% assign csa_label_3 = 'Battre an tandtrad' %}
      {% assign csa_label_4 = 'Djupare interdental rengoring' %}
      {% assign csa_link_label = 'Se hela den kliniska evidensen' %}
    {% when 'nb' %}
      {% assign csa_label_1 = 'Plakkfjerning' %}
      {% assign csa_label_2 = 'Subgingival rekkevidde' %}
      {% assign csa_source_2 = 'Under tannkjottranden' %}
      {% assign csa_label_3 = 'Bedre enn tanntrad' %}
      {% assign csa_label_4 = 'Dypere interdental rengjoring' %}
      {% assign csa_link_label = 'Se all klinisk dokumentasjon' %}
    {% when 'da' %}
      {% assign csa_label_1 = 'Plakfjernelse' %}
      {% assign csa_label_2 = 'Subgingival rakkevidde' %}
      {% assign csa_source_2 = 'Under tandkodskanten' %}
      {% assign csa_label_3 = 'Bedre end tandtrad' %}
      {% assign csa_label_4 = 'Dybere interdental rensning' %}
      {% assign csa_link_label = 'Se den fulde kliniske evidens' %}
    {% when 'fi' %}
      {% assign csa_label_1 = 'Plakin poisto' %}
      {% assign csa_label_2 = 'Subgingivaalinen ulottuvuus' %}
      {% assign csa_source_2 = 'Ikenreunan alle' %}
      {% assign csa_label_3 = 'Parempi kuin hammaslanka' %}
      {% assign csa_label_4 = 'Syvempi hammasvalienpuhdistus' %}
      {% assign csa_link_label = 'Katso kaikki kliiniset todisteet' %}
  {% endcase %}
