<style>
  .ob-compare {
    background: #F4F5F7;
    padding: 48px 0;
  }
  .ob-compare__container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-compare__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #1A3B5C;
    text-align: center;
    margin: 0 0 40px;
    line-height: 1.3;
  }
  .ob-compare__table {
    display: none;
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    background: #FFFFFF;
  }
  .ob-compare__table th,
  .ob-compare__table td {
    padding: 14px 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    text-align: center;
    border-bottom: 1px solid #F0F0F0;
    vertical-align: middle;
  }
  .ob-compare__table th {
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .ob-compare__table th:first-child,
  .ob-compare__table td:first-child {
    text-align: left;
    font-weight: 600;
    color: #1A3B5C;
    padding-left: 20px;
  }
  .ob-compare__table thead th {
    background: #F4F5F7;
    color: #6B7280;
  }
  .ob-compare__table thead th:last-child {
    background: rgba(201,168,76,0.12);
    color: #1A3B5C;
    border-top: 3px solid #C9A84C;
  }
  .ob-compare__table td:last-child {
    background: rgba(201,168,76,0.04);
  }
  .ob-compare__table tbody tr:last-child td { border-bottom: none; }
  .ob-compare__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #2E7D32;
  }
  .ob-compare__check svg { width: 14px; height: 14px; }
  .ob-compare__cross {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #E5E7EB;
  }
  .ob-compare__cross svg { width: 12px; height: 12px; }
  .ob-compare__partial {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    color: #6B7280;
    font-style: italic;
  }

  .ob-compare__mobile {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ob-compare__mobile-card {
    background: #FFFFFF;
    border-radius: 8px;
    padding: 16px 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ob-compare__mobile-card .ob-compare__check {
    flex-shrink: 0;
  }
  .ob-compare__mobile-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #1A3B5C;
    line-height: 1.4;
  }
  .ob-compare__mobile-sub {
    display: block;
    font-size: 12px;
    color: #6B7280;
    margin-top: 2px;
  }

  @media (min-width: 768px) {
    .ob-compare__table { display: table; }
    .ob-compare__mobile { display: none; }
  }
  @media (min-width: 1024px) {
    .ob-compare { padding: 80px 0; }
    .ob-compare__heading { font-size: 36px; }
    .ob-compare__table th,
    .ob-compare__table td { padding: 16px 20px; }
  }
</style>

<section class="ob-compare" data-section-id="{{ section.id }}">
  <div class="ob-compare__container">
    <h2 class="ob-compare__heading">{{ section.settings.heading }}</h2>

    <table class="ob-compare__table" role="table">
      <thead>
        <tr>
          <th>{{ section.settings.col_feature }}</th>
          <th>{{ section.settings.col_mouthwash }}</th>
          <th>{{ section.settings.col_toothpaste }}</th>
          <th>{{ section.settings.col_oralbiome }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <td>{{ block.settings.feature }}</td>
            <td>
              {%- if block.settings.mouthwash == 'yes' -%}
                <span class="ob-compare__check"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {%- elsif block.settings.mouthwash == 'partial' -%}
                <span class="ob-compare__partial">{{ block.settings.mouthwash_note }}</span>
              {%- else -%}
                <span class="ob-compare__cross"><svg viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg></span>
              {%- endif -%}
            </td>
            <td>
              {%- if block.settings.toothpaste == 'yes' -%}
                <span class="ob-compare__check"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {%- elsif block.settings.toothpaste == 'partial' -%}
                <span class="ob-compare__partial">{{ block.settings.toothpaste_note }}</span>
              {%- else -%}
                <span class="ob-compare__cross"><svg viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg></span>
              {%- endif -%}
            </td>
            <td>
              {%- if block.settings.oralbiome == 'yes' -%}
                <span class="ob-compare__check"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {%- elsif block.settings.oralbiome == 'partial' -%}
                <span class="ob-compare__partial">{{ block.settings.oralbiome_note }}</span>
              {%- else -%}
                <span class="ob-compare__cross"><svg viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg></span>
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="ob-compare__mobile" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.oralbiome == 'yes' -%}
          <div class="ob-compare__mobile-card" role="listitem" {{ block.shopify_attributes }}>
            <span class="ob-compare__check"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="ob-compare__mobile-text">
              {{ block.settings.feature }}
              {%- if block.settings.oralbiome_note != blank -%}
                <span class="ob-compare__mobile-sub">{{ block.settings.oralbiome_note }}</span>
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OB Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not all oral care is created equal." },
    { "type": "text", "id": "col_feature", "label": "Feature column header", "default": "Feature" },
    { "type": "text", "id": "col_mouthwash", "label": "Mouthwash column header", "default": "Mouthwash" },
    { "type": "text", "id": "col_toothpaste", "label": "Toothpaste column header", "default": "Antibacterial Toothpaste" },
    { "type": "text", "id": "col_oralbiome", "label": "OralBiome column header", "default": "OralBiome Pro" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature name", "default": "Feature" },
        { "type": "select", "id": "mouthwash", "label": "Mouthwash", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "partial", "label": "Partial" }], "default": "no" },
        { "type": "text", "id": "mouthwash_note", "label": "Mouthwash note (if partial)" },
        { "type": "select", "id": "toothpaste", "label": "Toothpaste", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "partial", "label": "Partial" }], "default": "no" },
        { "type": "text", "id": "toothpaste_note", "label": "Toothpaste note (if partial)" },
        { "type": "select", "id": "oralbiome", "label": "OralBiome Pro", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "partial", "label": "Partial" }], "default": "yes" },
        { "type": "text", "id": "oralbiome_note", "label": "OralBiome note (if partial)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Kills harmful bacteria", "mouthwash": "yes", "toothpaste": "yes", "oralbiome": "yes" } },
        { "type": "row", "settings": { "feature": "Preserves beneficial bacteria", "mouthwash": "no", "toothpaste": "no", "oralbiome": "yes" } },
        { "type": "row", "settings": { "feature": "Addresses bad breath at source", "mouthwash": "no", "mouthwash_note": "Masks only", "toothpaste": "no", "oralbiome": "yes" } },
        { "type": "row", "settings": { "feature": "Supports gum health long-term", "mouthwash": "no", "toothpaste": "partial", "toothpaste_note": "Partially", "oralbiome": "yes" } },
        { "type": "row", "settings": { "feature": "Rebuilds oral microbiome", "mouthwash": "no", "toothpaste": "no", "oralbiome": "yes" } },
        { "type": "row", "settings": { "feature": "Safe daily use without side effects", "mouthwash": "no", "toothpaste": "yes", "oralbiome": "yes" } },
        { "type": "row", "settings": { "feature": "Clinically studied strains", "mouthwash": "no", "toothpaste": "no", "oralbiome": "yes", "oralbiome_note": "70+ studies" } }
      ]
    }
  ]
}
{% endschema %}
