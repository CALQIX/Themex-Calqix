<style>
  .ob-compare {
    background: #F4F5F7;
    padding: 48px 0;
    overflow: hidden;
  }
  .ob-compare__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ob-compare__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #1A3B5C;
    text-align: center;
    margin: 0 0 40px;
    line-height: 1.3;
  }

  /* ── Desktop table ── */
  .ob-compare__table {
    display: table;
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    background: #FFFFFF;
  }
  .ob-compare__table th,
  .ob-compare__table td {
    padding: 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    text-align: center;
    border-bottom: 1px solid #F3F4F6;
    vertical-align: middle;
  }
  .ob-compare__table thead th {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #1A3B5C;
    background: transparent;
    border-bottom: 2px solid #E5E7EB;
  }
  .ob-compare__table thead th:last-child {
    background: rgba(201,168,76,0.08);
    border-top: 3px solid #C9A84C;
    position: relative;
    overflow: hidden;
  }
  .ob-compare__table thead th:last-child::after {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 60%; height: 100%;
    background: linear-gradient(105deg, transparent 20%, rgba(201,168,76,0.12) 45%, rgba(201,168,76,0.2) 50%, rgba(201,168,76,0.12) 55%, transparent 80%);
    animation: obCompareShimmer 4s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes obCompareShimmer {
    0% { left: -100%; }
    100% { left: 200%; }
  }
  .ob-compare__table th:first-child,
  .ob-compare__table td:first-child {
    text-align: left;
    font-weight: 500;
    color: #1A1A1A;
    padding-left: 20px;
  }
  .ob-compare__table td:last-child {
    background: rgba(201,168,76,0.08);
  }
  .ob-compare__table tbody tr:nth-child(even) td {
    background-color: #F9FAFB;
  }
  .ob-compare__table tbody tr:nth-child(even) td:last-child {
    background: rgba(201,168,76,0.06);
  }
  .ob-compare__table tbody tr:last-child td { border-bottom: none; }
  .ob-compare__table tbody tr {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease, background-color 0.2s ease;
  }
  .ob-compare__table tbody tr.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .ob-compare__table tbody tr:hover td {
    background-color: rgba(201,168,76,0.04);
  }
  .ob-compare__table tbody tr:hover td:last-child {
    background-color: rgba(201,168,76,0.12);
  }

  /* ── Icons ── */
  .comparison-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .comparison-icon--yes svg circle {
    transition: transform 0.3s ease;
    transform-origin: center;
  }
  .is-visible .comparison-icon--yes svg circle {
    animation: obCompareCheckPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes obCompareCheckPop {
    0% { transform: scale(0.6); }
    100% { transform: scale(1); }
  }
  .comparison-partial {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: #9CA3AF;
    font-style: italic;
  }
  .comparison-extra {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    color: #2E7D32;
    font-weight: 600;
    margin-left: 6px;
  }

  /* ── Scroll wrapper ── */
  .ob-compare__scroll-wrap { max-width: 900px; margin: 0 auto; }
  .ob-compare__scroll-hint { display: none; }
  .ob-compare__scroll {
    overflow-x: visible;
  }

  /* ── Hide desktop table on mobile, show mobile scroller ── */
  @media (max-width: 767px) {
    .ob-compare__scroll-wrap { display: none; }
    .ob-compare__heading { display: none; }
    .ob-compare { overflow: visible; padding: 0; background: transparent; }
  }
  @media (min-width: 768px) {
    .ob-compare-m { display: none !important; }
  }

  /* ═══════════════════════════════════════
     MOBILE CARD SCROLLER
     ═══════════════════════════════════════ */
  .ob-compare-m {
    padding: 48px 0 40px;
    background: linear-gradient(180deg, #F4F5F7 0%, #FFFFFF 100%);
    overflow: hidden;
  }

  /* Header */
  .ob-compare-m__header {
    text-align: center;
    padding: 0 20px;
    margin-bottom: 28px;
  }
  .ob-compare-m__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #C9A84C;
    margin: 0 0 10px;
  }
  .ob-compare-m__title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    color: #1A3B5C;
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .ob-compare-m__note {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #6B7280;
    line-height: 1.5;
    margin: 0;
  }

  /* Score strip */
  .ob-compare-m__score {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin: 20px 20px 24px;
    padding: 12px 0;
    background: #1A3B5C;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
  }
  .ob-compare-m__score::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(201,168,76,0.1) 50%, transparent 70%);
    animation: obMScoreShimmer 3s ease-in-out infinite;
  }
  @keyframes obMScoreShimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .ob-compare-m__score-item {
    text-align: center;
    flex: 1;
    position: relative;
    z-index: 1;
  }
  .ob-compare-m__score-num {
    font-family: 'DM Serif Display', serif;
    font-size: 22px;
    color: #FFFFFF;
    display: block;
    line-height: 1;
  }
  .ob-compare-m__score-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.5);
    display: block;
    margin-top: 3px;
  }
  .ob-compare-m__score-item + .ob-compare-m__score-item::before {
    content: '';
    position: absolute;
    left: 0; top: 20%; bottom: 20%;
    width: 1px;
    background: rgba(255,255,255,0.15);
  }

  /* Scroll track + hint */
  .ob-compare-m__track-wrap {
    position: relative;
  }
  .ob-compare-m__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 20px 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    color: #9CA3AF;
  }
  .ob-compare-m__hint svg {
    animation: obMHintPulse 1.8s ease-in-out infinite;
  }
  @keyframes obMHintPulse {
    0%, 100% { transform: translateX(0); opacity: 0.5; }
    50% { transform: translateX(5px); opacity: 1; }
  }
  .ob-compare-m__hint.is-hidden {
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  /* Card track */
  .ob-compare-m__track {
    display: flex;
    gap: 14px;
    padding: 4px 20px 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .ob-compare-m__track::-webkit-scrollbar { display: none; }

  /* Individual feature card */
  .ob-compare-m__card {
    flex: 0 0 85%;
    max-width: 320px;
    scroll-snap-align: center;
    background: #FFFFFF;
    border-radius: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid #E5E7EB;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .ob-compare-m__card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .ob-compare-m__card.is-active {
    border-color: #C9A84C;
    box-shadow: 0 4px 20px rgba(201,168,76,0.15);
  }

  .ob-compare-m__card-head {
    padding: 18px 18px 14px;
    border-bottom: 1px solid #F3F4F6;
  }
  .ob-compare-m__card-idx {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: #C9A84C;
    font-weight: 700;
    margin: 0 0 4px;
  }
  .ob-compare-m__card-feature {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #1A3B5C;
    line-height: 1.3;
    margin: 0;
  }

  /* Three-column comparison inside card */
  .ob-compare-m__card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
  }
  .ob-compare-m__card-col {
    padding: 14px 8px;
    text-align: center;
    border-right: 1px solid #F3F4F6;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .ob-compare-m__card-col:last-child {
    border-right: none;
  }
  .ob-compare-m__card-col--winner {
    background: rgba(201,168,76,0.06);
    position: relative;
  }
  .ob-compare-m__card-col--winner::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: #C9A84C;
    border-radius: 0 0 2px 2px;
  }
  .ob-compare-m__col-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #9CA3AF;
  }
  .ob-compare-m__col-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
  }
  .ob-compare-m__col-icon svg {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  .ob-compare-m__card.is-active .ob-compare-m__col-icon svg {
    opacity: 1;
    transform: scale(1);
  }
  .ob-compare-m__col-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    color: #6B7280;
    font-style: italic;
    line-height: 1.3;
  }
  .ob-compare-m__col-extra {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #2E7D32;
  }

  /* Winner pulse on OralBiome icon */
  .ob-compare-m__card-col--winner .ob-compare-m__col-icon svg circle {
    animation: obMWinPulse 2s ease-in-out infinite;
  }
  @keyframes obMWinPulse {
    0%, 100% { filter: drop-shadow(0 0 0 rgba(46,125,50,0)); }
    50% { filter: drop-shadow(0 0 6px rgba(46,125,50,0.3)); }
  }

  /* Progress dots */
  .ob-compare-m__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 0 20px;
  }
  .ob-compare-m__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D1D5DB;
    transition: all 0.3s ease;
  }
  .ob-compare-m__dot.is-active {
    background: #C9A84C;
    width: 20px;
    border-radius: 3px;
  }

  /* Bottom verdikt bar */
  .ob-compare-m__verdict {
    margin: 24px 20px 0;
    padding: 16px;
    background: #1A3B5C;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ob-compare-m__verdict-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #C9A84C;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ob-compare-m__verdict-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.85);
    line-height: 1.4;
  }
  .ob-compare-m__verdict-text strong {
    color: #C9A84C;
    font-weight: 700;
  }
  @media (min-width: 1024px) {
    .ob-compare { padding: 80px 0; }
    .ob-compare__heading { font-size: 36px; }
    .ob-compare__table th,
    .ob-compare__table td { padding: 16px 20px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- if _ob_lang != 'en' -%}
  {%- assign _ob_cmp_heading = 'calqix_oralbiome.compare.heading' | t -%}
  {%- assign _ob_cmp_col_trad = 'calqix_oralbiome.compare.col_traditional' | t -%}
  {%- assign _ob_cmp_col_calqix = 'calqix_oralbiome.compare.col_calqix' | t -%}
{%- else -%}
  {%- assign _ob_cmp_heading = section.settings.heading -%}
  {%- assign _ob_cmp_col_trad = section.settings.col_mouthwash -%}
  {%- assign _ob_cmp_col_calqix = section.settings.col_oralbiome -%}
{%- endif -%}

<section class="ob-compare" data-section-id="{{ section.id }}">
  <div class="ob-compare__container">
    <h2 class="ob-compare__heading">{{ _ob_cmp_heading }}</h2>

    <div class="ob-compare__scroll-wrap">
      <div class="ob-compare__scroll-hint" data-ob-compare-hint>
        <span>Scroll to compare</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <div class="ob-compare__scroll" data-ob-compare-scroll>
        <table class="ob-compare__table" role="table">
          <thead>
            <tr>
              <th>{{ section.settings.col_feature }}</th>
              <th>{{ section.settings.col_mouthwash }}</th>
              <th>{{ section.settings.col_toothpaste }}</th>
              <th>{{ section.settings.col_oralbiome }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }} data-ob-compare-row>
                <td>{{ block.settings.feature }}</td>
                <td>
                  {%- if block.settings.mouthwash == 'yes' -%}
                    <span class="comparison-icon comparison-icon--yes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7D32"/><path d="M7 12.5l3 3 7-7" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  {%- elsif block.settings.mouthwash == 'partial' -%}
                    <span class="comparison-partial">{{ block.settings.mouthwash_note | default: 'Partially' }}</span>
                  {%- else -%}
                    <span class="comparison-icon comparison-icon--no"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#E5E7EB"/><path d="M15 9l-6 6M9 9l6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg></span>
                  {%- endif -%}
                </td>
                <td>
                  {%- if block.settings.toothpaste == 'yes' -%}
                    <span class="comparison-icon comparison-icon--yes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7D32"/><path d="M7 12.5l3 3 7-7" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  {%- elsif block.settings.toothpaste == 'partial' -%}
                    <span class="comparison-partial">{{ block.settings.toothpaste_note | default: 'Partially' }}</span>
                  {%- else -%}
                    <span class="comparison-icon comparison-icon--no"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#E5E7EB"/><path d="M15 9l-6 6M9 9l6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg></span>
                  {%- endif -%}
                </td>
                <td>
                  <span class="comparison-icon comparison-icon--yes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7D32"/><path d="M7 12.5l3 3 7-7" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  {%- if block.settings.oralbiome == 'yes_text' and block.settings.oralbiome_note != blank -%}
                    <span class="comparison-extra">{{ block.settings.oralbiome_note }}</span>
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ═══ MOBILE CARD SCROLLER ═══ {%- endcomment -%}
<div class="ob-compare-m" data-ob-compare-m>

  <div class="ob-compare-m__header">
    <p class="ob-compare-m__eyebrow">COMPARISON</p>
    <h2 class="ob-compare-m__title">{{ section.settings.mobile_heading | default: section.settings.heading }}</h2>
    {%- if section.settings.mobile_note != blank -%}
      <p class="ob-compare-m__note">{{ section.settings.mobile_note }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} Score strip — tallies from block data {%- endcomment -%}
  {%- assign ob_win_count = 0 -%}
  {%- assign mw_win_count = 0 -%}
  {%- assign tp_win_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.mouthwash == 'yes' -%}{%- assign mw_win_count = mw_win_count | plus: 1 -%}{%- endif -%}
    {%- if block.settings.toothpaste == 'yes' -%}{%- assign tp_win_count = tp_win_count | plus: 1 -%}{%- endif -%}
    {%- assign ob_win_count = ob_win_count | plus: 1 -%}
  {%- endfor -%}
  <div class="ob-compare-m__score">
    <div class="ob-compare-m__score-item">
      <span class="ob-compare-m__score-num" data-ob-m-count="{{ mw_win_count }}">0</span>
      <span class="ob-compare-m__score-label">{{ section.settings.col_mouthwash | truncate: 12, '' }}</span>
    </div>
    <div class="ob-compare-m__score-item">
      <span class="ob-compare-m__score-num" data-ob-m-count="{{ tp_win_count }}">0</span>
      <span class="ob-compare-m__score-label">Toothpaste</span>
    </div>
    <div class="ob-compare-m__score-item">
      <span class="ob-compare-m__score-num" data-ob-m-count="{{ ob_win_count }}">0</span>
      <span class="ob-compare-m__score-label">OralBiome</span>
    </div>
  </div>

  <div class="ob-compare-m__track-wrap">
    <div class="ob-compare-m__hint" data-ob-m-hint>
      <span>Swipe to compare</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <div class="ob-compare-m__track" data-ob-m-track>
      {%- for block in section.blocks -%}
        <div class="ob-compare-m__card" data-ob-m-card {{ block.shopify_attributes }}>
          <div class="ob-compare-m__card-head">
            <p class="ob-compare-m__card-idx">{{ forloop.index }} / {{ forloop.length }}</p>
            <p class="ob-compare-m__card-feature">{{ block.settings.feature }}</p>
          </div>
          <div class="ob-compare-m__card-grid">
            {%- comment -%} Mouthwash column {%- endcomment -%}
            <div class="ob-compare-m__card-col">
              <span class="ob-compare-m__col-label">{{ section.settings.col_mouthwash | truncate: 10, '' }}</span>
              <span class="ob-compare-m__col-icon">
                {%- if block.settings.mouthwash == 'yes' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7D32"/><path d="M7 12.5l3 3 7-7" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- elsif block.settings.mouthwash == 'partial' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#F59E0B"/><path d="M8 12h8" stroke="#FFF" stroke-width="2" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#E5E7EB"/><path d="M15 9l-6 6M9 9l6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg>
                {%- endif -%}
              </span>
              {%- if block.settings.mouthwash == 'partial' and block.settings.mouthwash_note != blank -%}
                <span class="ob-compare-m__col-text">{{ block.settings.mouthwash_note }}</span>
              {%- endif -%}
            </div>
            {%- comment -%} Toothpaste column {%- endcomment -%}
            <div class="ob-compare-m__card-col">
              <span class="ob-compare-m__col-label">Toothpaste</span>
              <span class="ob-compare-m__col-icon">
                {%- if block.settings.toothpaste == 'yes' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7D32"/><path d="M7 12.5l3 3 7-7" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- elsif block.settings.toothpaste == 'partial' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#F59E0B"/><path d="M8 12h8" stroke="#FFF" stroke-width="2" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#E5E7EB"/><path d="M15 9l-6 6M9 9l6 6" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg>
                {%- endif -%}
              </span>
              {%- if block.settings.toothpaste == 'partial' and block.settings.toothpaste_note != blank -%}
                <span class="ob-compare-m__col-text">{{ block.settings.toothpaste_note }}</span>
              {%- endif -%}
            </div>
            {%- comment -%} OralBiome column (always winner) {%- endcomment -%}
            <div class="ob-compare-m__card-col ob-compare-m__card-col--winner">
              <span class="ob-compare-m__col-label">OralBiome</span>
              <span class="ob-compare-m__col-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7D32"/><path d="M7 12.5l3 3 7-7" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              {%- if block.settings.oralbiome == 'yes_text' and block.settings.oralbiome_note != blank -%}
                <span class="ob-compare-m__col-extra">{{ block.settings.oralbiome_note }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="ob-compare-m__dots" data-ob-m-dots>
      {%- for block in section.blocks -%}
        <span class="ob-compare-m__dot{%- if forloop.first %} is-active{%- endif -%}"></span>
      {%- endfor -%}
    </div>
  </div>

  <div class="ob-compare-m__verdict">
    <div class="ob-compare-m__verdict-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#1A3B5C"/></svg>
    </div>
    <p class="ob-compare-m__verdict-text">
      <strong>OralBiome Pro wins {{ ob_win_count }}/{{ ob_win_count }}</strong> categories.
      The only product that restores instead of destroys.
    </p>
  </div>
</div>

<script>
  (function() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');

    /* ── Desktop table row stagger ── */
    if (section) {
      var rows = section.querySelectorAll('[data-ob-compare-row]');
      if (rows.length) {
        var tableObs = new IntersectionObserver(function(entries) {
          var delay = 0;
          entries.forEach(function(entry) {
            if (entry.isIntersecting && !entry.target.classList.contains('is-visible')) {
              setTimeout(function() { entry.target.classList.add('is-visible'); }, delay);
              delay += 80;
            }
          });
        }, { threshold: 0.15 });
        rows.forEach(function(r) { tableObs.observe(r); });
      }
    }

    /* ── Mobile card scroller ── */
    var mob = document.querySelector('[data-ob-compare-m]');
    if (!mob) return;

    var track = mob.querySelector('[data-ob-m-track]');
    var cards = mob.querySelectorAll('[data-ob-m-card]');
    var dots  = mob.querySelectorAll('[data-ob-m-dots] .ob-compare-m__dot');
    var hint  = mob.querySelector('[data-ob-m-hint]');
    var nums  = mob.querySelectorAll('[data-ob-m-count]');

    /* Entrance: stagger cards into view */
    var cardObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = Array.prototype.indexOf.call(cards, entry.target);
          setTimeout(function() {
            entry.target.classList.add('is-visible');
          }, idx * 100);
          cardObs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    cards.forEach(function(c) { cardObs.observe(c); });

    /* Active card detection on scroll */
    if (track && cards.length) {
      function updateActive() {
        var trackRect = track.getBoundingClientRect();
        var center = trackRect.left + trackRect.width / 2;
        var closest = 0;
        var closestDist = Infinity;

        cards.forEach(function(card, i) {
          var cardRect = card.getBoundingClientRect();
          var cardCenter = cardRect.left + cardRect.width / 2;
          var dist = Math.abs(cardCenter - center);
          if (dist < closestDist) {
            closestDist = dist;
            closest = i;
          }
        });

        cards.forEach(function(c, i) {
          c.classList.toggle('is-active', i === closest);
        });
        dots.forEach(function(d, i) {
          d.classList.toggle('is-active', i === closest);
        });
      }

      track.addEventListener('scroll', updateActive, { passive: true });

      /* Initial state */
      setTimeout(function() {
        if (cards[0]) cards[0].classList.add('is-active');
      }, 600);

      /* Hide hint on first scroll */
      if (hint) {
        track.addEventListener('scroll', function() {
          hint.classList.add('is-hidden');
        }, { once: true });
      }
    }

    /* Score counter animation */
    if (nums.length) {
      var scoreObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            animateNums();
            scoreObs.disconnect();
          }
        });
      }, { threshold: 0.5 });
      scoreObs.observe(mob.querySelector('.ob-compare-m__score'));

      function animateNums() {
        nums.forEach(function(el) {
          var target = parseInt(el.dataset.obMCount, 10);
          var start = performance.now();
          var duration = 1200;
          function step(now) {
            var t = Math.min((now - start) / duration, 1);
            t = 1 - Math.pow(1 - t, 3);
            el.textContent = Math.round(t * target);
            if (t < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        });
      }
    }
  })();
</script>

