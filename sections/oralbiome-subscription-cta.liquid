<style>
  .ob-cta {
    position: relative;
    background: #0F2233;
    padding: 48px 0;
    overflow: hidden;
  }
  .ob-cta__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image:
      linear-gradient(30deg, #C9A84C 12%, transparent 12.5%, transparent 87%, #C9A84C 87.5%, #C9A84C),
      linear-gradient(150deg, #C9A84C 12%, transparent 12.5%, transparent 87%, #C9A84C 87.5%, #C9A84C),
      linear-gradient(30deg, #C9A84C 12%, transparent 12.5%, transparent 87%, #C9A84C 87.5%, #C9A84C),
      linear-gradient(150deg, #C9A84C 12%, transparent 12.5%, transparent 87%, #C9A84C 87.5%, #C9A84C),
      linear-gradient(60deg, rgba(201,168,76,0.5) 25%, transparent 25.5%, transparent 75%, rgba(201,168,76,0.5) 75%, rgba(201,168,76,0.5)),
      linear-gradient(60deg, rgba(201,168,76,0.5) 25%, transparent 25.5%, transparent 75%, rgba(201,168,76,0.5) 75%, rgba(201,168,76,0.5));
    background-size: 40px 70px;
    background-position: 0 0, 0 0, 20px 35px, 20px 35px, 0 0, 20px 35px;
    pointer-events: none;
  }
  .ob-cta__container {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }
  .ob-cta__heading {
    font-family: 'DM Serif Display', serif;
    font-size: 28px;
    color: #FFFFFF;
    margin: 0 0 12px;
    line-height: 1.3;
  }
  .ob-cta__subheading {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: rgba(255,255,255,0.8);
    margin: 0 0 28px;
  }
  .ob-cta__pills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 28px;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }
  .ob-cta__pill {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #FFFFFF;
    border: 1px solid rgba(201,168,76,0.6);
    border-radius: 50px;
    padding: 8px 12px;
    white-space: nowrap;
    text-align: center;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ob-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 0 40px;
    background: #C9A84C;
    color: #1A3B5C;
    border: none;
    border-radius: 4px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    max-width: 400px;
    width: 100%;
    text-decoration: none;
  }
  .ob-cta__button:hover {
    background: #b8953f;
    transform: scale(1.02);
  }
  .ob-cta__alt {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    margin: 14px 0 0;
  }
  .ob-cta__alt-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.4);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    padding: 0;
    transition: color 0.2s ease;
  }
  .ob-cta__alt-btn:hover { color: rgba(255,255,255,0.7); }
  .ob-cta__button-spinner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .ob-cta__pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      max-width: none;
      gap: 12px;
    }
    .ob-cta__pill { font-size: 13px; padding: 6px 16px; min-height: auto; }
  }
  @media (min-width: 1024px) {
    .ob-cta { padding: 80px 0; }
    .ob-cta__heading { font-size: 40px; }
    .ob-cta__subheading { font-size: 18px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- if _ob_lang != 'en' -%}
  {%- assign _ob_cta_heading = 'calqix_oralbiome.cta.heading' | t -%}
  {%- assign _ob_cta_sub = 'calqix_oralbiome.cta.subtext' | t -%}
  {%- assign _ob_cta_button = 'calqix_oralbiome.cta.button' | t -%}
{%- else -%}
  {%- assign _ob_cta_heading = section.settings.heading -%}
  {%- assign _ob_cta_sub = section.settings.subheading -%}
  {%- assign _ob_cta_button = section.settings.button_text -%}
{%- endif -%}

<section class="ob-cta" data-section-id="{{ section.id }}">
  <div class="ob-cta__pattern" aria-hidden="true"></div>
  <div class="ob-cta__container">
    <h2 class="ob-cta__heading">{{ _ob_cta_heading }}</h2>
    <p class="ob-cta__subheading">{{ _ob_cta_sub }}</p>
    <div class="ob-cta__pills">
      {%- if section.settings.pill_1 != blank -%}<span class="ob-cta__pill">{{ section.settings.pill_1 }}</span>{%- endif -%}
      {%- if section.settings.pill_2 != blank -%}<span class="ob-cta__pill">{{ section.settings.pill_2 }}</span>{%- endif -%}
      {%- if section.settings.pill_3 != blank -%}<span class="ob-cta__pill">{{ section.settings.pill_3 }}</span>{%- endif -%}
      {%- if section.settings.pill_4 != blank -%}<span class="ob-cta__pill">{{ section.settings.pill_4 }}</span>{%- endif -%}
    </div>
    {%- assign selling_plan_id = nil -%}
    {%- for group in product.selling_plan_groups -%}
      {%- for plan in group.selling_plans -%}
        {%- if selling_plan_id == nil -%}
          {%- assign selling_plan_id = plan.id -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}

    <button
      type="button"
      class="ob-cta__button"
      id="oralbiome-cta-subscribe"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-selling-plan-id="{{ selling_plan_id }}"
      aria-label="{{ _ob_cta_button }}"
    >
      <span class="ob-cta__button-text">{{ _ob_cta_button }}</span>
      <span class="ob-cta__button-spinner" style="display:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="20">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite"/>
          </circle>
        </svg>
      </span>
    </button>
    <p class="ob-cta__alt">
      {{ 'calqix_oralbiome.cta.onetime_prefix' | t }} <button type="button" class="ob-cta__alt-btn" id="oralbiome-cta-onetime">{{ 'calqix_oralbiome.cta.onetime_label' | t }} {{ product.price | money }}</button>
    </p>
  </div>
</section>

<script>
(function() {
  var ctaBtn = document.getElementById('oralbiome-cta-subscribe');
  var onetimeBtn = document.getElementById('oralbiome-cta-onetime');
  if (!ctaBtn) return;

  var defaultText = ctaBtn.querySelector('.ob-cta__button-text').textContent;

  /* ── Helpers ── */
  function getVariantId() {
    var id = ctaBtn.dataset.variantId;
    if (id) return parseInt(id);
    var input = document.querySelector('input[name="id"], select[name="id"], [data-variant-id]');
    if (input) return parseInt(input.value || input.dataset.variantId);
    return null;
  }

  function getSellingPlanId() {
    var id = ctaBtn.dataset.sellingPlanId;
    if (id) return parseInt(id);
    var input = document.querySelector('input[name="selling_plan"]:checked, select[name="selling_plan"], [data-selling-plan-id]');
    if (input) return parseInt(input.value || input.dataset.sellingPlanId);
    return null;
  }

  function openCartDrawer() {
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    var drawer = document.querySelector('cart-drawer')
      || document.querySelector('.cart-drawer')
      || document.querySelector('[data-cart-drawer]')
      || document.querySelector('#CartDrawer');
    if (drawer) {
      if (typeof drawer.open === 'function') { drawer.open(); }
      else if (drawer.classList) {
        drawer.classList.add('is-open', 'active', 'drawer--is-open');
        document.body.classList.add('overflow-hidden', 'drawer-open');
      }
    } else {
      var icon = document.querySelector('a[href="/cart"]')
        || document.querySelector('.header__icon--cart')
        || document.querySelector('[data-cart-toggle]')
        || document.querySelector('.cart-icon-bubble');
      if (icon) icon.click();
    }
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var badges = document.querySelectorAll('.cart-count-bubble span, .cart-count, [data-cart-count], .header__cart-count');
      badges.forEach(function(b){ b.textContent = cart.item_count; });
    });
  }

  function setBtnState(btn, txtEl, spinnerEl, state, label) {
    if (state === 'loading') {
      txtEl.style.display = 'none';
      spinnerEl.style.display = 'inline-flex';
      btn.disabled = true;
      btn.style.pointerEvents = 'none';
    } else if (state === 'success') {
      spinnerEl.style.display = 'none';
      txtEl.textContent = label || '{{ 'calqix_oralbiome.cta.added_to_cart' | t | escape }}';
      txtEl.style.display = 'inline';
      btn.style.background = '#2E7D32';
      btn.style.color = '#FFFFFF';
    } else if (state === 'error') {
      spinnerEl.style.display = 'none';
      txtEl.textContent = label || '{{ 'calqix_oralbiome.cta.error' | t | escape }}';
      txtEl.style.display = 'inline';
      btn.style.background = '#DC2626';
      btn.style.color = '#FFFFFF';
    } else {
      txtEl.textContent = label || defaultText;
      txtEl.style.display = 'inline';
      spinnerEl.style.display = 'none';
      btn.style.background = '';
      btn.style.color = '';
      btn.disabled = false;
      btn.style.pointerEvents = '';
    }
  }

  function resetBtn(btn, txtEl, spinnerEl) {
    setTimeout(function() { setBtnState(btn, txtEl, spinnerEl, 'idle', defaultText); }, 3000);
  }

  /* ── Subscribe button ── */
  ctaBtn.addEventListener('click', function() {
    var variantId = getVariantId();
    if (!variantId) { console.error('No variant found'); return; }
    var sellingPlanId = getSellingPlanId();
    var txtEl = ctaBtn.querySelector('.ob-cta__button-text');
    var spinnerEl = ctaBtn.querySelector('.ob-cta__button-spinner');

    setBtnState(ctaBtn, txtEl, spinnerEl, 'loading');

    var item = { id: variantId, quantity: 1 };
    if (sellingPlanId) item.selling_plan = sellingPlanId;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [item] })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Failed to add to cart');
      return res.json();
    })
    .then(function() {
      setBtnState(ctaBtn, txtEl, spinnerEl, 'success');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(openCartDrawer, 400);
      resetBtn(ctaBtn, txtEl, spinnerEl);
    })
    .catch(function(err) {
      console.error('Add to cart error:', err);
      setBtnState(ctaBtn, txtEl, spinnerEl, 'error');
      resetBtn(ctaBtn, txtEl, spinnerEl);
    });
  });

  /* ── One-time purchase button ── */
  if (onetimeBtn) {
    onetimeBtn.addEventListener('click', function() {
      var variantId = getVariantId();
      if (!variantId) return;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Failed');
        return res.json();
      })
      .then(function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(openCartDrawer, 400);
      })
      .catch(function(err) {
        console.error('One-time add to cart error:', err);
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "OB Subscription CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your mouth deserves daily balance." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "\u20ac0.67 per day for a clinically supported oral microbiome." },
    { "type": "text", "id": "pill_1", "label": "Pill 1", "default": "Free Shipping" },
    { "type": "text", "id": "pill_2", "label": "Pill 2", "default": "Skip Anytime" },
    { "type": "text", "id": "pill_3", "label": "Pill 3", "default": "60-Day Guarantee" },
    { "type": "text", "id": "pill_4", "label": "Pill 4", "default": "Cancel in 1 Click" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe & Save 20%" }
  ]
}
{% endschema %}
