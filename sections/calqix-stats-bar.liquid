<section id="calqix-stats-bar-{{ section.id }}" class="calqix-stats-bar">
  <style>
    #calqix-stats-bar-{{ section.id }} {
      background: #f4f5f7;
      padding: 20px 0;
    }

    #calqix-stats-bar-{{ section.id }} .csb-shell {
      width: min(100%, 1200px);
      margin: 0 auto;
      padding: 0 20px;
    }

    #calqix-stats-bar-{{ section.id }} .csb-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      background: #ffffff;
    }

    #calqix-stats-bar-{{ section.id }} .csb-item {
      padding: 20px 18px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }

    #calqix-stats-bar-{{ section.id }} .csb-item:not(:last-child) {
      border-right: 1px solid #e5e7eb;
    }

    #calqix-stats-bar-{{ section.id }} .csb-number {
      margin: 0;
      color: #1a3b5c;
      font-family: "DM Serif Display", serif;
      font-size: 28px;
      line-height: 1;
      font-weight: 400;
    }

    #calqix-stats-bar-{{ section.id }} .csb-label {
      margin: 0;
      color: #1a3b5c;
      font-family: "DM Sans", sans-serif;
      font-size: 13px;
      line-height: 1.4;
      font-weight: 500;
    }

    #calqix-stats-bar-{{ section.id }} .csb-source {
      margin: 0;
      color: #9ca3af;
      font-family: "DM Sans", sans-serif;
      font-size: 11px;
      line-height: 1.5;
    }

    #calqix-stats-bar-{{ section.id }} .csb-link-row {
      padding-top: 14px;
      text-align: center;
    }

    #calqix-stats-bar-{{ section.id }} .csb-link {
      color: #c9a84c;
      font-family: "DM Sans", sans-serif;
      font-size: 13px;
      line-height: 1.5;
      text-decoration: none;
    }

    #calqix-stats-bar-{{ section.id }} .csb-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 639px) {
      #calqix-stats-bar-{{ section.id }} .csb-shell {
        padding: 0 12px;
      }

      #calqix-stats-bar-{{ section.id }} .csb-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #calqix-stats-bar-{{ section.id }} .csb-item {
        padding: 18px 14px;
      }

      #calqix-stats-bar-{{ section.id }} .csb-item {
        border-right: none;
      }

      #calqix-stats-bar-{{ section.id }} .csb-item:nth-child(-n + 2) {
        border-bottom: 1px solid #e5e7eb;
      }

      #calqix-stats-bar-{{ section.id }} .csb-number {
        font-size: 24px;
      }
    }
  </style>

  <div class="csb-shell">
    <div class="csb-grid">
      <article class="csb-item">
        <p class="csb-number">99.9%</p>
        <p class="csb-label">Plaque removal</p>
        <p class="csb-source">J. Clinical Dentistry, 2019</p>
      </article>
      <article class="csb-item">
        <p class="csb-number">6mm</p>
        <p class="csb-label">Subgingival reach</p>
        <p class="csb-source">Below the gumline</p>
      </article>
      <article class="csb-item">
        <p class="csb-number">51%</p>
        <p class="csb-label">Better than string floss</p>
        <p class="csb-source">Cochrane Review, 2021</p>
      </article>
      <article class="csb-item">
        <p class="csb-number">40%</p>
        <p class="csb-label">Deeper interdental cleaning</p>
        <p class="csb-source">ADA, 2020</p>
      </article>
    </div>

    <div class="csb-link-row">
      <a class="csb-link" href="/pages/about-us">View the full clinical evidence →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CALQIX Stats Bar",
  "settings": [],
  "presets": [
    {
      "name": "CALQIX Stats Bar"
    }
  ]
}
{% endschema %}
