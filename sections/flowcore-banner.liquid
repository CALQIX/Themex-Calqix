{% comment %}
  CALQIX OralBiome Pro — Homepage Banner Section v3.0
  - 5 flavour variants (Fresh Mint, Cool Mint, Wild Grapes, Peach, Citrus Orange)
  - Variant button style: photo OR colour circle (theme editor toggle)
  - Per-flavour ambient glow + thematic canvas particles (mint leaf, droplet, grape, blossom, citrus wedge)
  - English C2 / CRO copy
{% endcomment %}

{%- if section.settings.hide_on_homepage -%}
  {%- comment -%}
    Section is explicitly hidden via Theme Editor toggle. Render nothing, but
    keep the section file + schema intact so Theme Editor configuration
    (copy, images, colors) is preserved and can be restored by unchecking.
  {%- endcomment -%}
  {%- if request.design_mode -%}
    <div style="padding:24px;background:#F7F4EC;color:#1A3B5C;font-family:'DM Sans',sans-serif;border:1px dashed #C9A84C;text-align:center;">
      OralBiome Pro Banner is hidden via the section toggle. Re-enable it from the Theme Editor to display.
    </div>
  {%- endif -%}
{%- else -%}

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">

<style>
  #calqix-banner-{{ section.id }} {
    --navy: #1A3B5C;
    --white: #FFFFFF;
    position: relative;
    width: 100%;
    min-height: {{ section.settings.banner_height }}px;
    background: #0d1c2b;
    overflow: hidden;
    display: flex;
    align-items: center;
    cursor: none;
  }
  @media (max-width: 700px) {
    #calqix-banner-{{ section.id }} {
      min-height: 0;
      cursor: auto;
    }
  }

  #calqix-banner-{{ section.id }} .bg-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;
  }
  #calqix-banner-{{ section.id }} .water-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(30,100,180,0.06) 70%, rgba(10,60,120,0.18) 100%);
    z-index: 1; pointer-events: none;
  }

  /* ── DESKTOP LAYOUT ── */
  #calqix-banner-{{ section.id }} .banner-inner {
    position: relative; z-index: 3;
    width: 100%; max-width: 1100px; margin: 0 auto; padding: 60px 48px;
    display: grid;
    grid-template-columns: 1fr 440px;
    align-items: center;
  }

  /* ── MOBILE LAYOUT ── */
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .banner-inner {
      grid-template-columns: 1fr;
      padding: 44px 24px 36px;
      text-align: center;
    }
  }

  /* ============================================================
     TEXT
     ============================================================ */
  #calqix-banner-{{ section.id }} .eyebrow {
    font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(255,255,255,0.35); margin-bottom: 18px;
    display: flex; align-items: center; gap: 10px;
    opacity: 0; animation: cqFadeUp 0.6s 0.1s ease forwards;
  }
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .eyebrow { justify-content: center; }
  }
  #calqix-banner-{{ section.id }} .eyebrow-line {
    width: 32px; height: 1px; background: rgba(255,255,255,0.2); flex-shrink: 0;
  }

  #calqix-banner-{{ section.id }} .title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(34px, 5vw, 58px); color: var(--white);
    line-height: 1.08; font-weight: 400; margin-bottom: 6px;
    opacity: 0; animation: cqFadeUp 0.6s 0.18s ease forwards;
  }
  #calqix-banner-{{ section.id }} .title em {
    font-style: italic; color: rgba(120,190,255,0.7);
  }

  #calqix-banner-{{ section.id }} .subtitle {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(20px, 2.8vw, 32px); color: rgba(255,255,255,0.35);
    font-weight: 400; font-style: italic; margin-bottom: 24px;
    opacity: 0; animation: cqFadeUp 0.6s 0.26s ease forwards;
  }

  #calqix-banner-{{ section.id }} .desc {
    font-size: 15px; color: rgba(255,255,255,0.5); line-height: 1.75;
    max-width: 420px; margin-bottom: 28px;
    opacity: 0; animation: cqFadeUp 0.6s 0.34s ease forwards;
  }
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .desc { margin: 0 auto 24px; }
  }

  /* ── COLOR SWITCHER ── */
  #calqix-banner-{{ section.id }} .color-switcher {
    display: flex; gap: 10px; margin-bottom: 28px; align-items: center;
    opacity: 0; animation: cqFadeUp 0.6s 0.42s ease forwards;
  }
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .color-switcher {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    /* Buttons row inside the switcher */
    #calqix-banner-{{ section.id }} .color-switcher-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
    }
    /* Hide inline desktop label on mobile — replaced by stacked label above buttons */
    #calqix-banner-{{ section.id }} .color-name { display: none; }
    /* Show Playfair mobile name below buttons */
    #calqix-banner-{{ section.id }} .color-name-mobile { display: block; }
    /* Photo size on mobile uses its own px setting */
    #calqix-banner-{{ section.id }} .cq-btn-style--photo .color-btn {
      --cq-photo-size: {{ section.settings.photo_size_mobile | default: 56 }}px;
    }
    /* Center label above buttons */
    #calqix-banner-{{ section.id }} .sw-label {
      margin-right: 0;
      text-align: center;
    }
  }
  /* Desktop: keep the buttons row inline next to the label as before */
  @media (min-width: 861px) {
    #calqix-banner-{{ section.id }} .color-switcher-buttons {
      display: contents;
    }
  }
  #calqix-banner-{{ section.id }} .sw-label {
    font-size: 10px; font-weight: 500; letter-spacing: 0.14em;
    text-transform: uppercase; color: rgba(255,255,255,0.28); margin-right: 2px;
    white-space: nowrap;
  }
  #calqix-banner-{{ section.id }} .color-btn {
    display: block;
    width: 24px; height: 24px; min-width: 24px; min-height: 24px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.15);
    cursor: pointer; position: relative;
    flex-shrink: 0; flex-grow: 0; padding: 0; margin: 0;
    box-sizing: border-box;
    transition: transform 0.2s, opacity 0.2s, filter 0.2s, border-color 0.2s, box-shadow 0.2s;
    outline: none; appearance: none; -webkit-appearance: none;
    background-repeat: no-repeat;
  }
  /* Photo style: no background, no circle, no border, no shadow — just the image. */
  #calqix-banner-{{ section.id }} .cq-btn-style--photo .color-btn {
    --cq-photo-size: {{ section.settings.photo_size_desktop | default: 38 }}px;
    width: var(--cq-photo-size); height: var(--cq-photo-size);
    min-width: var(--cq-photo-size); min-height: var(--cq-photo-size);
    border-radius: 0;
    border: 0;
    box-shadow: none;
    background-color: transparent !important;
    background-size: contain;
    background-position: center;
    opacity: 0.55;
    filter: grayscale(20%);
  }
  #calqix-banner-{{ section.id }} .cq-btn-style--photo .color-btn:hover {
    transform: scale(1.08);
    opacity: 0.9;
    filter: none;
    border-color: transparent;
  }
  #calqix-banner-{{ section.id }} .cq-btn-style--photo .color-btn.active {
    border-color: transparent;
    transform: scale(1.1);
    opacity: 1;
    filter: none;
  }
  #calqix-banner-{{ section.id }} .cq-btn-style--photo .color-btn.active::after {
    content: none;
  }
  /* Color-circle style retains the original ring/dot affordance. */
  #calqix-banner-{{ section.id }} .cq-btn-style--color .color-btn:hover {
    transform: scale(1.15); border-color: rgba(255,255,255,0.45);
  }
  #calqix-banner-{{ section.id }} .cq-btn-style--color .color-btn.active {
    border-color: rgba(255,255,255,0.92); transform: scale(1.1);
  }
  #calqix-banner-{{ section.id }} .cq-btn-style--color .color-btn.active::after {
    content: ''; position: absolute; inset: -5px;
    border-radius: 50%; border: 1px solid rgba(255,255,255,0.25); pointer-events: none;
  }
  #calqix-banner-{{ section.id }} .color-name {
    font-size: 11px; color: rgba(255,255,255,0.4); margin-left: 8px;
    min-width: 52px; white-space: nowrap;
  }
  /* Mobile-only flavour name shown BELOW the buttons in Playfair Display. */
  #calqix-banner-{{ section.id }} .color-name-mobile {
    display: none;
    font-family: 'Playfair Display', 'DM Serif Display', Georgia, serif;
    font-style: italic;
    font-size: 22px;
    color: rgba(255,255,255,0.92);
    margin-top: 14px;
    text-align: center;
    letter-spacing: 0.01em;
  }

  /* ── SPEC PILLS ── */
  #calqix-banner-{{ section.id }} .spec-pills {
    display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px;
    opacity: 0; animation: cqFadeUp 0.6s 0.50s ease forwards;
  }
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .spec-pills { justify-content: center; }
  }
  #calqix-banner-{{ section.id }} .pill {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.055); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 3px; padding: 6px 12px;
    font-size: 11px; font-weight: 500; color: rgba(255,255,255,0.62);
    letter-spacing: 0.04em;
    /* sentence case per CRO request — no uppercasing */
    text-transform: none;
    transition:
      color 320ms cubic-bezier(0.16, 1, 0.3, 1),
      background 320ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 320ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms cubic-bezier(0.16, 1, 0.3, 1),
      text-shadow 320ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Hover glow on desktop — letters subtly luminesce in white/blue */
  @media (hover: hover) and (pointer: fine) {
    #calqix-banner-{{ section.id }} .pill:hover {
      color: #ffffff;
      background: rgba(255,255,255,0.085);
      border-color: rgba(210, 227, 255, 0.55);
      text-shadow:
        0 0 6px rgba(210, 227, 255, 0.85),
        0 0 14px rgba(120, 180, 255, 0.55),
        0 0 28px rgba(60, 130, 220, 0.35);
      box-shadow:
        0 0 0 1px rgba(210, 227, 255, 0.15) inset,
        0 4px 18px -6px rgba(120, 180, 255, 0.45);
      transform: translateY(-1px);
    }
    #calqix-banner-{{ section.id }} .pill:hover .pill-dot {
      background: rgba(210, 227, 255, 1);
      box-shadow: 0 0 8px rgba(210, 227, 255, 0.9);
    }
  }
  /* Touch glow on mobile — same effect on press */
  #calqix-banner-{{ section.id }} .pill:active,
  #calqix-banner-{{ section.id }} .pill:focus-visible {
    color: #ffffff;
    background: rgba(255,255,255,0.085);
    border-color: rgba(210, 227, 255, 0.55);
    text-shadow:
      0 0 6px rgba(210, 227, 255, 0.85),
      0 0 14px rgba(120, 180, 255, 0.55),
      0 0 28px rgba(60, 130, 220, 0.35);
    box-shadow:
      0 0 0 1px rgba(210, 227, 255, 0.15) inset,
      0 4px 18px -6px rgba(120, 180, 255, 0.45);
    outline: none;
  }
  #calqix-banner-{{ section.id }} .pill-dot {
    width: 4px; height: 4px; border-radius: 50%;
    background: rgba(100,200,255,0.7); flex-shrink: 0;
    transition: background 320ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ============================================================
     CTA ROW — op mobiel: knop links, product rechts naast elkaar
     ============================================================ */
  #calqix-banner-{{ section.id }} .cta-row {
    opacity: 0;
    animation: cqFadeUp 0.6s 0.58s ease forwards;
  }

  /* Desktop: deep-navy CTA (CALQIX brand) */
  #calqix-banner-{{ section.id }} .cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: #002549; color: #ffffff;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; font-weight: 500;
    letter-spacing: 0;
    padding: 14px 28px; border-radius: 3px; text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  #calqix-banner-{{ section.id }} .cta:hover {
    background: #003a73; transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 37, 73, 0.45);
  }
  #calqix-banner-{{ section.id }} .cta-price {
    color: #d2e3ff;
    font-weight: 600;
    letter-spacing: 0;
  }
  #calqix-banner-{{ section.id }} .cta svg { transition: transform 0.2s; }
  #calqix-banner-{{ section.id }} .cta:hover svg { transform: translateX(4px); }
  /* Hero launch offer + subscription trust copy were intentionally removed
     from the markup per CRO simplification. Styles retained as no-ops in
     case operators reintroduce the lines from a future preset. */
  #calqix-banner-{{ section.id }} .hero-launch-offer { display: none; }
  #calqix-banner-{{ section.id }} .hero-subscription-trust { display: none; }
  #calqix-banner-{{ section.id }} ._hero-legacy-style-anchor {
    margin-top: 8px;
    color: #FFFFFF;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  #calqix-banner-{{ section.id }} .cta-trust {
    margin-top: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255,255,255,0.84);
    letter-spacing: 0.01em;
    max-width: 440px;
  }

  /* ── Mobiel: product gecentreerd, knop direct eronder met lichte overlap ── */
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .cta-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      gap: 0;
    }

    #calqix-banner-{{ section.id }} .cta {
      position: relative;
      z-index: 2;
      margin-top: -20px; /* overlapt licht de onderkant van het product */
      font-family: 'DM Serif Display', Georgia, serif;
      font-style: italic;
      letter-spacing: 0;
    }
    #calqix-banner-{{ section.id }} .cta-trust {
      margin-top: 12px;
      max-width: 320px;
    }

    #calqix-banner-{{ section.id }} .mobile-product {
      position: relative;
      z-index: 1;
    }
  }

  /* ============================================================
     IMAGES — Desktop
     ============================================================ */
  #calqix-banner-{{ section.id }} .banner-images {
    position: relative; height: 540px;
    opacity: 0; animation: cqFadeUp 0.8s 0.3s ease forwards;
  }

  #calqix-banner-{{ section.id }} .device-img {
    position: absolute; right: 55px; top: 50%;
    transform: translateY(-50%); height: 430px; width: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 50px rgba(0,0,0,0.55)) drop-shadow(0 0 30px rgba(30,100,200,0.12));
    animation: cqFloat 5s ease-in-out infinite;
    z-index: 3;
    transition: opacity 0.3s ease, filter 0.4s ease, transform 0.4s ease;
    cursor: pointer;
  }
  #calqix-banner-{{ section.id }} .device-img:hover {
    filter: drop-shadow(0 28px 70px rgba(0,0,0,0.65)) drop-shadow(0 0 50px rgba(40,140,255,0.35)) drop-shadow(0 0 20px rgba(100,200,255,0.2));
    transform: translateY(-54%) scale(1.04);
    animation-play-state: paused;
  }

  #calqix-banner-{{ section.id }} .pkg-img {
    position: absolute; right: 4px; top: 50%;
    transform: translateY(-44%) rotate(4deg); height: 320px; width: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 45px rgba(0,0,0,0.45));
    opacity: 0.72; animation: cqFloatPkg 6s 0.8s ease-in-out infinite;
    z-index: 2;
    transition: opacity 0.4s ease, filter 0.4s ease, transform 0.4s ease;
    cursor: pointer;
  }
  #calqix-banner-{{ section.id }} .pkg-img:hover {
    opacity: 0.95;
    filter: drop-shadow(0 20px 60px rgba(0,0,0,0.6)) drop-shadow(0 0 30px rgba(80,160,255,0.2));
    transform: translateY(-47%) rotate(2deg) scale(1.05);
    animation-play-state: paused; z-index: 4;
  }

  #calqix-banner-{{ section.id }} .img-glow {
    position: absolute; right: 20px; bottom: 52px;
    width: 320px; height: 70px; border-radius: 50%; z-index: 0;
    animation: cqGlow 3s ease-in-out infinite; transition: background 0.5s ease;
  }

  /* ============================================================
     IMAGES — Mobiel: zweeft rechtsboven in de cta-row
     ============================================================ */
  @media (max-width: 860px) {
    /* Desktop image column verbergen */
    #calqix-banner-{{ section.id }} .banner-images {
      display: none;
    }

    /* Mobiel product — gecentreerd, zweeft boven de CTA knop */
    #calqix-banner-{{ section.id }} .mobile-product {
      display: block;
      position: relative;
      height: 210px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 12px 30px rgba(0,0,0,0.55)) drop-shadow(0 0 20px rgba(30,100,200,0.15));
      pointer-events: none;
      z-index: 1;
    }

    /* pkg hidden op mobiel */
    #calqix-banner-{{ section.id }} .mobile-pkg {
      display: none;
    }
  }

  /* Op desktop: mobile-product verbergen */
  @media (min-width: 861px) {
    #calqix-banner-{{ section.id }} .mobile-product {
      display: none;
    }
  }

  /* ============================================================
     CURSOR
     ============================================================ */
  #calqix-banner-{{ section.id }} .cursor-dot {
    position: fixed; width: 8px; height: 8px;
    background: rgba(100,200,255,0.9); border-radius: 50%;
    pointer-events: none; z-index: 9999; transform: translate(-50%,-50%);
    mix-blend-mode: screen; opacity: 0; transition: opacity 0.3s;
  }

  /* ============================================================
     KEYFRAMES
     ============================================================ */
  @keyframes cqFadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0);    }
  }
  @keyframes cqFloat {
    0%, 100% { transform: translateY(-50%); }
    50%       { transform: translateY(-53.5%); }
  }
  @keyframes cqFloatPkg {
    0%, 100% { transform: translateY(-44%) rotate(4deg); }
    50%       { transform: translateY(-47%) rotate(3deg); }
  }
  @keyframes cqGlow {
    0%, 100% { opacity: .55; transform: scaleX(1);    }
    50%       { opacity: .90; transform: scaleX(1.18); }
  }

  /* Float keyframe voor mobiel product (geen translateY offset) */
  @keyframes cqFloatMobile {
    0%, 100% { transform: translateY(0);    }
    50%       { transform: translateY(-8px); }
  }
  @media (max-width: 860px) {
    #calqix-banner-{{ section.id }} .mobile-product {
      animation: cqFloatMobile 5s ease-in-out infinite;
    }
  }
</style>

{%- comment -%} Cursor dot {%- endcomment -%}
<div class="cursor-dot" id="cq-cursor-{{ section.id }}"></div>

<div id="calqix-banner-{{ section.id }}">
  <canvas class="bg-canvas" id="cq-bg-{{ section.id }}"></canvas>
  <div class="water-overlay"></div>

  <div class="banner-inner">

    {%- comment -%} TEXT COLUMN {%- endcomment -%}
    <div class="banner-text">

      <div class="eyebrow">
        <span class="eyebrow-line"></span>
        {{ section.settings.eyebrow }}
      </div>

      <h2 class="title">
        {{ section.settings.title_line1 }}<br>
        <em>{{ section.settings.title_line2_italic }}</em>
      </h2>

      <div class="subtitle">{{ section.settings.subtitle }}</div>

      <p class="desc">{{ section.settings.description }}</p>

      {%- comment -%} VARIANT SWITCHER (photo or colour circle) {%- endcomment -%}
      {%- assign cq_btn_style = section.settings.variant_button_style | default: 'photo' -%}
      <div class="color-switcher cq-btn-style--{{ cq_btn_style }}">
        <span class="sw-label">{{ section.settings.switcher_label | default: 'Flavour' }}</span>

        <div class="color-switcher-buttons">
        {%- for i in (1..5) -%}
          {%- assign img_key   = 'img_v'   | append: i -%}
          {%- assign label_key = 'label_v' | append: i -%}
          {%- assign color_key = 'color_v' | append: i -%}
          {%- assign v_img   = section.settings[img_key]   -%}
          {%- assign v_label = section.settings[label_key] -%}
          {%- assign v_color = section.settings[color_key] -%}
          {%- if v_img != blank -%}
            {%- assign idx = forloop.index0 -%}
            <button type="button"
              class="color-btn{% if forloop.first %} active{% endif %}"
              data-index="{{ idx }}"
              style="{% if cq_btn_style == 'photo' %}background-image:url('{{ v_img | img_url: '160x' }}');{% else %}background:{{ v_color }};{% endif %}"
              title="{{ v_label }}"
              aria-label="Select {{ v_label }}"></button>
          {%- endif -%}
        {%- endfor -%}
        </div>

        <span class="color-name" id="cq-colorname-{{ section.id }}">{{ section.settings.label_v1 }}</span>
        <span class="color-name-mobile" id="cq-colorname-mobile-{{ section.id }}">{{ section.settings.label_v1 }}</span>
      </div>

      {%- comment -%} SPEC PILLS {%- endcomment -%}
      <div class="spec-pills">
        {%- for i in (1..4) -%}
          {%- assign pill_key = 'pill_' | append: i -%}
          {%- assign pill_val = section.settings[pill_key] -%}
          {%- if pill_val != blank -%}
            <span class="pill"><span class="pill-dot"></span>{{ pill_val }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%}
        CTA ROW:
        — Desktop: gewone knop
        — Mobiel: flex row → knop links, product zweeft rechts
      {%- endcomment -%}
      <div class="cta-row">

        {%- comment -%}
          Mobiel product — eerst renderen zodat het boven de knop staat.
          Alleen zichtbaar op ≤860px. JS schakelt varianten.
        {%- endcomment -%}
        {%- for i in (1..5) -%}
          {%- assign img_key   = 'img_v'   | append: i -%}
          {%- assign label_key = 'label_v' | append: i -%}
          {%- assign v_img   = section.settings[img_key]   -%}
          {%- assign v_label = section.settings[label_key] -%}
          {%- if v_img != blank -%}
            {%- assign idx = forloop.index0 -%}
            <img
              class="mobile-product cq-mobile-variant"
              data-index="{{ idx }}"
              src="{{ v_img | img_url: '600x' }}"
              alt="{{ v_label }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {% unless forloop.first %}style="display:none;"{% endunless %}
            >
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%}
          Locale-aware price: when the merchant links a `cta_product`, render
          its live price via the `money` filter so Shopify Markets shows the
          correct currency + amount per visitor (EUR for /nl, GBP for /uk,
          USD for /us, etc.). Falls back to the static `cta_price` text when
          no product is linked, preserving existing storefront behaviour.
        {%- endcomment -%}
        {%- assign cta_product_obj = section.settings.cta_product -%}
        {%- if cta_product_obj != blank and cta_product_obj.price != blank -%}
          {%- assign cta_price_html = cta_product_obj.price | money -%}
        {%- else -%}
          {%- assign cta_price_html = section.settings.cta_price -%}
        {%- endif -%}
        <a href="{{ section.settings.cta_url }}" class="cta">
          {{ section.settings.cta_label }}
          <span class="cta-price">— {{ cta_price_html }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <p class="cta-trust">{{ section.settings.trust_line }}</p>

      </div>
      {%- comment -%} /cta-row {%- endcomment -%}

    </div>
    {%- comment -%} /banner-text {%- endcomment -%}

    {%- comment -%} DESKTOP IMAGE COLUMN {%- endcomment -%}
    <div class="banner-images">
      <div class="img-glow" id="cq-glow-{{ section.id }}"></div>

      {%- if section.settings.img_pkg != blank -%}
        <img class="pkg-img"
          src="{{ section.settings.img_pkg | img_url: '800x' }}"
          alt="FlowCore packaging" loading="lazy">
      {%- endif -%}

      {%- for i in (1..5) -%}
        {%- assign img_key   = 'img_v'   | append: i -%}
        {%- assign label_key = 'label_v' | append: i -%}
        {%- assign v_img   = section.settings[img_key]   -%}
        {%- assign v_label = section.settings[label_key] -%}
        {%- if v_img != blank -%}
          {%- assign idx = forloop.index0 -%}
          <img class="device-img cq-variant{% if forloop.first %} active{% endif %}" data-index="{{ idx }}"
            src="{{ v_img | img_url: '1080x' }}"
            alt="{{ v_label }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% unless forloop.first %}style="opacity:0;pointer-events:none;"{% endunless %}>
        {%- endif -%}
      {%- endfor -%}

    </div>

  </div>
</div>

<script>
(function () {
  'use strict';

  const SID = '{{ section.id }}';

  const COLOR_NAMES = [
    '{{ section.settings.label_v1 }}',
    '{{ section.settings.label_v2 }}',
    '{{ section.settings.label_v3 }}',
    '{{ section.settings.label_v4 }}',
    '{{ section.settings.label_v5 }}'
  ];
  const GLOW_COLORS = [
    '{{ section.settings.glow_v1 | default: "rgba(123,255,219,0.22)" }}',
    '{{ section.settings.glow_v2 | default: "rgba(65,161,255,0.22)" }}',
    '{{ section.settings.glow_v3 | default: "rgba(186,120,255,0.22)" }}',
    '{{ section.settings.glow_v4 | default: "rgba(255,180,150,0.22)" }}',
    '{{ section.settings.glow_v5 | default: "rgba(255,161,53,0.22)" }}'
  ];
  /* Per-variant particle theme (mint_leaf | cool_mint_droplet | grape_cluster | peach_blossom | citrus_wedge | dot) */
  const THEMES = [
    '{{ section.settings.theme_v1 | default: "mint_leaf" }}',
    '{{ section.settings.theme_v2 | default: "cool_mint_droplet" }}',
    '{{ section.settings.theme_v3 | default: "grape_cluster" }}',
    '{{ section.settings.theme_v4 | default: "peach_blossom" }}',
    '{{ section.settings.theme_v5 | default: "citrus_wedge" }}'
  ];
  /* Particle accent colour per variant — fed to canvas drawing fns */
  const PARTICLE_COLORS = [
    '{{ section.settings.particle_color_v1 | default: "rgba(123,255,219,1)" }}',
    '{{ section.settings.particle_color_v2 | default: "rgba(150,210,255,1)" }}',
    '{{ section.settings.particle_color_v3 | default: "rgba(186,120,255,1)" }}',
    '{{ section.settings.particle_color_v4 | default: "rgba(255,180,150,1)" }}',
    '{{ section.settings.particle_color_v5 | default: "rgba(255,170,80,1)" }}'
  ];
  /* Optional GPT-generated PNG sprites (image_picker). When set, sprite is drawn instead of procedural shape. */
  const PARTICLE_SPRITES = [
    {%- if section.settings.particle_img_v1 != blank -%}'{{ section.settings.particle_img_v1 | img_url: "96x" }}'{%- else -%}''{%- endif -%},
    {%- if section.settings.particle_img_v2 != blank -%}'{{ section.settings.particle_img_v2 | img_url: "96x" }}'{%- else -%}''{%- endif -%},
    {%- if section.settings.particle_img_v3 != blank -%}'{{ section.settings.particle_img_v3 | img_url: "96x" }}'{%- else -%}''{%- endif -%},
    {%- if section.settings.particle_img_v4 != blank -%}'{{ section.settings.particle_img_v4 | img_url: "96x" }}'{%- else -%}''{%- endif -%},
    {%- if section.settings.particle_img_v5 != blank -%}'{{ section.settings.particle_img_v5 | img_url: "96x" }}'{%- else -%}''{%- endif -%}
  ];

  const glowEl          = document.getElementById('cq-glow-' + SID);
  const colorNameEl     = document.getElementById('cq-colorname-' + SID);
  const colorNameMobEl  = document.getElementById('cq-colorname-mobile-' + SID);
  const variantImgs     = document.querySelectorAll('#calqix-banner-' + SID + ' .cq-variant');
  const mobileImgs    = document.querySelectorAll('#calqix-banner-' + SID + ' .cq-mobile-variant');
  const btns          = document.querySelectorAll('#calqix-banner-' + SID + ' .color-btn');
  let currentIdx = 0;

  /* Initieel glow */
  if (glowEl) {
    glowEl.style.background = 'radial-gradient(ellipse,' + GLOW_COLORS[0] + ' 0%,transparent 70%)';
  }

  /* ── VARIANT SWITCHER ── */
  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      const idx = parseInt(btn.dataset.index);
      if (idx === currentIdx) return;

      /* Apply new particle theme + colour BEFORE fade so canvas re-tints immediately */
      applyTheme(idx);

      /* Fade out desktop variants */
      variantImgs.forEach(function (img) {
        img.style.opacity = '0';
        img.style.pointerEvents = 'none';
        img.classList.remove('active');
      });

      /* Verberg alle mobiele variants */
      mobileImgs.forEach(function (img) {
        img.style.display = 'none';
      });

      /* Update buttons */
      btns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');

      /* Update labels (desktop inline + mobile Playfair) */
      if (colorNameEl)    colorNameEl.textContent    = COLOR_NAMES[idx] || '';
      if (colorNameMobEl) colorNameMobEl.textContent = COLOR_NAMES[idx] || '';

      /* Update glow */
      if (glowEl) {
        glowEl.style.background = 'radial-gradient(ellipse,' + GLOW_COLORS[idx] + ' 0%,transparent 70%)';
      }

      currentIdx = idx;

      setTimeout(function () {
        /* Desktop */
        const target = document.querySelector(
          '#calqix-banner-' + SID + ' .cq-variant[data-index="' + idx + '"]'
        );
        if (target) {
          target.style.opacity = '1';
          target.style.pointerEvents = 'auto';
          target.classList.add('active');
        }

        /* Mobiel */
        const mTarget = document.querySelector(
          '#calqix-banner-' + SID + ' .cq-mobile-variant[data-index="' + idx + '"]'
        );
        if (mTarget) {
          mTarget.style.display = '';
        }
      }, 260);
    });
  });

  /* ============================================================
     BACKGROUND CANVAS — hex grid + particles + ripples
     ============================================================ */
  const banner   = document.getElementById('calqix-banner-' + SID);
  const bgCanvas = document.getElementById('cq-bg-' + SID);
  const cursor   = document.getElementById('cq-cursor-' + SID);

  if (!banner || !bgCanvas) return;

  const ctx = bgCanvas.getContext('2d');
  let W, H;
  let mouse = { x: -999, y: -999 };

  function resize() {
    W = bgCanvas.width  = banner.offsetWidth;
    H = bgCanvas.height = banner.offsetHeight;
  }
  resize();

  const ro = new ResizeObserver(resize);
  ro.observe(banner);

  banner.addEventListener('mousemove', function (e) {
    const r = banner.getBoundingClientRect();
    mouse.x = e.clientX - r.left;
    mouse.y = e.clientY - r.top;
    if (cursor) {
      cursor.style.left    = e.clientX + 'px';
      cursor.style.top     = e.clientY + 'px';
      cursor.style.opacity = '1';
    }
  });
  banner.addEventListener('mouseleave', function () {
    mouse.x = mouse.y = -999;
    if (cursor) cursor.style.opacity = '0';
  });

  /* Ripples */
  const ripples = [];

  setInterval(function () {
    ripples.push({
      x: W * .5 + (Math.random() - .5) * W * .6,
      y: H * .7 + (Math.random() - .5) * H * .3,
      r: 0, alpha: .18, speed: 1.4
    });
  }, 2000);

  banner.addEventListener('click', function (e) {
    const r = banner.getBoundingClientRect();
    ripples.push({
      x: e.clientX - r.left,
      y: e.clientY - r.top,
      r: 0, alpha: .32, speed: 2.2
    });
  });

  /* ── PARTICLES — theme-aware ── */
  let activeTheme = THEMES[0];
  let activeParticleColor = PARTICLE_COLORS[0];
  let activeSprite = null;
  const spriteCache = {};
  function loadSprite(src) {
    if (!src) return null;
    if (spriteCache[src]) return spriteCache[src];
    const img = new Image();
    img.src = src;
    spriteCache[src] = img;
    return img;
  }
  function applyTheme(idx) {
    activeTheme = THEMES[idx] || 'dot';
    activeParticleColor = PARTICLE_COLORS[idx] || 'rgba(120,200,255,1)';
    activeSprite = PARTICLE_SPRITES[idx] ? loadSprite(PARTICLE_SPRITES[idx]) : null;
    /* reseed particles' angle/scale to give variant a fresh feel */
    particles.forEach(function (p) {
      p.angle = Math.random() * Math.PI * 2;
      p.spin  = (Math.random() - .5) * .015;
      p.scale = .7 + Math.random() * .9;
    });
  }
  const particles = [];
  for (let i = 0; i < 56; i++) {
    particles.push({
      x: Math.random() * 1400,
      y: Math.random() * 600,
      r: Math.random() * 1.8 + .4,
      vx: (Math.random() - .5) * .35,
      vy: (Math.random() - .5) * .35,
      alpha: Math.random() * .35 + .12,
      pulse: Math.random() * Math.PI * 2,
      angle: Math.random() * Math.PI * 2,
      spin:  (Math.random() - .5) * .015,
      scale: .7 + Math.random() * .9
    });
  }
  applyTheme(0);

  /* ── shape drawers ── */
  function rgba(base, a) {
    /* base is rgba(r,g,b,1) — replace alpha */
    return base.replace(/rgba\(([^,]+),([^,]+),([^,]+),[^)]+\)/, 'rgba($1,$2,$3,' + a.toFixed(3) + ')');
  }
  function drawDot(c, x, y, r, col, a) {
    c.beginPath(); c.arc(x, y, r, 0, Math.PI * 2);
    c.fillStyle = rgba(col, a); c.fill();
  }
  function drawLeaf(c, x, y, s, ang, col, a) {
    c.save(); c.translate(x, y); c.rotate(ang);
    c.fillStyle = rgba(col, a);
    c.beginPath();
    c.moveTo(0, -s);
    c.bezierCurveTo(s * .9, -s * .6, s * .9, s * .6, 0, s);
    c.bezierCurveTo(-s * .9, s * .6, -s * .9, -s * .6, 0, -s);
    c.fill();
    /* central vein */
    c.strokeStyle = rgba(col, a * .6);
    c.lineWidth = .6;
    c.beginPath(); c.moveTo(0, -s); c.lineTo(0, s); c.stroke();
    c.restore();
  }
  function drawDroplet(c, x, y, s, col, a) {
    c.save(); c.translate(x, y);
    c.fillStyle = rgba(col, a);
    c.beginPath();
    c.moveTo(0, -s);
    c.bezierCurveTo(s * .8, -s * .2, s * .6, s, 0, s);
    c.bezierCurveTo(-s * .6, s, -s * .8, -s * .2, 0, -s);
    c.fill();
    /* highlight */
    c.fillStyle = rgba(col, a * .35);
    c.beginPath(); c.arc(-s * .25, s * .15, s * .22, 0, Math.PI * 2); c.fill();
    c.restore();
  }
  function drawGrape(c, x, y, s, col, a) {
    /* small cluster of 4 berries */
    const offs = [[0, -s * .4], [-s * .55, s * .25], [s * .55, s * .25], [0, s * .85]];
    offs.forEach(function (o) {
      c.beginPath(); c.arc(x + o[0], y + o[1], s * .55, 0, Math.PI * 2);
      c.fillStyle = rgba(col, a); c.fill();
      c.beginPath(); c.arc(x + o[0] - s * .15, y + o[1] - s * .18, s * .15, 0, Math.PI * 2);
      c.fillStyle = rgba(col, a * .4); c.fill();
    });
  }
  function drawBlossom(c, x, y, s, ang, col, a) {
    c.save(); c.translate(x, y); c.rotate(ang);
    c.fillStyle = rgba(col, a);
    for (let k = 0; k < 5; k++) {
      c.save(); c.rotate((Math.PI * 2 / 5) * k);
      c.beginPath(); c.ellipse(0, -s * .55, s * .42, s * .7, 0, 0, Math.PI * 2); c.fill();
      c.restore();
    }
    c.fillStyle = rgba(col, a * .8);
    c.beginPath(); c.arc(0, 0, s * .25, 0, Math.PI * 2); c.fill();
    c.restore();
  }
  function drawWedge(c, x, y, s, ang, col, a) {
    c.save(); c.translate(x, y); c.rotate(ang);
    c.fillStyle = rgba(col, a);
    c.beginPath();
    c.moveTo(0, 0);
    c.arc(0, 0, s, 0, Math.PI * .55, false);
    c.closePath();
    c.fill();
    /* inner ribs */
    c.strokeStyle = rgba(col, a * .6); c.lineWidth = .6;
    for (let k = 1; k <= 3; k++) {
      c.beginPath();
      c.moveTo(0, 0);
      c.lineTo(Math.cos(Math.PI * .55 * k / 4) * s, Math.sin(Math.PI * .55 * k / 4) * s);
      c.stroke();
    }
    c.restore();
  }
  function drawSprite(c, x, y, s, ang, sprite, a) {
    if (!sprite || !sprite.complete || !sprite.naturalWidth) return false;
    c.save(); c.translate(x, y); c.rotate(ang); c.globalAlpha = a;
    c.drawImage(sprite, -s, -s, s * 2, s * 2);
    c.globalAlpha = 1; c.restore();
    return true;
  }
  function drawParticle(c, p) {
    const a = p.alpha * (.7 + .3 * Math.sin(p.pulse));
    /* sprite override if provided */
    if (activeSprite && drawSprite(c, p.x, p.y, p.r * 4 * p.scale, p.angle, activeSprite, a)) return;
    const col = activeParticleColor;
    switch (activeTheme) {
      case 'mint_leaf':         drawLeaf   (c, p.x, p.y, p.r * 4.2 * p.scale, p.angle, col, a); break;
      case 'cool_mint_droplet': drawDroplet(c, p.x, p.y, p.r * 3.4 * p.scale,            col, a); break;
      case 'grape_cluster':     drawGrape  (c, p.x, p.y, p.r * 2.0 * p.scale,            col, a); break;
      case 'peach_blossom':     drawBlossom(c, p.x, p.y, p.r * 3.0 * p.scale, p.angle, col, a); break;
      case 'citrus_wedge':      drawWedge  (c, p.x, p.y, p.r * 3.6 * p.scale, p.angle, col, a); break;
      default:                  drawDot    (c, p.x, p.y, p.r * 1.4,                    col, a);
    }
  }

  /* Hex */
  const S = 34, HH = S * Math.sqrt(3);

  function hexCorner(cx, cy, i) {
    const a = Math.PI / 180 * (60 * i - 30);
    return [cx + S * Math.cos(a), cy + S * Math.sin(a)];
  }
  function drawHex(cx, cy, a) {
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const [x, y] = hexCorner(cx, cy, i);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.strokeStyle = 'rgba(80,160,255,' + a + ')';
    ctx.lineWidth   = .5;
    ctx.stroke();
  }

  let t = 0;

  (function draw() {
    requestAnimationFrame(draw);
    t += .01;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1c2b';
    ctx.fillRect(0, 0, W, H);

    /* Hex grid */
    const cols = Math.ceil(W / (S * 1.73)) + 2;
    const rows = Math.ceil(H / HH) + 2;
    for (let row = -1; row < rows; row++) {
      for (let col = -1; col < cols; col++) {
        const cx = col * S * 1.732 + (row % 2) * S * .866;
        const cy = row * HH * .75;
        const dx = cx - mouse.x, dy = cy - mouse.y;
        const d  = Math.sqrt(dx * dx + dy * dy);
        drawHex(
          cx + Math.sin(t + row * .3) * .5,
          cy + Math.cos(t + col * .3) * .5,
          d < 110 ? .04 + (1 - d / 110) * .11 : .016
        );
      }
    }

    /* Ripples */
    for (let i = ripples.length - 1; i >= 0; i--) {
      const rp = ripples[i];
      rp.r    += rp.speed;
      rp.alpha *= .975;
      ctx.beginPath();
      ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(60,160,255,' + rp.alpha + ')';
      ctx.lineWidth   = 1.2;
      ctx.stroke();
      if (rp.r > 20) {
        ctx.beginPath();
        ctx.arc(rp.x, rp.y, rp.r * .6, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(100,200,255,' + (rp.alpha * .35) + ')';
        ctx.lineWidth   = .6;
        ctx.stroke();
      }
      if (rp.r > 200 || rp.alpha < .004) ripples.splice(i, 1);
    }

    /* Particles — themed shapes float, drift, gently spin */
    particles.forEach(function (p) {
      p.x += p.vx; p.y += p.vy; p.pulse += .022; p.angle += p.spin;
      if (p.x < -20) p.x = W + 20;
      if (p.x > W + 20) p.x = -20;
      if (p.y < -20) p.y = H + 20;
      if (p.y > H + 20) p.y = -20;

      const dx = p.x - mouse.x, dy = p.y - mouse.y;
      const d  = Math.sqrt(dx * dx + dy * dy);
      if (d < 85 && d > 0) { p.x += (dx / d) * .9; p.y += (dy / d) * .9; }

      drawParticle(ctx, p);
    });
  })();

})();
</script>

{%- endif -%}{%- comment -%} end hide_on_homepage branch {%- endcomment -%}

{% schema %}
{
  "name": "OralBiome Banner",
  "tag": "section",
  "class": "calqix-flowcore-banner",
  "settings": [
    { "type": "header", "content": "Visibility" },
    {
      "type": "checkbox",
      "id": "hide_on_homepage",
      "label": "Hide this banner (keep configuration)",
      "info": "When checked, the banner renders nothing on the live site. All settings (copy, colours, images) are preserved and reappear when you uncheck.",
      "default": false
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height — desktop (px)",
      "min": 400, "max": 800, "step": 20,
      "default": 560
    },

    { "type": "header", "content": "Variant buttons" },
    {
      "type": "select",
      "id": "variant_button_style",
      "label": "Variant button style",
      "default": "photo",
      "options": [
        { "value": "photo", "label": "Product photo (no background)" },
        { "value": "color", "label": "Colour circle" }
      ]
    },
    {
      "type": "text",
      "id": "switcher_label",
      "label": "Switcher label",
      "default": "Flavour"
    },
    {
      "type": "range",
      "id": "photo_size_desktop",
      "label": "Photo size — desktop (px)",
      "min": 24, "max": 96, "step": 2,
      "default": 38,
      "unit": "px",
      "info": "Only applies when Variant button style = Product photo."
    },
    {
      "type": "range",
      "id": "photo_size_mobile",
      "label": "Photo size — mobile (px)",
      "min": 32, "max": 120, "step": 2,
      "default": 56,
      "unit": "px",
      "info": "Only applies when Variant button style = Product photo. Controls the size of the photo buttons on mobile."
    },

    { "type": "header", "content": "Copy" },
    { "type": "text",     "id": "eyebrow",            "label": "Eyebrow",                 "default": "CALQIX · OralBiome Pro" },
    { "type": "text",     "id": "title_line1",        "label": "Title line 1",            "default": "Rebalance the biome." },
    { "type": "text",     "id": "title_line2_italic", "label": "Title line 2 (italic)",   "default": "Rebuild the enamel." },
    { "type": "text",     "id": "subtitle",           "label": "Subtitle",                "default": "OralBiome Pro · Probiotic lozenges" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Most oral care destroys what protects you. OralBiome Pro restores it. Clinically studied probiotic strains crowd out the bacteria behind decay, bad breath and bleeding gums — while nano-hydroxyapatite remineralises the enamel surface they have eroded. One lozenge a day. Five flavours. Visible balance in 28 days."
    },

    { "type": "header", "content": "Trust pills (max 4)" },
