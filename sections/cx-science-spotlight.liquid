{%- comment -%}
  CALQIX Navy Rebuild — Science spotlight.
  Source: _incoming/calqix-web-upgrade/handoff/source/components/features.jsx → ScienceSpotlight
{%- endcomment -%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-science-grid" data-cx-col2>
      <div class="cx-science-media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'cx-science-img' }}
        {%- else -%}
          {% render 'cx-placeholder', on_dark: true, ratio: '4/5', label: section.settings.image_label, radius: 'var(--cx-r-lg)' %}
        {%- endif -%}
      </div>

      <div class="cx-stack cx-gap-md" data-cx-stagger>
        {% render 'cx-eyebrow', text: section.settings.eyebrow %}
        <h2 class="cx-h2">{{ section.settings.heading }}</h2>
        <div class="cx-lede">{{ section.settings.lede }}</div>

        <div class="cx-feature-accordion" data-cx-accordion>
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <div class="cx-feature-item{% if forloop.first %} cx-is-open{% endif %}" data-cx-accordion-item {{ block.shopify_attributes }}>
                <button type="button" class="cx-feature-toggle" data-cx-accordion-toggle aria-expanded="{%- if forloop.first -%}true{%- else -%}false{%- endif -%}">
                  <span class="cx-feature-toggle-left">
                    <span class="cx-feature-num">0{{ forloop.index }}</span>
                    <span class="cx-feature-title">{{ block.settings.title }}</span>
                  </span>
                  <span class="cx-feature-toggle-ic cx-feature-toggle-ic-open">{% render 'cx-icons', name: 'minus', size: 18 %}</span>
                  <span class="cx-feature-toggle-ic cx-feature-toggle-ic-closed">{% render 'cx-icons', name: 'plus', size: 18 %}</span>
                </button>
                <div class="cx-feature-body" data-cx-accordion-body{% unless forloop.first %} hidden{% endunless %}>
                  <div class="cx-feature-desc">{{ block.settings.desc }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_text != blank -%}
          {%- assign cx_btn_kind = section.settings.cta_style | default: 'inline' -%}
          {%- case cx_btn_kind -%}
            {%- when 'gold' -%}<a class="cx-btn cx-btn-gold" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- when 'navy' -%}<a class="cx-btn cx-btn-primary" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- when 'ghost' -%}<a class="cx-btn cx-btn-ghost" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
            {%- else -%}<a class="cx-btn-inline" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }} <span class="cx-arrow"></span></a>
          {%- endcase -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .cx-science-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 72px; align-items: center; }
  .cx-science-img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--cx-r-lg); }
</style>

{% schema %}
{
  "name": "CX Science Spotlight",
  "tag": "section",
  "class": "cx-section-science",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our science" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>From deep cleaning<br>to <em>real enamel repair.</em></p>" },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>Flowcore removes what your toothbrush can't reach. Nano-HA can bind directly to the freshly cleaned enamel surface. Discover the science behind every step.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "DENTAL RESEARCHER · LAB SHOT" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Discover our science" },
    { "type": "url",  "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "cta_style", "label": "Button style",
      "default": "inline",
      "options": [
        { "value": "gold",   "label": "Gold (filled)" },
        { "value": "navy",   "label": "Navy (filled)" },
        { "value": "ghost",  "label": "Outline" },
        { "value": "inline", "label": "Inline arrow" }
      ]
    },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Deep cleaning" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "1,600 pulses per minute clean plaque and bacteria far below the gumline." }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "step", "settings": { "title": "Deep cleaning",        "desc": "1,600 pulses per minute clean plaque and bacteria far below the gumline." } },
      { "type": "step", "settings": { "title": "Open up absorption",   "desc": "By removing biofilm, the enamel surface is ready to take up minerals directly." } },
      { "type": "step", "settings": { "title": "Rebuild with science", "desc": "OralBiome Pro delivers nano-hydroxyapatite through a clinically supported protocol." } }
    ]
  }
}
{% endschema %}
