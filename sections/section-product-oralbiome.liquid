      <p class="ob-ingredients__free">{{ 'calqix_oralbiome.ingredients.free_from' | t }}</p>
      <div class="ob-acc" data-ob-accordion>
        <div class="ob-acc__item">
          <button type="button" class="ob-acc__trigger" data-ob-acc-trigger>
            <span>{{ 'calqix_oralbiome.ingredients.full_list_label' | t }}</span>
