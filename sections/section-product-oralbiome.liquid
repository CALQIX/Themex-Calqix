      <h2 class="ob-cta__heading">{{ 'calqix_oralbiome.cta.heading' | t }}</h2>
      <p class="ob-cta__sub">{{ 'calqix_oralbiome.cta.subtext' | t }}</p>
      <a href="#OralBiome-{{ section.id }}" class="ob-cta__btn">{{ 'calqix_oralbiome.cta.button' | t }}</a>
    </div>
  </section>
  {%- endif -%}

</div>

<script>
  (function() {
    const section = document.getElementById('OralBiome-{{ section.id }}');
    if (!section) return;

    /* ── Quantity selector ── */
    const qtyInput = section.querySelector('[data-ob-qty-input]');
    const qtyMinus = section.querySelector('[data-ob-qty-minus]');
    const qtyPlus  = section.querySelector('[data-ob-qty-plus]');
    if (qtyMinus) qtyMinus.addEventListener('click', () => {
      const v = parseInt(qtyInput.value, 10);
      if (v > 1) qtyInput.value = v - 1;
    });
    if (qtyPlus) qtyPlus.addEventListener('click', () => {
      const v = parseInt(qtyInput.value, 10);
      if (v < 10) qtyInput.value = v + 1;
    });

    /* ── Subscription plan toggle ── */
    const planToggle = section.querySelector('[data-ob-plan-toggle]');
    if (planToggle) {
      const options = planToggle.querySelectorAll('.ob-plan-option');
      const atcBtn  = section.querySelector('[data-ob-atc]');
      options.forEach(opt => {
        opt.addEventListener('click', () => {
          options.forEach(o => o.classList.remove('ob-plan-option--active'));
          opt.classList.add('ob-plan-option--active');
          const radio = opt.querySelector('input');
          radio.checked = true;
          const isSub = radio.value === 'subscribe';
          if (atcBtn) {
            atcBtn.dataset.usePlan = isSub ? 'true' : 'false';
          }
          const priceEl = section.querySelector('[data-ob-price]');
          if (priceEl) {
            const subPrice  = priceEl.querySelector('[data-ob-price-sub]');
            const oncePrice = priceEl.querySelector('[data-ob-price-once]');
            if (subPrice && oncePrice) {
              if (isSub) {
                subPrice.style.display = ''; oncePrice.style.textDecoration = 'line-through';
                subPrice.style.order = '-1';
              } else {
                oncePrice.style.textDecoration = 'none'; oncePrice.style.order = '-1';
                subPrice.style.display = 'none';
              }
            }
          }
        });
      });
    }

    /* ── AJAX Add to Cart ── */
    const atcBtn = section.querySelector('[data-ob-atc]');
    if (atcBtn) {
      atcBtn.addEventListener('click', async () => {
        if (atcBtn.disabled || atcBtn.classList.contains('ob-hero__atc--loading')) return;
        atcBtn.classList.add('ob-hero__atc--loading');
        const qty = parseInt(qtyInput ? qtyInput.value : 1, 10);
        const body = {
          id: parseInt(atcBtn.dataset.variantId, 10),
          quantity: qty
        };
        const usePlan = atcBtn.dataset.usePlan !== 'false';
        const planId = atcBtn.dataset.sellingPlanId;
        if (usePlan && planId) body.selling_plan = parseInt(planId, 10);
        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(body)
          });
          if (!res.ok) throw new Error('Cart error');
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          const drawerToggle = document.querySelector('[data-cart-toggle]') || document.querySelector('.js-cart-toggle');
          if (drawerToggle) drawerToggle.click();
        } catch (e) {
          console.error('[OralBiome] Add to cart failed:', e);
        } finally {
          atcBtn.classList.remove('ob-hero__atc--loading');
        }
      });
    }

    /* ── Accordions ── */
    section.querySelectorAll('[data-ob-acc-trigger]').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const content = trigger.nextElementSibling;
        const isOpen = trigger.classList.contains('ob-acc__trigger--open');
        trigger.classList.toggle('ob-acc__trigger--open');
        content.classList.toggle('ob-acc__content--open');
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
        } else {
          content.style.maxHeight = '0';
        }
      });
    });

    /* ── Strain detail toggles ── */
    section.querySelectorAll('[data-ob-strain-toggle]').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const detail = toggle.nextElementSibling;
        const isOpen = toggle.classList.contains('ob-strain__toggle--open');
        toggle.classList.toggle('ob-strain__toggle--open');
        detail.classList.toggle('ob-strain__detail--open');
        if (!isOpen) {
          detail.style.maxHeight = detail.scrollHeight + 'px';
        } else {
          detail.style.maxHeight = '0';
        }
      });
    });

    /* ── Smooth scroll for CTA ── */
    section.querySelectorAll('.ob-cta__btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>

