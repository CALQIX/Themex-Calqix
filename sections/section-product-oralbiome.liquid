{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_plan_group = product.selling_plan_groups | first
  assign first_plan = first_plan_group.selling_plans | first
  assign has_selling_plan = false
  if first_plan
    assign has_selling_plan = true
  endif
-%}

<style>
  /* ══════════════════════════════════════════════
     OralBiome Pro — Variables & Reset
     ══════════════════════════════════════════════ */
  .ob {
    --ob-navy: {{ section.settings.color_primary | default: '#1A3B5C' }};
    --ob-navy-deep: #0f2438;
    --ob-navy-light: #2e5a7d;
    --ob-gold: {{ section.settings.color_accent | default: '#C9A84C' }};
    --ob-gold-light: #e8c96a;
    --ob-bg: {{ section.settings.color_background | default: '#F4F5F7' }};
    --ob-white: #ffffff;
    --ob-gray: #9b9b9b;
    --ob-gray-light: #e4e4e0;
    --ob-red: #dc3545;
    --ob-green: #3ed660;
    --ob-font-heading: "DM Serif Display", serif;
    --ob-font-body: "DM Sans", sans-serif;
    --ob-radius: 8px;
    --ob-container: 1200px;
    font-family: var(--ob-font-body);
    color: var(--ob-navy);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .ob *, .ob *::before, .ob *::after { box-sizing: border-box; }
  .ob img { max-width: 100%; height: auto; display: block; }
  .ob__container { max-width: var(--ob-container); margin: 0 auto; padding: 0 20px; }

  /* ══════════════════════════════════════════════
     1. HERO
     ══════════════════════════════════════════════ */
  .ob-hero { background: var(--ob-white); padding: 40px 0; }
  .ob-hero__inner { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: start; }
  @media (min-width: 768px) {
    .ob-hero__inner { grid-template-columns: 3fr 2fr; gap: 48px; }
  }
  .ob-hero__media { position: relative; border-radius: var(--ob-radius); overflow: hidden; background: var(--ob-bg); }
  .ob-hero__media img { width: 100%; aspect-ratio: 1/1; object-fit: cover; }
  .ob-hero__info { display: flex; flex-direction: column; gap: 16px; }
  .ob-hero__title {
    font-family: var(--ob-font-heading);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.15;
    margin: 0;
    color: var(--ob-navy);
  }
  .ob-hero__subtitle {
    font-size: 14px;
    color: var(--ob-gray);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0;
  }

  /* Rating */
  .ob-hero__rating { display: flex; align-items: center; gap: 8px; }
  .ob-hero__stars { display: flex; gap: 2px; color: var(--ob-gold); }
  .ob-hero__stars svg { width: 16px; height: 16px; fill: currentColor; }
  .ob-hero__rating-text { font-size: 13px; color: var(--ob-gray); }

  /* Price */
  .ob-hero__price { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ob-hero__price-current {
    font-family: var(--ob-font-heading);
    font-size: 32px;
    color: var(--ob-navy);
    line-height: 1;
  }
  .ob-hero__price-compare {
    font-size: 18px;
    color: var(--ob-gray);
    text-decoration: line-through;
  }
  .ob-hero__price-per { font-size: 13px; color: var(--ob-gray); }

  /* Subscription toggle */
  .ob-plan-toggle { display: flex; flex-direction: column; gap: 8px; }
  .ob-plan-option {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border: 2px solid var(--ob-gray-light);
    border-radius: var(--ob-radius); cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }
  .ob-plan-option:hover { border-color: var(--ob-navy-light); }
  .ob-plan-option--active { border-color: var(--ob-gold); background: rgba(201,168,76,0.05); }
  .ob-plan-option input { position: absolute; opacity: 0; pointer-events: none; }
  .ob-plan-option__radio {
    width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--ob-gray-light);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    transition: border-color 0.2s;
  }
  .ob-plan-option--active .ob-plan-option__radio { border-color: var(--ob-gold); }
  .ob-plan-option--active .ob-plan-option__radio::after {
    content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--ob-gold);
  }
  .ob-plan-option__label { font-size: 14px; font-weight: 600; flex: 1; }
  .ob-plan-option__price { font-size: 14px; font-weight: 600; color: var(--ob-navy); }
  .ob-plan-option__badge {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    background: var(--ob-gold); color: var(--ob-white); padding: 3px 8px; border-radius: 4px;
  }

  /* Quantity */
  .ob-hero__qty { display: flex; align-items: center; gap: 12px; }
  .ob-hero__qty-label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .ob-qty {
    display: flex; align-items: center; border: 1px solid var(--ob-gray-light);
    border-radius: var(--ob-radius); overflow: hidden;
  }
  .ob-qty__btn {
    width: 40px; height: 40px; border: none; background: none; cursor: pointer;
    font-size: 18px; color: var(--ob-navy); display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .ob-qty__btn:hover { background: var(--ob-bg); }
  .ob-qty__input {
    width: 44px; height: 40px; text-align: center; border: none; border-left: 1px solid var(--ob-gray-light);
    border-right: 1px solid var(--ob-gray-light); font-size: 15px; font-weight: 600;
    font-family: var(--ob-font-body); color: var(--ob-navy); background: none; outline: none;
    -moz-appearance: textfield;
  }
  .ob-qty__input::-webkit-inner-spin-button,
  .ob-qty__input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  /* ATC */
  @keyframes ob-shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  .ob-hero__atc {
    width: 100%; height: 54px; border: none; border-radius: var(--ob-radius);
    background: var(--ob-gold); color: var(--ob-navy);
    font-family: var(--ob-font-body); font-size: 14px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;
    position: relative; overflow: hidden; transition: transform 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .ob-hero__atc:hover {
    transform: scale(1.015);
    background: linear-gradient(90deg, var(--ob-gold) 0%, var(--ob-gold-light) 40%, var(--ob-gold) 80%);
    background-size: 200% 100%;
    animation: ob-shimmer 1.5s ease-in-out infinite;
  }
  .ob-hero__atc:active { transform: scale(0.98); }
  .ob-hero__atc:disabled { opacity: 0.5; cursor: not-allowed; transform: none; animation: none; }
  .ob-hero__atc-loader {
    display: none; width: 20px; height: 20px; border: 2px solid rgba(26,59,92,0.2);
    border-top-color: var(--ob-navy); border-radius: 50%;
    animation: ob-spin 0.6s linear infinite;
  }
  @keyframes ob-spin { to { transform: rotate(360deg); } }
  .ob-hero__atc--loading .ob-hero__atc-loader { display: block; }
  .ob-hero__atc--loading .ob-hero__atc-text { display: none; }

  /* Trust badges */
  .ob-hero__trust {
    display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px;
    border-top: 1px solid var(--ob-gray-light); margin-top: 4px;
  }
  .ob-hero__trust-item {
    display: flex; align-items: center; gap: 6px; font-size: 12px;
    font-weight: 500; color: var(--ob-navy); letter-spacing: 0.02em;
  }
  .ob-hero__trust-item svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--ob-green); }

  /* ══════════════════════════════════════════════
     2. HOW IT WORKS
     ══════════════════════════════════════════════ */
  .ob-steps { background: var(--ob-navy); color: var(--ob-white); padding: 72px 0; }
  .ob-steps__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 3.5vw, 36px);
    text-align: center; margin: 0 0 48px; color: var(--ob-white);
  }
  .ob-steps__grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  @media (min-width: 768px) { .ob-steps__grid { grid-template-columns: repeat(3, 1fr); } }
  .ob-step { text-align: center; }
  .ob-step__icon {
    width: 72px; height: 72px; margin: 0 auto 20px; border-radius: 50%;
    background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center;
  }
  .ob-step__icon svg { width: 32px; height: 32px; color: var(--ob-gold); }
  .ob-step__num {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ob-gold); margin-bottom: 8px;
  }
  .ob-step__title { font-family: var(--ob-font-heading); font-size: 20px; margin: 0 0 8px; }
  .ob-step__text { font-size: 14px; color: rgba(255,255,255,0.7); max-width: 280px; margin: 0 auto; line-height: 1.6; }

  /* ══════════════════════════════════════════════
     3. SCIENCE
     ══════════════════════════════════════════════ */
  .ob-science { background: var(--ob-bg); padding: 72px 0; }
  .ob-science__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 3.5vw, 36px);
    text-align: center; margin: 0 0 48px;
  }
  .ob-science__grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 600px) { .ob-science__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .ob-science__grid { grid-template-columns: repeat(4, 1fr); } }
  .ob-strain {
    background: var(--ob-white); border: 1px solid var(--ob-gray-light);
    border-radius: var(--ob-radius); padding: 28px 24px;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .ob-strain:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(26,59,92,0.08); }
  .ob-strain__icon {
    width: 48px; height: 48px; border-radius: 50%; margin-bottom: 16px;
    background: rgba(201,168,76,0.1); display: flex; align-items: center; justify-content: center;
  }
  .ob-strain__icon svg { width: 24px; height: 24px; color: var(--ob-gold); }
  .ob-strain__name { font-family: var(--ob-font-heading); font-size: 18px; margin: 0 0 4px; }
  .ob-strain__cfu { font-size: 11px; font-weight: 600; color: var(--ob-gold); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; }
  .ob-strain__benefit { font-size: 14px; color: var(--ob-gray); line-height: 1.5; margin: 0 0 16px; }
  .ob-strain__toggle {
    font-size: 13px; font-weight: 600; color: var(--ob-navy); cursor: pointer;
    background: none; border: none; padding: 0; display: flex; align-items: center; gap: 4px;
    font-family: var(--ob-font-body);
  }
  .ob-strain__toggle svg { width: 14px; height: 14px; transition: transform 0.25s; }
  .ob-strain__toggle--open svg { transform: rotate(180deg); }
  .ob-strain__detail {
    max-height: 0; overflow: hidden; transition: max-height 0.35s ease;
    font-size: 13px; color: var(--ob-gray); line-height: 1.6;
  }
  .ob-strain__detail--open { max-height: 200px; padding-top: 12px; }

  /* ══════════════════════════════════════════════
     4. COMPARISON
     ══════════════════════════════════════════════ */
  .ob-compare { background: var(--ob-white); padding: 72px 0; }
  .ob-compare__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 3.5vw, 36px);
    text-align: center; margin: 0 0 48px;
  }
  .ob-compare__table {
    width: 100%; max-width: 800px; margin: 0 auto; border-collapse: collapse;
    border-radius: var(--ob-radius); overflow: hidden;
    border: 1px solid var(--ob-gray-light);
  }
  .ob-compare__table th, .ob-compare__table td { padding: 16px 20px; text-align: left; font-size: 14px; }
  .ob-compare__table thead th {
    background: var(--ob-navy); color: var(--ob-white); font-weight: 600;
    font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ob-compare__table thead th:first-child { background: var(--ob-navy); }
  .ob-compare__table thead th:last-child { background: var(--ob-gold); color: var(--ob-navy); }
  .ob-compare__table tbody tr { border-bottom: 1px solid var(--ob-gray-light); }
  .ob-compare__table tbody tr:last-child { border-bottom: none; }
  .ob-compare__table tbody td { vertical-align: middle; }
  .ob-compare__table tbody td:first-child { color: var(--ob-gray); }
  .ob-compare__table tbody td:last-child { color: var(--ob-navy); font-weight: 500; }
  .ob-compare__icon { display: inline-flex; align-items: center; gap: 8px; }
  .ob-compare__icon svg { width: 18px; height: 18px; flex-shrink: 0; }
  .ob-compare__icon--x svg { color: var(--ob-red); }
  .ob-compare__icon--check svg { color: var(--ob-green); }
  @media (max-width: 600px) {
    .ob-compare__table th, .ob-compare__table td { padding: 12px 14px; font-size: 13px; }
  }

  /* ══════════════════════════════════════════════
     5. INGREDIENTS
     ══════════════════════════════════════════════ */
  .ob-ingredients { background: var(--ob-bg); padding: 72px 0; }
  .ob-ingredients__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 3.5vw, 36px);
    text-align: center; margin: 0 0 16px;
  }
  .ob-ingredients__free {
    text-align: center; font-size: 14px; color: var(--ob-green); font-weight: 600;
    margin: 0 0 32px;
  }
  .ob-acc { max-width: 800px; margin: 0 auto; }
  .ob-acc__item { border-bottom: 1px solid var(--ob-gray-light); }
  .ob-acc__trigger {
    width: 100%; background: none; border: none; padding: 20px 0; display: flex;
    align-items: center; justify-content: space-between; cursor: pointer;
    font-family: var(--ob-font-body); font-size: 15px; font-weight: 600; color: var(--ob-navy);
    text-align: left;
  }
  .ob-acc__trigger svg {
    width: 18px; height: 18px; color: var(--ob-gold); transition: transform 0.25s; flex-shrink: 0;
  }
  .ob-acc__trigger--open svg { transform: rotate(45deg); }
  .ob-acc__content {
    max-height: 0; overflow: hidden; transition: max-height 0.35s ease;
    font-size: 14px; color: var(--ob-gray); line-height: 1.7;
  }
  .ob-acc__content--open { max-height: 500px; padding-bottom: 20px; }

  /* ══════════════════════════════════════════════
     6. REVIEWS
     ══════════════════════════════════════════════ */
  .ob-reviews { background: var(--ob-white); padding: 72px 0; }
  .ob-reviews__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 3.5vw, 36px);
    text-align: center; margin: 0 0 32px;
  }
  .ob-reviews__empty {
    text-align: center; padding: 48px 20px;
    background: var(--ob-bg); border-radius: var(--ob-radius); max-width: 600px; margin: 0 auto;
  }
  .ob-reviews__empty p { font-size: 15px; color: var(--ob-gray); margin: 0 0 20px; }
  .ob-reviews__empty-cta {
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px;
    border: 2px solid var(--ob-navy); border-radius: var(--ob-radius);
    background: none; color: var(--ob-navy); font-family: var(--ob-font-body);
    font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    cursor: pointer; transition: background 0.2s, color 0.2s; text-decoration: none;
  }
  .ob-reviews__empty-cta:hover { background: var(--ob-navy); color: var(--ob-white); }

  /* ══════════════════════════════════════════════
     7. FAQ
     ══════════════════════════════════════════════ */
  .ob-faq { background: var(--ob-bg); padding: 72px 0; }
  .ob-faq__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 3.5vw, 36px);
    text-align: center; margin: 0 0 48px;
  }

  /* ══════════════════════════════════════════════
     8. SUBSCRIPTION CTA
     ══════════════════════════════════════════════ */
  .ob-cta {
    background: var(--ob-navy); color: var(--ob-white); padding: 72px 0; text-align: center;
  }
  .ob-cta__heading {
    font-family: var(--ob-font-heading); font-size: clamp(26px, 4vw, 40px);
    margin: 0 0 12px; color: var(--ob-white);
  }
  .ob-cta__sub { font-size: 16px; color: rgba(255,255,255,0.65); margin: 0 0 32px; }
  .ob-cta__btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 16px 40px; border: none; border-radius: var(--ob-radius);
    background: var(--ob-gold); color: var(--ob-navy);
    font-family: var(--ob-font-body); font-size: 14px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;
    transition: transform 0.2s; text-decoration: none;
  }
  .ob-cta__btn:hover { transform: scale(1.03); }

  /* ══════════════════════════════════════════════
     Utilities
     ══════════════════════════════════════════════ */
  .ob-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); border: 0;
  }
</style>

<div id="OralBiome-{{ section.id }}" class="ob" data-section-id="{{ section.id }}">

  {%- comment -%} ═══ 1. HERO ═══ {%- endcomment -%}
  <section class="ob-hero">
    <div class="ob__container ob-hero__inner">
      <div class="ob-hero__media">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 900 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 768px) 60vw, 100vw',
            widths: '400, 600, 900, 1200',
            alt: product.title
          }}
        {%- elsif section.settings.hero_image_override -%}
          {{ section.settings.hero_image_override | image_url: width: 900 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 768px) 60vw, 100vw',
            widths: '400, 600, 900, 1200',
            alt: product.title
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'ob-hero__placeholder' }}
        {%- endif -%}
      </div>

      <div class="ob-hero__info">
        <h1 class="ob-hero__title">{{ 'calqix_oralbiome.hero.title' | t }}</h1>
        <p class="ob-hero__subtitle">{{ 'calqix_oralbiome.hero.subtitle' | t }}</p>

        <div class="ob-hero__rating">
          <div class="ob-hero__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20"><path d="M10 15.27L16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z"/></svg>
            {%- endfor -%}
          </div>
          <span class="ob-hero__rating-text">4.8 — {{ 'calqix_oralbiome.hero.rating_text' | t }}</span>
        </div>

        <div class="ob-hero__price" data-ob-price>
          {%- if has_selling_plan -%}
            <span class="ob-hero__price-current" data-ob-price-sub>{{ first_plan.price | money }}</span>
            <span class="ob-hero__price-compare" data-ob-price-once>{{ current_variant.price | money }}</span>
            <span class="ob-hero__price-per">{{ 'calqix_oralbiome.hero.per_month' | t }}</span>
          {%- else -%}
            <span class="ob-hero__price-current">{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="ob-hero__price-compare">{{ current_variant.compare_at_price | money }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if has_selling_plan -%}
          <div class="ob-plan-toggle" data-ob-plan-toggle>
            <label class="ob-plan-option" data-ob-plan="subscribe">
              <input type="radio" name="ob_plan" value="subscribe">
              <span class="ob-plan-option__radio"></span>
              <span class="ob-plan-option__label">{{ 'calqix_oralbiome.hero.subscribe_label' | t }}</span>
              <span class="ob-plan-option__badge">-20%</span>
              <span class="ob-plan-option__price">{{ first_plan.price | money }}</span>
            </label>
            <label class="ob-plan-option ob-plan-option--active" data-ob-plan="onetime">
              <input type="radio" name="ob_plan" value="onetime" checked>
              <span class="ob-plan-option__radio"></span>
              <span class="ob-plan-option__label">{{ 'calqix_oralbiome.hero.onetime_label' | t }}</span>
              <span class="ob-plan-option__price">{{ current_variant.price | money }}</span>
            </label>
          </div>
        {%- endif -%}

        <div class="ob-hero__qty">
          <span class="ob-hero__qty-label">{{ 'calqix_oralbiome.hero.qty_label' | t }}</span>
          <div class="ob-qty">
            <button type="button" class="ob-qty__btn" data-ob-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" class="ob-qty__input" value="1" min="1" max="10" data-ob-qty-input aria-label="Quantity">
            <button type="button" class="ob-qty__btn" data-ob-qty-plus aria-label="Increase quantity">+</button>
          </div>
        </div>

        <button
          type="button"
          class="ob-hero__atc"
          data-ob-atc
          data-variant-id="{{ current_variant.id }}"
          data-selling-plan-id="{{ first_plan.id | default: '' }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span class="ob-hero__atc-text">
            {%- if current_variant.available -%}
              {{ 'calqix_oralbiome.hero.add_to_cart' | t }}
            {%- else -%}
              {{ 'calqix_oralbiome.hero.sold_out' | t }}
            {%- endif -%}
          </span>
          <span class="ob-hero__atc-loader"></span>
        </button>

        <div class="ob-hero__trust">
          <span class="ob-hero__trust-item">
