<style>
  /* ── Section wrapper ── */
  .oralbiome-faq { background: #F4F5F7; padding: 48px 16px; }
  .oralbiome-faq__container { max-width: 780px; margin: 0 auto; }

  /* ── Header ── */
  .oralbiome-faq__eyebrow { display: block; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 3px; color: #C9A84C; text-align: center; margin: 0 0 12px; }
  .oralbiome-faq__heading { font-family: 'DM Serif Display', serif; font-size: 28px; color: #1A3B5C; text-align: center; margin: 0 0 16px; line-height: 1.3; }
  .oralbiome-faq__subheading { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #6B7280; text-align: center; margin: 0 auto 48px; max-width: 520px; line-height: 1.7; }
  .oralbiome-faq__subheading a { color: #C9A84C; text-decoration: none; }
  .oralbiome-faq__subheading a:hover { text-decoration: underline; }

  /* ── Filter pills ── */
  .oralbiome-faq__filters { display: flex; justify-content: center; gap: 8px; margin-bottom: 32px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; flex-wrap: nowrap; padding-bottom: 4px; }
  .oralbiome-faq__filters::-webkit-scrollbar { display: none; }
  .faq-filter-btn { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; padding: 8px 20px; border: 1px solid #E5E7EB; border-radius: 50px; background: #fff; color: #6B7280; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; flex-shrink: 0; }
  .faq-filter-btn:hover { border-color: #1A3B5C; background: #1A3B5C; color: #fff; }
  .faq-filter-btn.is-active { background: #1A3B5C; color: #fff; border-color: #1A3B5C; }

  /* ── Accordion items ── */
  .faq-item { position: relative; background: #fff; border: 1px solid #E5E7EB; border-radius: 8px; margin-bottom: 12px; overflow: hidden; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  .faq-item:hover { border-color: rgba(201, 168, 76, 0.3); background: #1A3B5C; }
  .faq-item:hover .faq-question { color: #fff; }
  .faq-item:hover .faq-number { color: #fff; opacity: 0.6; }

  /* Gold left accent bar on open */
  .faq-item.is-open { border-color: #C9A84C; box-shadow: 0 2px 16px rgba(201, 168, 76, 0.08); }
  .faq-item.is-open::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #C9A84C; border-radius: 3px 0 0 3px; }

  /* Trigger button */
  .faq-trigger { display: flex; align-items: center; gap: 16px; width: 100%; padding: 20px 24px; background: none; border: none; cursor: pointer; text-align: left; font-family: 'DM Sans', sans-serif; min-height: 56px; position: relative; overflow: hidden; }
  .faq-trigger:focus-visible { outline: 2px solid #C9A84C; outline-offset: -2px; border-radius: 8px; }

  /* Number */
  .faq-number { font-family: 'DM Serif Display', serif; font-size: 14px; color: #C9A84C; opacity: 0.4; min-width: 24px; transition: opacity 0.3s ease; }
  .faq-item.is-open .faq-number { opacity: 1; }

  /* Question text */
  .faq-question { flex: 1; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; color: #1A3B5C; line-height: 1.4; }

  /* Plus/minus icon */
  .faq-icon { position: relative; width: 20px; height: 20px; flex-shrink: 0; }
  .faq-icon__line-h, .faq-icon__line-v { position: absolute; top: 0; left: 0; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease; }
  .faq-item.is-open .faq-icon__line-v { transform: rotate(90deg); opacity: 0; }

  /* Clinical pulse on open */
  .faq-item.is-open .faq-trigger::after { content: ''; position: absolute; top: 50%; right: 24px; width: 20px; height: 20px; border-radius: 50%; background: rgba(201, 168, 76, 0.15); transform: translate(50%, -50%) scale(0); animation: obFaqPulse 0.6s cubic-bezier(0, 0, 0.2, 1) forwards; pointer-events: none; }
  @keyframes obFaqPulse {
    0% { transform: translate(50%, -50%) scale(0); opacity: 1; }
    100% { transform: translate(50%, -50%) scale(4); opacity: 0; }
  }

  /* Answer panel */
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  .faq-answer__inner { padding: 0 24px 24px 64px; font-family: 'DM Sans', sans-serif; font-size: 14px; color: #6B7280; line-height: 1.7; }
  .faq-answer__inner p { margin: 0; }

  /* ── Entrance animation ── */
  .faq-item[data-animate] { opacity: 0; transform: translateY(12px); transition: opacity 0.5s ease-out, transform 0.5s ease-out, border-color 0.3s ease, box-shadow 0.3s ease; }
  .faq-item[data-animate].is-visible { opacity: 1; transform: translateY(0); }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    .oralbiome-faq { padding: 80px 0; }
    .oralbiome-faq__heading { font-size: 36px; }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .faq-trigger { padding: 16px; gap: 12px; }
    .faq-number { display: none; }
    .faq-question { font-size: 14px; }
    .faq-answer__inner { padding: 0 16px 20px 16px; font-size: 13px; }
    .faq-item { margin-bottom: 8px; border-radius: 6px; }
  }
</style>

{%- assign _ob_lang = request.locale.iso_code | downcase | slice: 0, 2 -%}
{%- assign _ob_faq_translated = false -%}
{%- if _ob_lang == 'nl' or _ob_lang == 'de' or _ob_lang == 'fr' -%}
  {%- assign _ob_faq_translated = true -%}
{%- endif -%}

{%- assign _ob_faq_eyebrow = section.settings.eyebrow -%}
{%- assign _ob_faq_heading = section.settings.heading -%}
{%- assign _ob_faq_subheading = section.settings.subheading -%}
{%- if _ob_faq_translated -%}
  {%- assign _ob_faq_eyebrow = 'calqix_oralbiome.faq.eyebrow' | t -%}
  {%- assign _ob_faq_heading = 'calqix_oralbiome.faq.heading' | t -%}
  {%- assign _ob_faq_subheading = 'calqix_oralbiome.faq.subheading' | t -%}
{%- endif -%}

<section class="oralbiome-faq" data-section-id="{{ section.id }}">
  <div class="oralbiome-faq__container">
    {%- if _ob_faq_eyebrow != blank -%}
      <span class="oralbiome-faq__eyebrow">{{ _ob_faq_eyebrow }}</span>
    {%- endif -%}
    <h2 class="oralbiome-faq__heading">{{ _ob_faq_heading }}</h2>
    {%- if _ob_faq_subheading != blank -%}
      <div class="oralbiome-faq__subheading">{{ _ob_faq_subheading }}</div>
    {%- endif -%}

    <div class="oralbiome-faq__filters">
      <button class="faq-filter-btn is-active" data-category="all" type="button">{{ 'calqix_oralbiome.faq.filter_all' | t | default: 'Alle' }}</button>
      <button class="faq-filter-btn" data-category="product" type="button">{{ 'calqix_oralbiome.faq.filter_product' | t | default: 'Product' }}</button>
      <button class="faq-filter-btn" data-category="usage" type="button">{{ 'calqix_oralbiome.faq.filter_usage' | t | default: 'Gebruik' }}</button>
      <button class="faq-filter-btn" data-category="subscription" type="button">{{ 'calqix_oralbiome.faq.filter_subscription' | t | default: 'Abonnement' }}</button>
    </div>

    <div class="oralbiome-faq__list">
      {%- for block in section.blocks -%}
          <div class="faq-item"
               data-category="{{ block.settings.category }}"
               data-animate
               style="transition-delay: {{ forloop.index0 | times: 0.06 }}s"
               {{ block.shopify_attributes }}>
            <button class="faq-trigger"
                    type="button"
                    aria-expanded="false"
                    aria-controls="faq-answer-{{ section.id }}-{{ forloop.index }}">
              <span class="faq-number">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span>
              {%- if _ob_faq_translated -%}
                {%- assign _ob_faq_qkey = 'calqix_oralbiome.faq.q' | append: forloop.index -%}
                {%- assign _ob_faq_q = _ob_faq_qkey | t -%}
                {%- if _ob_faq_q == _ob_faq_qkey -%}{%- assign _ob_faq_q = block.settings.question -%}{%- endif -%}
              {%- else -%}
                {%- assign _ob_faq_q = block.settings.question -%}
              {%- endif -%}
              <span class="faq-question">{{ _ob_faq_q }}</span>
              <span class="faq-icon">
                <svg class="faq-icon__line-h" width="20" height="20" viewBox="0 0 20 20"><line x1="4" y1="10" x2="16" y2="10" stroke="#C9A84C" stroke-width="2" stroke-linecap="round"/></svg>
                <svg class="faq-icon__line-v" width="20" height="20" viewBox="0 0 20 20"><line x1="10" y1="4" x2="10" y2="16" stroke="#C9A84C" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="faq-answer" id="faq-answer-{{ section.id }}-{{ forloop.index }}">
              {%- if _ob_faq_translated -%}
                {%- assign _ob_faq_akey = 'calqix_oralbiome.faq.a' | append: forloop.index -%}
                {%- assign _ob_faq_a = _ob_faq_akey | t -%}
                {%- if _ob_faq_a == _ob_faq_akey -%}{%- assign _ob_faq_a = block.settings.answer -%}{%- endif -%}
              {%- else -%}
                {%- assign _ob_faq_a = block.settings.answer -%}
              {%- endif -%}
              <div class="faq-answer__inner">{{ _ob_faq_a }}</div>
            </div>
          </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function() {
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;

  var items = section.querySelectorAll('.faq-item');
  var filterBtns = section.querySelectorAll('.faq-filter-btn');

  /* ── Accordion toggle (single-open) ── */
  items.forEach(function(item) {
    var trigger = item.querySelector('.faq-trigger');
    var answer = item.querySelector('.faq-answer');
    var inner = item.querySelector('.faq-answer__inner');

    trigger.addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');

      items.forEach(function(other) {
        if (other !== item && other.classList.contains('is-open')) {
          other.classList.remove('is-open');
          other.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
          other.querySelector('.faq-answer').style.maxHeight = '0px';
        }
      });

      if (isOpen) {
        item.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        answer.style.maxHeight = '0px';
      } else {
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = inner.scrollHeight + 24 + 'px';
      }
    });
  });

  /* ── Category filter ── */
  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filterBtns.forEach(function(b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var cat = btn.dataset.category;

      items.forEach(function(item) {
        item.classList.remove('is-open');
        item.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
        item.querySelector('.faq-answer').style.maxHeight = '0px';

        if (cat === 'all' || item.dataset.category === cat) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  /* ── Scroll entrance animation ── */
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

  items.forEach(function(el) { observer.observe(el); });
})();
</script>

{% schema %}
{
  "name": "OB FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "HAVE QUESTIONS?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Everything you need to know about OralBiome Pro. Can't find your answer? Contact us at <a href=\"mailto:info@calqix.com\">info@calqix.com</a></p>" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question text" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer text</p>" },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "product", "label": "Product" },
            { "value": "usage", "label": "Usage" },
            { "value": "subscription", "label": "Subscription" }
          ],
          "default": "product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OB FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How do I use OralBiome Pro?", "answer": "<p>After brushing and flossing, place one lozenge on your tongue and let it dissolve slowly. Do not chew. Avoid eating or drinking for 30 minutes afterwards to allow the probiotic strains to colonize your oral cavity. For optimal results, use daily before bed \u2014 this gives the beneficial bacteria the longest uninterrupted window to establish themselves.</p>", "category": "usage" } },
        { "type": "faq_item", "settings": { "question": "How long before I notice results?", "answer": "<p>Most users report fresher breath within the first 5\u20137 days. For measurable improvements in gum health \u2014 such as reduced bleeding during flossing \u2014 consistent daily use for 4 to 8 weeks is typically needed. Your oral microbiome took years to become imbalanced; restoring it is a gradual process, not an overnight fix. Clinical studies on L. reuteri show significant gum health improvements at the 4-week mark.</p>", "category": "product" } },
        { "type": "faq_item", "settings": { "question": "What makes this different from gut probiotics?", "answer": "<p>Gut probiotics are encapsulated to survive stomach acid and colonize your intestines. OralBiome Pro is designed to dissolve in your mouth, delivering clinically studied bacterial strains directly to the oral cavity \u2014 where they're needed. The strains in our formula (L. reuteri, S. salivarius K12, S. salivarius M18) have been specifically researched for oral health benefits, not digestive ones.</p>", "category": "product" } },
        { "type": "faq_item", "settings": { "question": "Can children use this product?", "answer": "<p>OralBiome Pro is suitable for children aged 4 and above who can safely dissolve a lozenge on their tongue without chewing or swallowing it whole. The probiotic strains in our formula have been studied in pediatric populations with favorable safety profiles. If your child is under 4 or has difficulty with lozenges, consult your healthcare provider first.</p>", "category": "product" } },
        { "type": "faq_item", "settings": { "question": "Can I use it alongside mouthwash?", "answer": "<p>Yes, but timing matters. Use OralBiome Pro after mouthwash \u2014 never before. Antibacterial mouthwash can reduce the viability of the probiotic strains if used immediately after. We recommend waiting at least 30 minutes after mouthwash before dissolving your lozenge. Ideally, the best routine is: brush, floss, lozenge, sleep.</p>", "category": "usage" } },
        { "type": "faq_item", "settings": { "question": "Do I need to refrigerate it?", "answer": "<p>No. OralBiome Pro is shelf-stable at room temperature (below 25 degrees Celsius). Store in a cool, dry place away from direct sunlight. The jar is designed to protect the probiotic strains from moisture. No special storage is needed \u2014 keep it on your nightstand or in your bathroom cabinet.</p>", "category": "usage" } },
        { "type": "faq_item", "settings": { "question": "Is it safe during pregnancy or breastfeeding?", "answer": "<p>The strains in OralBiome Pro \u2014 particularly L. reuteri \u2014 have been used in clinical studies involving pregnant women without adverse effects. However, as with any supplement during pregnancy or breastfeeding, we recommend consulting your healthcare provider before starting use. Your doctor knows your individual circumstances best.</p>", "category": "product" } },
        { "type": "faq_item", "settings": { "question": "How does the subscription work?", "answer": "<p>Your first jar ships immediately after ordering. Subsequent deliveries are automatic every 30 days (or 60/90 days \u2014 you choose the frequency). You save 20% compared to one-time purchases. There are no commitments: you can skip a month, change your delivery frequency, or cancel entirely from your account dashboard with one click. No phone calls, no retention tricks, no penalties.</p>", "category": "subscription" } },
        { "type": "faq_item", "settings": { "question": "Can I pause or cancel my subscription?", "answer": "<p>Yes \u2014 instantly, anytime. Log in to your account at calqix.com, go to your subscription, and click pause or cancel. Changes take effect immediately. If you pause, your subscription resumes automatically after the skipped period. If you cancel, you will not be charged again. We also offer a 60-day money-back guarantee on your first order if you are not satisfied.</p>", "category": "subscription" } },
        { "type": "faq_item", "settings": { "question": "What clinical evidence supports this product?", "answer": "<p>The primary strain in OralBiome Pro \u2014 Lactobacillus reuteri \u2014 has been researched in over 70 peer-reviewed clinical studies for oral health applications. Key findings include significant reduction in gingival inflammation, reduced plaque accumulation, and improved gum pocket depth scores. S. salivarius K12 has been studied for over 30 years for its role in reducing halitosis-causing bacteria. We maintain a research page at calqix.com/research with direct links to published studies.</p>", "category": "product" } }
      ]
    }
  ]
}
{% endschema %}
