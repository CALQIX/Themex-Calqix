{% comment %}
  CALQIX Blog Article — Premium interactive research blog section
  Linked from "Read the research" CTA in oralbiome-video-explainer
{% endcomment %}

<style>
  /* =============================================
     CALQIX BLOG — ENHANCED BRAND STYLE
     ============================================= */
  :root {
    --calqix-navy: #1A3B5C;
    --calqix-navy-deep: #0F2233;
    --calqix-gold: #C9A84C;
    --calqix-gold-light: rgba(201, 168, 76, 0.12);
    --calqix-bg-light: #F4F5F7;
    --calqix-white: #FFFFFF;
    --calqix-green: #2E7D32;
    --calqix-text: #1A1A1A;
    --calqix-muted: #6B7280;
    --calqix-border: #E5E7EB;
    --calqix-font-heading: 'DM Serif Display', serif;
    --calqix-font-body: 'DM Sans', sans-serif;
  }

  /* =============================================
     HERO BANNER
     ============================================= */
  .blog-hero {
    position: relative;
    background: var(--calqix-navy-deep);
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 80px 24px;
  }
  .blog-hero__particles {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .blog-hero__particle {
    position: absolute;
    border-radius: 50%;
    background: var(--calqix-gold);
    opacity: 0;
    animation: particle-float var(--duration) var(--delay) infinite ease-in-out;
  }
  @keyframes particle-float {
    0% { transform: translate(0, 0) scale(0); opacity: 0; }
    8% { opacity: var(--max-opacity); transform: scale(1); }
    85% { opacity: var(--max-opacity); }
    100% { transform: translate(var(--drift-x), -500px) scale(0.3); opacity: 0; }
  }
  .blog-hero__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }
  .blog-hero__inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 720px;
    padding: 0 24px;
  }
  .blog-hero__category {
    display: inline-block;
    padding: 6px 20px;
    border: 1px solid rgba(201, 168, 76, 0.4);
    border-radius: 50px;
    font-family: var(--calqix-font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--calqix-gold);
    margin-bottom: 24px;
    animation: hero-fade-in 0.8s 0.2s ease-out both;
  }
  .blog-hero__title {
    font-family: var(--calqix-font-heading);
    font-size: 48px;
    color: var(--calqix-white);
    line-height: 1.15;
    margin: 0 0 20px;
    animation: hero-fade-in 0.8s 0.4s ease-out both;
  }
  .blog-hero__meta {
    font-family: var(--calqix-font-body);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    animation: hero-fade-in 0.8s 0.6s ease-out both;
  }
  .blog-hero__meta span {
    margin: 0 8px;
    color: rgba(255, 255, 255, 0.2);
  }
  .blog-hero__meta span + span::before {
    content: '|';
    margin: 0 10px;
  }
  @keyframes hero-fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .blog-hero__scroll {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    animation: hero-fade-in 0.8s 1s ease-out both;
  }
  .blog-hero__scroll-line {
    width: 2px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, var(--calqix-gold), transparent);
    margin: 0 auto;
    animation: scroll-pulse 2s ease-in-out infinite;
  }
  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.2; transform: scaleY(0.5); }
    50% { opacity: 0.8; transform: scaleY(1); }
  }

  /* =============================================
     READING PROGRESS
     ============================================= */
  .blog-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--calqix-gold), #E8D48B);
    z-index: 1000;
    width: 0%;
    transition: width 0.15s linear;
    box-shadow: 0 0 8px rgba(201, 168, 76, 0.4);
  }

  /* =============================================
     LAYOUT — CONTENT + TOC SIDEBAR (right)
     ============================================= */
  .blog-layout {
    display: block;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (min-width: 1024px) {
    .blog-layout {
      display: grid;
      grid-template-columns: 1fr 240px;
      gap: 48px;
      max-width: 1080px;
      align-items: start;
    }
  }

  /* =============================================
     TABLE OF CONTENTS — SIDEBAR
     ============================================= */
  .blog-toc {
    display: none;
  }
  @media (min-width: 1024px) {
    .blog-toc {
      display: block;
      position: sticky;
      top: 120px;
      align-self: start;
      order: 2;
      background: #F4F5F7;
      border-left: 3px solid #C9A84C;
      border-radius: 8px;
      padding: 20px 24px;
      max-width: 240px;
      max-height: calc(100vh - 160px);
      overflow-y: auto;
    }
    .blog-content {
      order: 1;
    }
  }
  .blog-toc__heading,
  .blog-toc__label {
    font-family: var(--calqix-font-body);
    font-size: 11px;
    font-weight: 700;
    font-variant: small-caps;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    color: var(--calqix-navy);
    margin: 0 0 14px;
    display: block;
  }
  .blog-toc__item {
    display: block;
    padding: 6px 0;
    font-family: var(--calqix-font-body);
    font-size: 14px;
    color: var(--calqix-muted);
    text-decoration: none;
    transition: color 0.3s ease, font-weight 0.2s ease;
    line-height: 1.7;
  }
  .blog-toc__item:hover {
    color: var(--calqix-navy);
  }
  .blog-toc__item.is-active {
    color: var(--calqix-gold);
    font-weight: 600;
    padding-left: 10px;
    border-left: 2px solid var(--calqix-gold);
  }

  /* MOBILE TOC — inline accordion below article */
  .blog-toc-mobile {
    display: none;
  }
  @media (max-width: 1023px) {
    .blog-toc-mobile {
      display: block;
      max-width: 100%;
      margin: 0;
      padding: 12px 16px;
      position: sticky;
      top: var(--header-height, 0px);
      z-index: 50;
      background: var(--calqix-white, #fff);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .blog-toc-mobile__trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: var(--calqix-navy);
      color: var(--calqix-white);
      border: none;
      border-radius: 8px;
      padding: 14px 20px;
      font-family: var(--calqix-font-body);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.02em;
    }
    .blog-toc-mobile__trigger span {
      pointer-events: none;
    }
    .blog-toc-mobile__body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      background: var(--calqix-bg-light);
      border-radius: 0 0 8px 8px;
    }
    .blog-toc-mobile.is-open .blog-toc-mobile__body {
      max-height: 600px;
    }
    .blog-toc-mobile__body-inner {
      padding: 16px 20px 20px;
    }
    .blog-toc-mobile .blog-toc__heading {
      margin-bottom: 12px;
    }
    .blog-toc-mobile .blog-toc__item {
      display: block;
      font-size: 14px;
      padding: 8px 0;
      color: var(--calqix-navy);
      font-weight: 500;
      line-height: 1.5;
      text-decoration: none;
      font-family: var(--calqix-font-body);
    }
    .blog-toc-mobile .blog-toc__item.is-active {
      color: var(--calqix-gold);
      font-weight: 600;
    }
  }
  @media (min-width: 1024px) {
    .blog-toc-mobile { display: none !important; }
  }

  /* =============================================
     ARTICLE BODY — TYPOGRAPHY
     ============================================= */
  .blog-content {
    padding: 64px 0;
    min-width: 0;
  }
  .blog-content h2 {
    font-family: var(--calqix-font-heading);
    font-size: 30px;
    color: var(--calqix-navy);
    margin: 56px 0 16px;
    line-height: 1.25;
    position: relative;
    padding-left: 20px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    scroll-margin-top: 100px;
  }
  .blog-content h2.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .blog-content h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: var(--calqix-gold);
    border-radius: 2px;
  }
  .blog-content h3 {
    font-family: var(--calqix-font-body);
    font-size: 20px;
    font-weight: 700;
    color: var(--calqix-navy);
    margin: 40px 0 12px;
  }
  .blog-content p {
    font-family: var(--calqix-font-body);
    font-size: 16.5px;
    color: var(--calqix-text);
    line-height: 1.85;
    margin: 0 0 22px;
  }
  .blog-content a {
    color: var(--calqix-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .blog-content a:hover { color: var(--calqix-navy); }
  .blog-content strong { color: var(--calqix-navy); font-weight: 600; }
  .blog-content blockquote {
    border-left: 3px solid var(--calqix-gold);
    margin: 36px 0;
    padding: 24px 28px;
    background: var(--calqix-gold-light);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: var(--calqix-muted);
    line-height: 1.7;
  }
  .blog-content ul, .blog-content ol {
    padding-left: 24px;
    margin: 0 0 22px;
  }
  .blog-content li {
    margin-bottom: 10px;
    line-height: 1.75;
    font-family: var(--calqix-font-body);
    font-size: 16px;
    color: var(--calqix-text);
  }
  .blog-content li::marker {
    color: var(--calqix-gold);
  }

  /* =============================================
     SECTION DIVIDERS
     ============================================= */
  .blog-content hr,
  .blog-divider {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--calqix-gold), transparent);
    margin: 48px auto;
    max-width: 200px;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .blog-content hr.is-visible,
  .blog-divider.is-visible {
    opacity: 1;
  }

  /* =============================================
     IMAGES — parallax-ready
     ============================================= */
  .blog-content img {
    width: 100%;
    border-radius: 12px;
    margin: 40px 0;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease, box-shadow 0.3s ease;
  }
  .blog-content img.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .blog-content img:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  }

  /* Scroll-entrance animation (data-animate) */
  .blog-content [data-animate] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .blog-content [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* =============================================
     FLOATING PARTICLES (in-content)
     ============================================= */
  .blog-content-particles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .blog-content-particles .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--calqix-gold);
    opacity: 0;
    animation: content-particle-drift 20s infinite ease-in-out;
  }
  @keyframes content-particle-drift {
    0% { opacity: 0; transform: translateY(100vh) scale(0); }
    10% { opacity: 0.15; transform: scale(1); }
    90% { opacity: 0.15; }
    100% { opacity: 0; transform: translateY(-100px) scale(0.5); }
  }

  /* =============================================
     STAT COUNTER
     ============================================= */
  .blog-stat {
    text-align: center;
    padding: 48px 24px;
    margin: 48px 0;
    background: var(--calqix-bg-light);
    border-radius: 12px;
    border: 1px solid var(--calqix-border);
    position: relative;
    overflow: hidden;
  }
  .blog-stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: var(--calqix-gold);
    border-radius: 0 0 2px 2px;
  }
  .blog-stat__number {
    font-family: var(--calqix-font-heading);
    font-size: 64px;
    color: var(--calqix-navy);
    line-height: 1;
  }
  .blog-stat__suffix {
    font-family: var(--calqix-font-heading);
    font-size: 40px;
    color: var(--calqix-gold);
  }
  .blog-stat__label {
    display: block;
    margin-top: 8px;
    font-family: var(--calqix-font-body);
    font-size: 13px;
    color: var(--calqix-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* =============================================
     BEFORE / AFTER SLIDER
     ============================================= */
  .blog-compare {
    position: relative;
    margin: 48px 0;
    border-radius: 12px;
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    aspect-ratio: 16/9;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  }
  .blog-compare__before,
  .blog-compare__after {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }
  .blog-compare__before { z-index: 1; }
  .blog-compare__after  { z-index: 2; clip-path: inset(0 50% 0 0); }
  .blog-compare__before img,
  .blog-compare__after img {
    width: 100%; height: 100%;
    object-fit: cover;
    margin: 0; border-radius: 0;
    box-shadow: none;
    opacity: 1;
    transform: none;
  }
  .blog-compare__handle {
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .blog-compare__handle-line {
    flex: 1;
    width: 2px;
    background: var(--calqix-gold);
  }
  .blog-compare__handle-circle {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--calqix-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    flex-shrink: 0;
  }
  .blog-compare__label {
    position: absolute;
    bottom: 16px;
    padding: 6px 16px;
    border-radius: 50px;
    font-family: var(--calqix-font-body);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 4;
  }
  .blog-compare__label--before {
    left: 16px;
    background: rgba(0,0,0,0.6);
    color: white;
  }
  .blog-compare__label--after {
    right: 16px;
    background: var(--calqix-gold);
    color: var(--calqix-navy);
  }

  /* =============================================
     CITATION POPUP
     ============================================= */
  .blog-cite { position: relative; display: inline; }
  .blog-cite__trigger {
    color: var(--calqix-gold);
    font-weight: 700;
    cursor: pointer;
    font-size: 12px;
    vertical-align: super;
    transition: color 0.2s;
  }
  .blog-cite__trigger:hover { color: var(--calqix-navy); }
  .blog-cite__popup {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: 320px;
    padding: 16px;
    background: var(--calqix-white);
    border: 1px solid var(--calqix-border);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    font-size: 13px;
    line-height: 1.5;
    color: var(--calqix-text);
    z-index: 10;
  }
  .blog-cite__popup::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--calqix-white);
  }
  .blog-cite.is-open .blog-cite__popup {
    display: block;
    animation: cite-pop 0.2s ease-out;
  }
  @keyframes cite-pop {
    from { opacity: 0; transform: translateX(-50%) translateY(4px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  /* =============================================
     INGREDIENT TOOLTIP
     ============================================= */
  .blog-ingredient {
    color: var(--calqix-navy);
    font-weight: 600;
    border-bottom: 2px dotted var(--calqix-gold);
    cursor: help;
    position: relative;
  }
  .blog-ingredient__tooltip {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    min-width: 240px;
    padding: 16px;
    background: var(--calqix-navy-deep);
    color: white;
    border-radius: 12px;
    font-size: 13px;
    z-index: 10;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .blog-ingredient__tooltip-name {
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 4px;
    display: block;
  }
  .blog-ingredient__tooltip-cfu {
    display: inline-block;
    background: var(--calqix-gold);
    color: var(--calqix-navy);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 50px;
    margin-bottom: 8px;
  }
  .blog-ingredient__tooltip-benefit {
    color: rgba(255,255,255,0.7);
    font-size: 12px;
    display: block;
  }
  .blog-ingredient:hover .blog-ingredient__tooltip {
    display: block;
    animation: cite-pop 0.2s ease-out;
  }

  /* =============================================
     GLOSSARY TOOLTIPS
     ============================================= */
  .blog-glossary {
    color: var(--calqix-navy);
    font-weight: 600;
    border-bottom: 1.5px dashed var(--calqix-gold);
    cursor: help;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }
  .blog-glossary__tip {
    display: none;
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    max-width: 300px;
    padding: 14px 16px;
    background: var(--calqix-navy-deep);
    color: rgba(255,255,255,0.92);
    border-radius: 10px;
    font-family: var(--calqix-font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
    z-index: 100;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    pointer-events: none;
    text-align: left;
    white-space: normal;
    word-break: normal;
  }
  .blog-glossary__tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--calqix-navy-deep);
  }
  /* desktop: show on hover */
  @media (hover: hover) {
    .blog-glossary:hover .blog-glossary__tip {
      display: block;
      animation: cite-pop 0.2s ease-out;
      pointer-events: auto;
    }
  }
  /* mobile: show on tap via .is-open class */
  .blog-glossary.is-open .blog-glossary__tip {
    display: block;
    animation: cite-pop 0.2s ease-out;
    pointer-events: auto;
  }
  @media (max-width: 767px) {
    .blog-glossary__tip {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      top: auto;
      transform: none;
      min-width: 0;
      max-width: 100%;
      width: 100%;
      border-radius: 14px 14px 0 0;
      padding: 20px 24px 28px;
      font-size: 14.5px;
      line-height: 1.6;
      box-shadow: 0 -6px 32px rgba(0,0,0,0.2);
      z-index: 1000;
    }
    .blog-glossary__tip::after { display: none; }
  }

  /* =============================================
     ARTICLE FOOTER
     ============================================= */

  /* Tags */
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 24px;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .blog-tags__item {
    display: inline-block;
    padding: 6px 16px;
    border: 1px solid var(--calqix-border);
    border-radius: 50px;
    font-family: var(--calqix-font-body);
    font-size: 12px;
    color: var(--calqix-muted);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .blog-tags__item:hover {
    border-color: var(--calqix-gold);
    color: var(--calqix-navy);
    background: var(--calqix-gold-light);
    transform: translateY(-1px);
  }

  /* Author card */
  .blog-author {
    max-width: 720px;
    margin: 0 auto 48px;
    padding: 0 24px;
  }
  .blog-author__card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--calqix-navy);
    border-radius: 16px;
    padding: 28px 32px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .blog-author__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(26, 59, 92, 0.3);
  }
  .blog-author__image {
    width: 64px; height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--calqix-gold);
  }
  .blog-author__name {
    font-family: var(--calqix-font-heading);
    font-size: 18px;
    color: var(--calqix-white);
    margin: 0 0 2px;
  }
  .blog-author__title {
    font-family: var(--calqix-font-body);
    font-size: 12px;
    color: var(--calqix-gold);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 6px;
  }
  .blog-author__bio {
    font-family: var(--calqix-font-body);
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    line-height: 1.5;
    margin: 0;
  }

  /* Related articles */
  .blog-related {
    max-width: 1000px;
    margin: 0 auto 64px;
    padding: 0 24px;
  }
  .blog-related__heading {
    font-family: var(--calqix-font-heading);
    font-size: 24px;
    color: var(--calqix-navy);
    margin: 0 0 24px;
    text-align: center;
  }
  .blog-related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .blog-related__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .blog-related__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .blog-related__card {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--calqix-border);
    text-decoration: none;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    display: block;
    background: var(--calqix-white);
  }
  .blog-related__card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    transform: translateY(-4px);
  }
  .blog-related__card-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .blog-related__card:hover .blog-related__card-img {
    transform: scale(1.03);
  }
  .blog-related__card-body {
    padding: 16px;
  }
  .blog-related__card-cat {
    font-family: var(--calqix-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--calqix-gold);
    margin: 0 0 6px;
  }
  .blog-related__card-title {
    font-family: var(--calqix-font-heading);
    font-size: 17px;
    color: var(--calqix-navy);
    margin: 0 0 6px;
    line-height: 1.3;
  }
  .blog-related__card-time {
    font-family: var(--calqix-font-body);
    font-size: 12px;
    color: var(--calqix-muted);
  }

  /* CTA Banner */
  .blog-cta {
    background: linear-gradient(135deg, var(--calqix-bg-light) 0%, #EDE8DC 100%);
    padding: 56px 24px;
    text-align: center;
    margin-bottom: 0;
    position: relative;
    overflow: hidden;
  }
  .blog-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: var(--calqix-gold);
    border-radius: 0 0 2px 2px;
  }
  .blog-cta__inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .blog-cta__eyebrow {
    font-family: var(--calqix-font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--calqix-gold);
    margin: 0 0 12px;
  }
  .blog-cta__heading {
    font-family: var(--calqix-font-heading);
    font-size: 28px;
    color: var(--calqix-navy);
    margin: 0 0 12px;
    line-height: 1.3;
  }
  .blog-cta__text {
    font-family: var(--calqix-font-body);
    font-size: 15px;
    color: var(--calqix-muted);
    margin: 0 0 24px;
    line-height: 1.6;
  }
  .blog-cta__button {
    display: inline-block;
    background: var(--calqix-gold);
    color: var(--calqix-navy);
    font-family: var(--calqix-font-body);
    font-size: 14px;
    font-weight: 700;
    padding: 14px 40px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(201, 168, 76, 0.3);
  }
  .blog-cta__button:hover {
    background: #b8953f;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(201, 168, 76, 0.4);
  }

  /* =============================================
     MOBILE RESPONSIVE
     ============================================= */
  @media (max-width: 767px) {
    .blog-hero { min-height: 320px; padding: 60px 16px; }
    .blog-hero__title { font-size: 28px; }
    .blog-hero__meta { font-size: 12px; }

    .blog-content { padding: 40px 0; }
    .blog-content h2 { font-size: 22px; margin-top: 40px; }
    .blog-content h3 { font-size: 17px; }
    .blog-content p { font-size: 15px; }

    .blog-stat__number { font-size: 48px; }
    .blog-stat { padding: 32px 16px; margin: 32px -16px; border-radius: 0; }
    .blog-stat__label { font-size: 12px; letter-spacing: 1.5px; }

    .blog-compare { aspect-ratio: 4/3; border-radius: 8px; }

    .blog-cite__popup {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      top: auto;
      transform: none;
      width: 100%;
      border-radius: 12px 12px 0 0;
      max-height: 50vh;
    }
    .blog-cite__popup::after { display: none; }
    .blog-cite .blog-cite__popup {
      transform: translateY(100%);
      transition: transform 0.3s ease, opacity 0.3s ease;
      opacity: 0;
      display: block;
      pointer-events: none;
    }
    .blog-cite.is-open .blog-cite__popup {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
      animation: none;
    }

    .blog-layout { display: block; padding: 0 16px; }

    .blog-author__card { flex-direction: column; text-align: center; }
    .blog-related__heading { font-size: 20px; }
    .blog-cta__heading { font-size: 22px; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .blog-hero { min-height: 400px; }
    .blog-hero__title { font-size: 40px; }
    .blog-stat { padding: 40px 24px; }
    .blog-stat__number { font-size: 56px; }
  }

  /* Scientific names — prevent line breaks on compound terms */
  .sci-nowrap { white-space: nowrap; }

  /* =============================================
     DEFAULT TABLE STYLES
     ============================================= */
  .blog-content table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--calqix-font-body);
    font-size: 14px;
    line-height: 1.6;
    margin: 32px 0;
  }
  .blog-content th {
    background: var(--calqix-navy);
    color: white;
    padding: 14px 16px;
    text-align: left;
    font-weight: 600;
  }
  .blog-content td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--calqix-border);
  }
  .blog-content tr:nth-child(even) td {
    background: #f9fafb;
  }

  /* =============================================
     FOCUS & ACCESSIBILITY
     ============================================= */
  .blog-toc__item:focus-visible,
  .blog-toc-mobile__trigger:focus-visible {
    outline: 2px solid var(--calqix-gold);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* =============================================
     REDUCED MOTION
     ============================================= */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .blog-content h2,
    .blog-content img,
    .blog-content hr,
    .blog-content [data-animate] {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* =============================================
     MOBILE BOTTOM SHEET BACKDROP
     ============================================= */
  .blog-cite-backdrop,
  .blog-glossary-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.3);
    z-index: 999;
  }
  .blog-cite-backdrop.is-visible,
  .blog-glossary-backdrop.is-visible {
    display: block;
  }
</style>

{%- comment -%} ─── READING PROGRESS BAR ─── {%- endcomment -%}
{%- if section.settings.show_progress_bar -%}
  <div class="blog-progress" aria-hidden="true"></div>
{%- endif -%}

{%- comment -%} ─── HERO BANNER ─── {%- endcomment -%}
<div class="calqix-blog">
  <header class="blog-hero">
    <div class="blog-hero__particles" aria-hidden="true">
      {%- for i in (1..30) -%}
        {%- assign size = i | modulo: 4 | plus: 3 -%}
        {%- assign left = i | times: 3.33 | modulo: 100 -%}
        {%- assign duration = i | modulo: 20 | plus: 20 -%}
        {%- assign delay = i | modulo: 15 -%}
        {%- assign opacity = i | modulo: 3 | times: 5 | plus: 8 -%}
        <div class="blog-hero__particle" style="
          width: {{ size }}px;
          height: {{ size }}px;
          left: {{ left }}%;
          bottom: -10px;
          --duration: {{ duration }}s;
          --delay: {{ delay }}s;
          --drift-x: {{ i | modulo: 60 | minus: 30 }}px;
          --max-opacity: 0.{{ opacity }};
        "></div>
      {%- endfor -%}
    </div>

    <div class="blog-hero__inner">
      {%- if article.tags.size > 0 -%}
        <span class="blog-hero__category">{{ article.tags.first | upcase }}</span>
      {%- endif -%}

      <h1 class="blog-hero__title">{{ article.title }}</h1>

      <p class="blog-hero__meta">
        <span>{{ section.settings.author_name | default: article.author }}</span>
        {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
        {%- assign read_time = word_count | divided_by: 200 | plus: 1 -%}
        <span>{{ read_time }} min read</span>
        <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
      </p>

      <div class="blog-hero__scroll-line" aria-hidden="true"></div>
    </div>
  </header>

  {%- comment -%} ─── MOBILE TOC — sticky bar on mobile ─── {%- endcomment -%}
  {%- if section.settings.show_toc -%}
    <div class="blog-toc-mobile">
      <button class="blog-toc-mobile__trigger" type="button" aria-expanded="false">
        <span>Contents ↕</span>
      </button>
      <div class="blog-toc-mobile__body">
        <div class="blog-toc-mobile__body-inner">
          <p class="blog-toc__heading">In this article</p>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ─── TOC + ARTICLE BODY ─── {%- endcomment -%}
  <div class="blog-layout">

    {%- comment -%} Desktop TOC sidebar — JS will populate links from h2 headings {%- endcomment -%}
    {%- if section.settings.show_toc -%}
      <nav class="blog-toc" aria-label="Table of contents">
        <p class="blog-toc__heading">In this article</p>
      </nav>
    {%- endif -%}

    {%- comment -%} Article content — scientific names are italicised by JS (text-nodes only) {%- endcomment -%}
    <article class="blog-content">
      {{ article.content }}
    </article>
  </div>

  {%- comment -%} ─── TAGS ─── {%- endcomment -%}
  {%- if article.tags.size > 0 -%}
    <div class="blog-tags">
      {%- for tag in article.tags -%}
        <a class="blog-tags__item" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ─── AUTHOR CARD ─── {%- endcomment -%}
  {%- if section.settings.show_author_card -%}
    <div class="blog-author">
      <div class="blog-author__card">
        {%- if section.settings.author_image -%}
          <img
            class="blog-author__image"
            src="{{ section.settings.author_image | image_url: width: 128 }}"
            alt="{{ section.settings.author_name | escape }}"
            width="64"
            height="64"
            loading="lazy"
          >
        {%- else -%}
          <div class="blog-author__image" style="background:var(--calqix-gold);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--calqix-navy);font-weight:700;">
            {{ section.settings.author_name | slice: 0, 1 | upcase }}
          </div>
        {%- endif -%}
        <div>
          <p class="blog-author__name">{{ section.settings.author_name }}</p>
          <p class="blog-author__title">{{ section.settings.author_title }}</p>
          <p class="blog-author__bio">{{ section.settings.author_bio }}</p>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ─── RELATED ARTICLES ─── {%- endcomment -%}
  {%- if blog.articles.size > 1 -%}
    <div class="blog-related">
      <h2 class="blog-related__heading">Continue reading</h2>
      <div class="blog-related__grid">
        {%- assign related_count = 0 -%}
        {%- for related in blog.articles -%}
          {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
          <a class="blog-related__card" href="{{ related.url }}">
            {%- if related.image -%}
              <img
                class="blog-related__card-img"
                src="{{ related.image | image_url: width: 600 }}"
                alt="{{ related.title | escape }}"
                loading="lazy"
                width="600"
                height="338"
              >
            {%- endif -%}
            <div class="blog-related__card-body">
              {%- if related.tags.size > 0 -%}
                <p class="blog-related__card-cat">{{ related.tags.first }}</p>
              {%- endif -%}
              <p class="blog-related__card-title">{{ related.title }}</p>
              {%- assign r_words = related.content | strip_html | split: ' ' | size -%}
              {%- assign r_time = r_words | divided_by: 200 | plus: 1 -%}
              <p class="blog-related__card-time">{{ r_time }} min read</p>
            </div>
          </a>
          {%- assign related_count = related_count | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ─── CTA BANNER ─── {%- endcomment -%}
  {%- if section.settings.show_cta_banner -%}
    <div class="blog-cta">
      <div class="blog-cta__inner">
        <p class="blog-cta__eyebrow">ORALBIOME PRO</p>
        <h2 class="blog-cta__heading">Experience the science yourself</h2>
        <p class="blog-cta__text">3 billion CFU. 4 clinically studied strains. One lozenge a day for a healthier oral microbiome.</p>
        {%- assign ob_product = all_products['oralbiome-pro'] -%}
        {%- if ob_product -%}
          <a class="blog-cta__button" href="/collections/teeth-withening">Try OralBiome Pro</a>
        {%- else -%}
          <a class="blog-cta__button" href="/collections/teeth-withening">Shop Now</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

</div>

<script src="{{ 'calqix-blog-interactive.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CALQIX Blog Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show reading progress bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_toc",
      "label": "Show table of contents (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author_card",
      "label": "Show author card",
      "default": true
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Dr. Elena Hartwell"
    },
    {
      "type": "text",
      "id": "author_title",
      "label": "Author title",
      "default": "Dental Science Specialist"
    },
    {
      "type": "textarea",
      "id": "author_bio",
      "label": "Author bio",
      "default": "Dr. Hartwell specializes in preventive dentistry and oral microbiome research. She advises CALQIX on clinical evidence and product formulation."
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author image"
    },
    {
      "type": "checkbox",
      "id": "show_cta_banner",
      "label": "Show product CTA at bottom",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "CALQIX Blog Article"
    }
  ]
}
{% endschema %}
