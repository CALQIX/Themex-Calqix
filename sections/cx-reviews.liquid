{%- comment -%}
  CALQIX Navy Rebuild - Reviews with categorized filters.
{%- endcomment -%}

{%- assign cx_filters = 'homepage.reviews.filter_options' | t | split: ',' -%}
{%- liquid
  assign cx_reviews_eyebrow = 'homepage.reviews.eyebrow' | t
  assign cx_reviews_heading = 'homepage.reviews.heading_html' | t
  assign cx_reviews_count_label = 'homepage.reviews.rating_count_label' | t
  assign cx_reviews_verified = 'homepage.reviews.verified_label' | t
-%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section" data-cx-reviews-section data-cx-reveal>
  <div class="cx-container">
    <div class="cx-reviews-header">
      <div class="cx-stack cx-gap-sm">
        {% render 'cx-eyebrow', text: cx_reviews_eyebrow %}
        <h2 class="cx-h2">{{ cx_reviews_heading }}</h2>
      </div>
      <div class="cx-reviews-rating">
        <div class="cx-gold-shimmer cx-reviews-score" data-cx-count="{{ section.settings.rating_value }}" data-cx-count-decimals="1" data-cx-count-duration="1600">0,0</div>
        <div class="cx-reviews-stars">
          {%- for i in (1..5) -%}{% render 'cx-icons', name: 'star', size: 16 %}{%- endfor -%}
        </div>
        <div class="cx-eyebrow cx-reviews-count">{{ section.settings.rating_count }} {{ cx_reviews_count_label }}</div>
      </div>
    </div>

    {%- if cx_filters.size > 0 -%}
      <div class="cx-reviews-filters" data-cx-review-filter role="tablist" aria-label="Review filters">
        {%- for f in cx_filters -%}
          {%- assign label = f | strip -%}
          {%- liquid
            assign filter_key = 'all'
            case forloop.index
              when 2
                assign filter_key = 'recent'
              when 3
                assign filter_key = 'sensitive'
              when 4
                assign filter_key = 'whitening'
              when 5
                assign filter_key = 'fresh-breath'
              when 6
                assign filter_key = 'daily-routine'
            endcase
          -%}
          <button type="button" class="cx-reviews-pill{% if forloop.first %} cx-is-active{% endif %}" data-cx-review-pill="{{ filter_key }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
            <span>{{ label }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cx-reviews-grid" data-cx-col3 data-cx-stagger data-cx-reviews-grid>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign cx_review_category = block.settings.category | default: 'daily-routine' -%}
          <article class="cx-reviews-card cx-lux-lift" data-cx-review-card data-category="{{ cx_review_category }}" data-date="{{ block.settings.sort_date | default: block.settings.date | escape }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="cx-reviews-stars-row" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- assign r = block.settings.rating | plus: 0 -%}
              {%- for i in (1..5) -%}
                {%- if i <= r -%}{% render 'cx-icons', name: 'star', size: 14 %}{%- endif -%}
              {%- endfor -%}
            </div>
            <h3 class="cx-reviews-title">&ldquo;{{ block.settings.title | escape }}&rdquo;</h3>
            <p class="cx-reviews-body">{{ block.settings.body }}</p>
            <div class="cx-reviews-footer">
              <div>
                <div class="cx-reviews-name">{{ block.settings.name | escape }}</div>
                <div class="cx-reviews-date">{{ block.settings.date | escape }}</div>
              </div>
              <div class="cx-reviews-verified">
                <span class="cx-reviews-check" aria-hidden="true"></span>{{ cx_reviews_verified }}<br>
                <span>{{ block.settings.verified | escape }}</span>
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .cx-reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cx-reviews-rating { text-align: right; }
  .cx-reviews-score { font-family: var(--cx-f-display); font-size: 60px; line-height: 1; }
  .cx-reviews-stars { display: flex; gap: 2px; justify-content: flex-end; margin-top: 4px; color: var(--cx-gold); }
  .cx-reviews-count { margin-top: 6px; }

  .cx-reviews-filters {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 30px;
  }

  .cx-reviews-pill {
    position: relative;
    isolation: isolate;
    flex: 0 0 auto;
    min-width: 168px;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid rgba(0, 37, 73, .14);
    border-radius: 999px;
    background: rgba(255, 255, 255, .78);
    color: #002549;
    cursor: pointer;
    font-size: 14.5px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0;
    white-space: nowrap;
    box-shadow: 0 14px 34px rgba(0, 37, 73, .06);
    overflow: hidden;
    transition:
      transform .24s var(--cx-ease-silk),
      color .24s ease,
      border-color .24s ease,
      box-shadow .24s ease,
      background .24s ease;
  }

  .cx-reviews-pill::before {
    content: "";
    position: absolute;
    inset: 4px;
    border-radius: inherit;
    background: linear-gradient(135deg, #002549, #00528f);
    opacity: 0;
    transform: scale(.92);
    transition: opacity .26s ease, transform .32s var(--cx-ease-silk);
    z-index: -1;
  }

  .cx-reviews-pill span {
    display: block;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .cx-reviews-pill:hover,
  .cx-reviews-pill:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(0, 118, 194, .32);
    box-shadow: 0 18px 42px rgba(0, 37, 73, .11);
    outline: none;
  }

  .cx-reviews-pill.cx-is-active {
    color: #fff;
    border-color: #002549;
    box-shadow: 0 18px 42px rgba(0, 37, 73, .16);
  }

  .cx-reviews-pill.cx-is-active::before {
    opacity: 1;
    transform: scale(1);
  }

  .cx-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .cx-reviews-card {
    border: 1px solid var(--cx-rule);
    border-radius: var(--cx-r-md);
    padding: 28px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.9), rgba(248,251,255,.78)),
      var(--cx-page);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 260px;
    opacity: 1;
    transform: translateY(0) scale(1);
    box-shadow: 0 18px 46px rgba(0, 37, 73, .05);
    transition:
      opacity .26s ease,
      transform .32s var(--cx-ease-silk),
      border-color .28s ease,
      box-shadow .28s ease,
      background .28s ease;
  }

  .cx-reviews-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 118, 194, .26);
    box-shadow: 0 24px 58px rgba(0, 37, 73, .1);
  }

  .cx-reviews-card.cx-is-filtering {
    opacity: 0;
    transform: translateY(10px) scale(.985);
  }

  .cx-reviews-card[hidden] { display: none; }
  .cx-reviews-stars-row { display: flex; gap: 2px; color: var(--cx-gold); }
  .cx-reviews-title { font-family: var(--cx-f-display); font-size: 20px; line-height: 1.18; margin: 0; color: var(--cx-forest-3); }
  .cx-reviews-body { margin: 0; font-size: 15px; line-height: 1.58; color: var(--cx-ink-soft); }

  .cx-reviews-footer {
    border-top: 1px solid var(--cx-rule);
    padding-top: 14px;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
  }

  .cx-reviews-name { font-size: 13px; font-weight: 700; color: var(--cx-ink); }
  .cx-reviews-date { font-family: var(--cx-f-mono); font-size: 10.5px; color: var(--cx-ink-mute); }

  .cx-reviews-verified {
    font-family: var(--cx-f-mono);
    font-size: 10px;
    color: var(--cx-gold-ink);
    letter-spacing: .06em;
    text-align: right;
    max-width: 150px;
    text-transform: uppercase;
  }

  .cx-reviews-check {
    display: inline-block;
    width: 7px;
    height: 12px;
    margin-right: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(42deg) translateY(-1px);
  }

  .cx-reviews-verified span:last-child {
    color: var(--cx-ink-mute);
    text-transform: none;
    letter-spacing: 0;
  }

  @media (max-width: 980px) {
    .cx-reviews-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cx-reviews-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 2px 2px 10px;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }
    .cx-reviews-filters::-webkit-scrollbar { display: none; }
    .cx-reviews-pill {
      flex: 0 0 auto;
      min-width: 172px;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 640px) {
    .cx-reviews-header {
      align-items: flex-start;
      margin-bottom: 24px;
    }
    .cx-reviews-rating { text-align: left; }
    .cx-reviews-stars { justify-content: flex-start; }
    .cx-reviews-score { font-size: 52px; }
    .cx-reviews-pill {
      min-width: 166px;
      min-height: 46px;
      padding: 0 18px;
      font-size: 13px;
    }
    .cx-reviews-grid { grid-template-columns: 1fr; }
    .cx-reviews-card {
      padding: 22px;
      min-height: 0;
    }
  }
</style>

<script>
  (() => {
    const sections = document.querySelectorAll('[data-cx-reviews-section]:not([data-cx-reviews-bound])');

    sections.forEach((section) => {
      section.setAttribute('data-cx-reviews-bound', 'true');
      const grid = section.querySelector('[data-cx-reviews-grid]');
      const pills = Array.from(section.querySelectorAll('[data-cx-review-pill]'));
      const cards = Array.from(section.querySelectorAll('[data-cx-review-card]'));
      if (!grid || !pills.length || !cards.length) return;

      const sortCards = (mode) => {
        const sorted = [...cards].sort((a, b) => {
          if (mode === 'recent') {
            return String(b.dataset.date || '').localeCompare(String(a.dataset.date || ''));
          }
          return Number(a.dataset.index || 0) - Number(b.dataset.index || 0);
        });
        sorted.forEach((card) => grid.appendChild(card));
      };

      const applyFilter = (filter) => {
        grid.classList.add('cx-is-changing');
        cards.forEach((card) => card.classList.add('cx-is-filtering'));

        window.setTimeout(() => {
          sortCards(filter);
          cards.forEach((card) => {
            const visible = filter === 'all' || filter === 'recent' || card.dataset.category === filter;
            card.hidden = !visible;
            card.classList.toggle('cx-is-filtering', !visible);
          });

          window.requestAnimationFrame(() => {
            cards.forEach((card) => {
              if (!card.hidden) card.classList.remove('cx-is-filtering');
            });
            grid.classList.remove('cx-is-changing');
          });
        }, 150);
      };

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.dataset.cxReviewPill || 'all';
          pills.forEach((item) => {
            const active = item === pill;
            item.classList.toggle('cx-is-active', active);
            item.setAttribute('aria-selected', String(active));
          });
          applyFilter(filter);
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "CX Reviews",
  "tag": "section",
  "class": "cx-section-reviews",
  "settings": [
