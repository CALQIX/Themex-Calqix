{%- comment -%}
  CALQIX Navy Rebuild — Reviews (filter pills + 3 cards + aggregate rating).
  Source: _incoming/calqix-web-upgrade/handoff/source/components/body.jsx → Reviews
{%- endcomment -%}

{%- assign cx_filters = 'homepage.reviews.filter_options' | t | split: ',' -%}
{%- liquid
  assign cx_reviews_eyebrow = 'homepage.reviews.eyebrow' | t
  assign cx_reviews_heading = 'homepage.reviews.heading_html' | t
  assign cx_reviews_count_label = 'homepage.reviews.rating_count_label' | t
  assign cx_reviews_verified = 'homepage.reviews.verified_label' | t
-%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-reviews-header">
      <div class="cx-stack cx-gap-sm">
        {% render 'cx-eyebrow', text: cx_reviews_eyebrow %}
        <h2 class="cx-h2">{{ cx_reviews_heading }}</h2>
      </div>
      <div class="cx-reviews-rating">
        <div class="cx-gold-shimmer cx-reviews-score" data-cx-count="{{ section.settings.rating_value }}" data-cx-count-decimals="1" data-cx-count-duration="1600">0,0</div>
        <div class="cx-reviews-stars">
          {%- for i in (1..5) -%}{% render 'cx-icons', name: 'star', size: 16 %}{%- endfor -%}
        </div>
        <div class="cx-eyebrow cx-reviews-count">{{ section.settings.rating_count }} {{ cx_reviews_count_label }}</div>
      </div>
    </div>

    {%- if cx_filters.size > 0 -%}
      <div class="cx-reviews-filters" data-cx-review-filter>
        {%- for f in cx_filters -%}
          {%- assign label = f | strip -%}
          <button type="button" class="cx-pill{% if forloop.first %} cx-is-active{% endif %}" data-cx-review-pill>{{ label }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cx-reviews-stage" data-cx-reviews-stage>
      <button type="button" class="cx-reviews-edge" data-cx-reviews-prev aria-label="Vorige review">
        <span aria-hidden="true">&lsaquo;</span>
      </button>
      <div class="cx-reviews-grid" data-cx-col3 data-cx-stagger data-cx-reviews-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="cx-reviews-card cx-lux-lift" {{ block.shopify_attributes }}>
            {%- assign cx_review_prefix = 'homepage.reviews.review_' | append: forloop.index -%}
            {%- assign cx_review_title_key = cx_review_prefix | append: '_title' -%}
            {%- assign cx_review_body_key = cx_review_prefix | append: '_body' -%}
            {%- assign cx_review_verified_key = cx_review_prefix | append: '_verified' -%}
            <div class="cx-reviews-stars-row">
              {%- assign r = block.settings.rating | plus: 0 -%}
              {%- for i in (1..r) -%}{% render 'cx-icons', name: 'star', size: 14 %}{%- endfor -%}
            </div>
            <h3 class="cx-reviews-title">&ldquo;{{ cx_review_title_key | t }}&rdquo;</h3>
            <p class="cx-reviews-body">{{ cx_review_body_key | t }}</p>
            <button type="button" class="cx-reviews-more" data-cx-reviews-more aria-expanded="false">Meer lezen</button>
            <div class="cx-reviews-footer">
              <div>
                <div class="cx-reviews-name">{{ block.settings.name }}</div>
                <div class="cx-reviews-date">{{ block.settings.date }}</div>
              </div>
              <div class="cx-reviews-verified">
                ✓ {{ cx_reviews_verified }}<br>
                <span>{{ cx_review_verified_key | t }}</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>
      <button type="button" class="cx-reviews-edge" data-cx-reviews-next aria-label="Volgende review">
        <span aria-hidden="true">&rsaquo;</span>
      </button>
    </div>
    <div class="cx-reviews-mobile-rail" data-cx-reviews-rail aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  .cx-section-reviews .cx-root {
    position: relative;
    overflow: hidden;
  }
  .cx-section-reviews .cx-root::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(680px, 62vw);
    height: min(680px, 62vw);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,118,194,.10), transparent 64%);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .cx-reviews-header {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
    gap: 28px;
  }
  .cx-reviews-header .cx-h2 {
    max-width: 12ch;
  }
  .cx-reviews-rating {
    padding: 14px 18px;
    border: 1px solid rgba(0,67,129,.13);
    border-radius: 18px;
    background: rgba(255,255,255,.62);
    text-align: right;
    box-shadow: 0 18px 50px rgba(0,37,73,.07), inset 0 1px 0 rgba(255,255,255,.80);
    backdrop-filter: blur(16px);
  }
  .cx-reviews-score {
    font-family: var(--cx-f-display);
    font-size: clamp(46px, 4.5vw, 62px);
    line-height: .9;
  }
  .cx-reviews-stars {
    display: flex;
    gap: 2px;
    justify-content: flex-end;
    margin-top: 7px;
    color: var(--cx-gold);
  }
  .cx-reviews-count { display: none; }
  .cx-reviews-filters {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 12px;
    flex-wrap: nowrap;
    margin: 0 0 26px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .cx-reviews-filters::-webkit-scrollbar { display: none; }
  .cx-reviews-filters .cx-pill {
    flex: 0 0 auto;
    min-height: 48px;
    padding: 13px 24px;
    border: 1px solid rgba(0,67,129,.12);
    border-radius: 999px;
    background: rgba(255,255,255,.76);
    color: var(--cx-forest);
    box-shadow: 0 16px 40px rgba(0,37,73,.07), inset 0 1px 0 rgba(255,255,255,.78);
    backdrop-filter: blur(14px);
    transition: color .24s ease, background .24s ease, border-color .24s ease, box-shadow .24s ease, transform .24s ease;
  }
  .cx-reviews-filters .cx-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 20px 44px rgba(0,37,73,.10), inset 0 1px 0 rgba(255,255,255,.84);
  }
  .cx-reviews-filters .cx-pill.cx-is-active {
    border-color: var(--cx-forest);
    background: var(--cx-forest);
    color: #fff;
    box-shadow: 0 18px 36px rgba(0,37,73,.22);
  }
  .cx-reviews-stage {
    position: relative;
    z-index: 1;
    padding-inline: 36px;
  }
  .cx-reviews-grid {
    display: flex;
    gap: 20px;
    overflow-x: hidden;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 2px 8px;
    cursor: grab;
    mask-image: linear-gradient(90deg, transparent 0, #000 22px, #000 calc(100% - 22px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22px, #000 calc(100% - 22px), transparent 100%);
  }
  .cx-reviews-grid:active { cursor: grabbing; }
  .cx-reviews-grid::-webkit-scrollbar { display: none; }
  .cx-reviews-card {
    flex: 0 0 calc((100% - 40px) / 3);
    min-height: 326px;
    border: 1px solid rgba(0,67,129,.18);
    border-radius: 18px;
    padding: 30px 28px 26px;
    background:
      radial-gradient(circle at 90% 10%, rgba(209,170,84,.10), transparent 26%),
      linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,250,255,.92));
    display: flex;
    flex-direction: column;
    gap: 15px;
    scroll-snap-align: start;
    box-shadow: 0 18px 48px rgba(0,37,73,.075), inset 0 1px 0 rgba(255,255,255,.82);
    transition: box-shadow .34s ease, transform .34s ease, border-color .34s ease;
  }
  .cx-reviews-card:hover {
    border-color: rgba(0,118,194,.28);
    box-shadow: 0 26px 60px rgba(0,37,73,.12), inset 0 1px 0 rgba(255,255,255,.88);
    transform: translateY(-3px);
  }
  .cx-reviews-stars-row { display: flex; gap: 2px; color: var(--cx-gold); }
  .cx-reviews-title {
    font-family: var(--cx-f-display);
    font-size: clamp(20px, 1.45vw, 24px);
    line-height: 1.15;
    margin: 0;
    color: var(--cx-forest-3);
  }
  .cx-reviews-body {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.58;
    color: var(--cx-ink-soft);
  }
  .cx-reviews-footer {
    border-top: 1px solid var(--cx-rule);
    padding-top: 15px;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
  }
  .cx-reviews-name { font-size: 13px; font-weight: 700; color: var(--cx-ink); }
  .cx-reviews-date { font-family: var(--cx-f-mono); font-size: 10.5px; color: var(--cx-ink-mute); margin-top: 2px; }
  .cx-reviews-verified {
    font-family: var(--cx-f-mono);
    font-size: 10px;
    color: var(--cx-gold-ink);
    letter-spacing: 0.06em;
    text-align: right;
    max-width: 132px;
  }
  .cx-reviews-verified span { color: var(--cx-ink-mute); }
  .cx-reviews-more { display: none; }
  .cx-reviews-edge {
    position: absolute;
    top: 50%;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(0,67,129,.17);
    border-radius: 999px;
    background: rgba(255,255,255,.88);
    color: var(--cx-forest);
    box-shadow: 0 18px 44px rgba(0,37,73,.14), inset 0 1px 0 rgba(255,255,255,.88);
    backdrop-filter: blur(16px);
    transform: translateY(-50%);
    cursor: pointer;
    transition: transform .24s ease, opacity .24s ease, background .24s ease, box-shadow .24s ease;
  }
  .cx-reviews-edge span {
    font-family: var(--cx-f-display);
    font-size: 31px;
    line-height: 1;
    margin-top: -3px;
  }
  .cx-reviews-edge:hover {
    background: var(--cx-forest);
    color: #fff;
    box-shadow: 0 22px 50px rgba(0,37,73,.20);
  }
  .cx-reviews-edge:active { transform: translateY(-50%) scale(.96); }
  .cx-reviews-edge:disabled {
    opacity: .28;
    pointer-events: none;
  }
  .cx-reviews-edge[data-cx-reviews-prev] { left: 4px; }
  .cx-reviews-edge[data-cx-reviews-next] { right: 4px; }
  .cx-reviews-mobile-rail {
    position: relative;
    z-index: 1;
    display: block;
    width: min(320px, 44vw);
    height: 7px;
    margin: 22px auto 0;
    border-radius: 999px;
    background:
      linear-gradient(90deg, rgba(0,37,73,0), rgba(0,37,73,.16) 14%, rgba(0,37,73,.16) 86%, rgba(0,37,73,0));
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(0,37,73,.08);
  }
  .cx-reviews-mobile-rail::before,
  .cx-reviews-mobile-rail::after {
    content: "";
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 7px;
    height: 7px;
    border-top: 1.5px solid rgba(0,37,73,.42);
    border-right: 1.5px solid rgba(0,37,73,.42);
  }
  .cx-reviews-mobile-rail::before {
    left: 5px;
    transform: translateY(-50%) rotate(-135deg);
  }
  .cx-reviews-mobile-rail::after {
    right: 5px;
    transform: translateY(-50%) rotate(45deg);
  }
  .cx-reviews-mobile-rail span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--cx-review-progress-x, 0%);
    width: var(--cx-review-progress-w, 24%);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--cx-gold), var(--cx-blue), var(--cx-forest));
    box-shadow: 0 0 18px rgba(0,118,194,.28), 0 0 8px rgba(209,170,84,.28);
    transition: left .62s cubic-bezier(.2,.78,.16,1), width .32s ease;
    animation: cxReviewsRailPulse 1800ms ease-in-out infinite;
  }

  @media (max-width: 900px) {
    .cx-reviews-card { flex-basis: calc((100% - 20px) / 2); }
  }

  @media (max-width: 640px) {
    .cx-section-reviews .cx-root { padding-top: 56px; padding-bottom: 66px; }
    .cx-section-reviews .cx-root::after { width: 520px; height: 520px; top: 52%; }
    .cx-reviews-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 22px;
    }
    .cx-reviews-header .cx-h2 {
      max-width: 10ch;
      font-size: clamp(38px, 12vw, 54px);
    }
    .cx-reviews-rating {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 12px;
      align-items: center;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      text-align: left;
    }
    .cx-reviews-score { grid-row: span 2; font-size: 44px; }
    .cx-reviews-stars { justify-content: flex-start; margin-top: 0; }
    .cx-reviews-filters {
      gap: 10px;
      margin: 0 -16px 18px;
      padding: 2px 16px 12px;
      scroll-snap-type: x proximity;
      mask-image: linear-gradient(90deg, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
    }
    .cx-reviews-filters .cx-pill {
      min-height: 44px;
      padding: 11px 17px;
      scroll-snap-align: start;
    }
    .cx-reviews-stage {
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .cx-reviews-grid {
      gap: 14px;
      overflow-x: auto;
      padding: 2px 0 10px;
    }
    .cx-reviews-card {
      flex: 0 0 calc(100vw - 54px);
      min-height: 348px;
      padding: 25px 22px 22px;
    }
    .cx-reviews-card:hover { transform: none; }
    .cx-reviews-card.cx-has-more .cx-reviews-more {
      display: inline-flex;
    }
    .cx-reviews-more {
      align-items: center;
      align-self: flex-start;
      gap: 7px;
      margin: -2px 0 0;
      padding: 8px 12px;
      border: 1px solid rgba(0,67,129,.12);
      border-radius: 999px;
      background: rgba(255,255,255,.78);
      color: var(--cx-forest);
      font-family: var(--cx-f-display), "DM Serif Display", serif;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: .08em;
      text-transform: uppercase;
      box-shadow: 0 10px 24px rgba(0,37,73,.07), inset 0 1px 0 rgba(255,255,255,.80);
      cursor: pointer;
    }
    .cx-reviews-more::after {
      content: "\2192";
      transition: transform .24s ease;
    }
    .cx-reviews-card.cx-is-expanded .cx-reviews-more::after {
      transform: rotate(-90deg);
    }
    .cx-reviews-edge {
      width: 32px;
      height: 68px;
    }
    .cx-reviews-edge span { font-size: 24px; }
    .cx-reviews-edge[data-cx-reviews-prev] { left: 2px; }
    .cx-reviews-edge[data-cx-reviews-next] { right: 2px; }
    .cx-reviews-mobile-rail {
      width: min(232px, 66vw);
      margin-top: 16px;
    }
  }

  @keyframes cxReviewsRailPulse {
    0%, 100% { filter: saturate(1); opacity: .82; }
    50% { filter: saturate(1.18); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-reviews-grid,
    .cx-reviews-mobile-rail span {
      scroll-behavior: auto;
      transition: none;
      animation: none;
    }
  }
</style>

<script>
(function () {
  var scopes = document.querySelectorAll('.cx-section-reviews .cx-root');
  scopes.forEach(function (scope) {
    var track = scope.querySelector('[data-cx-reviews-track]');
    var rail = scope.querySelector('[data-cx-reviews-rail]');
    var railThumb = rail ? rail.querySelector('span') : null;
    var prev = scope.querySelector('[data-cx-reviews-prev]');
    var next = scope.querySelector('[data-cx-reviews-next]');
    var filters = scope.querySelector('[data-cx-review-filter]');
    if (!track) return;

    var cards = Array.prototype.slice.call(track.querySelectorAll('.cx-reviews-card'));
    var autoplay = null;
    var resume = null;
    var scrollTicking = false;
    var dragging = false;
    var dragStartX = 0;
    var dragStartScroll = 0;
    var dragMoved = false;
    var WORD_LIMIT = 10;

    function isMobile() {
      return window.matchMedia('(max-width: 640px)').matches;
    }

    function prefersReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function visibleCount() {
      if (isMobile()) return 1;
      if (window.matchMedia('(max-width: 900px)').matches) return 2;
      return 3;
    }

    function stepSize() {
      var first = cards[0];
      if (!first) return track.clientWidth;
      var styles = window.getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return first.getBoundingClientRect().width + gap;
    }

    function maxIndex() {
      return Math.max(0, cards.length - visibleCount());
    }

    function activeIndex() {
      return Math.max(0, Math.min(maxIndex(), Math.round(track.scrollLeft / stepSize())));
    }

    function updateRail() {
      if (!railThumb) return;
      var max = maxIndex();
      var width = cards.length > 0 ? (visibleCount() / cards.length) * 100 : 100;
      var x = max > 0 ? activeIndex() * ((100 - width) / max) : 0;
      railThumb.style.setProperty('--cx-review-progress-w', width + '%');
      railThumb.style.setProperty('--cx-review-progress-x', x + '%');
      if (prev) prev.disabled = activeIndex() === 0;
      if (next) next.disabled = activeIndex() >= max;
    }

    function goTo(index, behavior) {
      var target = Math.max(0, Math.min(maxIndex(), index));
      track.scrollTo({
        left: target * stepSize(),
        behavior: behavior || (prefersReducedMotion() ? 'auto' : 'smooth')
      });
      window.setTimeout(updateRail, 90);
    }

    function stopAutoplay() {
      if (autoplay) window.clearInterval(autoplay);
      autoplay = null;
      if (rail) rail.classList.remove('cx-is-autoplaying');
    }

    function startAutoplay() {
      stopAutoplay();
      if (maxIndex() < 1 || prefersReducedMotion()) return;
      if (rail) rail.classList.add('cx-is-autoplaying');
      autoplay = window.setInterval(function () {
        var current = activeIndex();
        goTo(current >= maxIndex() ? 0 : current + 1);
      }, 5000);
    }

    function pauseAutoplay() {
      stopAutoplay();
      if (resume) window.clearTimeout(resume);
      resume = window.setTimeout(startAutoplay, 7600);
    }

    function getWords(text) {
      return String(text || '').trim().split(/\s+/).filter(Boolean);
    }

    function truncateWords(text) {
      var words = getWords(text);
      if (words.length <= WORD_LIMIT) return text;
      return words.slice(0, WORD_LIMIT).join(' ') + '...';
    }

    function applyMobileReadMore() {
      cards.forEach(function (card) {
        var body = card.querySelector('.cx-reviews-body');
        var button = card.querySelector('[data-cx-reviews-more]');
        if (!body || !button) return;

        if (!body.dataset.fullText) {
          body.dataset.fullText = body.textContent.trim();
        }

        var full = body.dataset.fullText;
        var hasMore = getWords(full).length > WORD_LIMIT;
        card.classList.toggle('cx-has-more', isMobile() && hasMore);

        if (!isMobile() || !hasMore) {
          card.classList.remove('cx-is-expanded');
          body.textContent = full;
          button.setAttribute('aria-expanded', 'false');
          button.textContent = 'Meer lezen';
          return;
        }

        if (card.classList.contains('cx-is-expanded')) {
          body.textContent = full;
          button.textContent = 'Minder lezen';
          button.setAttribute('aria-expanded', 'true');
        } else {
          body.textContent = truncateWords(full);
          button.textContent = 'Meer lezen';
          button.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if (prev) prev.addEventListener('click', function () {
      pauseAutoplay();
      goTo(activeIndex() - 1);
    });

    if (next) next.addEventListener('click', function () {
      pauseAutoplay();
      goTo(activeIndex() + 1);
    });

    track.addEventListener('click', function (event) {
      var button = event.target.closest('[data-cx-reviews-more]');
      if (!button) return;
      pauseAutoplay();
      var card = button.closest('.cx-reviews-card');
      if (!card) return;
      var expanded = card.classList.toggle('cx-is-expanded');
      var body = card.querySelector('.cx-reviews-body');
      if (body && body.dataset.fullText) {
        body.textContent = expanded ? body.dataset.fullText : truncateWords(body.dataset.fullText);
      }
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      button.textContent = expanded ? 'Minder lezen' : 'Meer lezen';
    });

    track.addEventListener('scroll', function () {
      if (scrollTicking) return;
      scrollTicking = true;
      window.requestAnimationFrame(function () {
        updateRail();
        scrollTicking = false;
      });
    }, { passive: true });

    track.addEventListener('pointerdown', function (event) {
      pauseAutoplay();
      dragging = true;
      dragMoved = false;
      dragStartX = event.clientX;
      dragStartScroll = track.scrollLeft;
      track.setPointerCapture(event.pointerId);
    });

    track.addEventListener('pointermove', function (event) {
      if (!dragging) return;
      var delta = event.clientX - dragStartX;
      if (Math.abs(delta) > 6) dragMoved = true;
      track.scrollLeft = dragStartScroll - delta;
    });

    track.addEventListener('pointerup', function (event) {
      if (!dragging) return;
      dragging = false;
      if (track.releasePointerCapture) track.releasePointerCapture(event.pointerId);
      goTo(activeIndex());
    });

    track.addEventListener('pointercancel', function () {
      dragging = false;
      goTo(activeIndex());
    });

    track.addEventListener('click', function (event) {
      if (!dragMoved) return;
      event.preventDefault();
      event.stopPropagation();
      dragMoved = false;
    }, true);

    if (filters) {
      filters.addEventListener('click', function (event) {
        if (!event.target.closest('[data-cx-review-pill]')) return;
        pauseAutoplay();
        goTo(0, 'auto');
      });
    }

    window.addEventListener('resize', function () {
      applyMobileReadMore();
      updateRail();
