{%- comment -%}
  CALQIX Navy Rebuild — Reviews (filter pills + 3 cards + aggregate rating).
  Source: _incoming/calqix-web-upgrade/handoff/source/components/body.jsx → Reviews
{%- endcomment -%}

{%- assign cx_filters = 'homepage.reviews.filter_options' | t | split: ',' -%}
{%- liquid
  assign cx_reviews_eyebrow = 'homepage.reviews.eyebrow' | t
  assign cx_reviews_heading = 'homepage.reviews.heading_html' | t
  assign cx_reviews_count_label = 'homepage.reviews.rating_count_label' | t
  assign cx_reviews_verified = 'homepage.reviews.verified_label' | t
-%}

{% render 'cx-section-overrides', section: section %}
<section class="cx-root cx-section" data-cx-reveal>
  <div class="cx-container">
    <div class="cx-reviews-header">
      <div class="cx-stack cx-gap-sm">
        {% render 'cx-eyebrow', text: cx_reviews_eyebrow %}
        <h2 class="cx-h2">{{ cx_reviews_heading }}</h2>
      </div>
      <div class="cx-reviews-rating">
        <div class="cx-gold-shimmer cx-reviews-score" data-cx-count="{{ section.settings.rating_value }}" data-cx-count-decimals="1" data-cx-count-duration="1600">0,0</div>
        <div class="cx-reviews-stars">
          {%- for i in (1..5) -%}{% render 'cx-icons', name: 'star', size: 16 %}{%- endfor -%}
        </div>
        <div class="cx-eyebrow cx-reviews-count">{{ section.settings.rating_count }} {{ cx_reviews_count_label }}</div>
      </div>
    </div>

    {%- if cx_filters.size > 0 -%}
      <div class="cx-reviews-filters" data-cx-review-filter>
        {%- for f in cx_filters -%}
          {%- assign label = f | strip -%}
          <button type="button" class="cx-pill{% if forloop.first %} cx-is-active{% endif %}" data-cx-review-pill>{{ label }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cx-reviews-stage" data-cx-reviews-stage>
      <button type="button" class="cx-reviews-edge" data-cx-reviews-prev aria-label="Vorige review">
        <span aria-hidden="true">‹</span>
      </button>
      <div class="cx-reviews-grid" data-cx-col3 data-cx-stagger data-cx-reviews-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="cx-reviews-card cx-lux-lift" {{ block.shopify_attributes }}>
            {%- assign cx_review_prefix = 'homepage.reviews.review_' | append: forloop.index -%}
            {%- assign cx_review_title_key = cx_review_prefix | append: '_title' -%}
            {%- assign cx_review_body_key = cx_review_prefix | append: '_body' -%}
            {%- assign cx_review_verified_key = cx_review_prefix | append: '_verified' -%}
            <div class="cx-reviews-stars-row">
              {%- assign r = block.settings.rating | plus: 0 -%}
              {%- for i in (1..r) -%}{% render 'cx-icons', name: 'star', size: 14 %}{%- endfor -%}
            </div>
            <h3 class="cx-reviews-title">&ldquo;{{ cx_review_title_key | t }}&rdquo;</h3>
            <p class="cx-reviews-body">{{ cx_review_body_key | t }}</p>
            <button type="button" class="cx-reviews-more" data-cx-reviews-more aria-expanded="false">Meer lezen</button>
            <div class="cx-reviews-footer">
              <div>
                <div class="cx-reviews-name">{{ block.settings.name }}</div>
                <div class="cx-reviews-date">{{ block.settings.date }}</div>
              </div>
              <div class="cx-reviews-verified">
                ✓ {{ cx_reviews_verified }}<br>
                <span>{{ cx_review_verified_key | t }}</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>
      <button type="button" class="cx-reviews-edge" data-cx-reviews-next aria-label="Volgende review">
        <span aria-hidden="true">›</span>
      </button>
    </div>
    <div class="cx-reviews-mobile-rail" data-cx-reviews-rail aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  .cx-reviews-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 32px; gap: 24px; flex-wrap: wrap;
  }
  .cx-reviews-rating { text-align: right; }
  .cx-reviews-score { font-family: var(--cx-f-display); font-size: 60px; line-height: 1; }
  .cx-reviews-stars { display: flex; gap: 2px; justify-content: flex-end; margin-top: 4px; color: var(--cx-gold); }
  .cx-reviews-count { margin-top: 6px; }
  .cx-reviews-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px; }
  .cx-reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .cx-reviews-card {
    border: 1px solid var(--cx-rule);
    border-radius: var(--cx-r-md);
    padding: 28px;
    background: var(--cx-page);
    display: flex; flex-direction: column; gap: 14px;
  }
  .cx-reviews-stars-row { display: flex; gap: 2px; color: var(--cx-gold); }
  .cx-reviews-title { font-family: var(--cx-f-display); font-size: 18px; margin: 0; color: var(--cx-forest-3); }
  .cx-reviews-body { margin: 0; font-size: 14.5px; color: var(--cx-ink-soft); }
  .cx-reviews-footer {
    border-top: 1px solid var(--cx-rule);
    padding-top: 14px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .cx-reviews-name { font-size: 13px; font-weight: 500; color: var(--cx-ink); }
  .cx-reviews-date { font-family: var(--cx-f-mono); font-size: 10.5px; color: var(--cx-ink-mute); }
  .cx-reviews-verified {
    font-family: var(--cx-f-mono); font-size: 10px;
    color: var(--cx-gold-ink); letter-spacing: 0.06em;
    text-align: right; max-width: 130px;
  }
  .cx-reviews-verified span { color: var(--cx-ink-mute); }
  .cx-reviews-stage { position: relative; }
  .cx-reviews-edge,
  .cx-reviews-mobile-rail,
  .cx-reviews-more {
    display: none;
  }

  @media (max-width: 640px) {
    .cx-section-reviews .cx-root {
      padding-top: 56px;
      padding-bottom: 66px;
    }
    .cx-reviews-header {
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 22px;
    }
    .cx-reviews-header .cx-h2 {
      max-width: 10ch;
      font-size: clamp(38px, 12vw, 54px);
    }
    .cx-reviews-rating {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 12px;
      align-items: center;
      text-align: left;
    }
    .cx-reviews-score {
      grid-row: span 2;
      font-size: 44px;
    }
    .cx-reviews-stars {
      justify-content: flex-start;
      margin-top: 0;
    }
    .cx-reviews-count {
      margin-top: 1px;
      font-size: 10px;
    }
    .cx-reviews-filters {
      flex-wrap: nowrap;
      gap: 10px;
      margin: 0 -16px 18px;
      padding: 2px 16px 12px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      mask-image: linear-gradient(90deg, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
    }
    .cx-reviews-filters::-webkit-scrollbar { display: none; }
    .cx-reviews-filters .cx-pill {
      flex: 0 0 auto;
      min-height: 44px;
      padding: 11px 17px;
      scroll-snap-align: start;
      box-shadow: 0 10px 26px rgba(0, 37, 73, .06);
    }
    .cx-reviews-stage {
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .cx-reviews-grid {
      display: flex;
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding: 2px 0 10px;
      mask-image: linear-gradient(90deg, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
    }
    .cx-reviews-grid::-webkit-scrollbar { display: none; }
    .cx-reviews-card {
      flex: 0 0 calc(100vw - 54px);
      min-height: 348px;
      scroll-snap-align: center;
      padding: 25px 22px 22px;
      border-radius: 18px;
      background:
        radial-gradient(circle at 88% 12%, rgba(209, 170, 84, .10), transparent 25%),
        linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,250,255,.92));
      box-shadow: 0 18px 46px rgba(0, 37, 73, .08), inset 0 1px 0 rgba(255,255,255,.78);
    }
    .cx-reviews-card:hover { transform: none; }
    .cx-reviews-card:not(.cx-is-expanded) .cx-reviews-body {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      max-height: 6.7em;
      overflow: hidden;
    }
    .cx-reviews-more {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      gap: 7px;
      margin: -3px 0 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--cx-gold-ink);
      font-family: var(--cx-f-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      cursor: pointer;
    }
    .cx-reviews-more::after {
      content: "→";
      transition: transform .24s ease;
    }
    .cx-reviews-card.cx-is-expanded .cx-reviews-more::after {
      transform: rotate(-90deg);
    }
    .cx-reviews-edge {
      position: absolute;
      top: 50%;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 68px;
      border: 1px solid rgba(0, 67, 129, .18);
      border-radius: 999px;
      background: rgba(255,255,255,.86);
      color: var(--cx-forest);
      box-shadow: 0 16px 38px rgba(0, 37, 73, .14), inset 0 1px 0 rgba(255,255,255,.86);
      backdrop-filter: blur(14px);
      transform: translateY(-50%);
      cursor: pointer;
      transition: transform .24s ease, opacity .24s ease, background .24s ease;
    }
    .cx-reviews-edge span {
      font-family: var(--cx-f-display);
      font-size: 24px;
      line-height: 1;
      margin-top: -2px;
    }
    .cx-reviews-edge[data-cx-reviews-prev] { left: 2px; }
    .cx-reviews-edge[data-cx-reviews-next] { right: 2px; }
    .cx-reviews-edge:active { transform: translateY(-50%) scale(.96); }
    .cx-reviews-edge:disabled {
      opacity: .24;
      pointer-events: none;
    }
    .cx-reviews-mobile-rail {
      position: relative;
      display: block;
      width: min(232px, 66vw);
      height: 7px;
      margin: 16px auto 0;
      border-radius: 999px;
      background:
        linear-gradient(90deg, rgba(0,37,73,0), rgba(0,37,73,.16) 14%, rgba(0,37,73,.16) 86%, rgba(0,37,73,0));
      overflow: hidden;
      box-shadow: 0 12px 28px rgba(0, 37, 73, .08);
    }
    .cx-reviews-mobile-rail::before,
    .cx-reviews-mobile-rail::after {
      content: "";
      position: absolute;
      top: 50%;
      z-index: 2;
      width: 7px;
      height: 7px;
      border-top: 1.5px solid rgba(0, 37, 73, .42);
      border-right: 1.5px solid rgba(0, 37, 73, .42);
    }
    .cx-reviews-mobile-rail::before {
      left: 5px;
      transform: translateY(-50%) rotate(-135deg);
    }
    .cx-reviews-mobile-rail::after {
      right: 5px;
      transform: translateY(-50%) rotate(45deg);
    }
    .cx-reviews-mobile-rail span {
      position: absolute;
      inset: 0 auto 0 0;
      width: var(--cx-review-progress-w, 24%);
      border-radius: inherit;
      background: linear-gradient(90deg, var(--cx-gold), var(--cx-blue), var(--cx-forest));
      box-shadow: 0 0 18px rgba(0,118,194,.28), 0 0 8px rgba(209,170,84,.28);
      transform: translateX(var(--cx-review-progress-x, 0%));
      transition: transform .62s cubic-bezier(.2, .78, .16, 1), width .32s ease;
      animation: cxReviewsRailPulse 1800ms ease-in-out infinite;
    }
  }

  @keyframes cxReviewsRailPulse {
    0%, 100% { filter: saturate(1); opacity: .82; }
    50% { filter: saturate(1.18); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-reviews-grid,
    .cx-reviews-mobile-rail span {
      scroll-behavior: auto;
      transition: none;
      animation: none;
    }
  }
</style>

<script>
(function () {
  var scopes = document.querySelectorAll('.cx-section-reviews .cx-root');
  scopes.forEach(function (scope) {
    var track = scope.querySelector('[data-cx-reviews-track]');
    var rail = scope.querySelector('[data-cx-reviews-rail]');
    var railThumb = rail ? rail.querySelector('span') : null;
    var prev = scope.querySelector('[data-cx-reviews-prev]');
    var next = scope.querySelector('[data-cx-reviews-next]');
    var filters = scope.querySelector('[data-cx-review-filter]');
    if (!track) return;

    var cards = Array.prototype.slice.call(track.querySelectorAll('.cx-reviews-card'));
    var autoplay = null;
    var resume = null;
    var scrollTicking = false;

    function isMobile() {
      return window.matchMedia('(max-width: 640px)').matches;
    }

    function prefersReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function stepSize() {
      var first = cards[0];
      if (!first) return track.clientWidth;
      var styles = window.getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return first.getBoundingClientRect().width + gap;
    }

    function maxIndex() {
      return Math.max(0, cards.length - 1);
    }

    function activeIndex() {
      return Math.max(0, Math.min(maxIndex(), Math.round(track.scrollLeft / stepSize())));
    }

    function updateRail() {
      if (!railThumb) return;
      var max = maxIndex();
      var width = max > 0 ? 100 / (max + 1) : 100;
      var x = max > 0 ? activeIndex() * 100 : 0;
      railThumb.style.setProperty('--cx-review-progress-w', width + '%');
      railThumb.style.setProperty('--cx-review-progress-x', x + '%');
      if (prev) prev.disabled = activeIndex() === 0;
      if (next) next.disabled = activeIndex() >= max;
    }

    function goTo(index, behavior) {
      var target = Math.max(0, Math.min(maxIndex(), index));
      track.scrollTo({
        left: target * stepSize(),
        behavior: behavior || (prefersReducedMotion() ? 'auto' : 'smooth')
      });
      window.setTimeout(updateRail, 90);
    }

    function stopAutoplay() {
      if (autoplay) window.clearInterval(autoplay);
      autoplay = null;
      if (rail) rail.classList.remove('cx-is-autoplaying');
    }

    function startAutoplay() {
      stopAutoplay();
      if (!isMobile() || maxIndex() < 1 || prefersReducedMotion()) return;
      if (rail) rail.classList.add('cx-is-autoplaying');
      autoplay = window.setInterval(function () {
        var current = activeIndex();
        goTo(current >= maxIndex() ? 0 : current + 1);
      }, 4800);
    }

    function pauseAutoplay() {
      stopAutoplay();
      if (resume) window.clearTimeout(resume);
      resume = window.setTimeout(startAutoplay, 7600);
    }

    if (prev) prev.addEventListener('click', function () {
      pauseAutoplay();
      goTo(activeIndex() - 1);
    });

    if (next) next.addEventListener('click', function () {
      pauseAutoplay();
      goTo(activeIndex() + 1);
    });

    track.addEventListener('click', function (event) {
      var button = event.target.closest('[data-cx-reviews-more]');
      if (!button) return;
      pauseAutoplay();
      var card = button.closest('.cx-reviews-card');
      if (!card) return;
      var expanded = card.classList.toggle('cx-is-expanded');
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      button.textContent = expanded ? 'Minder lezen' : 'Meer lezen';
    });

    track.addEventListener('scroll', function () {
      if (scrollTicking) return;
      scrollTicking = true;
      window.requestAnimationFrame(function () {
        updateRail();
        scrollTicking = false;
      });
    }, { passive: true });

    track.addEventListener('pointerdown', pauseAutoplay, { passive: true });
    track.addEventListener('touchstart', pauseAutoplay, { passive: true });

    if (filters) {
      filters.addEventListener('click', function (event) {
        if (!event.target.closest('[data-cx-review-pill]')) return;
        pauseAutoplay();
        goTo(0, 'auto');
      });
    }

    window.addEventListener('resize', function () {
      updateRail();
      startAutoplay();
    });

    updateRail();
    startAutoplay();
  });
})();
</script>

{% schema %}
{
  "name": "CX Reviews",
  "tag": "section",
  "class": "cx-section-reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Social proof" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>What customers <em>say.</em></p>" },
    { "type": "text", "id": "rating_value", "label": "Average score", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Review count", "default": "2,184" },
    { "type": "text", "id": "rating_count_label", "label": "Review count label", "default": "verified reviews" },
    { "type": "text", "id": "verified_label", "label": "Verified badge label (uppercase)", "default": "VERIFIED" },
    { "type": "textarea", "id": "filter_options", "label": "Filter pills (comma-separated)", "default": "All reviews, Most recent, Sensitive teeth, Whitening, Fresh breath, Daily routine" },

    { "type": "header", "content": "Style overrides" },
    { "type": "color", "id": "ovr_bg", "label": "Background color" },
    { "type": "color", "id": "ovr_fg", "label": "Text color" },
    { "type": "color", "id": "ovr_accent", "label": "Accent / italic color" },
    {
      "type": "select", "id": "ovr_font", "label": "Heading font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Display (Playfair)" },
        { "value": "sans",    "label": "Sans (Inter)" },
        { "value": "mono",    "label": "Mono" }
      ]
    },
    { "type": "range", "id": "ovr_h_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Laurie M." },
        { "type": "text", "id": "date", "label": "Date", "default": "January 14, 2026" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Found what I was looking for" },
        { "type": "textarea", "id": "body", "label": "Review", "default": "Tried everything in whitening toothpaste. After 30 days my dentist was the first to compliment how naturally healthy my teeth looked." },
        { "type": "text", "id": "verified", "label": "Verification", "default": "Fresh Mint · 3 months" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "review", "settings": { "name": "Laurie M.", "date": "January 14, 2026", "rating": 5, "title": "Found what I was looking for", "body": "Tried everything in whitening toothpaste. After 30 days my dentist was the first to compliment how naturally healthy my teeth looked. That says it all.", "verified": "Fresh Mint · 3 months" } },
      { "type": "review", "settings": { "name": "Dennis B.", "date": "January 12, 2026", "rating": 5, "title": "Real difference",            "body": "I have very sensitive teeth. After a few weeks of OralBiome Pro — without mouthwash that wipes out 700 species — everything finally feels calm.", "verified": "Cool Mint · 6 weeks" } },
      { "type": "review", "settings": { "name": "Leni K.",   "date": "January 10, 2026", "rating": 5, "title": "Finally fluoride-free",       "body": "Finally an option I don't have to second-guess. The ingredients are what they say they are, the science holds up, and it works.", "verified": "Peach · subscribed" } }
    ]
  }
}
{% endschema %}
