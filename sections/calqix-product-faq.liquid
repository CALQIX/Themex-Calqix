    </div>

    <div class="cqa-item">
      <button class="cqa-trigger" type="button" aria-controls="cpf-panel-6-{{ section.id }}" aria-expanded="false">
        {{ faq_q6 }}
        <span class="cqa-icon" aria-hidden="true">+</span>
      </button>
      <div id="cpf-panel-6-{{ section.id }}" class="cqa-body" role="region" aria-hidden="true">
        <div class="cqa-content">
