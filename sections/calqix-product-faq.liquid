{% assign cq_lang = request.locale.iso_code | downcase | slice: 0, 2 %}
{% assign cq_flowcore_handles = 'calqix-flowcore,flowcore-white,flowcore-green,flowcore-pink' | split: ',' %}
{% assign cq_is_flowcore = false %}
{% if product != blank and cq_flowcore_handles contains product.handle %}
  {% assign cq_is_flowcore = true %}
{% endif %}
{% assign faq_heading = 'Common questions' %}
{% assign faq_q1 = 'How long does the battery last?' %}
{% assign faq_a1 = 'A single USB-C charge powers the FlowCore for up to 30 days of daily use, based on 60 seconds per session. The LED indicator shows battery status. Charging takes approximately 4 hours from empty.' %}
{% assign faq_q2 = 'Is it safe to use with braces or implants?' %}
{% assign faq_a2 = 'Yes. The FlowCore includes a dedicated orthodontic nozzle for cleaning around brackets and wires, and a periodontal nozzle optimised for implant care. Start with Gentle mode if you are new to water flossing.' %}
{% assign faq_q3 = 'How often should I use it?' %}
{% assign faq_a3 = 'Once daily is sufficient for most users. Use it before brushing and before applying your CALQIX nano-HA tablet, so that remineralisation works on a clean enamel surface. Twice daily is safe and beneficial for users managing active gum inflammation.' %}
{% assign faq_q4 = 'What is the difference between the 4 pressure modes?' %}
{% assign faq_a4 = 'Gentle is recommended for first-time users and sensitive gums. Clean is the standard daily mode for most users. Pulse delivers an alternating pressure pattern effective for dislodging stubborn plaque. Turbo is maximum pressure for users who require deeper cleaning or have been advised by a dental professional.' %}
{% assign faq_q5 = 'Can I use it in the shower?' %}
{% assign faq_a5 = 'Yes. The FlowCore is IPX7 waterproof, meaning it is fully submersible up to 1 metre for 30 minutes. It is safe for shower use. Do not submerge the USB-C charging port while charging.' %}
{% assign faq_q6 = 'What is included in the box?' %}
{% assign faq_a6 = 'The FlowCore comes with one device, four replacement nozzles (standard, orthodontic, periodontal, tongue cleaner), one USB-C charging cable, one travel pouch, and a quick-start guide.' %}
{% if cq_is_flowcore %}
  {% case cq_lang %}
    {% when 'nl' %}
      {% assign faq_heading = 'Veelgestelde vragen' %}
      {% assign faq_q1 = 'Hoe lang gaat de batterij mee?' %}
      {% assign faq_a1 = 'Eén USB-C-lading laat de FlowCore bij dagelijks gebruik tot 30 dagen meegaan, uitgaand van 60 seconden per sessie. De LED-indicator toont de batterijstatus. Opladen vanaf leeg duurt ongeveer 4 uur.' %}
      {% assign faq_q2 = 'Is het veilig bij een beugel of implantaten?' %}
      {% assign faq_a2 = 'Ja. De FlowCore bevat een speciale orthodontische nozzle voor reiniging rond brackets en draden, en een parodontale nozzle die is afgestemd op implantaatverzorging. Start met de modus Gentle als je nog niet eerder een monddouche hebt gebruikt.' %}
      {% assign faq_q3 = 'Hoe vaak moet ik hem gebruiken?' %}
      {% assign faq_a3 = 'Eén keer per dag is voor de meeste gebruikers voldoende. Gebruik hem vóór het poetsen en vóór je CALQIX nano-HA-tablet, zodat remineralisatie op een schoon glazuuroppervlak kan plaatsvinden. Twee keer per dag is veilig en zinvol voor gebruikers die actieve tandvleesontsteking onder controle houden.' %}
      {% assign faq_q4 = 'Wat is het verschil tussen de 4 drukstanden?' %}
      {% assign faq_a4 = 'Gentle wordt aanbevolen voor nieuwe gebruikers en gevoelig tandvlees. Clean is de standaardstand voor dagelijks gebruik. Pulse geeft een afwisselend drukpatroon dat helpt hardnekkige plaque los te maken. Turbo is de hoogste drukstand voor gebruikers die diepere reiniging nodig hebben of dit advies van een mondzorgprofessional hebben gekregen.' %}
      {% assign faq_q5 = 'Kan ik hem onder de douche gebruiken?' %}
      {% assign faq_a5 = 'Ja. De FlowCore is IPX7-waterdicht, wat betekent dat hij tot 30 minuten volledig ondergedompeld kan worden tot 1 meter diepte. Gebruik onder de douche is veilig. Dompel de USB-C-laadpoort niet onder tijdens het opladen.' %}
      {% assign faq_q6 = 'Wat zit er in de doos?' %}
      {% assign faq_a6 = 'De FlowCore wordt geleverd met één apparaat, vier vervangingsnozzles (standaard, orthodontisch, parodontaal, tongreiniger), één USB-C-laadkabel, één reisetui en een snelstartgids.' %}
    {% when 'de' %}
      {% assign faq_heading = 'Häufige Fragen' %}
      {% assign faq_q1 = 'Wie lange hält der Akku?' %}
      {% assign faq_a1 = 'Eine USB-C-Ladung versorgt den FlowCore bei täglicher Nutzung bis zu 30 Tage lang, ausgehend von 60 Sekunden pro Anwendung. Die LED-Anzeige zeigt den Akkustatus. Das Aufladen aus dem leeren Zustand dauert etwa 4 Stunden.' %}
      {% assign faq_q2 = 'Ist die Anwendung mit einer Zahnspange oder Implantaten sicher?' %}
      {% assign faq_a2 = 'Ja. Der FlowCore enthält eine spezielle orthodontische Düse zur Reinigung rund um Brackets und Drähte sowie eine parodontale Düse, die für die Pflege von Implantaten optimiert ist. Beginne mit dem Modus Gentle, wenn du neu beim Water Flossing bist.' %}
      {% assign faq_q3 = 'Wie oft sollte ich ihn verwenden?' %}
      {% assign faq_a3 = 'Einmal täglich ist für die meisten Anwender ausreichend. Verwende ihn vor dem Zähneputzen und vor deiner CALQIX nano-HA-Tablette, damit die Remineralisierung auf einer sauberen Schmelzoberfläche stattfinden kann. Zweimal täglich ist sicher und sinnvoll für Anwender, die eine aktive Zahnfleischentzündung kontrollieren.' %}
      {% assign faq_q4 = 'Worin unterscheiden sich die 4 Druckmodi?' %}
      {% assign faq_a4 = 'Gentle wird für Erstanwender und empfindliches Zahnfleisch empfohlen. Clean ist der Standardmodus für die tägliche Anwendung. Pulse liefert ein wechselndes Druckmuster, das hartnäckige Plaque effektiv löst. Turbo ist die höchste Druckstufe für Anwender, die eine tiefere Reinigung benötigen oder dies von einer zahnmedizinischen Fachperson empfohlen bekommen haben.' %}
      {% assign faq_q5 = 'Kann ich ihn unter der Dusche verwenden?' %}
      {% assign faq_a5 = 'Ja. Der FlowCore ist nach IPX7 wasserdicht, das heißt, er kann bis zu 30 Minuten lang vollständig in bis zu 1 Meter tiefes Wasser eingetaucht werden. Die Anwendung unter der Dusche ist sicher. Tauche den USB-C-Ladeanschluss während des Ladens nicht ins Wasser.' %}
      {% assign faq_q6 = 'Was ist in der Box enthalten?' %}
      {% assign faq_a6 = 'Der FlowCore wird mit einem Gerät, vier Ersatzdüsen (Standard, orthodontisch, parodontal, Zungenreiniger), einem USB-C-Ladekabel, einem Reisebeutel und einer Schnellstartanleitung geliefert.' %}
    {% when 'fr' %}
      {% assign faq_heading = 'Questions fréquentes' %}
      {% assign faq_q1 = 'Quelle est l’autonomie de la batterie ?' %}
      {% assign faq_a1 = 'Une charge USB-C permet au FlowCore de fonctionner jusqu’à 30 jours avec une utilisation quotidienne, sur la base de 60 secondes par session. Le voyant LED indique l’état de la batterie. Une charge complète depuis 0 prend environ 4 heures.' %}
      {% assign faq_q2 = 'Est-il sûr avec un appareil orthodontique ou des implants ?' %}
      {% assign faq_a2 = 'Oui. Le FlowCore comprend un embout orthodontique dédié pour nettoyer autour des bagues et des fils, ainsi qu’un embout parodontal optimisé pour le soin des implants. Commencez avec le mode Gentle si vous débutez avec l’hydropulseur.' %}
      {% assign faq_q3 = 'À quelle fréquence dois-je l’utiliser ?' %}
      {% assign faq_a3 = 'Une fois par jour suffit pour la plupart des utilisateurs. Utilisez-le avant le brossage et avant votre comprimé CALQIX nano-HA, afin que la reminéralisation agisse sur une surface d’émail propre. Deux utilisations par jour sont sûres et bénéfiques pour les utilisateurs qui gèrent une inflammation gingivale active.' %}
      {% assign faq_q4 = 'Quelle est la différence entre les 4 modes de pression ?' %}
      {% assign faq_a4 = 'Gentle est recommandé pour les nouveaux utilisateurs et les gencives sensibles. Clean est le mode quotidien standard pour la plupart des utilisateurs. Pulse délivre une pression alternée efficace pour déloger la plaque tenace. Turbo correspond à la pression maximale pour les utilisateurs qui ont besoin d’un nettoyage plus profond ou qui ont reçu ce conseil d’un professionnel dentaire.' %}
      {% assign faq_q5 = 'Puis-je l’utiliser sous la douche ?' %}
      {% assign faq_a5 = 'Oui. Le FlowCore est étanche IPX7, ce qui signifie qu’il peut être entièrement immergé jusqu’à 1 mètre pendant 30 minutes. Son utilisation sous la douche est sûre. N’immergez pas le port de charge USB-C pendant la charge.' %}
      {% assign faq_q6 = 'Que contient la boîte ?' %}
      {% assign faq_a6 = 'Le FlowCore est livré avec un appareil, quatre embouts de rechange (standard, orthodontique, parodontal, nettoyeur de langue), un câble de charge USB-C, une trousse de voyage et un guide de démarrage rapide.' %}
    {% when 'sv' %}
      {% assign faq_heading = 'Vanliga fragor' %}
    {% when 'nb' %}
      {% assign faq_heading = 'Vanlige sporsmal' %}
    {% when 'da' %}
      {% assign faq_heading = 'Ofte stillede sporsmal' %}
    {% when 'fi' %}
      {% assign faq_heading = 'Usein kysytyt kysymykset' %}
  {% endcase %}
{% endif %}
<section id="calqix-product-faq-{{ section.id }}" class="calqix-product-faq">
  <style>
    #calqix-product-faq-{{ section.id }} {
      box-sizing: border-box;
      width: 100%;
      max-width: 920px;
      margin: 0 auto;
      padding: 64px 20px 72px;
      background: linear-gradient(180deg, #f4f5f7 0%, #eef1f5 100%);
    }

    #calqix-product-faq-{{ section.id }} *,
    #calqix-product-faq-{{ section.id }} *::before,
    #calqix-product-faq-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #calqix-product-faq-{{ section.id }} .cpf-heading {
      margin: 0 0 28px;
      color: #1a3b5c;
      font-family: "DM Serif Display", serif;
      font-size: 34px;
      line-height: 1.1;
      font-weight: 400;
      text-align: center;
    }

    #calqix-product-faq-{{ section.id }} .cqa-wrap {
      border: 1px solid rgba(26, 59, 92, 0.08);
      border-radius: 10px;
      min-width: 0;
      background: #ffffff;
      overflow: hidden;
      box-shadow: 0 18px 46px rgba(15, 36, 56, 0.08);
    }

    #calqix-product-faq-{{ section.id }} .cqa-item {
      position: relative;
      border-bottom: 1px solid #e4e4e0;
      background: #ffffff;
      transition: background-color 200ms ease, transform 200ms ease;
    }

    #calqix-product-faq-{{ section.id }} .cqa-item:last-child {
      border-bottom: none;
    }

    #calqix-product-faq-{{ section.id }} .cqa-item:hover {
      background: #fbfbfc;
    }

    #calqix-product-faq-{{ section.id }} .cqa-item.open {
      background: linear-gradient(180deg, rgba(201, 168, 76, 0.08) 0%, #ffffff 34%);
    }

    #calqix-product-faq-{{ section.id }} .cqa-trigger {
      width: 100%;
      min-width: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      padding: 22px 24px;
      background: none;
      border: none;
      cursor: pointer;
      font-family: "DM Sans", sans-serif;
      font-size: 15px;
      font-weight: 600;
      color: #1a3b5c;
      letter-spacing: 0.02em;
      text-align: left;
      transition: color 0.2s ease, transform 0.2s ease;
    }

    #calqix-product-faq-{{ section.id }} .cqa-trigger:hover {
      color: #c9a84c;
    }

    #calqix-product-faq-{{ section.id }} .cqa-trigger:focus-visible {
      outline: 2px solid #c9a84c;
      outline-offset: 2px;
    }

    #calqix-product-faq-{{ section.id }} .cqa-icon {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: rgba(201, 168, 76, 0.14);
      font-size: 22px;
      color: #c9a84c;
      font-weight: 300;
      line-height: 1;
      flex-shrink: 0;
      margin-left: auto;
      transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #calqix-product-faq-{{ section.id }} .cqa-item.open .cqa-icon {
      transform: rotate(45deg);
      background: #c9a84c;
      color: #1a3b5c;
    }

    #calqix-product-faq-{{ section.id }} .cqa-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 500ms ease;
      will-change: max-height;
    }

    #calqix-product-faq-{{ section.id }} .cqa-content {
      min-width: 0;
      padding: 0 24px 24px;
      font-family: "DM Sans", sans-serif;
      font-size: 14px;
      color: #6b7280;
      line-height: 1.7;
      font-weight: 400;
      overflow-wrap: anywhere;
      word-break: break-word;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 250ms ease, transform 250ms ease;
    }

    #calqix-product-faq-{{ section.id }} .cqa-item.open .cqa-content {
      opacity: 1;
      transform: translateY(0);
    }

    #calqix-product-faq-{{ section.id }} .cqa-content p {
      margin: 0;
    }

    @media (max-width: 749px) {
      #calqix-product-faq-{{ section.id }} {
        padding: 56px 12px 64px;
      }

      #calqix-product-faq-{{ section.id }} .cpf-heading {
        font-size: 28px;
      }

      #calqix-product-faq-{{ section.id }} .cqa-trigger {
        padding: 18px 18px;
        font-size: 14px;
      }

      #calqix-product-faq-{{ section.id }} .cqa-content {
        padding: 0 18px 20px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #calqix-product-faq-{{ section.id }} *,
      #calqix-product-faq-{{ section.id }} *::before,
      #calqix-product-faq-{{ section.id }} *::after {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>

