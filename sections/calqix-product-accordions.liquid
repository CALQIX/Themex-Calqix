{% comment %}
  CALQIX — Product Accordions
  Bestandsnaam: sections/calqix-product-accordions.liquid
  
  Volledig aanpasbaar via Shopify Theme Customizer:
  - Onbeperkte accordions via blocks (voeg toe / verwijder / herorden via drag & drop)
  - Elke accordion: titel, content (rich text), standaard open/dicht
  - Kleuren, typografie, spacing allemaal instelbaar
  - Eerste accordion standaard open (instelbaar)
  - Custom CSS + JS per sectie
{% endcomment %}
{% assign cq_lang = request.locale.iso_code | downcase | slice: 0, 2 %}
{% assign cq_flowcore_handles = 'calqix-flowcore,flowcore-white,flowcore-green,flowcore-pink' | split: ',' %}
{% assign cq_is_flowcore = false %}
{% if product != blank and cq_flowcore_handles contains product.handle %}
  {% assign cq_is_flowcore = true %}
{% endif %}
{% assign cqa_empty_state = 'Voeg accordions toe via de Theme Customizer → "Block toevoegen"' %}
{% if cq_is_flowcore %}
  {% case cq_lang %}
    {% when 'de' %}
      {% assign cqa_empty_state = 'Fügen Sie Accordions über den Theme-Customizer → "Block hinzufügen" hinzu' %}
    {% when 'fr' %}
      {% assign cqa_empty_state = 'Ajoutez des accordéons via le personnalisateur de thème → "Ajouter un bloc"' %}
  {% endcase %}
{% endif %}

{% assign border_col  = section.settings.border_color %}
{% assign trigger_col = section.settings.trigger_color %}
{% assign icon_col    = section.settings.icon_color %}
{% assign content_col = section.settings.content_color %}
{% assign accent_col  = section.settings.accent_color %}
{% assign navy_col    = section.settings.navy_color %}
{% assign pad_v_desktop = section.settings.padding_vertical_desktop | default: section.settings.padding_vertical %}
{% assign pad_h_desktop = section.settings.padding_horizontal_desktop | default: section.settings.padding_horizontal %}
{% assign max_w_desktop = section.settings.max_width_desktop | default: section.settings.max_width %}
{% assign mar_t_desktop = section.settings.margin_top_desktop | default: 0 %}
{% assign mar_b_desktop = section.settings.margin_bottom_desktop | default: 0 %}

{% assign pad_v_tablet = section.settings.padding_vertical_tablet | default: pad_v_desktop %}
{% assign pad_h_tablet = section.settings.padding_horizontal_tablet | default: pad_h_desktop %}
{% assign max_w_tablet = section.settings.max_width_tablet | default: max_w_desktop %}
{% assign mar_t_tablet = section.settings.margin_top_tablet | default: mar_t_desktop %}
{% assign mar_b_tablet = section.settings.margin_bottom_tablet | default: mar_b_desktop %}

{% assign pad_v_mobile = section.settings.padding_vertical_mobile | default: pad_v_tablet %}
{% assign pad_h_mobile = section.settings.padding_horizontal_mobile | default: pad_h_tablet %}
{% assign max_w_mobile = section.settings.max_width_mobile | default: max_w_tablet %}
{% assign mar_t_mobile = section.settings.margin_top_mobile | default: mar_t_tablet %}
{% assign mar_b_mobile = section.settings.margin_bottom_mobile | default: mar_b_tablet %}
{% assign trigger_sz  = section.settings.trigger_font_size %}
{% assign content_sz  = section.settings.content_font_size %}

<style>
  #calqix-accordions-{{ section.id }} {
    box-sizing: border-box;
    width: 100%;
    padding: {{ pad_v_desktop }}px {{ pad_h_desktop }}px;
    max-width: min(100%, {{ max_w_desktop }}px);
    margin: {{ mar_t_desktop }}px auto {{ mar_b_desktop }}px;
    overflow-x: clip;
  }
  #calqix-accordions-{{ section.id }} *,
  #calqix-accordions-{{ section.id }} *::before,
  #calqix-accordions-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #calqix-accordions-{{ section.id }} .cqa-wrap {
    border: 1px solid rgba(26, 59, 92, 0.08);
    border-radius: 10px;
    min-width: 0;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 18px 46px rgba(15, 36, 56, 0.08);
  }

  #calqix-accordions-{{ section.id }} .cqa-item {
    position: relative;
    border-bottom: 1px solid {{ border_col }};
    background: #ffffff;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #calqix-accordions-{{ section.id }} .cqa-item:last-child {
    border-bottom: none;
  }

  #calqix-accordions-{{ section.id }} .cqa-item:hover {
    background: #fbfbfc;
  }

  #calqix-accordions-{{ section.id }} .cqa-item.open {
    background: linear-gradient(180deg, rgba(201, 168, 76, 0.08) 0%, #ffffff 34%);
  }

  #calqix-accordions-{{ section.id }} .cqa-trigger {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: {{ section.settings.trigger_padding | plus: 4 }}px 24px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: "DM Sans", sans-serif;
    font-size: {{ trigger_sz | plus: 1 }}px;
    font-weight: {{ section.settings.trigger_weight }};
    color: {{ trigger_col }};
    letter-spacing: 0.02em;
    text-align: left;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  #calqix-accordions-{{ section.id }} .cqa-trigger:hover {
    color: {{ accent_col }};
  }
  #calqix-accordions-{{ section.id }} .cqa-trigger:focus-visible {
    outline: 2px solid {{ accent_col }};
    outline-offset: 2px;
  }

  #calqix-accordions-{{ section.id }} .cqa-icon {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: rgba(201, 168, 76, 0.14);
    font-size: 22px;
    color: {{ icon_col }};
    font-weight: 300;
    line-height: 1;
    flex-shrink: 0;
    margin-left: auto;
    transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #calqix-accordions-{{ section.id }} .cqa-item.open .cqa-icon {
    transform: rotate(45deg);
    background: {{ accent_col }};
    color: {{ navy_col }};
  }

  #calqix-accordions-{{ section.id }} .cqa-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height {{ section.settings.animation_speed }}ms ease;
    will-change: max-height;
  }

  #calqix-accordions-{{ section.id }} .cqa-body.open {
    max-height: 0;
  }

  #calqix-accordions-{{ section.id }} .cqa-content {
    min-width: 0;
    padding: 0 24px {{ section.settings.trigger_padding | plus: 6 }}px;
    font-size: {{ content_sz }}px;
    color: {{ content_col }};
    line-height: calc({{ section.settings.line_height }} / 10);
    font-weight: 400;
    overflow-wrap: anywhere;
    word-break: break-word;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  #calqix-accordions-{{ section.id }} .cqa-item.open .cqa-content {
    opacity: 1;
    transform: translateY(0);
  }
  #calqix-accordions-{{ section.id }} .cqa-content > *:first-child {
    margin-top: 0;
  }
  #calqix-accordions-{{ section.id }} .cqa-content > *:last-child {
    margin-bottom: 0;
  }

  /* Rich text resets */
  #calqix-accordions-{{ section.id }} .cqa-content p {
    margin-bottom: 12px;
  }
  #calqix-accordions-{{ section.id }} .cqa-content p:last-child {
    margin-bottom: 0;
  }
  #calqix-accordions-{{ section.id }} .cqa-content ul,
  #calqix-accordions-{{ section.id }} .cqa-content ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
  }
  #calqix-accordions-{{ section.id }} .cqa-content li {
    padding-left: 20px;
    position: relative;
  }
  #calqix-accordions-{{ section.id }} .cqa-content ul li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: {{ accent_col }};
    font-weight: 600;
  }
  #calqix-accordions-{{ section.id }} .cqa-content ol {
    counter-reset: cqa-counter;
  }
  #calqix-accordions-{{ section.id }} .cqa-content ol li {
    counter-increment: cqa-counter;
  }
  #calqix-accordions-{{ section.id }} .cqa-content ol li::before {
    content: counter(cqa-counter) '.';
    position: absolute;
    left: 0;
    color: {{ accent_col }};
    font-weight: 700;
    font-size: 11px;
  }
  #calqix-accordions-{{ section.id }} .cqa-content strong {
    color: {{ navy_col }};
    font-weight: 600;
  }
  #calqix-accordions-{{ section.id }} .cqa-content a {
    color: {{ accent_col }};
    text-decoration: underline;
  }
  #calqix-accordions-{{ section.id }} .cqa-content img,
  #calqix-accordions-{{ section.id }} .cqa-content video,
  #calqix-accordions-{{ section.id }} .cqa-content iframe,
  #calqix-accordions-{{ section.id }} .cqa-content svg {
    max-width: 100%;
    height: auto;
  }
  #calqix-accordions-{{ section.id }} .cqa-content table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Specs grid (optioneel binnen content) */
  #calqix-accordions-{{ section.id }} .cqa-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  #calqix-accordions-{{ section.id }} .cqa-spec-row {
    display: flex;
    flex-direction: column;
    padding: 10px 16px 10px 0;
    border-bottom: 1px solid {{ border_col }};
  }
  #calqix-accordions-{{ section.id }} .cqa-spec-row:nth-last-child(-n+2) {
    border-bottom: none;
  }
  #calqix-accordions-{{ section.id }} .cqa-spec-key {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9B9B9B;
    font-weight: 600;
    margin-bottom: 3px;
  }
  #calqix-accordions-{{ section.id }} .cqa-spec-val {
    font-size: {{ content_sz }}px;
    color: {{ navy_col }};
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    #calqix-accordions-{{ section.id }} {
      padding: {{ pad_v_tablet }}px {{ pad_h_tablet }}px;
      max-width: min(100%, {{ max_w_tablet }}px);
      margin: {{ mar_t_tablet }}px auto {{ mar_b_tablet }}px;
    }
  }
  @media (max-width: 749px) {
    #calqix-accordions-{{ section.id }} {
      padding: {{ pad_v_mobile }}px {{ pad_h_mobile }}px;
      max-width: min(100%, {{ max_w_mobile }}px);
      margin: {{ mar_t_mobile }}px auto {{ mar_b_mobile }}px;
    }
    #calqix-accordions-{{ section.id }} .cqa-trigger {
      padding: {{ section.settings.trigger_padding }}px 18px;
      font-size: {{ trigger_sz }}px;
    }
    #calqix-accordions-{{ section.id }} .cqa-content {
      padding: 0 18px {{ section.settings.trigger_padding | plus: 2 }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #calqix-accordions-{{ section.id }} *,
    #calqix-accordions-{{ section.id }} *::before,
    #calqix-accordions-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
    }
  }

  {% if section.settings.custom_css != blank %}
    {{ section.settings.custom_css }}
  {% endif %}
</style>

<div id="calqix-accordions-{{ section.id }}" class="calqix-accordions">
  <div class="cqa-wrap">

    {% for block in section.blocks %}
      {% assign is_default_open = false %}
      {% if forloop.first and section.settings.first_open %}
        {% assign is_default_open = true %}
      {% endif %}
      {% if block.settings.force_open %}
        {% assign is_default_open = true %}
      {% endif %}
      {% assign cqa_title = block.settings.title %}
      {% assign cqa_content = block.settings.content %}
      {% if cq_is_flowcore %}
        {% case cq_lang %}
          {% when 'nl' %}
            {% case forloop.index %}
              {% when 1 %}
                {% assign cqa_title = 'Beschrijving' %}
                {% assign cqa_content = '<p><strong>Voordat uw glazuur zich kan herstellen, heeft het een schoon oppervlak nodig.</strong></p><p>Nano-hydroxyapatiet werkt door rechtstreeks aan tandglazuur te hechten. Plaque, bacteriën en resten blokkeren dat contact. FlowCore verwijdert die barrière, reikt 40% dieper in de interdentale ruimtes dan alleen een tandenborstel en maakt de weg vrij zodat remineralisatie daadwerkelijk kan werken.</p><p>Dit is stap 1 van de CALQIX-klinische routine.</p>' %}
              {% when 2 %}
                {% assign cqa_title = 'Voordelen' %}
                {% assign cqa_content = '<ul><li>Verwijdert tot 99,9% van plaque met 1.600 pulsaties per minuut</li><li>Reikt 6 mm subgingivaal, dieper dan elke tandenborstel of flossdraad</li><li>4 drukstanden: Gentle, Clean, Pulse, Turbo</li><li>360 ml watertank, voldoende voor een volledige sessie zonder bijvullen</li><li>IPX7-waterdicht, veilig onder de douche te gebruiken</li><li>30 dagen batterijduur op één USB-C-lading</li><li>Ontworpen voor gebruik vóór uw CALQIX-glazuurtablet voor maximale remineralisatie</li></ul>' %}
              {% when 3 %}
                {% assign cqa_title = 'Gebruik' %}
                {% assign cqa_content = '<ol><li>Vul het 360 ml reservoir met lauw water</li><li>Kies uw drukstand, begin met Gentle als u nieuw bent met een monddouche</li><li>Beweeg de tip in een hoek van 90° langs uw tandvleesrand en pauzeer 1 tot 2 seconden tussen de tanden</li><li>Leeg en spoel het reservoir na elk gebruik</li><li>Volg direct op met uw CALQIX-glazuurtablet voor de herstelfase</li></ol>' %}
              {% when 4 %}
                {% assign cqa_title = 'In de doos' %}
                {% assign cqa_content = '<ul><li>1× FlowCore-apparaat</li><li>4× vervangingsnozzles (standaard, orthodontisch, parodontaal, tongreiniger)</li><li>1× USB-C-laadkabel</li><li>1× reisetui</li><li>Snelstartgids</li></ul><p></p>' %}
              {% when 5 %}
                {% assign cqa_title = 'Verzending en retouren' %}
                {% assign cqa_content = '<p><strong>Nederland:</strong> 1 tot 2 werkdagen, gratis boven €80<br><strong>België / Duitsland:</strong> 2 tot 3 werkdagen, gratis boven €80<br><strong>Rest van de EU:</strong> 3 tot 5 werkdagen, vast tarief €5,95</p><p><strong>30 dagen retour</strong> op ongebruikte artikelen in de originele verpakking.<br><strong>2 jaar garantie</strong> op alle FlowCore-apparaten.</p>' %}
            {% endcase %}
          {% when 'de' %}
            {% case forloop.index %}
              {% when 1 %}
                {% assign cqa_title = 'Beschreibung' %}
                {% assign cqa_content = '<p><strong>Bevor sich Ihr Zahnschmelz wieder aufbauen kann, braucht er eine saubere Oberfläche.</strong></p><p>Nano-Hydroxylapatit wirkt, indem es sich direkt an den Zahnschmelz bindet. Plaque, Bakterien und Rückstände blockieren diesen Kontakt. FlowCore entfernt diese Barriere, erreicht die Zahnzwischenräume 40 % tiefer als eine Zahnbürste allein und schafft den Zugang, damit Remineralisierung tatsächlich wirken kann.</p><p>Dies ist Schritt 1 der klinischen CALQIX-Routine.</p>' %}
              {% when 2 %}
                {% assign cqa_title = 'Vorteile' %}
                {% assign cqa_content = '<ul><li>Entfernt bis zu 99,9 % Plaque mit 1.600 Pulsationen pro Minute</li><li>Erreicht subgingival 6 mm, tiefer als jede Zahnbürste oder Zahnseide</li><li>4 Druckmodi: Gentle, Clean, Pulse, Turbo</li><li>360-ml-Wassertank, ausreichend für eine vollständige Sitzung ohne Nachfüllen</li><li>IPX7-wasserdicht, sicher für die Anwendung unter der Dusche</li><li>30 Tage Akkulaufzeit mit einer einzigen USB-C-Ladung</li><li>Entwickelt für die Anwendung vor Ihrer CALQIX-Zahnschmelztablette für maximale Remineralisierung</li></ul>' %}
              {% when 3 %}
                {% assign cqa_title = 'Anwendung' %}
                {% assign cqa_content = '<ol><li>Füllen Sie den 360-ml-Tank mit lauwarmem Wasser</li><li>Wählen Sie Ihren Druckmodus, beginnen Sie mit Gentle, wenn Sie neu beim Water Flossing sind</li><li>Führen Sie die Spitze in einem 90°-Winkel entlang Ihres Zahnfleischrands und pausieren Sie 1 bis 2 Sekunden zwischen den Zähnen</li><li>Leeren und spülen Sie den Tank nach jeder Anwendung</li><li>Verwenden Sie direkt danach Ihre CALQIX-Zahnschmelztablette für die Wiederaufbauphase</li></ol>' %}
              {% when 4 %}
                {% assign cqa_title = 'Lieferumfang' %}
                {% assign cqa_content = '<ul><li>1× FlowCore-Gerät</li><li>4× Ersatzdüsen (Standard, orthodontisch, parodontal, Zungenreiniger)</li><li>1× USB-C-Ladekabel</li><li>1× Reisebeutel</li><li>Schnellstartanleitung</li></ul><p></p>' %}
              {% when 5 %}
                {% assign cqa_title = 'Versand & Rückgabe' %}
                {% assign cqa_content = '<p><strong>Niederlande:</strong> 1 bis 2 Werktage, kostenlos ab €80<br><strong>Belgien / Deutschland:</strong> 2 bis 3 Werktage, kostenlos ab €80<br><strong>Rest der EU:</strong> 3 bis 5 Werktage, Pauschale €5,95</p><p><strong>30 Tage Rückgabe</strong> für unbenutzte Artikel in der Originalverpackung.<br><strong>2 Jahre Garantie</strong> auf alle FlowCore-Geräte.</p>' %}
            {% endcase %}
          {% when 'fr' %}
            {% case forloop.index %}
              {% when 1 %}
                {% assign cqa_title = 'Description' %}
                {% assign cqa_content = '<p><strong>Avant que votre émail puisse se reconstruire, il a besoin d’une surface propre.</strong></p><p>Le nano-hydroxyapatite agit en se liant directement à l’émail dentaire. La plaque, les bactéries et les résidus bloquent ce contact. FlowCore enlève cette barrière, atteint les espaces interdentaires 40 % plus profondément qu’une brosse à dents seule et libère la voie pour que la reminéralisation puisse réellement agir.</p><p>Il s’agit de l’étape 1 de la routine clinique CALQIX.</p>' %}
              {% when 2 %}
                {% assign cqa_title = 'Bénéfices' %}
                {% assign cqa_content = '<ul><li>Élimine jusqu’à 99,9 % de la plaque avec 1 600 pulsations par minute</li><li>Atteint 6 mm en sous-gingival, plus profondément que toute brosse à dents ou le fil dentaire</li><li>4 modes de pression : Gentle, Clean, Pulse, Turbo</li><li>Réservoir de 360 ml, couvre une séance complète sans remplissage</li><li>Étanche IPX7, sûr sous la douche</li><li>30 jours d’autonomie avec une seule charge USB-C</li><li>Conçu pour être utilisé avant votre comprimé d’émail CALQIX pour une reminéralisation maximale</li></ul>' %}
              {% when 3 %}
                {% assign cqa_title = 'Mode d’emploi' %}
                {% assign cqa_content = '<ol><li>Remplissez le réservoir de 360 ml avec de l’eau tiède</li><li>Sélectionnez votre mode de pression, commencez par Gentle si vous débutez avec l’hydropulseur</li><li>Guidez l’embout le long du rebord gingival à un angle de 90° en marquant une pause de 1 à 2 secondes entre les dents</li><li>Videz et rincez le réservoir après chaque utilisation</li><li>Enchaînez immédiatement avec votre comprimé d’émail CALQIX pour la phase de reconstruction</li></ol>' %}
              {% when 4 %}
                {% assign cqa_title = 'Dans la boîte' %}
                {% assign cqa_content = '<ul><li>1× appareil FlowCore</li><li>4× embouts de rechange (standard, orthodontique, parodontal, nettoyeur de langue)</li><li>1× câble de charge USB-C</li><li>1× trousse de voyage</li><li>Guide de démarrage rapide</li></ul><p></p>' %}
              {% when 5 %}
                {% assign cqa_title = 'Livraison et retours' %}
                {% assign cqa_content = '<p><strong>Pays-Bas :</strong> 1 à 2 jours ouvrés, offert dès €80<br><strong>Belgique / Allemagne :</strong> 2 à 3 jours ouvrés, offert dès €80<br><strong>Reste de l’UE :</strong> 3 à 5 jours ouvrés, tarif fixe de €5,95</p><p><strong>Retours sous 30 jours</strong> pour les articles non utilisés dans leur emballage d’origine.<br><strong>Garantie de 2 ans</strong> sur tous les appareils FlowCore.</p>' %}
            {% endcase %}
        {% endcase %}
      {% endif %}

      <div class="cqa-item {% if is_default_open %}open{% endif %}" {{ block.shopify_attributes }}>
        <button class="cqa-trigger" type="button" aria-controls="cqa-panel-{{ section.id }}-{{ block.id }}" aria-expanded="{% if is_default_open %}true{% else %}false{% endif %}">
          {{ cqa_title }}
          <span class="cqa-icon" aria-hidden="true">+</span>
        </button>
        <div id="cqa-panel-{{ section.id }}-{{ block.id }}" class="cqa-body {% if is_default_open %}open{% endif %}" role="region" aria-hidden="{% if is_default_open %}false{% else %}true{% endif %}">
          <div class="cqa-content">
            {{ cqa_content }}
          </div>
        </div>
      </div>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div style="padding: 24px 0; color: #9B9B9B; font-size: 13px; text-align: center;">
        {{ cqa_empty_state }}
      </div>
    {% endif %}

  </div>
</div>

<script>
  (function() {
    var container = document.getElementById('calqix-accordions-{{ section.id }}');
    if (!container) return;

    var allowMultiple = {{ section.settings.allow_multiple | json }};

    var speed = {{ section.settings.animation_speed | json }};

    function setOpen(item, shouldOpen) {
      var body = item.querySelector('.cqa-body');
      var trig = item.querySelector('.cqa-trigger');
      if (!body || !trig) return;

      if (shouldOpen) {
        item.classList.add('open');
        body.classList.add('open');
        trig.setAttribute('aria-expanded', 'true');
        body.setAttribute('aria-hidden', 'false');
        body.style.maxHeight = body.scrollHeight + 'px';
      } else {
        item.classList.remove('open');
        body.classList.remove('open');
        trig.setAttribute('aria-expanded', 'false');
        body.setAttribute('aria-hidden', 'true');
        body.style.maxHeight = '0px';
      }
    }

    function syncOpenHeights() {
      container.querySelectorAll('.cqa-item.open .cqa-body').forEach(function(body) {
        body.style.maxHeight = body.scrollHeight + 'px';
      });
    }

    container.querySelectorAll('.cqa-item').forEach(function(item) {
      var isOpen = item.classList.contains('open');
      setOpen(item, isOpen);
    });

    container.querySelectorAll('.cqa-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        var item = this.closest('.cqa-item');
        if (!item) return;
        var isOpen = item.classList.contains('open');

        if (!allowMultiple) {
          container.querySelectorAll('.cqa-item.open').forEach(function(openItem) {
            if (openItem !== item) setOpen(openItem, false);
          });
        }

        setOpen(item, !isOpen);

        if (!isOpen) {
          window.setTimeout(syncOpenHeights, speed + 20);
        }
      });
    });

    window.addEventListener('resize', function() {
      syncOpenHeights();
    });

    {% if section.settings.custom_js != blank %}
    (function() {
      var section = container;
      var sectionId = '{{ section.id }}';
      {{ section.settings.custom_js }}
    })();
    {% endif %}
  })();
</script>

{% schema %}
{
  "name": "CALQIX Accordions",
  "tag": "section",
  "class": "calqix-accordions-section",
  "blocks": [
    {
